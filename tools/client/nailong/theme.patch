diff --git a/src/components/NailongBackground.tsx b/src/components/NailongBackground.tsx
new file mode 100644
index 0000000..5e93f29
--- /dev/null
+++ b/src/components/NailongBackground.tsx
@@ -0,0 +1,123 @@
+import { useEffect, useRef } from 'react';
+import { invoke } from '@tauri-apps/api/core';
+import backgroundUrl from '@/assets/nailong/background.png';
+import { isTauri } from '@/utils/paths';
+import { createLogger } from '@/utils/logger';
+import {
+  getNailongImageLayout,
+  getNailongPupilOffset,
+  NAILONG_EYES,
+  NAILONG_PUPIL_RADIUS,
+  type GazePoint,
+} from '@/utils/nailongGaze';
+
+const log = createLogger('NailongBackground');
+const CURSOR_POLL_INTERVAL = 33;
+
+interface NailongBackgroundProps {
+  opacity: number;
+}
+
+/** 显示奶龙内置背景，桌面端读取全局指针，窗口外也能持续追视。 */
+export function NailongBackground({ opacity }: NailongBackgroundProps) {
+  const layerRef = useRef<HTMLDivElement>(null);
+  const pupilRefs = useRef<(HTMLDivElement | null)[]>([]);
+
+  useEffect(() => {
+    const layer = layerRef.current;
+    if (!layer) return;
+
+    let disposed = false;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let pointer: GazePoint | null = null;
+
+    /** 使用同一 cover 坐标系放置背景与瞳孔，不触发整页 React 重渲染。 */
+    const updatePupils = () => {
+      const bounds = layer.getBoundingClientRect();
+      const layout = getNailongImageLayout(bounds.width, bounds.height);
+      for (const [index, eye] of NAILONG_EYES.entries()) {
+        const pupil = pupilRefs.current[index];
+        if (!pupil) continue;
+        const imagePointer = pointer
+          ? {
+              x: (pointer.x - bounds.left - layout.x) / layout.scale,
+              y: (pointer.y - bounds.top - layout.y) / layout.scale,
+            }
+          : eye;
+        const offset = getNailongPupilOffset(eye, imagePointer);
+        const radius = NAILONG_PUPIL_RADIUS * layout.scale;
+        pupil.style.width = `${radius * 2}px`;
+        pupil.style.height = `${radius * 2}px`;
+        pupil.style.transform = `translate3d(${layout.x + (eye.x + offset.x) * layout.scale - radius}px, ${layout.y + (eye.y + offset.y) * layout.scale - radius}px, 0)`;
+      }
+    };
+
+    /** 仅串行读取当前指针；切换主题后取消调度，迟到的响应也不再更新界面。 */
+    const pollDesktopCursor = async () => {
+      try {
+        if (!document.hidden) {
+          const position = await invoke<GazePoint | null>('get_nailong_cursor_position');
+          if (disposed) return;
+          if (position) {
+            pointer = position;
+            updatePupils();
+          }
+        }
+        if (!disposed) timer = setTimeout(pollDesktopCursor, CURSOR_POLL_INTERVAL);
+      } catch (error) {
+        if (!disposed) log.warn('读取桌面鼠标位置失败，已停止追视:', error);
+      }
+    };
+
+    /** 浏览器端使用页面指针事件，桌面端的窗口外追视交给原生接口。 */
+    const handlePointerMove = (event: PointerEvent) => {
+      pointer = { x: event.clientX, y: event.clientY };
+      updatePupils();
+    };
+
+    const observer = new ResizeObserver(updatePupils);
+    observer.observe(layer);
+    updatePupils();
+    if (isTauri()) {
+      void pollDesktopCursor();
+    } else {
+      window.addEventListener('pointermove', handlePointerMove);
+    }
+
+    return () => {
+      disposed = true;
+      clearTimeout(timer);
+      observer.disconnect();
+      window.removeEventListener('pointermove', handlePointerMove);
+    };
+  }, []);
+
+  return (
+    <div
+      ref={layerRef}
+      aria-hidden="true"
+      className="absolute inset-0 overflow-hidden pointer-events-none"
+      style={{
+        backgroundImage: `url("${backgroundUrl}")`,
+        backgroundSize: 'cover',
+        backgroundPosition: 'center',
+        opacity: opacity / 100,
+      }}
+    >
+      {NAILONG_EYES.map((_, index) => (
+        <div
+          key={index}
+          ref={(element) => {
+            pupilRefs.current[index] = element;
+          }}
+          className="absolute left-0 top-0 rounded-full"
+          style={{
+            background: 'radial-gradient(circle at 38% 27%, #191b18, #080a08 80%)',
+            transition: 'transform 70ms linear',
+            willChange: 'transform',
+          }}
+        />
+      ))}
+    </div>
+  );
+}
