diff --git a/src/utils/nailongGaze.ts b/src/utils/nailongGaze.ts
new file mode 100644
index 0000000..4c68f9a
--- /dev/null
+++ b/src/utils/nailongGaze.ts
@@ -0,0 +1,33 @@
+export interface GazePoint {
+  x: number;
+  y: number;
+}
+
+// --- 背景坐标与瞳孔范围 ---
+
+export const NAILONG_IMAGE_SIZE = { width: 1448, height: 1086 };
+export const NAILONG_EYES: readonly GazePoint[] = [
+  { x: 493, y: 381 },
+  { x: 954, y: 381 },
+];
+export const NAILONG_PUPIL_RADIUS = 56;
+const MAX_PUPIL_OFFSET = 35;
+
+/** 计算居中 cover 背景的缩放与裁切，让眼睛位置始终对齐原图。 */
+export function getNailongImageLayout(width: number, height: number) {
+  const scale = Math.max(width / NAILONG_IMAGE_SIZE.width, height / NAILONG_IMAGE_SIZE.height);
+  return {
+    scale,
+    x: (width - NAILONG_IMAGE_SIZE.width * scale) / 2,
+    y: (height - NAILONG_IMAGE_SIZE.height * scale) / 2,
+  };
+}
+
+/** 将指针方向映射到眼睛内部，限制瞳孔不会越过绿色眼球边缘。 */
+export function getNailongPupilOffset(eye: GazePoint, pointer: GazePoint): GazePoint {
+  const dx = pointer.x - eye.x;
+  const dy = pointer.y - eye.y;
+  // 近距离缓慢偏移，窗口外的远处指针仍保持方向，但位移不超过眼球边界。
+  const factor = Math.min(0.15, MAX_PUPIL_OFFSET / (Math.hypot(dx, dy) || 1));
+  return { x: dx * factor, y: dy * factor };
+}
