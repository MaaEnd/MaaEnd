@@ -0,0 +1,28 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { useNailongDemoStore } from '../src/stores/nailongDemoStore.ts';
+
+test('theme demo supports start, stop and completion independently per instance', () => {
+  const demo = useNailongDemoStore.getState();
+  demo.setEnabled(true);
+  demo.setPhase('first', 'running');
+  demo.setPhase('second', 'running');
+  demo.setPhase('first', 'completed');
+  assert.equal(useNailongDemoStore.getState().phases.first, 'completed');
+  assert.equal(useNailongDemoStore.getState().phases.second, 'running');
+  demo.setPhase('second', 'idle');
+  assert.equal(useNailongDemoStore.getState().phases.second, 'idle');
+  demo.setEnabled(false);
+});
+
+test('closing demo clears all simulated runs and rejects late state updates', () => {
+  const demo = useNailongDemoStore.getState();
+  demo.setEnabled(true);
+  demo.setPhase('first', 'running');
+  demo.setEnabled(false);
+  demo.setPhase('first', 'completed');
+  assert.deepEqual(useNailongDemoStore.getState().phases, {});
+  demo.setEnabled(true);
+  assert.deepEqual(useNailongDemoStore.getState().phases, {});
+  demo.setEnabled(false);
+});
diff --git a/tests/nailongGaze.test.ts b/tests/nailongGaze.test.ts
new file mode 100644
index 0000000..cd9691d
--- /dev/null
+++ b/tests/nailongGaze.test.ts
@@ -0,0 +1,34 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  getNailongImageLayout,
+  getNailongPupilOffset,
+  NAILONG_EYES,
+} from '../src/utils/nailongGaze.ts';
+
+test('wide windows crop the background vertically and keep the image centered', () => {
+  const layout = getNailongImageLayout(1448, 720);
+  assert.deepEqual(layout, { scale: 1, x: 0, y: -183 });
+});
+
+test('tall windows crop the background horizontally', () => {
+  assert.deepEqual(getNailongImageLayout(1000, 1086), { scale: 1, x: -224, y: 0 });
+});
+
+test('pupils point toward off-window cursors while staying inside the iris', () => {
+  for (const eye of NAILONG_EYES) {
+    for (const pointer of [
+      { x: -10000, y: -10000 },
+      { x: 10000, y: 10000 },
+    ]) {
+      const offset = getNailongPupilOffset(eye, pointer);
+      assert.ok(Math.hypot(offset.x, offset.y) <= 35 + Number.EPSILON * 35);
+      assert.equal(Math.sign(offset.x), Math.sign(pointer.x - eye.x));
+      assert.equal(Math.sign(offset.y), Math.sign(pointer.y - eye.y));
+    }
+  }
+});
+
+test('a pointer centered on the eye leaves the pupil at rest', () => {
+  assert.deepEqual(getNailongPupilOffset(NAILONG_EYES[0], NAILONG_EYES[0]), { x: 0, y: 0 });
+});
