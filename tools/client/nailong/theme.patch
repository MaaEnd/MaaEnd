@@ -0,0 +1,21 @@
+import { create } from 'zustand';
+
+export type NailongDemoPhase = 'idle' | 'running' | 'completed';
+
+interface NailongDemoState {
+  enabled: boolean;
+  phases: Record<string, NailongDemoPhase>;
+  setEnabled: (enabled: boolean) => void;
+  setPhase: (instanceId: string, phase: NailongDemoPhase) => void;
+}
+
+/** 仅存放主题演示状态，不写入配置，也不触碰真实连接、任务或调度器。 */
+export const useNailongDemoStore = create<NailongDemoState>((set) => ({
+  enabled: false,
+  phases: {},
+  /** 开关演示时清空状态，避免再次进入时残留运行效果。 */
+  setEnabled: (enabled) => set({ enabled, phases: {} }),
+  /** 按实例更新演示阶段，关闭演示后不再接受状态变更。 */
+  setPhase: (instanceId, phase) =>
+    set((state) => (state.enabled ? { phases: { ...state.phases, [instanceId]: phase } } : state)),
+}));
