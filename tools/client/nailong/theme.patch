diff --git a/src/components/NailongCompanion.tsx b/src/components/NailongCompanion.tsx
new file mode 100644
index 0000000..40f8243
--- /dev/null
+++ b/src/components/NailongCompanion.tsx
@@ -0,0 +1,100 @@
+import { useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import clsx from 'clsx';
+import { useAppStore } from '@/stores/appStore';
+import { useNailongDemoStore } from '@/stores/nailongDemoStore';
+import standingUrl from '@/assets/nailong/standing-smile.png';
+import workingUrl from '@/assets/nailong/working.gif';
+
+const CATCHPHRASE_KEYS = ['cheer', 'andy', 'spicy', 'keepGoing'] as const;
+
+/** 根据当前实例的真实任务状态，显示工作动图或微笑陪伴。 */
+export function NailongCompanion() {
+  const { t } = useTranslation();
+  const [catchphraseIndex, setCatchphraseIndex] = useState(0);
+  const theme = useAppStore((state) => state.theme);
+  const instance = useAppStore((state) =>
+    state.instances.find((item) => item.id === state.activeInstanceId),
+  );
+  const taskStatus = useAppStore((state) =>
+    state.activeInstanceId ? state.instanceTaskStatus[state.activeInstanceId] : null,
+  );
+  const {
+    enabled: demoEnabled,
+    phases: demoPhases,
+    setPhase: setDemoPhase,
+  } = useNailongDemoStore();
+  const isDemoMode = import.meta.env.DEV && demoEnabled;
+  const demoPhase = instance ? demoPhases[instance.id] : undefined;
+  const isRunning = isDemoMode ? demoPhase === 'running' : instance?.isRunning;
+  const completed = isDemoMode ? demoPhase === 'completed' : taskStatus === 'Succeeded';
+
+  /** 仅结束主题演示，真实任务状态和完成回调保持不变。 */
+  const completeDemo = () => {
+    if (!instance || !isDemoMode) return;
+    setDemoPhase(instance.id, 'completed');
+    useAppStore.getState().addLog(instance.id, {
+      type: 'info',
+      message: t('nailong.demoCompleted'),
+    });
+  };
+
+  /** 从其余三句中等概率抽取，确保每次点击都会更换文案。 */
+  const changeCatchphrase = () => {
+    setCatchphraseIndex(
+      (current) =>
+        (current + 1 + Math.floor(Math.random() * (CATCHPHRASE_KEYS.length - 1))) %
+        CATCHPHRASE_KEYS.length,
+    );
+  };
+
+  if (theme !== 'nailong') return null;
+
+  return (
+    <div className="shrink-0">
+      {isDemoMode && (
+        <p className="px-3 pt-2 text-xs text-text-secondary">{t('nailong.demoHint')}</p>
+      )}
+      {isRunning ? (
+        <div className="nailong-working">
+          <img className="nailong-working-gif" src={workingUrl} alt="" />
+          <img className="nailong-working-still" src={standingUrl} alt="" />
+          <div>
+            <p className="font-medium text-text-primary">{t('nailong.working')}</p>
+            <p className="mt-1 text-xs text-text-secondary">{t('nailong.workingHint')}</p>
+            {isDemoMode && (
+              <button
+                type="button"
+                onClick={completeDemo}
+                className="mt-1 text-xs text-accent underline"
+              >
+                {t('nailong.completeDemo')}
+              </button>
+            )}
+          </div>
+        </div>
+      ) : (
+        <div className="nailong-companion">
+          <p className="nailong-companion-speech" aria-live="polite">
+            {t(`nailong.${CATCHPHRASE_KEYS[catchphraseIndex]}`)}
+          </p>
+          <button
+            type="button"
+            className="nailong-companion-button"
+            onClick={changeCatchphrase}
+            aria-label={t('nailong.changeCatchphrase')}
+            title={t('nailong.changeCatchphrase')}
+          >
+            <img
+              key={`${instance?.id}-${taskStatus}-${demoPhase}`}
+              className={clsx('nailong-standing', completed && 'nailong-celebrating')}
+              src={standingUrl}
+              alt=""
+              draggable={false}
+            />
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
