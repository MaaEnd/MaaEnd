{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "MaaEnd 基质库存（协议第 1 版）",
    "description": "一个账号在贵重品库中的无瑕与高纯基质，逐件记录。只记录观察到的事实；适配哪些武器、可用数量、分组统计都由读取方用自己的数据表计算。本 Schema 故意不禁止未知字段和未知枚举值：同一版本内只会新增可选字段和枚举值，读取方必须忽略不认识的内容。",
    "type": "object",
    "required": [
        "format",
        "version",
        "updated_at",
        "coverage",
        "items"
    ],
    "properties": {
        "format": {
            "description": "协议标识。读取方靠它识别文件，不靠文件名或结构猜测。",
            "const": "maaend.essence_inventory"
        },
        "version": {
            "description": "只在出现不兼容变更时加一。读取方遇到更高的版本应拒绝并提示升级。",
            "const": 1
        },
        "account_id": {
            "description": "账号的不透明代号。同一份 MaaEnd 安装内，相同的值表示同一个游戏账号；不同安装之间不可比较。缺失表示写入时未能确认账号。",
            "type": "string",
            "minLength": 1
        },
        "updated_at": {
            "description": "最近一次成功写入的 UTC 时间。",
            "type": "string",
            "format": "date-time"
        },
        "coverage": {
            "description": "按品质记录 items 的完整程度，键是品质。某个品质没有 complete_at，就表示 items 里该品质只是已知的一部分。",
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "complete_at": {
                        "description": "存在即表示：items 列出了仓库里该品质的每一枚基质，且词条全部读出。值是那次完整盘点的 UTC 时间；此后由 MaaEnd 确认过的变化已经叠加在 items 中。有一次更新尚未确认时，写入方会撤下这个字段。",
                        "type": "string",
                        "format": "date-time"
                    },
                    "unread": {
                        "description": "已确认存在、但词条没有读出的件数。这些基质不在 items 中。有未读件数的品质不会同时带有 complete_at。",
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "not": {
                    "required": [
                        "complete_at",
                        "unread"
                    ]
                }
            }
        },
        "items": {
            "description": "每个元素是一枚实物基质。内容相同的两个元素是两枚。顺序没有含义。",
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "quality",
                    "mark",
                    "skills"
                ],
                "properties": {
                    "quality": {
                        "description": "品质。目前的取值：flawless_gold（无瑕）、high_purity_purple（高纯）。今后可能新增。",
                        "type": "string",
                        "minLength": 1
                    },
                    "mark": {
                        "description": "写入时游戏里的实际标记。目前的取值：none（未标记）、lock（已锁定）、discard（弃置）。今后可能新增。",
                        "type": "string",
                        "minLength": 1
                    },
                    "skills": {
                        "description": "这枚基质的全部词条，按游戏内显示顺序排列。目前恒为三条。",
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "required": [
                                "id",
                                "level"
                            ],
                            "properties": {
                                "id": {
                                    "description": "游戏内部的词条 ID（客户端 GemTable 的 gemTermId），例如 gat_passive_attr_agi、gst_passive_magabn。",
                                    "type": "string",
                                    "pattern": "^[a-z][a-z0-9_]*$"
                                },
                                "level": {
                                    "description": "词条等级。目前基础属性和附加属性为 1 到 6，技能属性为 1 到 3；上限属于游戏数值，本 Schema 不作限制。",
                                    "type": "integer",
                                    "minimum": 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
