{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/MaaEnd/MaaEnd/blob/v2/tools/schema/environment_monitoring_routes.schema.json",
    "title": "EnvironmentMonitoring routes.json",
    "description": "MaaEnd 环境监测观察点路线配置。每个数组元素对应一个观察点的路线/朝向覆盖项，由 tools/pipeline-generate/EnvironmentMonitoring/generator/model.mjs 读取并规范化为生成器输入。字段语义详见 docs/zh_cn/developers/tasks/environment-monitoring-maintain.md。",
    "type": "array",
    "items": {
        "type": "object",
        "title": "ObservationPointRoute",
        "additionalProperties": false,
        "dependencies": {
            "MapTargetTier": [
                "MapTarget"
            ],
            "MapTargetDeckY": [
                "MapTarget"
            ],
            "NavZoneId": [
                "NavAssert",
                "NavPath"
            ],
            "NavAssert": [
                "NavZoneId",
                "NavPath"
            ]
        },
        "required": [
            "MissionId",
            "Name",
            "Id"
        ],
        "allOf": [
            {
                "if": {
                    "anyOf": [
                        {
                            "required": [
                                "EnterMap"
                            ]
                        },
                        {
                            "required": [
                                "MapName"
                            ]
                        },
                        {
                            "required": [
                                "MapAssert"
                            ]
                        },
                        {
                            "required": [
                                "MapPath"
                            ]
                        },
                        {
                            "required": [
                                "MapTarget"
                            ]
                        },
                        {
                            "required": [
                                "MapTargetTier"
                            ]
                        },
                        {
                            "required": [
                                "MapTargetDeckY"
                            ]
                        },
                        {
                            "required": [
                                "MapGoal"
                            ]
                        },
                        {
                            "required": [
                                "NavZoneId"
                            ]
                        },
                        {
                            "required": [
                                "CameraSwipeDirection"
                            ]
                        },
                        {
                            "required": [
                                "CameraMaxHit"
                            ]
                        },
                        {
                            "required": [
                                "Replace"
                            ]
                        },
                        {
                            "required": [
                                "Heading"
                            ]
                        },
                        {
                            "required": [
                                "NoEnsureInitialMovementState"
                            ]
                        },
                        {
                            "required": [
                                "QuickTeleport"
                            ]
                        }
                    ]
                },
                "then": {
                    "required": [
                        "CameraSwipeDirection"
                    ],
                    "anyOf": [
                        {
                            "required": [
                                "EnterMap"
                            ]
                        },
                        {
                            "required": [
                                "QuickTeleport"
                            ],
                            "properties": {
                                "QuickTeleport": {
                                    "const": true
                                }
                            }
                        }
                    ],
                    "oneOf": [
                        {
                            "title": "TeleportAndTakePhoto",
                            "description": "传送点可直接拍照：不配置 MapAssert 和任何寻路字段。",
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "MapAssert"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "MapPath"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "MapTarget"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "MapGoal"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "MapName"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "MapTargetTier"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "MapTargetDeckY"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "NoEnsureInitialMovementState"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "NavZoneId"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "NavAssert"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "NavPath"
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "title": "MapNavigatorRoute",
                            "description": "MapNavigator 路线：NavPath 必填，普通传送还需 NavZoneId / NavAssert，QuickTeleport 可省略二者；不再填写 MapName / MapAssert / MapPath / MapTarget / MapTargetTier / MapGoal / NoEnsureInitialMovementState。",
                            "required": [
                                "NavPath"
                            ],
                            "allOf": [
                                {
                                    "if": {
                                        "not": {
                                            "required": [
                                                "QuickTeleport"
                                            ],
                                            "properties": {
                                                "QuickTeleport": {
                                                    "const": true
                                                }
                                            }
                                        }
                                    },
                                    "then": {
                                        "required": [
                                            "NavZoneId",
                                            "NavAssert"
                                        ]
                                    }
                                }
                            ],
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "MapName"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "MapAssert"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "MapPath"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "MapTarget"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "MapTargetTier"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "MapGoal"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "NoEnsureInitialMovementState"
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "required": [
                                "MapName"
                            ],
                            "allOf": [
                                {
                                    "if": {
                                        "not": {
                                            "allOf": [
                                                {
                                                    "required": [
                                                        "QuickTeleport"
                                                    ],
                                                    "properties": {
                                                        "QuickTeleport": {
                                                            "const": true
                                                        }
                                                    }
                                                },
                                                {
                                                    "anyOf": [
                                                        {
                                                            "required": [
                                                                "MapPath"
                                                            ]
                                                        },
                                                        {
                                                            "required": [
                                                                "MapTarget"
                                                            ]
                                                        },
                                                        {
                                                            "required": [
                                                                "MapGoal"
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    },
                                    "then": {
                                        "required": [
                                            "MapAssert"
                                        ]
                                    }
                                }
                            ],
                            "oneOf": [
                                {
                                    "required": [
                                        "MapPath"
                                    ]
                                },
                                {
                                    "required": [
                                        "MapTarget"
                                    ]
                                },
                                {
                                    "required": [
                                        "MapGoal"
                                    ]
                                }
                            ],
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "NavZoneId"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "NavAssert"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "NavPath"
                                        ]
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ],
        "properties": {
            "MissionId": {
                "type": "string",
                "minLength": 1,
                "description": "观察点任务 ID，用于在 model.mjs 中匹配 zmdmap 精简数据 environment_monitoring.json 的 mission_id。该字段是 routes.json 的主键。"
            },
            "Name": {
                "type": "string",
                "minLength": 1,
                "description": "观察点中文名，仅供人工阅读。生成器以 MissionId 匹配；Name 与当前游戏数据中的中文名不一致时会自动刷新。"
            },
            "Id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                "description": "最终模板使用的观察点节点 ID，用于拼接节点名和输出文件名（${Station}/${Id}.json）。生成器会按当前游戏数据中的英文名自动刷新，方便人工搜索对应节点。"
            },
            "EnterMap": {
                "type": "string",
                "minLength": 1,
                "description": "传送入口 Pipeline 节点名，不限制名称前缀或字符组合。该节点必须已存在于 assets/resource/pipeline/，并能作为 SubTask 完整执行后正常返回。暂无合适入口时，直接不要在 routes.json 中补路线字段，让生成器走未适配分支。",
                "examples": [
                    "SceneEnterWorldWulingJingyuValley7",
                    "SceneEnterWorldWulingMarkerStone_Ship2DestinationThenWalkAndFight"
                ]
            },
            "MapName": {
                "type": "string",
                "minLength": 1,
                "description": "遗留字段，仅 MapTarget / MapPath / MapGoal 路线使用，新增路线改用 NavZoneId。使用 MapTarget 时填写 MapLocate 的 zone_id；MapPath / MapGoal 填写原有实现的 map_name（支持正则）。传送后直拍时省略。",
                "examples": [
                    "map02_lv001",
                    "map02_lv002",
                    "map02_lv003",
                    "map02_lv004",
                    "map02_lv004_tier_328",
                    "^map\\d+_lv\\d+$",
                    "Wuling_Base"
                ]
            },
            "MapAssert": {
                "type": "array",
                "description": "初始位置判断矩形 [x, y, w, h]。普通传送寻路路线必填；QuickTeleport 与 MapPath / MapTarget / MapGoal 组合时可省略；传送后直拍时必须省略。",
                "items": {
                    "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
            },
            "MapPath": {
                "type": "array",
                "description": "遗留字段，只保留给尚未迁移的存量路线，新增路线改用 NavPath。逐点跟随的寻路路径（小地图坐标序列），与 MapTarget / MapGoal 三选一；传送后直拍时省略。",
                "minItems": 1,
                "items": {
                    "type": "array",
                    "description": "路径点 [x, y]（小地图坐标）。",
                    "items": {
                        "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                }
            },
            "MapTarget": {
                "type": "array",
                "description": "MapNavigateAction 的 NAVMESH 目标点 [x, y]。未配置 MapTargetTier 时按 base 坐标解释；配置 MapTargetTier 时按对应 tier 坐标解释。与 MapPath / MapGoal 三选一，适合不依赖交互、过图、机关的普通可达路线。",
                "items": {
                    "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
            },
            "MapTargetTier": {
                "type": "string",
                "minLength": 1,
                "description": "可选，仅用于 MapTarget 路线。MapTarget 坐标所在的 MapNavigator target_tier 区域名；当目标点与起点不在同一 tier，且 MapTarget 是在 tier 底图上直接点出的坐标时填写。未配置时 MapTarget 按 base 坐标解释。",
                "examples": [
                    "ValleyIV_L1_171",
                    "Wuling_L4_328"
                ]
            },
            "MapTargetDeckY": {
                "type": "number",
                "description": "可选，仅用于 MapTarget 路线。目标点所在那张可走面的世界高度。小地图是二维的，同一个坐标底下可能压着两三张面（走廊 / 天桥 / 屋顶）；不配置时寻路取整格的全部面，先够到哪张停哪张。用 MapNavigator 预览工具点中目标后从重叠面列表读出该值，别手估。填了却够不到那张面时会报「目标面不可达」而不是静默走到另一张。",
                "examples": [
                    265.37
                ]
            },
            "MapGoal": {
                "type": "array",
                "description": "遗留字段，只保留给尚未迁移的存量路线，新增路线改用 NavPath。自动寻路目标点 [x, y]，生成器会把 MapName 作为 map_name、该坐标作为 target 交给原有实现。与 MapPath / MapTarget 三选一。",
                "items": {
                    "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
            },
            "NavZoneId": {
                "type": "string",
                "minLength": 1,
                "description": "普通传送 MapNavigator 路线起点断言的 MapLocate zone_id（渲染为 MapLocateAssertLocation 的 zone_id）。与 NavAssert / NavPath 同时配置；QuickTeleport 不执行起点断言，可省略 NavZoneId / NavAssert。",
                "examples": [
                    "Wuling_Base",
                    "Wuling_L4_328"
                ]
            },
            "NavAssert": {
                "type": "array",
                "description": "初始位置判断矩形 [x, y, w, h]，使用 NavZoneId 分区坐标（tier 分区为 tier 局部坐标）。普通传送必填；QuickTeleport 不执行起点断言，可与 NavZoneId 一并省略。",
                "items": {
                    "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
            },
            "NavPath": {
                "type": "array",
                "description": "MapNavigateAction 的 path 数组（不含 HEADING；朝向仍由 Heading 字段在生成时追加）。元素为坐标点 [x, y] / [x, y, \"COLLECT\"|\"DIG\"|\"PORTAL\"]，或 {\"action\": \"ZONE\"|\"NAVMESH\", ...} 声明，格式详见 docs/zh_cn/developers/components/map-navigator.md。",
                "minItems": 1,
                "items": {
                    "oneOf": [
                        {
                            "type": "array",
                            "items": [
                                {
                                    "type": "number"
                                },
                                {
                                    "type": "number"
                                },
                                {
                                    "type": "string"
                                }
                            ],
                            "additionalItems": false,
                            "minItems": 2
                        },
                        {
                            "type": "object",
                            "required": [
                                "action"
                            ]
                        }
                    ]
                }
            },
            "CameraSwipeDirection": {
                "type": "string",
                "description": "拍照时调整摄像头朝向的滑屏方向。",
                "enum": [
                    "EnvironmentMonitoringSwipeScreenUp",
                    "EnvironmentMonitoringSwipeScreenDown",
                    "EnvironmentMonitoringSwipeScreenLeft",
                    "EnvironmentMonitoringSwipeScreenRight"
                ]
            },
            "CameraMaxHit": {
                "type": "integer",
                "description": "调整摄像头时的最大滑屏命中次数。可选；默认值为 2。拍照目标较难对准时可适当调大。",
                "minimum": 1
            },
            "Replace": {
                "type": "array",
                "description": "可选；任务列表和任务详情页 OCR 的 replace 替换表，用于修正任务文本中容易被误识别的字符。生成到 Check{Id}Text.replace 与 In{Id}Mission.replace。每一项为 [识别结果, 替换后文本]。",
                "items": {
                    "type": "array",
                    "items": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "string"
                        }
                    ],
                    "additionalItems": false,
                    "minItems": 2,
                    "maxItems": 2
                },
                "examples": [
                    [
                        [
                            "売",
                            "壳"
                        ]
                    ]
                ]
            },
            "Heading": {
                "type": "number",
                "description": "可选；进入拍照模式前把角色朝向旋转到该角度。传送后直拍时只原地调整朝向，不需要任何地图断言或寻路字段。仅影响角色朝向，与摄像头滑屏（CameraSwipeDirection）相互独立。",
                "minimum": 0,
                "exclusiveMaximum": 360
            },
            "NoEnsureInitialMovementState": {
                "type": "boolean",
                "description": "可选，默认 false，仅遗留的 MapPath 路线使用，对应其 no_ensure_initial_movement_state 参数。一般只在路线起点紧贴桥边、悬崖边等危险地形时开启，用于跳过开局的冲刺准备动作，避免角色因为这一步直接掉下桥或掉下悬崖。"
            },
            "QuickTeleport": {
                "type": "boolean",
                "description": "可选，默认 false。启用后通过已追踪任务的地图界面依次点击“前往传送”和“传送”，不再调用 EnterMap 配置的 Pipeline 入口节点；此时 EnterMap 可省略。"
            }
        }
    }
}
