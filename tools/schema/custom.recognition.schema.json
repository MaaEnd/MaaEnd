{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Custom Recognition Schema",
    "description": "Schema for custom recognitions in MaaFramework pipeline",
    "properties": {
        "custom_recognition": {
            "enum": [
                "AutoFightEntryRecognition",
                "AeroSalvageGridRecognition",
                "AeroSalvageInitialStateRecognition",
                "AutoSellPriceCompareRecognition",
                "AutoSellScanItemRecognition",
                "AutoStockpile.Recognition",
                "EssenceFilterAfterBattleNthRecognition",
                "EssenceGridAdvanceRecognition",
                "EssenceGridPendingRecognition",
                "ExpendableRecognition",
                "ExpressionRecognition",
                "ImageCheckNotPassedRecognition",
                "IconRecognition",
                "IntelArchiveScanDetailRecognition",
                "IntelArchiveScanItemsRecognition",
                "ItemDataReady",
                "ItemQuantitySatisfied",
                "ItemTransferSameItemRecognition",
                "ListCompleteRecognition",
                "MapLocateAssertLocation",
                "MapTrackerAssertLocation",
                "MapTrackerAssertLocationCompatible",
                "MapTrackerBigMapFindImage",
                "MapTrackerBigMapInfer",
                "MapTrackerInfer",
                "PuzzleRecognition",
                "ReceptionRoomExchangeCountdownWithinThresholdRecognition",
                "ReceptionRoomWaitExchangeKeepAliveDueRecognition",
                "ScheduleRecognition",
                "ScreenshotStableRecognition",
                "ScrollbarRecognition",
                "ScrollbarCompleteRecognition",
                "SellProductCurrentBestOperator",
                "SellProductCurrentOperatorUncached",
                "SellProductOperatorCacheReady",
                "SellProductOperatorListBottom",
                "SellProductOperatorScanOutcome",
                "SellProductPriorityItem",
                "SellProductSelectBestOperator",
                "TrialOfSwordmancy.Recognize",
                "TrialOfSwordmancy.RecognizeAband",
                "TrialOfSwordmancy.RecognizeDeck",
                "WeaponInventoryScanRecognition",
                "SeizeDeliveryJobsFindTargetRecognition",
                "SeizeDeliveryJobsScanTargetRecognition",
                "autoEcoFarmCalculateSwipeTarget",
                "autoEcoFarmFindNearestRecognitionResult"
            ]
        }
    },
    "allOf": [
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": {
                    "custom_recognition": {
                        "const": "IconRecognition"
                    }
                }
            },
            "then": {
                "type": "object",
                "required": [ "roi", "custom_recognition_param" ],
                "properties": {
                    "custom_recognition_param": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [ "grid_type" ],
                        "properties": {
                            "grid_type": {
                                "type": "string",
                                "enum": [
                                    "trade",
                                    "transfer",
                                    "port_storager",
                                    "valuables",
                                    "shipment",
                                    "credit_trade",
                                    "rewards",
                                    "single_roi"
                                ],
                                "title": "Grid Type",
                                "description": "Icon grid layout used by IconRecognition."
                            },
                            "item_ids": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "uniqueItems": true,
                                "title": "Item IDs",
                                "description": "Optional item catalog IDs to match."
                            },
                            "item_filters": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "uniqueItems": true,
                                "title": "Item Filters",
                                "description": "Optional storageKind:categoryType filters for candidate icons."
                            },
                            "item_recheck_filters": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "uniqueItems": true,
                                "title": "Item Recheck Filters",
                                "description": "Optional storageKind:categoryType filters for reverse-checking item_ids; deduplicate is recommended to avoid repeated checks."
                            },
                            "threshold": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1,
                                "default": 0.85,
                                "title": "Threshold",
                                "description": "General minimum final match score enforced uniformly for every grid type."
                            },
                            "subpixel_threshold": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1,
                                "default": 0.6,
                                "title": "Subpixel Threshold",
                                "description": "Minimum base score for subpixel refinement."
                            },
                            "deduplicate": {
                                "type": "boolean",
                                "default": false,
                                "title": "Deduplicate",
                                "description": "Keep only the highest-scoring match for each item ID."
                            },
                            "debug": {
                                "type": "boolean",
                                "default": false,
                                "title": "Debug",
                                "description": "Collect IconRecognition diagnostics and debug captures."
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": {
                    "custom_recognition": {
                        "enum": [
                            "AeroSalvageGridRecognition",
                            "AeroSalvageInitialStateRecognition"
                        ]
                    }
                }
            },
            "then": {
                "type": "object",
                "required": [ "custom_recognition_param" ],
                "properties": {
                    "custom_recognition_param": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "grid_roi",
                            "center_roi"
                        ],
                        "properties": {
                            "grid_roi": {
                                "description": "Grid detection rectangle [x, y, width, height].",
                                "type": "array",
                                "items": { "type": "integer" },
                                "minItems": 4,
                                "maxItems": 4
                            },
                            "center_roi": {
                                "description": "Center-point detection rectangle [x, y, width, height].",
                                "type": "array",
                                "items": { "type": "integer" },
                                "minItems": 4,
                                "maxItems": 4
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": { "custom_recognition": { "const": "ItemDataReady" } }
            },
            "then": {
                "type": "object",
                "properties": {
                    "custom_recognition_param": {
                        "$ref": "./components/ims.schema.json#/$defs/ItemDataReadyParam"
                    }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": { "custom_recognition": { "const": "ItemQuantitySatisfied" } }
            },
            "then": {
                "type": "object",
                "required": [ "custom_recognition_param" ],
                "properties": {
                    "custom_recognition_param": {
                        "$ref": "./components/ims.schema.json#/$defs/ItemQuantitySatisfiedParam"
                    }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": { "custom_recognition": { "const": "ExpressionRecognition" } }
            },
            "then": {
                "type": "object",
                "required": [ "custom_recognition_param" ],
                "properties": {
                    "custom_recognition_param": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [ "expression" ],
                        "properties": {
                            "expression": {
                                "type": "string",
                                "minLength": 1
                            },
                            "box_node": {
                                "type": "string",
                                "minLength": 1
                            },
                            "focus_matched_resolved_expression": {
                                "type": "boolean"
                            },
                            "focus_unmatched_resolved_expression": {
                                "type": "boolean"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": { "custom_recognition": { "const": "IntelArchiveScanItemsRecognition" } }
            },
            "then": {
                "type": "object",
                "properties": {
                    "custom_recognition_param": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "file_category": {
                                "type": "string",
                                "enum": [
                                    "investigate",
                                    "paper",
                                    "digital",
                                    "collection",
                                    "media",
                                    "document",
                                    "report"
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": { "custom_recognition": { "const": "ItemTransferSameItemRecognition" } }
            },
            "then": {
                "type": "object",
                "required": [ "custom_recognition_param" ],
                "properties": {
                    "custom_recognition_param": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [ "forward_item_node", "return_item_node" ],
                        "properties": {
                            "forward_item_node": {
                                "type": "string",
                                "minLength": 1
                            },
                            "return_item_node": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": { "custom_recognition": { "const": "ListCompleteRecognition" } }
            },
            "then": {
                "type": "object",
                "properties": {
                    "custom_recognition_param": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "threshold": {
                                "type": "number",
                                "exclusiveMinimum": 0,
                                "maximum": 1,
                                "default": 0.9,
                                "title": "Threshold",
                                "description": "TemplateMatch threshold. Score >= threshold means the list is complete (return true/hit). Below threshold recaptures OverrideImage and returns false/miss so Pipeline can keep scrolling. Default 0.9. Recognition region uses the native recognition roi (V2: recognition.param.roi, sibling of custom_recognition; exposed as arg.Roi), not this param. Place this recognition before the swipe node; callers must use post_wait_freezes on the swipe so recognition runs only after the screen is still."
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": { "custom_recognition": { "const": "ScrollbarRecognition" } }
            },
            "then": {
                "type": "object",
                "required": [ "roi" ],
                "properties": {
                    "custom_recognition_param": {
                        "type": "object",
                        "additionalProperties": false
                    }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": { "custom_recognition": { "const": "ScrollbarCompleteRecognition" } }
            },
            "then": {
                "type": "object",
                "required": [ "roi" ],
                "properties": {
                    "custom_recognition_param": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "position_tolerance": {
                                "type": "integer",
                                "minimum": 0,
                                "default": 2,
                                "title": "Position Tolerance",
                                "description": "Maximum 720p pixel difference allowed for both the top and bottom boundaries of the detected scrollbar thumb. When both boundaries remain within tolerance between consecutive frames, the list is complete. Default 2. Recognition region uses the native recognition roi."
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": { "custom_recognition": { "const": "ExpendableRecognition" } }
            },
            "then": {
                "type": "object",
                "required": [ "custom_recognition_param" ],
                "properties": {
                    "custom_recognition_param": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [ "candidate" ],
                        "properties": {
                            "candidate": {
                                "type": "string",
                                "minLength": 1,
                                "title": "Candidate",
                                "description": "OCR or And (box_index -> text OCR). That named OCR is patched with visited blacklist. Hit box is returned for Click."
                            },
                            "visited_node": {
                                "type": "string",
                                "minLength": 1,
                                "title": "Visited Node",
                                "description": "Optional. Node whose attach.visited is used as the shared blacklist store. Defaults to the current Custom recognition node."
                            },
                            "key_regex": {
                                "type": "string",
                                "minLength": 1,
                                "title": "Key Regex",
                                "description": "Optional. Regex applied to OCR text to derive the visited key (capture group 1 if present, otherwise the full match; fall back to raw text on no match). Without it, store/exclude the raw OCR string exactly. With it, the blacklist also tolerates non-digit OCR tail noise after the key. Game-specific truncation (e.g. remark cut at first ')', normal name cut at '#UID') belongs in Pipeline, not in this component."
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": { "custom_recognition": { "const": "MapTrackerAssertLocation" } }
            },
            "then": {
                "type": "object",
                "required": [ "custom_recognition_param" ],
                "properties": {
                    "custom_recognition_param": { "$ref": "./components/map_tracker.schema.json#/$defs/MapTrackerAssertLocationParam" }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": { "custom_recognition": { "const": "MapLocateAssertLocation" } }
            },
            "then": {
                "type": "object",
                "required": [ "custom_recognition_param" ],
                "properties": {
                    "custom_recognition_param": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [ "zone_id", "target" ],
                        "properties": {
                            "zone_id": {
                                "type": "string",
                                "minLength": 1
                            },
                            "target": {
                                "type": "array",
                                "items": {
                                    "type": "number"
                                },
                                "minItems": 4,
                                "maxItems": 4
                            },
                            "loc_threshold": {
                                "type": "number"
                            },
                            "yolo_threshold": {
                                "type": "number"
                            },
                            "force_global_search": {
                                "type": "boolean"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": { "custom_recognition": { "const": "MapTrackerInfer" } }
            },
            "then": {
                "type": "object",
                "required": [ "custom_recognition_param" ],
                "properties": {
                    "custom_recognition_param": { "$ref": "./components/map_tracker.schema.json#/$defs/MapTrackerInferParam" }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": { "custom_recognition": { "const": "MapTrackerBigMapInfer" } }
            },
            "then": {
                "type": "object",
                "required": [ "custom_recognition_param" ],
                "properties": {
                    "custom_recognition_param": { "$ref": "./components/map_tracker.schema.json#/$defs/MapTrackerBigMapInferParam" }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": { "custom_recognition": { "const": "MapTrackerBigMapFindImage" } }
            },
            "then": {
                "type": "object",
                "required": [ "custom_recognition_param" ],
                "properties": {
                    "custom_recognition_param": { "$ref": "./components/map_tracker.schema.json#/$defs/MapTrackerBigMapFindImageParam" }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [ "custom_recognition" ],
                "properties": { "custom_recognition": { "const": "SellProductPriorityItem" } }
            },
            "then": {
                "type": "object",
                "required": [ "custom_recognition_param" ],
                "properties": {
                    "custom_recognition_param": { "$ref": "./components/sell_product.schema.json#/$defs/PriorityItemRecognitionParam" }
                }
            }
        }
    ]
}
