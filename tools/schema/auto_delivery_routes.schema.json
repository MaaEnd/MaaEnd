{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/MaaEnd/MaaEnd/blob/v2/tools/schema/auto_delivery_routes.schema.json",
    "title": "AutoDelivery routes.json",
    "description": "AutoDelivery 仓储与送货终点的实测 MapNavigator 路线覆盖。",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "depots",
        "destinations"
    ],
    "properties": {
        "depots": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "source_id"
                ],
                "anyOf": [
                    {
                        "required": [
                            "path"
                        ]
                    },
                    {
                        "required": [
                            "retry_path"
                        ]
                    },
                    {
                        "required": [
                            "departure_path"
                        ]
                    }
                ],
                "properties": {
                    "source_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "path": {
                        "$ref": "#/$defs/path"
                    },
                    "retry_path": {
                        "$ref": "#/$defs/path"
                    },
                    "departure_path": {
                        "$ref": "#/$defs/path"
                    }
                }
            }
        },
        "destinations": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "source_id",
                    "path"
                ],
                "properties": {
                    "source_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "path": {
                        "$ref": "#/$defs/path"
                    }
                }
            }
        }
    },
    "$defs": {
        "path": {
            "type": "array",
            "minItems": 1,
            "description": "MapNavigateAction.custom_action_param.path，必须来自 MapNavigator 工具或实机录制。"
        }
    }
}
