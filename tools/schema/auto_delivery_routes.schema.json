{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/MaaEnd/MaaEnd/blob/v2/tools/schema/auto_delivery_routes.schema.json",
    "title": "AutoDelivery routes.json",
    "description": "AutoDelivery 仓储与送货终点的检索元数据及实测 MapNavigator 路线覆盖。",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "depots",
        "destinations"
    ],
    "properties": {
        "depots": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "source_id",
                    "name"
                ],
                "properties": {
                    "source_id": {
                        "type": "string",
                        "minLength": 1,
                        "description": "仓储节点在 delivery_destinations.json 中的稳定 ID。"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "从 delivery_destinations.json 同步的中文名称，仅供检索。"
                    },
                    "description": {
                        "type": "string",
                        "minLength": 1,
                        "description": "可选的人工维护说明，仅供阅读，不参与路线生成。"
                    },
                    "walk_only": {
                        "type": "boolean",
                        "description": "是否在全局启用滑索时仍强制该仓储主路线仅步行。"
                    },
                    "yaw": {
                        "type": "number",
                        "description": "覆盖自动接近点使用的朝向角（度，与数据源 yaw 同义：0 度指向底图上方，数值增大顺时针旋转）。主路线或自动重试路线未被 path / retry_path 覆盖时生效。"
                    },
                    "path": {
                        "$ref": "#/$defs/path"
                    },
                    "retry_path": {
                        "$ref": "#/$defs/path"
                    },
                    "departure_path": {
                        "$ref": "#/$defs/path"
                    }
                }
            }
        },
        "destinations": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "source_id",
                    "name",
                    "depot_id"
                ],
                "properties": {
                    "source_id": {
                        "type": "string",
                        "minLength": 1,
                        "description": "送货终点在 delivery_destinations.json 中的稳定 ID。"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "从 delivery_destinations.json 同步的中文名称，仅供检索。"
                    },
                    "depot_id": {
                        "type": "string",
                        "minLength": 1,
                        "description": "从 delivery_destinations.json 同步的起点仓储 ID，仅供检索。"
                    },
                    "description": {
                        "type": "string",
                        "minLength": 1,
                        "description": "可选的人工维护说明，仅供阅读，不参与路线生成。"
                    },
                    "walk_only": {
                        "type": "boolean",
                        "description": "是否在全局启用滑索时仍强制该终点主路线仅步行。"
                    },
                    "yaw": {
                        "type": "number",
                        "description": "覆盖自动接近点使用的朝向角（度，与数据源 yaw 同义：0 度指向底图上方，数值增大顺时针旋转）。作用于回收站主路线的接近点与自动重试路线；NPC 主路线仍为单个终点。"
                    },
                    "path": {
                        "$ref": "#/$defs/path"
                    },
                    "retry_path": {
                        "$ref": "#/$defs/path"
                    }
                }
            }
        }
    },
    "$defs": {
        "path": {
            "type": "array",
            "minItems": 1,
            "description": "MapNavigateAction.custom_action_param.path，必须来自 MapNavigator 工具或实机录制。"
        }
    }
}
