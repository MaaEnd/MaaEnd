{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Failure Collector Component Schemas",
    "description": "Parameter definitions for generic FailureCollector custom actions.",
    "$defs": {
        "BaseParam": {
            "type": "object",
            "required": [
                "key"
            ],
            "properties": {
                "key": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "SetCurrentParam": {
            "allOf": [
                {
                    "$ref": "#/$defs/BaseParam"
                },
                {
                    "type": "object",
                    "required": [
                        "name"
                    ],
                    "properties": {
                        "name": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        },
        "RecordParam": {
            "allOf": [
                {
                    "$ref": "#/$defs/BaseParam"
                },
                {
                    "type": "object",
                    "properties": {
                        "item_key": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        },
        "FinishParam": {
            "allOf": [
                {
                    "$ref": "#/$defs/BaseParam"
                },
                {
                    "type": "object",
                    "properties": {
                        "summary_key": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        }
    }
}
