{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "Action": {
            "type": "object",
            "required": [
                "step"
            ],
            "additionalProperties": false,
            "properties": {
                "step": {
                    "enum": [
                        "begin",
                        "reset",
                        "top",
                        "read",
                        "bottom",
                        "finish",
                        "end",
                        "operator_missing",
                        "expectation_missing"
                    ]
                },
                "tab": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1
                }
            }
        },
        "Guard": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "decision": {
                    "enum": [
                        "again",
                        "done",
                        "skip"
                    ]
                },
                "tab": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1
                }
            }
        }
    }
}
