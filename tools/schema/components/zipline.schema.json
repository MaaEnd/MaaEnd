{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Zipline Component Schema",
    "description": "Zipline custom action parameter definitions. Referenced by custom.action.schema.json.",
    "$defs": {
        "ImportParam": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "url": {
                    "type": "string",
                    "format": "uri",
                    "minLength": 1
                },
                "mark_list_path": {
                    "type": "string",
                    "minLength": 1
                },
                "template_ids": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "firefox": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Linux only: Firefox executable path, defaults to firefox from PATH. Ignored on Windows."
                },
                "proxy_port": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "Linux only: local restricted MITM proxy listen port; 0 picks a random free port. Ignored on Windows."
                }
            }
        }
    }
}
