{
    "DeliveryJobsCheck${DepotId}DeliveryJob": {
        "desc": "检查${DepotName}的送货任务按钮",
        "recognition": "OCR",
        "roi": "DeliveryJobsCheckLocalDepotNode${DepotId}Text",
        "roi_offset": [
            -39,
            286,
            220,
            62
        ],
        "expected": [
            "查看任务",
            "查看任務",
            "(?i)Check\\s*Mission",
            "任務確認",
            "임무 확인"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "DeliveryJobsEnter${DepotId}DeliveryJob": {
        "desc": "${DepotName}：进入送货任务",
        "max_hit": 1,
        "recognition": "And",
        "all_of": [
            "DeliveryJobsCheckLocalDepotNode${DepotId}Text",
            "DeliveryJobsCheck${DepotId}DeliveryJob"
        ],
        "box_index": 1,
        "pre_delay": 0,
        "action": "Click",
        "anchor": {
            "DeliveryJobsReturnToDepotNode": "InLocalDepotNode"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsClickTransferJob"
        ]
    },
    "DeliveryJobsReturnAndTransfer${DepotId}": {
        "desc": "返回${DepotName}并转交达到报价阈值的任务",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "${DepotScene}"
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsEnter${DepotId}PriceDeliveryJob"
        ]
    },
    "DeliveryJobsEnter${DepotId}PriceDeliveryJob": {
        "desc": "${DepotName}：进入达到报价阈值的送货任务",
        "max_hit": 1,
        "recognition": "And",
        "all_of": [
            "DeliveryJobsCheckLocalDepotNode${DepotId}Text",
            "DeliveryJobsCheck${DepotId}DeliveryJob"
        ],
        "box_index": 1,
        "pre_delay": 0,
        "action": "Click",
        "anchor": {
            "DeliveryJobsReturnToDepotNode": "InLocalDepotNode"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsClickTransferJob"
        ]
    },
    "DeliveryJobsWait${DepotId}DeliveryMissionDetail": {
        "desc": "等待${DepotName}的送货任务详情界面稳定后再开始全自动送货",
        "recognition": "And",
        "all_of": [
            "AutoDeliveryInDeliveryMissionDetail"
        ],
        // 等待区域与组件里 AutoDeliveryInDeliveryMissionDetail 的等待区域相同
        "pre_wait_freezes": {
            "time": 200,
            "target": [
                417,
                51,
                547,
                279
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsAutoDelivery${DepotId}"
        ]
    },
    "DeliveryJobsAutoDelivery${DepotId}": {
        "desc": "为${DepotName}当前送货任务设置回跳锚点，并交给公共调用节点处理",
        "pre_delay": 0,
        "anchor": {
            "DeliveryJobsAfterAutoDelivery": "DeliveryJobs${RegionId}Loop",
            "DeliveryJobsReturnToDepotNode": "${DepotScene}"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsDeliverByAutoDelivery"
        ]
    },
    "DeliveryJobsOngoingDeliveryFor${DepotId}": {
        "desc": "按${DepotName}的处理方式处理已有的待运送货物；next 由该仓储节点的处理方式覆盖，不声明回跳落点",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsSkipOngoingDelivery"
        ]
    },
    "DeliveryJobsCheckLocalDepotNode${DepotId}Text": {
        "desc": "检查本地仓储节点中是否有${DepotName}",
        "recognition": "OCR",
        "roi": [
            67,
            224,
            1006,
            95
        ],
        "expected": "${DepotExpected}",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "DeliveryJobsCheck${DepotId}Cargo": {
        "desc": "检查${DepotName}的货物是否准备好",
        "recognition": "OCR",
        "roi": "DeliveryJobsCheckLocalDepotNode${DepotId}Text",
        "roi_offset": [
            -39,
            286,
            220,
            62
        ],
        "expected": [
            "查看报价",
            "查看報價",
            "(?i)Check\\s*Bid",
            "希望価格確認",
            "货物装箱",
            "貨物裝箱",
            "(?i)Pack\\s*Goods",
            "パッキング",
            "화물 포장",
            "입찰 보기"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "DeliveryJobsEnter${DepotId}Cargo": {
        "desc": "进入${DepotName}货物",
        "max_hit": 1,
        "recognition": "And",
        "all_of": [
            "DeliveryJobsCheckLocalDepotNode${DepotId}Text",
            "DeliveryJobsCheck${DepotId}Cargo"
        ],
        "box_index": 1,
        "pre_delay": 0,
        "action": "Click",
        "anchor": {
            "DeliveryJobsSelectPriorityItems": "DeliveryJobsSelectPriorityItems${RegionId}",
            "DeliveryJobsRedistributionBidAction": "DeliveryJobsRedistributionBidNextStep",
            "DeliveryJobsAfterAcceptJob": "DeliveryJobsDeliverQuickly",
            "DeliveryJobsGoToDepot": "${DepotScene}",
            "DeliveryJobsReturnToDepotNode": "${DepotScene}"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsPackCargo"
        ]
    },
    "DeliveryJobsDecide${DepotId}Quote": {
        "desc": "按报价决定如何处理${DepotName}的货物",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobs${DepotId}QuoteAtLeastMinimum",
            "DeliveryJobs${DepotId}QuoteBelowMinimum",
            "DeliveryJobsBidPriceRecognitionFailed"
        ]
    },
    "DeliveryJobs${DepotId}QuoteAtLeastMinimum": {
        "desc": "${DepotName}当前报价达到或高于阈值",
        "recognition": "Custom",
        "custom_recognition": "ExpressionRecognition",
        "custom_recognition_param": {
            "expression": "{DeliveryJobsSelectedBidPrice}>=119000"
        },
        "pre_delay": 0,
        "anchor": {
            "DeliveryJobsGoToDepot": "DeliveryJobsReturnAndTransfer${DepotId}"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsRedistributionBidNextStep"
        ]
    },
    "DeliveryJobs${DepotId}QuoteBelowMinimum": {
        "desc": "${DepotName}当前报价低于阈值",
        "recognition": "Custom",
        "custom_recognition": "ExpressionRecognition",
        "custom_recognition_param": {
            "expression": "{DeliveryJobsSelectedBidPrice}<119000"
        },
        "pre_delay": 0,
        "anchor": {
            "DeliveryJobsGoToDepot": "${DepotScene}"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsRedistributionBidNextStep"
        ]
    }
}
