{
    "DeliveryJobsAuto${RegionId}": {
        "desc": "自动选择${RegionName}运送委托",
        "recognition": "Or",
        "any_of": [
            "InRegionalDevelopment${RegionId}",
            "DeliveryJobsIn${RegionId}LocalDepotNode"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobs${RegionId}",
            "DeliveryJobsLoop"
        ]
    },
    "DeliveryJobs${RegionId}": {
        "desc": "${RegionName}运送委托",
        "max_hit": 1,
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "${RegionScene}"
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobs${RegionId}Loop"
        ]
    },
    "DeliveryJobs${RegionId}Loop": {
        "desc": "${RegionName}运送委托主循环",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "${DepotScene}"
            ]
        },
        "anchor": {
            "DeliveryJobsGoToDepot": "${DepotScene}"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": "${LoopNext}"
    },
    "DeliveryJobsSelectPriorityItems${RegionId}": {
        "desc": "${RegionName}未启用指定货物优先级，使用游戏默认填充至满",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsCargoFillToMax"
        ]
    },
    "DeliveryJobsIn${RegionId}LocalDepotNode": {
        "desc": "在${RegionName}本地仓储节点界面",
        "recognition": "And",
        "all_of": [
            "InLocalDepotNode",
            "DeliveryJobsCheckLocalDepotNode${FirstDepotId}Text"
        ],
        // 刚进入界面时可能会遇到元素未加载完成，必须等待页面稳定后才能继续
        "pre_wait_freezes": {
            "time": 80,
            "target": [
                66,
                221,
                166,
                124
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
