{
    "${Id}": {
        "desc": "${Name}",
        "max_hit": 1,
        "recognition": "And",
        "all_of": [
            "EnvironmentMonitoringInMonitoringTerminal",
            "EnvironmentMonitoringCheck${Id}Text"
        ],
        "next": [
            "${Id}Loop",
            "[JumpBack]EnvironmentMonitoringGoTo${Id}"
        ]
    },
    "${Id}Loop": {
        "desc": "${Name}循环",
        "recognition": "And",
        "all_of": [
            "EnvironmentMonitoringIn${Id}"
        ],
        "next": "${Next}",
        "on_error": [
            "EnvironmentMonitoringRecord${Id}Failure"
        ]
    },
    "EnvironmentMonitoringRecord${Id}Failure": {
        "desc": "记录${Name}路线失败并恢复终端界面",
        "action": "Custom",
        "custom_action": "FailureCollectorRecord",
        "custom_action_param": {
            "key": "EnvironmentMonitoring",
            "item_key": "environmentmonitoring.route_failed"
        },
        "next": [
            "EnvironmentMonitoringRecover${Id}AfterFailure"
        ]
    },
    "EnvironmentMonitoringRecover${Id}AfterFailure": {
        "desc": "路线失败后返回${Name}",
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "${GoToMonitoringTerminal}"
            ]
        },
        "next": [
            "${Id}Loop"
        ]
    }
}
