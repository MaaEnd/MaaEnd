{
    "task": [
        {
            "name": "EnvironmentMonitoring",
            "label": "$task.EnvironmentMonitoring.label",
            "entry": "EnvironmentMonitoringMain",
            "description": "$task.EnvironmentMonitoring.description",
            "option": ["${Station}Monitoring"],
            "controller": [
                "Win32-Front",
                "Wlroots",
                "ADB",
                "PlayCover"
            ],
            "group": ["regional_development"]
        }
    ],
    "option": {
        // ===== 地区总开关 =====
        "${Station}Monitoring": {
            "type": "switch",
            "label": "${StationLabel}",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": "${MissionDisabledOverrides}",
                    "option": ["${Station}MonitoringTasks"]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "${Station}": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        // ===== 环境监测任务多选 =====
        "${Station}MonitoringTasks": {
            "type": "checkbox",
            "label": "${StationLabel}",
            "default_case": "${MissionDefaultCases}",
            "cases": "${MissionCases}"
        }
    }
}
