{
    "SeizeDeliveryJobsEnter${MapName}JobList": {
        "desc": "进入${AreaName}仓储的运送委托列表",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "__SeizeDeliveryJobsIn${MapName}DepotNode",
            "[JumpBack]SceneEnterMenuRegionalDevelopment${MapName}DepotNode"
        ]
    },
    "__SeizeDeliveryJobsIn${MapName}DepotNode": {
        "desc": "已经在${AreaName}仓储管理页面",
        "recognition": "And",
        "all_of": [
            "InLocalDepotNode",
            "DeliveryJobsCheckLocalDepotNode${DepotTextNode}"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 500,
        "next": [
            "__SeizeDeliveryJobsInJobList",
            "__SeizeDeliveryJobsEnterJobList"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "已位于${AreaName}仓储管理"
        }
    },
    "__SeizeDeliveryJobsRecoFilter${MapName}": {
        "desc": "寻找底部当前${AreaName}筛选标志（仅识别）",
        "recognition": "TemplateMatch",
        "roi": [
            20,
            640,
            140,
            40
        ],
        "template": "SeizeDeliveryJobs/DepotNodePage/Filter${MapName}.png",
        "order_by": "Score"
    },
    "__SeizeDeliveryJobsRecoFilterOption${MapName}": {
        "desc": "寻找地区筛选菜单中的${AreaName}选项（仅识别）",
        "recognition": "TemplateMatch",
        "roi": [
            20,
            520,
            140,
            160
        ],
        "template": "SeizeDeliveryJobs/DepotNodePage/Filter${MapName}.png",
        "order_by": "Score",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "SeizeDeliveryJobsJobListIs${MapName}Filter": {
        "desc": "在运送委托列表检查到${AreaName}筛选",
        "recognition": "And",
        "all_of": [
            "__SeizeDeliveryJobsRecoFilter${MapName}"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "SeizeDeliveryJobsLoop"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "当前已是${AreaName}筛选，直接进入抢单"
        }
    },
    "SeizeDeliveryJobsJobListSelect${MapName}FilterPre": {
        "desc": "展开地区筛选以选择${AreaName}",
        "recognition": "And",
        "all_of": [
            "__SeizeDeliveryJobsRecoFilterOther"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "next": [
            "SeizeDeliveryJobsJobListSelect${MapName}Filter"
        ],
        "focus": {
            "Node.Action.Succeeded": "展开地区筛选"
        }
    },
    "SeizeDeliveryJobsJobListSelect${MapName}Filter": {
        "desc": "在筛选列表中选择${AreaName}",
        "recognition": "And",
        "all_of": [
            "__SeizeDeliveryJobsRecoFilterOption${MapName}"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "next": [
            "SeizeDeliveryJobsJobListIs${MapName}Filter"
        ],
        "focus": {
            "Node.Action.Succeeded": "切换到${AreaName}筛选"
        }
    }
}
