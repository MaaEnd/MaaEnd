                    "label": "$option.DiscountValue.cases.Any.label",
                    "pipeline_override": {
                        "AutoStockInStapleItemDiscountsValleyIV": {
                            "recognition": {
                                "type": "ColorMatch",
                                "param": {
                                    "roi": "AutoStockInStapleItemName",
