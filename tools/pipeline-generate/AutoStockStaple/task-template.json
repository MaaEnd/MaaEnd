            "entry": "AutoStockStapleSchedule",
            "description": "$task.AutoStockStaple.description",
            "group": [
                "regional_development"
            ],
            "controller": [
                "ADB",
                "CloudADB",
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "MacOS-Background",
                "MacOS-Front",
                "PlayCover",
                "Win32-Front"
