                        "AutoStockStapleScheduleEnabled": {
                            "attach": {
                                "saturday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoStockStapleScheduleSunday",
                    "label": "$option.TaskScheduleSunday.label",
                    "pipeline_override": {
                        "AutoStockStapleScheduleEnabled": {
                            "attach": {
                                "sunday": true
                            }
                        }
                    }
                }
            ],
            "default_case": [
                "AutoStockStapleScheduleMonday",
                "AutoStockStapleScheduleTuesday",
                "AutoStockStapleScheduleWednesday",
                "AutoStockStapleScheduleThursday",
                "AutoStockStapleScheduleFriday",
                "AutoStockStapleScheduleSaturday",
                "AutoStockStapleScheduleSunday"
