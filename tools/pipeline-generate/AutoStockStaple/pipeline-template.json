{
    "GoodsCountValidate": {
        "AutoStockStapleGoodsCountValidate": {
            "desc": "物品数量验证",
            "recognition": {
                "type": "And",
                "param": {
                    "all_of": [
                        "AutoStockStapleGoodsCountValidateArea",
                        "AutoStockStapleGoodsCountValidateColor",
                        "AutoStockStapleGoodsCountValidateText"
                    ],
                    "box_index": 2
                }
            }
        },
        "AutoStockStapleGoodsCountValidateArea": {
            "desc": "物品数量验证区域",
            "recognition": {
                "type": "ColorMatch",
                "param": {
                    "roi": [
                        1036,
                        189,
                        50,
                        17
                    ],
                    "method": 6,
                    "lower": [
                        90
                    ],
                    "upper": [
                        100
                    ],
                    "connected": true,
                    "count": 10
                }
            }
        },
        "AutoStockStapleGoodsCountValidateText": {
            "desc": "物品数量验证文本",
            "recognition": {
                "type": "OCR",
                "param": {
                    "roi": "AutoStockStapleGoodsCountValidateColor",
                    "roi_offset": [
                        -2,
                        -2,
                        4,
                        4
                    ],
                    "expected": [
                        "\\d+"
                    ],
                    "only_rec": true
                }
            }
        },
        "AutoStockStapleGoodsCountValidateColor": {
            "desc": "物品数量验证颜色",
            "recognition": {
                "type": "ColorMatch",
                "param": {
                    "roi": "AutoStockStapleGoodsCountValidateArea",
                    "method": 6,
                    "lower": [
                        160
                    ],
                    "upper": [
                        255
                    ]
                }
            }
        }
    },
    "QuantityControl": {
        "AutoStockStapleQuantityControl": {
            "desc": "购买商品界面的数量控制",
            "recognition": {
                "type": "OCR",
                "param": {
                    "roi": [
                        55,
                        53,
                        333,
                        167
                    ],
                    "expected": [
                        "购买商品",
                        "購買商品",
                        "(?i)Purchase",
                        "購入"
                    ]
                }
            },
            "pre_delay": 0,
            "post_delay": 0,
            "rate_limit": 0,
            "next": [],
            "focus": {
                "Node.PipelineNode.Failed": "$task.AutoStockStaple.focus.quantity_control.purchase_page_failed"
            }
        },
        "AutoStockStapleGoodsStockBillInsufficientValidate": {
            "desc": "调度券不足的验证",
            "recognition": {
                "type": "ColorMatch",
                "param": {
                    "roi": [
                        200,
                        454,
                        924,
                        133
                    ],
                    "method": 40,
                    "lower": [
                        175,
                        100,
                        100
                    ],
                    "upper": [
                        180,
                        255,
                        255
                    ],
                    "connected": true,
                    "count": 10
                }
            }
        },
        "AutoStockStapleCheckSliding": {
            "desc": "检查滑条是否存在，当购买数量为1时滑条会隐藏",
            "recognition": {
                "type": "ColorMatch",
                "param": {
                    "roi": [
                        543,
                        514,
                        138,
                        24
                    ],
                    "method": 6,
                    "lower": [
                        80
                    ],
                    "upper": [
                        255
                    ],
                    "connected": true,
                    "count": 2000
                }
            },
            "pre_delay": 0,
            "post_delay": 0,
            "rate_limit": 0,
            "next": [
                "AutoStockStapleQuantityControlConfirmBuy"
            ]
        },
        "AutoStockStapleQuantityControlConfirmBuy": {
            "desc": "确认购买",
            "recognition": {
                "type": "And",
                "param": {
                    "all_of": [
                        "AutoStockStapleQuantityControl",
                        "YellowConfirmButtonType1"
                    ],
                    "box_index": 1
                }
            },
            "pre_delay": 0,
            "action": {
                "type": "Click"
            },
            "post_wait_freezes": {
                "time": 100,
                "target": [
                    339,
                    231,
                    602,
                    239
                ]
            },
            "next": [
                "AutoStockStapleQuantityControlCloseRewards"
            ]
        },
        "AutoStockStapleQuantityControlResetRecognitionParams": {
            "desc": "重置识别参数",
            "recognition": {
                "type": "And",
                "param": {
                    "all_of": [
                        "AutoStockStapleQuantityControl"
                    ]
                }
            },
            "pre_delay": 0,
            "action": {
                "type": "Custom",
                "param": {
                    "custom_action": "AttachToExpectedRegexAction",
                    "custom_action_param": {
                        "target": "AutoStockInStapleItemName"
                    }
                }
            },
            "post_delay": 0,
            "rate_limit": 0
        },
        "AutoStockStapleQuantityControlCloseBuyWindow": {
            "desc": "关闭购买窗口",
            "recognition": {
                "type": "And",
                "param": {
                    "all_of": [
                        "CloseButtonType1"
                    ]
                }
            },
            "pre_delay": 0,
            "action": {
                "type": "Click"
            },
            "post_wait_freezes": 200,
            "post_delay": 0,
            "rate_limit": 0
        },
        "AutoStockStapleQuantityControlCloseRewards": {
            "desc": "关闭奖励窗口",
            "recognition": {
                "type": "And",
                "param": {
                    "all_of": [
                        "CloseRewardsButton"
                    ]
                }
            },
            "pre_wait_freezes": {
                "time": 200,
                "target": [
                    339,
                    231,
                    602,
                    239
                ]
            },
            "action": {
                "type": "Click"
            },
            "post_delay": 0
        }
    },
    "item": {
        "AutoStockStapleGoods${NodeId}": {
            "desc": "${Name}",
            "recognition": {
                "type": "OCR",
                "param": {
                    "roi": [
                        418,
                        122,
                        269,
                        147
                    ],
                    "expected": []
                }
            }
        },
        "AutoStockStapleGoods${NodeId}Validate": {
            "desc": "${Name}数量验证",
            "recognition": {
                "type": "Custom",
                "param": {
                    "custom_recognition": "ExpressionRecognition",
                    "custom_recognition_param": {
                        "expression": "20 > {AutoStockStapleGoodsCountValidate}"
                    }
                }
            }
        },
        "AutoStockStapleGoods${NodeId}ExcludeValidate": {
            "desc": "${Name}数量排除验证",
            "recognition": {
                "type": "Custom",
                "param": {
                    "custom_recognition": "ExpressionRecognition",
                    "custom_recognition_param": {
                        "expression": "20 <= {AutoStockStapleGoodsCountValidate}"
                    }
                }
            }
        },
        "AutoStockStapleQuantityControl${NodeId}": {
            "desc": "${Name}的数量控制",
            "recognition": {
                "type": "And",
                "param": {
                    "all_of": [
                        "AutoStockStapleGoods${NodeId}"
                    ]
                }
            },
            "pre_delay": 0,
            "post_delay": 0,
            "rate_limit": 0,
            "next": [
                "AutoStockStapleQuantityControl${NodeId}StockBillInsufficient",
                "AutoStockStapleQuantityControl${NodeId}Buy",
                "AutoStockStapleQuantityControl${NodeId}Exclude"
            ]
        },
        "AutoStockStapleQuantityControl${NodeId}RemoveFilter": {
            "desc": "${Name}移除筛选",
            "max_hit": 1,
            "pre_delay": 0,
            "action": {
                "type": "Custom",
                "param": {
                    "custom_action": "PipelineOverrideAction",
                    "custom_action_param": {
                        "patch": {
                            "AutoStockInStapleItemName": {
                                "attach": {
                                    "${ItemId}": false
                                }
                            }
                        }
                    }
                }
            },
            "post_delay": 0,
            "rate_limit": 0,
            "next": [
                "AutoStockStapleQuantityControlResetRecognitionParams"
            ]
        },
        "AutoStockStapleQuantityControl${NodeId}Buy": {
            "desc": "${Name}低于阈值时购买指定数量",
            "recognition": {
                "type": "And",
                "param": {
                    "all_of": [
                        "AutoStockStapleGoods${NodeId}",
                        "AutoStockStapleGoods${NodeId}Validate"
                    ]
                }
            },
            "pre_delay": 0,
            "action": {
                "type": "Custom",
                "param": {
                    "custom_action": "AutoStockStapleQuantityControlAction",
                    "custom_action_param": {
                        "item_name": "${ItemId}",
                        "validator_node": "AutoStockStapleGoods${NodeId}Validate"
                    }
                }
            },
            "post_delay": 0,
            "rate_limit": 0,
            "next": [
                "AutoStockStapleCheckSliding",
                "AutoStockStapleBetterSliding"
            ],
            "focus": {
                "Node.Action.Starting": "$task.AutoStockStaple.focus.quantity_control.buy.${ItemId}"
            }
        },
        "AutoStockStapleQuantityControl${NodeId}Exclude": {
            "desc": "${Name}达到阈值后退出",
            "recognition": {
                "type": "And",
                "param": {
                    "all_of": [
                        "AutoStockStapleGoods${NodeId}",
                        "AutoStockStapleGoods${NodeId}ExcludeValidate"
                    ]
                }
            },
            "pre_delay": 0,
            "post_delay": 0,
            "rate_limit": 0,
            "next": [
                "[JumpBack]AutoStockStapleQuantityControl${NodeId}RemoveFilter",
                "AutoStockStapleQuantityControlCloseBuyWindow"
            ],
            "focus": {
                "Node.Action.Starting": "$task.AutoStockStaple.focus.quantity_control.reached.${ItemId}"
            }
        },
        "AutoStockStapleQuantityControl${NodeId}StockBillInsufficient": {
            "desc": "${Name}调度券不足时退出",
            "recognition": {
                "type": "And",
                "param": {
                    "all_of": [
                        "AutoStockStapleGoods${NodeId}",
                        "AutoStockStapleGoodsStockBillInsufficientValidate"
                    ]
                }
            },
            "pre_delay": 0,
            "post_delay": 0,
            "rate_limit": 0,
            "next": [
                "[JumpBack]AutoStockStapleQuantityControl${NodeId}RemoveFilter",
                "AutoStockStapleQuantityControlCloseBuyWindow"
            ],
            "focus": {
                "Node.Action.Starting": "$task.AutoStockStaple.focus.quantity_control.stock_bill_insufficient.${ItemId}"
            }
        }
    }
}
