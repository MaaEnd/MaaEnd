{
    "task": [
        {
            "name": "SellProduct",
            "label": "$task.SellProduct.label",
            "entry": "SellProductMain",
            "description": "$task.SellProduct.description",
            "option": [
                "SellProductGlobalItemPriority",
                "SellProductItemReserveRules",
                "SellProductForceRefreshOperatorCache",
                "${RegionPrefix}Sell"
            ],
            "controller": [
                "Win32-Front",
                "ADB",
                "PlayCover",
                "Wlroots"
            ],
            "group": [
                "regional_development"
            ]
        }
    ],
    "option": {
        "SellProductGlobalItemPriority": {
            "type": "switch",
            "label": "$task.SellProduct.GlobalPrioritySwitch",
            "description": "$task.SellProduct.GlobalPrioritySwitchDescription",
            "default_case": "No",
            "cases": "${GlobalItemPrioritySwitchCases}"
        },
        // 四个全局优先级由总开关作为同级子选项一次性展开。
        "SellProductPriorityItem1": {
            "type": "select",
            "label": "$task.SellProduct.GlobalPriorityItem1",
            "description": "$task.SellProduct.GlobalPriorityDescription",
            "default_case": "Auto",
            "cases": "${GlobalItemPriorityCases1}"
        },
        "SellProductPriorityItem2": {
            "type": "select",
            "label": "$task.SellProduct.GlobalPriorityItem2",
            "default_case": "Auto",
            "cases": "${GlobalItemPriorityCases2}"
        },
        "SellProductPriorityItem3": {
            "type": "select",
            "label": "$task.SellProduct.GlobalPriorityItem3",
            "default_case": "None",
            "cases": "${GlobalItemPriorityCases3}"
        },
        "SellProductPriorityItem4": {
            "type": "select",
            "label": "$task.SellProduct.GlobalPriorityItem4",
            "default_case": "None",
            "cases": "${GlobalItemPriorityCases4}"
        },
        "SellProductItemReserveRules": {
            "type": "switch",
            "label": "$task.SellProduct.ReserveSwitch",
            "description": "$task.SellProduct.ReserveSwitchDescription",
            "default_case": "No",
            "cases": "${ReserveRuleSwitchCases}"
        },
        // 保留规则与售卖优先级完全独立；选中具体货品后才展开对应数量输入。
        "SellProductReserveItem1": {
            "type": "select",
            "label": "$task.SellProduct.ReserveItem1",
            "description": "$task.SellProduct.ReserveDescription",
            "default_case": "None",
            "cases": "${ReserveItemCases1}"
        },
        "SellProductReserveItem1Value": {
            "type": "input",
            "label": "$task.SellProduct.ReserveQuantityInput",
            "inputs": [
                {
                    "name": "SellProductReserveItem1Value",
                    "label": "$task.SellProduct.ReserveQuantity",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "default": "100",
                    "pattern_msg": "$task.SellProduct.ReserveQuantityPattern"
                }
            ]
        },
        "SellProductReserveItem2": {
            "type": "select",
            "label": "$task.SellProduct.ReserveItem2",
            "default_case": "None",
            "cases": "${ReserveItemCases2}"
        },
        "SellProductReserveItem2Value": {
            "type": "input",
            "label": "$task.SellProduct.ReserveQuantityInput",
            "inputs": [
                {
                    "name": "SellProductReserveItem2Value",
                    "label": "$task.SellProduct.ReserveQuantity",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "default": "100",
                    "pattern_msg": "$task.SellProduct.ReserveQuantityPattern"
                }
            ]
        },
        "SellProductReserveItem3": {
            "type": "select",
            "label": "$task.SellProduct.ReserveItem3",
            "default_case": "None",
            "cases": "${ReserveItemCases3}"
        },
        "SellProductReserveItem3Value": {
            "type": "input",
            "label": "$task.SellProduct.ReserveQuantityInput",
            "inputs": [
                {
                    "name": "SellProductReserveItem3Value",
                    "label": "$task.SellProduct.ReserveQuantity",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "default": "100",
                    "pattern_msg": "$task.SellProduct.ReserveQuantityPattern"
                }
            ]
        },
        "SellProductReserveItem4": {
            "type": "select",
            "label": "$task.SellProduct.ReserveItem4",
            "default_case": "None",
            "cases": "${ReserveItemCases4}"
        },
        "SellProductReserveItem4Value": {
            "type": "input",
            "label": "$task.SellProduct.ReserveQuantityInput",
            "inputs": [
                {
                    "name": "SellProductReserveItem4Value",
                    "label": "$task.SellProduct.ReserveQuantity",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "default": "100",
                    "pattern_msg": "$task.SellProduct.ReserveQuantityPattern"
                }
            ]
        },
        "SellProductForceRefreshOperatorCache": {
            "type": "switch",
            "label": "$task.SellProduct.ForceRefreshOperatorCache",
            "description": "$task.SellProduct.ForceRefreshOperatorCacheDescription",
            "default_case": "No",
            "cases": "${OperatorRefreshModeCases}"
        },
        "${RegionPrefix}Sell": {
            "type": "switch",
            "label": "$global.region.${RegionPrefix}",
            "description": "$task.SellProduct.regionToggleDescription",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "SellProduct${RegionPrefix}": {
                            "enabled": true
                        }
                    },
                    "option": "${SellOptions}"
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "SellProduct${RegionPrefix}": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "${RegionPrefix}${LocationId}": {
            "type": "switch",
            "label": "$task.SellProduct.${RegionPrefix}${LocationId}",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "SellProduct${LocationId}": {
                            "enabled": true
                        },
                        "SellProductRegisterAuto${LocationId}": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "SellProduct${LocationId}": {
                            "enabled": false
                        },
                        "SellProductRegisterAuto${LocationId}": {
                            "enabled": false
                        }
                    }
                }
            ]
        }
    }
}
