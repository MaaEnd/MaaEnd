{
    // ===== 售卖点顶层节点 =====
    "OutpostTrading${LocationId}": {
        "desc": "${LocationDesc}售卖",
        "max_hit": 1,
        "recognition": "And",
        "all_of": [
            "OutpostTradingCheck${LocationId}TabText"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}Sell",
            "[JumpBack]OutpostTradingGoTo${LocationId}"
        ]
    },
    // ===== 售卖锚点节点 =====
    "OutpostTrading${LocationId}Sell": {
        "desc": "${LocationDesc}售卖",
        "recognition": "And",
        "all_of": [
            "OutpostTradingIn${LocationId}"
        ],
        "pre_delay": 0,
        "anchor": {
            "OutpostTradingZeroMoneyHandler": "OutpostTradingZeroMoneyWithTip",
            "OutpostTradingCurrentGoodsReady": "OutpostTrading${LocationId}CurrentGoodsReady",
            "OutpostTradingSelectPriorityItem": "OutpostTrading${LocationId}SelectPriorityItem",
            "OutpostTradingPriorityItemsExhausted": "OutpostTrading${LocationId}PriorityItemsExhausted",
            "OutpostTradingCommitPriorityItem": "OutpostTrading${LocationId}CommitPriorityItem",
            "OutpostTradingMarkOutOfStock": "OutpostTrading${LocationId}MarkOutOfStock",
            "OutpostTradingBetterSliding": "OutpostTrading${LocationId}ApplyReserve"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}OutpostProsperityAvailable",
            "OutpostTrading${LocationId}OutpostProsperityMax"
        ]
    },
    "OutpostTrading${LocationId}OutpostProsperityAvailable": {
        "desc": "${LocationDesc}据点发展值未达上限",
        "recognition": "And",
        "all_of": [
            "OutpostTradingIn${LocationId}",
            "OutpostTradingOutpostProsperityAvailable"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "OutpostTradingOperatorSession",
        "custom_action_param": {
            "operation": "enter_location",
            "location": "${LocationId}",
            "outpost_prosperity_max": false
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}ReportLocationPlan"
        ]
    },
    "OutpostTrading${LocationId}OutpostProsperityMax": {
        "desc": "${LocationDesc}据点发展值已达上限",
        "recognition": "And",
        "all_of": [
            "OutpostTradingIn${LocationId}"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "OutpostTradingOperatorSession",
        "custom_action_param": {
            "operation": "enter_location",
            "location": "${LocationId}",
            "outpost_prosperity_max": true
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}ReportLocationPlan"
        ]
    },
    "OutpostTrading${LocationId}ReportLocationPlan": {
        "desc": "${LocationDesc}输出完整售卖计划",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "OutpostTradingLocationPlan",
        "custom_action_param": {
            "location": "${LocationId}"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}SetOperatorAnchors"
        ]
    },
    "OutpostTrading${LocationId}SetOperatorAnchors": {
        "desc": "${LocationDesc}设置联络干员流程锚点",
        "pre_delay": 0,
        "anchor": {
            "OutpostTradingBeforeSellOperatorTarget": "OutpostTrading${LocationId}BeforeSellOperator",
            "OutpostTradingAfterSellOperatorTarget": "OutpostTrading${LocationId}AfterSellOperator"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTradingSellMain"
        ]
    },
    // ===== 售卖前联络干员切换 =====
    "OutpostTrading${LocationId}BeforeSellOperator": {
        "desc": "${LocationDesc}售卖前检查并切换联络干员",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}CurrentOperatorUncached",
            "OutpostTrading${LocationId}CurrentTargetOperator",
            "OutpostTrading${LocationId}OpenTargetOperatorList"
        ]
    },
    "OutpostTrading${LocationId}CurrentOperatorUncached": {
        "desc": "${LocationDesc}当前联络干员未缓存，重新扫描干员列表",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "OutpostTradingCurrentOperatorUncached",
                "custom_recognition_param": {
                    "mode": "cache",
                    "usage": "all",
                    "location": "${LocationId}",
                    "roi": "${CurrentOperatorROI}"
                }
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SubTask",
                "custom_action_param": {
                    "sub": [
                        "OutpostTradingScanOperatorList"
                    ]
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}BeforeSellOperator"
        ]
    },
    "OutpostTrading${LocationId}CurrentTargetOperator": {
        "desc": "${LocationDesc}当前联络干员已是售卖用干员",
        "recognition": "Custom",
        "custom_recognition": "OutpostTradingCurrentBestOperator",
        "custom_recognition_param": {
            "mode": "cache",
            "usage": "target",
            "location": "${LocationId}",
            "roi": "${CurrentOperatorROI}"
        },
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "OutpostTradingOperatorSession",
        "custom_action_param": {
            "operation": "complete_target",
            "location": "${LocationId}",
            "changed": false
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTradingSellLoop"
        ]
    },
    "OutpostTrading${LocationId}OpenTargetOperatorList": {
        "desc": "${LocationDesc}打开联络干员列表以切换售卖用干员",
        "recognition": "And",
        "all_of": [
            "OutpostTradingOpenOperatorLiaisonButton",
            "OutpostTradingIn${LocationId}"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}InTargetOperatorList"
        ]
    },
    "OutpostTrading${LocationId}InTargetOperatorList": {
        "desc": "${LocationDesc}已打开联络干员列表，选择售卖用干员",
        "recognition": "And",
        "all_of": [
            "OutpostTradingInOperatorLiaison"
        ],
        "pre_wait_freezes": {
            "time": 100,
            "target": [
                170,
                120,
                690,
                425
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}SelectTargetOperator",
            "OutpostTrading${LocationId}RetryTargetOperatorAfterScan",
            "OutpostTrading${LocationId}TargetOperatorNotFound",
            "OutpostTrading${LocationId}TargetOperatorScanFailed",
            "OutpostTrading${LocationId}SwipeTargetOperatorList"
        ]
    },
    "OutpostTrading${LocationId}SelectTargetOperator": {
        "desc": "${LocationDesc}在联络干员列表中选择售卖用干员",
        "recognition": "Custom",
        "custom_recognition": "OutpostTradingSelectBestOperator",
        "custom_recognition_param": {
            "mode": "cache",
            "usage": "target",
            "location": "${LocationId}",
            "roi": [
                164,
                121,
                700,
                430
            ]
        },
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}ConfirmTargetOperator"
        ]
    },
    "OutpostTrading${LocationId}ConfirmTargetOperator": {
        "desc": "${LocationDesc}点击派驻确认售卖用干员",
        "recognition": "And",
        "all_of": [
            "OutpostTradingCheckAssignText",
            "WhiteConfirmButtonType1"
        ],
        "box_index": 1,
        "pre_delay": 0,
        "action": "Click",
        "post_wait_freezes": {
            "time": 150,
            "target": [
                190,
                160,
                360,
                150
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}TargetOperatorManagedConflict",
            "OutpostTrading${LocationId}TargetOperatorProtectedConflict",
            "OutpostTrading${LocationId}CloseTargetOperatorLiaison"
        ]
    },
    "OutpostTrading${LocationId}TargetOperatorManagedConflict": {
        "desc": "${LocationDesc}售卖用干员来自本次启用据点，确认调至当前据点",
        "recognition": "And",
        "all_of": [
            "OutpostTradingOperatorAlreadyAssignedPrompt",
            {
                "recognition": "Custom",
                "custom_recognition": "OutpostTradingOperatorConflict",
                "custom_recognition_param": {
                    "result": "managed",
                    "usage": "target",
                    "location": "${LocationId}"
                },
                "roi": [
                    240,
                    260,
                    800,
                    90
                ]
            },
            "YellowConfirmButtonType1"
        ],
        "box_index": 2,
        "pre_delay": 0,
        "action": "Click",
        "post_wait_freezes": {
            "time": 150,
            "target": [
                190,
                160,
                360,
                150
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}CloseTargetOperatorLiaison"
        ]
    },
    "OutpostTrading${LocationId}TargetOperatorProtectedConflict": {
        "desc": "${LocationDesc}售卖用干员来自未启用据点，临时排除并重新规划",
        "recognition": "And",
        "all_of": [
            "OutpostTradingOperatorAlreadyAssignedPrompt",
            {
                "recognition": "Custom",
                "custom_recognition": "OutpostTradingOperatorConflict",
                "custom_recognition_param": {
                    "result": "protected",
                    "usage": "target",
                    "location": "${LocationId}"
                },
                "roi": [
                    240,
                    260,
                    800,
                    90
                ]
            },
            "CancelButton"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "OutpostTradingOperatorSession",
        "custom_action_param": {
            "operation": "exclude_selected",
            "usage": "target",
            "location": "${LocationId}"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}CancelTargetOperatorAlreadyAssigned"
        ]
    },
    "OutpostTrading${LocationId}CancelTargetOperatorAlreadyAssigned": {
        "desc": "${LocationDesc}取消抢占其他据点的售卖用干员",
        "recognition": "And",
        "all_of": [
            "OutpostTradingOperatorAlreadyAssignedPrompt",
            "CancelButton"
        ],
        "box_index": 1,
        "pre_delay": 0,
        "action": "Click",
        "post_wait_freezes": {
            "time": 80,
            "target": [
                0,
                0,
                0,
                0
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}CloseTargetOperatorLiaisonAfterAlreadyAssigned"
        ]
    },
    "OutpostTrading${LocationId}CloseTargetOperatorLiaisonAfterAlreadyAssigned": {
        "desc": "${LocationDesc}关闭联络干员列表并从顶部重新选择售卖用干员",
        "recognition": "And",
        "all_of": [
            "OutpostTradingInOperatorLiaison",
            "CloseButtonType1"
        ],
        "box_index": 1,
        "pre_delay": 0,
        "action": "Click",
        "post_wait_freezes": {
            "time": 150,
            "target": [
                45,
                55,
                1180,
                620
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}BeforeSellOperator"
        ]
    },
    "OutpostTrading${LocationId}CloseTargetOperatorLiaison": {
        "desc": "${LocationDesc}关闭售卖用联络干员列表",
        "recognition": "And",
        "all_of": [
            "OutpostTradingInOperatorLiaison",
            "OutpostTradingCheckWithdrawText",
            "CloseButtonType1"
        ],
        "box_index": 2,
        "pre_delay": 0,
        "action": "Click",
        "post_wait_freezes": {
            "time": 150,
            "target": [
                45,
                55,
                1180,
                620
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}TargetOperatorDone"
        ]
    },
    "OutpostTrading${LocationId}TargetOperatorDone": {
        "desc": "${LocationDesc}售卖用干员派驻完成，回到售卖循环",
        "recognition": "And",
        "all_of": [
            "OutpostTradingIn${LocationId}"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "OutpostTradingOperatorSession",
        "custom_action_param": {
            "operation": "complete_target",
            "location": "${LocationId}",
            "changed": true
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTradingSellLoop"
        ]
    },
    "OutpostTrading${LocationId}SwipeTargetOperatorList": {
        "desc": "${LocationDesc}在联络干员列表中向下滑动查找售卖用干员",
        "recognition": "And",
        "all_of": [
            "OutpostTradingInOperatorLiaison"
        ],
        "pre_delay": 0,
        "action": "Swipe",
        "begin": [
            620,
            520
        ],
        "end": [
            [
                620,
                285
            ],
            [
                760,
                285
            ]
        ],
        "end_hold": 200,
        "post_wait_freezes": {
            "time": 150,
            "target": [
                170,
                120,
                690,
                425
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}InTargetOperatorList"
        ]
    },
    "OutpostTrading${LocationId}RetryTargetOperatorAfterScan": {
        "desc": "${LocationDesc}完整扫描后存在新的售卖用干员方案",
        "recognition": "Custom",
        "custom_recognition": "OutpostTradingOperatorListBottom",
        "custom_recognition_param": {
            "mode": "cache",
            "usage": "target",
            "location": "${LocationId}",
            "result": "retry",
            "roi": [
                164,
                121,
                700,
                430
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}CloseTargetOperatorLiaisonAfterScan"
        ]
    },
    "OutpostTrading${LocationId}CloseTargetOperatorLiaisonAfterScan": {
        "desc": "${LocationDesc}刷新缓存后关闭售卖用干员列表",
        "recognition": "And",
        "all_of": [
            "OutpostTradingInOperatorLiaison",
            "CloseButtonType1"
        ],
        "box_index": 1,
        "pre_delay": 0,
        "action": "Click",
        "post_wait_freezes": {
            "time": 150,
            "target": [
                45,
                55,
                1180,
                620
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}OpenTargetOperatorList"
        ]
    },
    "OutpostTrading${LocationId}TargetOperatorScanFailed": {
        "desc": "${LocationDesc}售卖用干员列表扫描失败",
        "recognition": "Custom",
        "custom_recognition": "OutpostTradingOperatorScanOutcome",
        "custom_recognition_param": {
            "mode": "cache",
            "usage": "target",
            "location": "${LocationId}",
            "result": "error",
            "roi": [
                164,
                121,
                700,
                430
            ]
        },
        "pre_delay": 0,
        "action": "StopTask",
        "post_delay": 0,
        "rate_limit": 0
    },
    "OutpostTrading${LocationId}TargetOperatorNotFound": {
        "desc": "${LocationDesc}联络干员列表已到底，未找到配置的售卖用干员",
        "recognition": "Custom",
        "custom_recognition": "OutpostTradingOperatorScanOutcome",
        "custom_recognition_param": {
            "mode": "cache",
            "usage": "target",
            "location": "${LocationId}",
            "result": "not_found",
            "roi": [
                164,
                121,
                700,
                430
            ]
        },
        "pre_delay": 0,
        "action": "StopTask",
        "post_delay": 0,
        "rate_limit": 0
    },
    // ===== 售卖后联络干员恢复 =====
    "OutpostTrading${LocationId}AfterSellOperator": {
        "desc": "${LocationDesc}售卖后恢复联络干员",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}CurrentRestoreOperator",
            "OutpostTrading${LocationId}OpenRestoreOperatorList"
        ]
    },
    "OutpostTrading${LocationId}CurrentRestoreOperator": {
        "desc": "${LocationDesc}当前联络干员已是恢复目标",
        "recognition": "Custom",
        "custom_recognition": "OutpostTradingCurrentBestOperator",
        "custom_recognition_param": {
            "mode": "cache",
            "usage": "restore",
            "location": "${LocationId}",
            "roi": "${CurrentOperatorROI}"
        },
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "OutpostTradingOperatorSession",
        "custom_action_param": {
            "operation": "complete_restore",
            "location": "${LocationId}",
            "changed": false
        },
        "post_delay": 0,
        "rate_limit": 0
    },
    "OutpostTrading${LocationId}OpenRestoreOperatorList": {
        "desc": "${LocationDesc}打开联络干员列表以恢复干员",
        "recognition": "And",
        "all_of": [
            "OutpostTradingOpenOperatorLiaisonButton",
            "OutpostTradingIn${LocationId}"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}InRestoreOperatorList"
        ]
    },
    "OutpostTrading${LocationId}InRestoreOperatorList": {
        "desc": "${LocationDesc}已打开联络干员列表，选择恢复干员",
        "recognition": "And",
        "all_of": [
            "OutpostTradingInOperatorLiaison"
        ],
        "pre_wait_freezes": {
            "time": 100,
            "target": [
                170,
                120,
                690,
                425
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}SelectRestoreOperator",
            "OutpostTrading${LocationId}RetryRestoreOperatorAfterScan",
            "OutpostTrading${LocationId}RestoreOperatorNotFoundAtBottom",
            "OutpostTrading${LocationId}RestoreOperatorScanFailed",
            "OutpostTrading${LocationId}SwipeRestoreOperatorList"
        ]
    },
    "OutpostTrading${LocationId}RestoreOperatorNotFoundAtBottom": {
        "desc": "${LocationDesc}联络干员列表已到底，未找到可用的恢复干员",
        "recognition": "Custom",
        "custom_recognition": "OutpostTradingOperatorScanOutcome",
        "custom_recognition_param": {
            "mode": "cache",
            "usage": "restore",
            "location": "${LocationId}",
            "result": "not_found",
            "roi": [
                164,
                121,
                700,
                430
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}CloseRestoreOperatorLiaisonAfterNotFound"
        ]
    },
    "OutpostTrading${LocationId}SelectRestoreOperator": {
        "desc": "${LocationDesc}在联络干员列表中选择恢复干员",
        "recognition": "Custom",
        "custom_recognition": "OutpostTradingSelectBestOperator",
        "custom_recognition_param": {
            "mode": "cache",
            "usage": "restore",
            "location": "${LocationId}",
            "roi": [
                164,
                121,
                700,
                430
            ]
        },
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}ConfirmRestoreOperator"
        ]
    },
    "OutpostTrading${LocationId}ConfirmRestoreOperator": {
        "desc": "${LocationDesc}点击派驻确认恢复干员",
        "recognition": "And",
        "all_of": [
            "OutpostTradingCheckAssignText",
            "WhiteConfirmButtonType1"
        ],
        "box_index": 1,
        "pre_delay": 0,
        "action": "Click",
        "post_wait_freezes": {
            "time": 150,
            "target": [
                190,
                160,
                360,
                150
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}RestoreOperatorManagedConflict",
            "OutpostTrading${LocationId}RestoreOperatorProtectedConflict",
            "OutpostTrading${LocationId}CloseRestoreOperatorLiaison"
        ]
    },
    "OutpostTrading${LocationId}RestoreOperatorManagedConflict": {
        "desc": "${LocationDesc}恢复干员来自本次启用据点，确认调至当前据点",
        "recognition": "And",
        "all_of": [
            "OutpostTradingOperatorAlreadyAssignedPrompt",
            {
                "recognition": "Custom",
                "custom_recognition": "OutpostTradingOperatorConflict",
                "custom_recognition_param": {
                    "result": "managed",
                    "usage": "restore",
                    "location": "${LocationId}"
                },
                "roi": [
                    240,
                    260,
                    800,
                    90
                ]
            },
            "YellowConfirmButtonType1"
        ],
        "box_index": 2,
        "pre_delay": 0,
        "action": "Click",
        "post_wait_freezes": {
            "time": 150,
            "target": [
                190,
                160,
                360,
                150
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}CloseRestoreOperatorLiaison"
        ]
    },
    "OutpostTrading${LocationId}RestoreOperatorProtectedConflict": {
        "desc": "${LocationDesc}恢复干员来自未启用据点，临时排除并重新规划",
        "recognition": "And",
        "all_of": [
            "OutpostTradingOperatorAlreadyAssignedPrompt",
            {
                "recognition": "Custom",
                "custom_recognition": "OutpostTradingOperatorConflict",
                "custom_recognition_param": {
                    "result": "protected",
                    "usage": "restore",
                    "location": "${LocationId}"
                },
                "roi": [
                    240,
                    260,
                    800,
                    90
                ]
            },
            "CancelButton"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "OutpostTradingOperatorSession",
        "custom_action_param": {
            "operation": "exclude_selected",
            "usage": "restore",
            "location": "${LocationId}"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "OutpostTrading${LocationId}CancelRestoreOperatorAlreadyAssigned"
