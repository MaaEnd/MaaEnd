{
    "OutpostTrading${LocationId}CurrentGoodsReady": {
        "custom_recognition_param": {
            "location": "${LocationId}",
            "roi": "${CurrentGoodsROIAdb}"
        }
    },
    "OutpostTrading${LocationId}SelectPriorityItem": {
        "custom_recognition_param": {
            "location": "${LocationId}",
            "result": "select",
            "stock_name_offset": [
                46,
                -67,
                208,
                10
            ],
            "stock_quantity_offset": [
                40,
                -6,
                103,
                7
            ],
            "stock_click_offset": [
                42,
                -58,
                130,
                34
            ]
        }
    },
    "OutpostTrading${LocationId}BetterSliding": {
        "custom_action_param": {
            "TargetQuantity": 999999,
            "ClampTargetToSliderMax": true,
            "FineTuneQuantity": 100,
            "FineTuneFallback": "less",
            "AvailableQuantity": {
                "roi": "${AvailableQuantityBoxAdb}",
                "only_rec": true
            },
            "SliderQuantity": {
                "roi": "${SliderQuantityBoxAdb}",
                "only_rec": true
            },
            "Direction": "right",
            "DecreaseButton": {
                "template": "OutpostTrading/DecreaseButton.png"
            },
            "IncreaseButton": {
                "template": "OutpostTrading/IncreaseButton.png"
            },
            "OutOfRangeOverrideEnable": "OutpostTradingReserveAlreadySatisfied",
            "TargetReachableOverrideEnable": "OutpostTradingReserveQuantityReached"
        }
    }
}
