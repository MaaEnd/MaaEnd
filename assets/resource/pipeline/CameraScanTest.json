{
    "CameraScanTestMain": {
        "next": [
            "CameraScanTestScan"
        ]
    },
    // 镜头扫描测试：移动镜头，命中拍照目标（快门可点 + 目标达成）就停，但不会按快门。
    // 想跑完整条路径、不看命中，把 wait_nodes 换回 CameraScanTestNeverHit。
    "CameraScanTestScan": {
        "desc": "镜头扫描测试：移动镜头找拍照目标，不点拍照",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "CameraScanAction",
        "custom_action_param": {
            "wait_nodes": [
                "__TakePhotoShutter"
            ]
        },
        "post_delay": 0,
        "rate_limit": 0
    },
    // 恒定不命中的占位识别：让扫描走完整条路径，方便逐格看镜头走位。
    // 1 × 1 的 ROI 凑不满 1000000 个像素，所以永远不会命中。
    "CameraScanTestNeverHit": {
        "desc": "镜头扫描测试用：恒定不命中的识别节点",
        "recognition": "ColorMatch",
        "roi": [
            0,
            0,
            1,
            1
        ],
        "lower": [
            0,
            0,
            0
        ],
        "upper": [
            255,
            255,
            255
        ],
        "count": 1000000
    }
}
