{
    "AutoDeliveryRecognizeDestination": {
        "desc": "从当前送货任务详情识别送货目标；同区重复资源回收站转入大地图判定，其余目标直接注入寻路参数",
        "recognition": "And",
        "all_of": [
            "AutoDeliveryInDeliveryMissionDetail",
            "AutoDeliveryCheckAreaText",
            "AutoDeliveryCheckDestinationField"
        ],
        "box_index": 2,
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                455,
                180,
                790,
                43
            ]
        },
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "AutoDeliveryResolveDestinationAction",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[Anchor]AutoDeliveryAfterRecognizeDestination",
            "AutoDeliveryAfterResolveDestination"
        ]
    },
    "AutoDeliveryAfterResolveDestination": {
        "desc": "[运行时覆盖] 根据 AutoDeliveryRecognizeDestination 的解析结果，进入普通送货或资源回收站地图判定流程",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        // next 运行时由 AutoDeliveryResolveDestinationAction 覆写，每次解析终点都会显式重写：
        // ・普通终点（含滑索/步行由终点配置与任务选项决定）→ 下面的默认流程；
        // ・同区重复的资源回收站 → [AutoDeliveryViewRecycleBin{区域}Map, AutoDeliveryStartTrackingRecycleBin{区域}]，先转大地图确认。
        // 这里保留默认值只是给「没被覆写就执行」兜底，实际判定以动作写回的那份为准。
        "next": [
            "AutoDeliveryReturnWorldAndNavigateDestination"
        ]
    },
    "AutoDeliveryCheckCancelCurrentJobTrackingButton": {
        "desc": "识别当前送货任务详情中的取消追踪按钮",
        "recognition": "TemplateMatch",
        "roi": [
            1100,
            560,
            170,
            150
        ],
        "template": [
            "Common/Button/CancelButtonType2.png",
            "Common/Button/CancelButtonType2Hover.png"
        ],
        "order_by": "Score"
    },
    "AutoDeliveryCheckSkipChatButton": {
        "recognition": "TemplateMatch",
        "roi": [
            1190,
            10,
            90,
            90
        ],
        "template": "MapNavigator/ObstacleDevice/SkipChatButton.png",
        "green_mask": true,
        "threshold": 0.6,
        "order_by": "Score"
    },
    "AutoDeliveryCheckSubmitGoodsButton": {
        "desc": "在送货目标附近识别交货图标",
        "recognition": "TemplateMatch",
        "roi": [
            760,
            350,
            200,
            270
        ],
        "template": [
            "AutoDelivery/SubmitGoods.png", // NPC 交货图标
            "AutoDelivery/SubmitGoods2.png" // 非 NPC 交货图标
        ],
        "threshold": 0.9,
        "order_by": "Score"
    },
    "AutoDeliverySubmitGoodsInteractScan": {
        "desc": "走向送货目标时边走边认的交货图标预筛，只给寻路读取 roi/template",
        "recognition": "TemplateMatch",
        "roi": [
            760,
            350,
            200,
            270
        ],
        "template": [
            "AutoDelivery/SubmitGoods.png", // NPC 交货图标
            "AutoDelivery/SubmitGoods2.png" // 非 NPC 交货图标
        ],
        "threshold": 0.8
    },
    "AutoDeliverySubmitGoodsInteractText": {
        "desc": "资源回收站交互提示中的交货选项文字，只给寻路读取 expected",
        "recognition": "OCR",
        "roi": [
            760,
            350,
            200,
            270
        ],
        "expected": [
            "交货",
            "交貨",
            "(?i)Deliver",
            "引き渡す",
            "화물 제출"
        ]
    },
    "AutoDeliveryCheckSubmitGoodsName": {
        "desc": "[运行时覆盖] 识别送货目标交互提示中的文本",
        "recognition": "OCR",
        "roi": [
            763,
            349,
            195,
            270
        ],
        // 本节点静态不写 expected：AutoDeliveryResolveDestinationAction 解析出终点后，
        // 按当前终点的名称（各语言名称经 regexp 转义成正则字面量）注入 expected 做提示文本复核，
        // 每次解析都重写，避免上一个终点的名称残留。
        // 终点未开启名称复核时既不注入 expected，也不会被加进 AutoDeliveryCheckSubmitGoodsTarget 的 all_of，
        // 也就是本节点根本不参与判定。
        "only_rec": false,
        "order_by": "Horizontal"
    },
    "AutoDeliveryCheckSubmitGoodsTarget": {
        "desc": "[运行时覆盖] 确认已站在送货目标前：交货图标命中，需要名称复核时交互提示中的名称也要命中",
        "recognition": "And",
        // all_of 运行时由 AutoDeliveryResolveDestinationAction 整体重写：
        // 恒含 AutoDeliveryCheckSubmitGoodsButton，终点开启名称复核时追加 AutoDeliveryCheckSubmitGoodsName。
        // 静态这份就是「不做名称复核」的形态。
        "all_of": [
            "AutoDeliveryCheckSubmitGoodsButton"
        ],
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                763,
                349,
                195,
                270
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDeliverySubmitGoods"
        ]
    },
    "AutoDeliveryCloseRewardDialog": {
        "desc": "提交货物后由 IMS A3 累加培养道具",
        "recognition": "And",
        "all_of": [
            "CloseRewardsButton"
        ],
        "box_index": 0,
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                528,
                299,
                222,
                131
            ],
            "threshold": 0.97,
            "timeout": 1500
        },
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "AddItemData",
        "custom_action_param": {},
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDeliveryCloseRewardDialogClick"
        ],
        "focus": {
            "Node.Action.Starting": "$task.AutoDelivery.focus.delivery_completed"
        }
    },
    "AutoDeliveryCloseRewardDialogClick": {
        "desc": "关闭送货奖励界面",
        "recognition": "And",
        "all_of": [
            "CloseRewardsButton"
        ],
        "box_index": 0,
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[Anchor]AutoDeliveryAfterSubmitGoods",
            "AutoDeliveryEnd"
        ]
    },
    "AutoDeliveryInChatDialog": {
        "recognition": "TemplateMatch",
        "roi": [
            20,
            20,
            90,
            90
        ],
        "template": "MapNavigator/ObstacleDevice/ChatDialog.png",
        "green_mask": true,
        "threshold": 0.6,
        "order_by": "Score"
    },
    "AutoDeliveryNavigateDestination": {
        "desc": "[运行时覆盖] 动态调用送货目标识别节点选择的生成路线；未配置时安全失败",
        "pre_delay": 0,
        "action": "Custom",
        // custom_action / custom_action_param 运行时由 AutoDeliveryResolveDestinationAction 覆写：
        // 换成 SubTask + custom_action_param.sub=[该终点的主路线节点]，滑索或步行由终点配置与调用方选项共同决定。
        // 每次解析终点都会显式重写，避免上个终点的路线残留。
        // 静态的 FalseAction 是「还没解析出终点就执行到本节点」时的安全失败占位，不会真的导航。
        "custom_action": "FalseAction",
        "post_wait_freezes": {
            "time": 300,
            "target": [
                763,
                349,
                195,
                270
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDeliveryCheckSubmitGoodsTarget",
            "AutoDeliverySearchSubmitGoodsButton"
        ],
        "on_error": [
            "AutoDeliveryNavigateDestinationFailed"
        ],
        "focus": {
            "Node.Action.Starting": "$task.AutoDelivery.focus.navigate_destination",
            "Node.Action.Succeeded": {
                "trace": true
            },
            "Node.Action.Failed": {
                "trace": true
            }
        },
        // attach.zip 不由本文件决定：调用方的任务选项会通过 pipeline_override（接口层，不是 go）注入，
        // 例如 assets/tasks/DeliveryJobs.json 的 DeliveryJobsAutoDeliveryPreferZipline 选项把它设成 true/false。
        // AutoDeliveryResolveDestinationAction 读它来决定选滑索路线还是步行路线。
        "attach": {
            "zip": false
        }
    },
    "AutoDeliveryNavigateDestinationFailed": {
        "desc": "前往送货目标的导航失败（如到点没认到交互提示）时，照常识别交货图标并环绕查找",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDeliveryCheckSubmitGoodsTarget",
            "AutoDeliverySearchSubmitGoodsButton"
        ]
    },
    "AutoDeliveryRetryNavigateDestination": {
        "desc": "[运行时覆盖] 动态调用送货目标配置的一次性站位修正路线；无重试路线时不启用",
        // enabled 与（启用时的）custom_action / custom_action_param 运行时由 AutoDeliveryResolveDestinationAction 覆写：
        // 终点配了重试路线就置 enabled=true 并换成 SubTask + sub=[该终点的一次性站位修正路线]；
        // 没配则显式置 false，本节点整轮跳过。静态 false 表示「默认不启用」。
        "enabled": false,
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "FalseAction",
        "post_wait_freezes": {
            "time": 300,
            "target": [
                763,
                349,
                195,
                270
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDeliveryCheckSubmitGoodsTarget"
        ]
    },
    "AutoDeliveryReturnWorldAndNavigateDestination": {
        "desc": "返回大世界并前往已识别的送货目标",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneAnyEnterWorld"
            ],
            "continue": false,
            "strict": true
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDeliveryNavigateDestination"
        ]
    },
    "AutoDeliverySearchSubmitGoodsButton": {
        "desc": "到达送货目标后未确认站在目标前时，环绕微调站位并持续查找目标",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "CharacterSearchAction",
        "custom_action_param": {
            "wait_nodes": [
                "AutoDeliveryCheckSubmitGoodsTarget"
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDeliveryCheckSubmitGoodsTarget"
        ],
        "on_error": [
            "AutoDeliveryRetryNavigateDestination"
        ]
    },
    "AutoDeliveryCheckSkipChatReady": {
        "desc": "送货交互进入对话后等待跳过按钮稳定",
        "recognition": "And",
        "all_of": [
            "AutoDeliveryInChatDialog",
            "AutoDeliveryCheckSkipChatButton"
        ],
        "box_index": 1,
        "pre_wait_freezes": 200,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDeliverySkipChat"
        ]
    },
    "AutoDeliverySkipChat": {
        "desc": "送货交互进入对话时，先将鼠标移到左上角",
        "recognition": "And",
        "all_of": [
            "AutoDeliveryInChatDialog",
            "AutoDeliveryCheckSkipChatButton"
        ],
        "box_index": 1,
        "pre_delay": 0,
        "action": "TouchMove",
        "target": [
            0,
            0,
            1,
            1
        ],
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDeliveryCheckSkipChatAfterMoveAway"
        ]
    },
    "AutoDeliveryCheckSkipChatAfterMoveAway": {
        "desc": "鼠标移到左上角后，重新识别对话和跳过按钮，确认按钮仍可见并产出最新识别框",
        "recognition": "And",
        "all_of": [
            "AutoDeliveryInChatDialog",
            "AutoDeliveryCheckSkipChatButton"
        ],
        "box_index": 1,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDeliverySkipChatMoveToButton"
        ]
    },
    "AutoDeliverySkipChatMoveToButton": {
        "desc": "按移开后重新识别到的跳过按钮位置，将鼠标移回跳过按钮",
        "pre_delay": 0,
        "action": "TouchMove",
        "target": "AutoDeliveryCheckSkipChatAfterMoveAway",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDeliverySkipChatClick"
        ]
    },
    "AutoDeliverySkipChatClick": {
        "desc": "鼠标移回跳过按钮后，重新确认对话和按钮仍然可见再点击",
        "recognition": "And",
        "all_of": [
            "AutoDeliveryInChatDialog",
            "AutoDeliveryCheckSkipChatButton"
        ],
        "box_index": 1,
        "pre_delay": 80, // 等一帧
        "action": "Click",
        "post_wait_freezes": {
            "time": 500,
            "target": [
                520,
                300,
                240,
                120
            ],
            "timeout": 10000
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDeliverySkipChatConfirm",
            "AutoDeliveryCloseRewardDialog"
        ]
    },
    "AutoDeliverySkipChatConfirm": {
        "desc": "确认跳过送货对话",
        "recognition": "TemplateMatch",
        "roi": [
            750,
            390,
            170,
            160
        ],
        "template": [
            "Common/Button/YellowConfirmButtonType1.png",
            "Common/Button/YellowConfirmButtonType1Hover.png"
        ],
        "order_by": "Score",
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDeliveryCloseRewardDialog"
        ]
    },
    "AutoDeliverySubmitGoods": {
        "desc": "在送货目标附近识别交互按钮并提交货物",
        "recognition": "And",
        "all_of": [
            "AutoDeliveryCheckSubmitGoodsTarget"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "RepeatUntilFoundAction",
        "custom_action_param": {
            "custom_action": "AutoAltClickAction",
            "wait_nodes": [
                "AutoDeliveryInChatDialog",
                "AutoDeliveryCloseRewardDialog"
            ],
            "repeat_count": 5
        },
        "post_delay": 0,
        "timeout": 6000,
        "rate_limit": 0,
        "next": [
            "AutoDeliveryCheckSkipChatReady",
            "AutoDeliveryCloseRewardDialog"
        ],
        "focus": {
            "Node.Action.Starting": "$task.AutoDelivery.focus.submit_goods"
        }
    }
}
