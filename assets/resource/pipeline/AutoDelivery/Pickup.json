{
    "AutoDeliveryQuickTeleportSelect": {
        "desc": "在目的地地图界面，使用游戏自带的前往传送功能选中任务目标附近的传送点",
        "recognition": "TemplateMatch",
        "roi": [
            950,
            540,
            210,
            160
        ],
        "template": [
            "Common/Button/WhiteConfirmButtonType1.png",
            "Common/Button/WhiteConfirmButtonType1Hover.png"
        ],
        "order_by": "Score",
        "action": "Click",
        "post_wait_freezes": 500, // 等待地图视窗移动到传送点
        "next": [
            "AutoDeliveryQuickTeleport"
        ],
        "focus": {
            "Node.Action.Starting": "点击前往传送按钮"
        }
    },
    "AutoDeliveryQuickTeleport": {
        "desc": "在目的地地图界面，且已选中了传送点，直接点击传送",
        "recognition": "TemplateMatch",
        "roi": [
            1110,
            540,
            150,
            160
        ],
        "template": [
            "Common/Button/WhiteConfirmButtonType1.png",
            "Common/Button/WhiteConfirmButtonType1Hover.png"
        ],
        "order_by": "Score",
        "action": "Click",
        "next": [
            "AutoDeliveryQuickTeleportDone",
            "[JumpBack]SceneAnyEnterWorld"
        ],
        "focus": {
            "Node.Action.Starting": "点击传送按钮"
        }
    },
    "AutoDeliveryQuickTeleportDone": {
        "desc": "已在大世界中；已解析送货终点时先取消追踪再短程导航，否则根据当前位置判断仓储区域",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 5000, // 断言在短时间内可以命中任一 next
        "next": [
            "[Anchor]AutoDeliveryAfterQuickTeleport",
            "AutoDeliveryTargetDepotNodeIsWulingCity",
            "AutoDeliveryTargetDepotNodeIsTestArea"
        ],
        "on_error": [
            "AutoDeliveryFatalCannotDetermineDestination"
        ]
    },
    "AutoDeliveryCheckCarryingAfterUnresolvedTeleport": {
        "desc": "终点 OCR 未命中时，在快速传送落地后先确认是否已经携带货物",
        "recognition": "DirectHit",
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                130,
                30,
                170,
                90
            ]
        },
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "timeout": 5000,
        "rate_limit": 0,
        "next": [
            "AutoDeliveryIsCarryingGoodsAfterUnresolvedTeleport",
            "AutoDeliveryPrepareDepotNavigation"
        ]
    },
    "AutoDeliveryIsCarryingGoodsAfterUnresolvedTeleport": {
        "desc": "终点 OCR 未命中但已携带货物，重新进入任务详情识别终点",
        "recognition": "And",
        "all_of": [
            "AutoDeliveryIsCarryingGoods"
        ],
        "box_index": 0,
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDeliveryRetryResolveDestinationEntry"
        ]
    },
    "AutoDeliveryTargetDepotNodeIsWulingCity": {
        "desc": "判断当前是武陵城的送货任务",
        "recognition": "Custom",
        "custom_recognition": "MapLocateAssertLocation",
        "custom_recognition_param": {
            "zone_id": "Wuling_Base",
            "target": [
                920.48,
                1760.33,
                53.2,
                89.64
            ]
        },
        "pre_delay": 0,
        "anchor": {
            "AutoDeliveryWalkToDepotNode": "AutoDeliveryWalkToDepotNodeWulingCity"
        },
        "post_delay": 0,
        "next": [
            "AutoDeliveryCheckCarryingGoods"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "判断任务地点是武陵城"
        }
    },
    "AutoDeliveryTargetDepotNodeIsTestArea": {
        "desc": "判断当前是试验园区的送货任务",
