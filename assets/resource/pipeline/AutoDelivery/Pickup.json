    "AutoDeliveryIsCarryingGoods": {
        "desc": "发现已携带了货物，不再传送，直接尝试走送货流程",
        "recognition": "TemplateMatch",
        "roi": [
            130,
            30,
            170,
            90
        ],
        "template": "AutoDelivery/CarryingGoods.png",
        "green_mask": true,
        "order_by": "Score",
