{
    "EssenceFullScreenDetectAll": {
        "desc": "逐格检查战利品：模板确认基质、色条判断品质，保留未能确认的格位",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "EssenceRewardRecognition",
                "roi": [
                    34,
                    87,
                    1210,
                    522
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 0
    },
    "EssenceFindLockItem": {
        "desc": "定位详情页锁按钮，作为品质和标记的识别锚点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    276,
                    87,
                    972,
                    486
                ],
                "template": [
                    "EssenceFilter/LockButton.png",
                    "EssenceFilter/LockButtonLocked.png"
                ],
                "threshold": 0.9,
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_wait_freezes": 300,
        "next": [
            "EssenceFilterAfterBattleIsflawless",
            "EssenceFilterAfterBattleIsPure"
        ],
        "on_error": [
            "EssenceFilterAfterBattleFailed"
        ],
        "focus": {
            "Node.Action.Succeeded": "已定位基质详情"
        }
    },
