{
    "EssenceFilterMainFailed": {
        "desc": "入口点失败",
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 0,
        "next": [
            "EssenceFilterFinish"
        ],
        "focus": {
            "Node.Action.Failed": "未能进入基质界面，结束任务"
        }
    },
    "EssenceFilterCheckInInventory": {
        "desc": "检查是否在背包Essence页（已选中武器基质页签）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    435,
                    3,
                    150,
                    49
                ],
                "template": "EssenceFilter/EssenceTabChoose.png",
                "threshold": 0.9
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 2000,
        "next": [
            "EssenceFilterInit",
            "EssenceFilterInventoryInit"
        ],
        "on_error": [
            "EssenceFilterNavigateToInventory"
        ],
        "focus": {
            "Node.Action.Succeeded": "确认在基质界面"
        }
    },
    "EssenceFilterNavigateToInventory": {
        "desc": "导航",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "next": [
            "EssenceFilterFinish"
        ],
        "focus": {
            "Node.Action.Succeeded": "不在基质界面"
        }
    },
    "EssenceFilterInit": {
        "desc": "初始化：加载数据与预设",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EssenceFilterInitAction"
            }
        },
        "post_wait_freezes": {
            "time": 50,
            "target": [
                38,
                398,
                922,
                198
            ]
        },
        "post_delay": 0,
        "next": [
            "EssenceGridAdvance"
        ],
        "focus": {
            "Node.Action.Succeeded": "初始化完成"
        },
        "attach": {
            "mode": "filter"
        }
    },
    "EssenceFilterInventoryInit": {
        "desc": "初始化：库存盘点模式（只读扫描无瑕基质，匹配四至六星武器）",
        "enabled": false,
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EssenceFilterInitAction"
            }
        },
        "post_wait_freezes": {
            "time": 50,
            "target": [
                38,
                398,
                922,
                198
            ]
        },
        "post_delay": 0,
        "next": [
            "EssenceGridAdvance"
        ],
        "focus": {
            "Node.Action.Succeeded": "初始化完成"
        },
        "attach": {
            "mode": "inventory",
            "flawless_essence": true,
            "pure_essence": false,
            "rarity4_weapon": true,
            "rarity5_weapon": true,
            "rarity6_weapon": true
        }
    },
    "EssenceFilterFinish": {
        "desc": "任务完成",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EssenceFilterFinishAction"
            }
        },
        "post_delay": 0,
        "focus": {
            "Node.Action.Succeeded": "任务完成"
        }
    }
}
