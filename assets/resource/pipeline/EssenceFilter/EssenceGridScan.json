    "EssenceGridClickPending": {
        "desc": "点击 C++ 已选择的基质格子",
        // 沿用每格最多两次点击；Go 派发新格位时清零。
        "max_hit": 2,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "EssenceGridPendingRecognition"
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [
                1167,
                110,
                38,
                38
            ],
            "threshold": 0.05,
            // 比较核心的像素差，详情淡入时即使图案相同，亮度仍在变化。
            "method": 1,
            "rate_limit": 75
        },
        "post_delay": 0,
        "next": [
            "EssenceGridCheckSelection"
        ],
        "on_error": [
            "FailedNode"
        ]
    },
