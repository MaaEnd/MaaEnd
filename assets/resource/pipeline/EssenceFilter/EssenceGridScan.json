{
    "EssenceGridAdvance": {
        "desc": "C++ 扫描基质网格并选择下一个未处理格子",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "EssenceGridAdvanceRecognition"
            }
        },
        "pre_wait_freezes": {
            "time": 100,
            "target": [
                18,
                72,
                956,
                570
            ]
        },
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "next": [
            "EssenceFilterFinish"
        ],
        "attach": {
            "thumb_discard_template_path": "resource/image/EssenceFilter/ThumbDiscard.png",
            "thumb_lock_template_paths": [
                "resource/image/EssenceFilter/ThumbLock.png",
                "resource/image/EssenceFilter/LockPurple.png"
            ],
            // 宽度收到 948：956 会把右侧详情面板的左边框（x≈965）框进 ROI，
            // 而列数走的是「暗分隔线」推导 —— 那条边框被当成一条分隔线，首帧于是
            // 多出一个 6px 宽的假列（10 列）；后续帧因拿到追踪器测出的格宽而只认 9 列。
            // 首帧与后续帧列数不一致会让 GridTracker 判 shape_changed 并永久卡死
            // （拒绝后不更新基准，直到 reco_timeout），故收窄 ROI 让首帧也是 9 列。
            "roi": [
                18,
                72,
                948,
                570
            ],
            "normalized_size": [
                1280,
                720
            ],
            "row_threshold_ratio": 0.2,
            "col_threshold_ratio": 0.4,
            "min_raw_segment_length": 10,
            "min_kept_segment_ratio": 0.9,
            "repeat_match_ratio": 0.95,
            "flawless_essence": true,
            "pure_essence": false,
            "skip_thumb_lock": true,
            "skip_thumb_discard": true
        }
    },
    "EssenceGridClickPending": {
        "desc": "点击 C++ 已选择的基质格子",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "EssenceGridPendingRecognition"
            }
        },
        "pre_delay": 0,
        "action": {
            // target_offset 为 [dx, dy, dw, dh]：96x96 格子向中心收束为 48x48，避免落点偏散
            "type": "Click",
            "param": {
                "target_offset": [
                    24,
                    24,
                    -48,
                    -48
                ]
            }
        },
        "post_wait_freezes": {
            "time": 50,
            "target": [
                979,
                101,
                283,
                250
            ]
        },
        "post_delay": 0,
        "next": [
            "EssenceFilterCheckItemSlot1"
        ],
        "on_error": [
            "EssenceGridAdvance"
        ]
    },
    "EssenceGridSwipeNext": {
        "desc": "滑动到下一页基质网格",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "pre_delay": 0,
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    135,
                    291
                ],
                "end": [
                    135,
                    76
                ],
                "end_hold": 700,
                "duration": 101
            }
        },
        "post_wait_freezes": {
            "time": 100,
            "target": [
                18,
                72,
                956,
                570
            ]
        },
        "post_delay": 0,
        "next": [
            "EssenceGridAdvance"
        ]
    }
}
