{
    "EssenceFullScreenDetectAll": {
        "desc": "在战利品界面模板匹配：收集所有基质图标（不点击）,给custom调用",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    34,
                    87,
                    1210,
                    522
                ],
                "template": "EssenceFilter/EssenceGeneral.png",
                "method": 5,
                "threshold": 0.35
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 0
    },
    "EssenceFindLockItem": {
        "desc": "查找上锁的图标，已上锁就跳过",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    0,
                    1280,
                    720
                ],
                "template": "EssenceFilter/LockButton.png",
                "threshold": 0.9,
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_wait_freezes": 300,
        "next": [
            "EssenceFilterAfterBattleIsflawless",
            "EssenceFilterAfterBattleIsPure",
            "EssenceFilterAfterBattleCloseDetail"
        ],
        "focus": {
            "Node.Action.Succeeded": "基质未锁定"
        }
    }
}
