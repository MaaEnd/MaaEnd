        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    -500,
                    -300,
                    500,
                    300
                ],
                "expected": [
                    "点击领取奖励"
                ]
            }
        },
        "pre_delay": 1200, // 3d移动，pre_wait_freeze不生效
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilNotFoundAction",
                "custom_action_param": {
                    "action": "Click",
                    "wait_node": "__ScenePrivateLoginCompanionGiftConfirm"
                }
            }
        }
    },
    "__ScenePrivateLoginPristineMonthlyPassConfirm": {
        "desc": "领取焕新月卡，无法跳过必须领取",
        "max_hit": 1, // 3d移动不好判断什么时候结束，因此只点一次防止影响到下一层弹窗
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    850,
                    180,
                    300,
                    150
                ],
                "expected": [
                    "焕新月卡赠礼",
                    "煥新月卡贈禮",
                    "Pristine Monthly Pass Tribute",
                    "月パス特典",
                    "리뉴얼 월정액 선물"
                ]
            }
        },
        "pre_wait_freezes": 200,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilNotFoundAction",
                "custom_action_param": {
                    "action": "Click",
                    "wait_node": "__ScenePrivateLoginPristineMonthlyPassConfirm"
                }
            }
        },
        "next": [
            "SceneNoticeRewardsConfirm"
        ]
    },
    "__ScenePrivateLoginCloseDialog": {
        "desc": "关闭所有待领取的弹窗，此功能目的是进入游戏，奖励领取统一在单独任务中处理",
        "max_hit": 100,
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 27 // ESC
            }
        },
        "post_wait_freezes": {
            "target": [
                0,
                0,
                100,
                100
            ],
            "time": 600,
            "timeout": 2000
        }
    },
    "__ScenePrivateLoginSuccess": {
        "desc": "进入大世界成功",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InWorld"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0
    }
}
