    "__ScenePrivateMapEnterTeleport": {
        "desc": "在地图界面，随机选择一个传送点进入",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "roi": [
                                    -350,
                                    0,
                                    350,
                                    60
                                ],
                                "template": [
                                    "SceneManager/MapMind.png"
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "roi": [
                                    0,
                                    0,
                                    0,
                                    0
                                ],
                                "template": [
                                    "SceneManager/MapTeleport.png"
                                ]
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "[JumpBack]__ScenePrivateMapTeleportChoose",
            "[JumpBack]__ScenePrivateMapMarkerPanelClose",
            "__ScenePrivateMapTeleportConfirm"
        ]
    },
    "__ScenePrivateMapTeleportChoose": {
        "desc": "判断是否有多个图标重叠，导致出现候选条目",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    -500,
                    350,
                    400,
                    300
                ],
                // 候选条目按点位类型显示不同名字：普通的叫「协议传送点」，
                // 基建那两种分别叫「协议核心」「次级核心」。都是传送点，一并列在这里
                "expected": [
                    "协议传送点",
                    "協議傳送點",
                    "(?i)TP\\s*Point",
                    "協約転送ポイント",
                    "프로토콜 전송 지점",
                    "协议核心",
                    "協議核心",
                    "協約核心",
                    "프로토콜 코어",
                    "(?i)Protocol\\s*Automation.*",
                    "次级核心",
                    "次級核心",
                    "サブ協約核心",
                    "서브 코어",
                    "(?i)Sub-?PAC"
                ]
            }
        },
        "pre_wait_freezes": 100,
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 100,
            "target": [
                -100,
                300,
                100,
                300
            ]
        }
    },
