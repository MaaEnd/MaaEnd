{
    "__ScenePrivateNextTrue": {
        "desc": "识别结果永远为真，用于退出next循环"
    },
    "__ScenePrivateAnyExit": {
        "desc": "退出当前场景，返回上一个场景",
        "max_hit": 100,
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 27 // ESC
            }
        },
        "post_delay": 3000 // 等待 3 秒再继续，手表动画展开需要几秒钟时间，防止错过识别信息
    },
    "__ScenePrivateScreenshotStableAbnormal": {
        "desc": "连续画面不变时判定环境识别异常强制失败,部分用户vulcan全屏游戏时，所有截图api截取到的画面都是不动的",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ScreenshotStableRecognition"
            }
        },
        "next": [
            "__ScenePrivateScreenshotStableAbnormalWhite",
            "__ScenePrivateScreenshotStableAbnormalDefault"
        ]
    },
    "__ScenePrivateScreenshotStableAbnormalWhite": {
        "desc": "画面不变且大面积为白色，通常是通过前置程序直接启动游戏导致",
        "recognition": "ColorMatch",
        "roi": [
            540,
            310,
            200,
            100
        ],
        "lower": [
            240,
            240,
            240
        ],
        "upper": [
            255,
            255,
            255
        ],
        "count": 18000,
        "action": "Custom",
        "custom_action": "FalseAction",
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "$task.SceneManager.focus.screenshot_stable_white",
                "display": "modal"
            }
        }
    },
    "__ScenePrivateScreenshotStableAbnormalDefault": {
        "desc": "画面不变的其他情况",
        "action": "Custom",
        "custom_action": "FalseAction",
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "$task.SceneManager.focus.screenshot_stable_abnormal",
                "display": "modal"
            }
        }
    },
    "__ScenePrivateLoggedOutConfirm": {
        "desc": "确认自动登出 / 重连失败弹窗",
        "recognition": "And",
        "all_of": [
            {
                "recognition": "OCR",
                "roi": [
                    350,
                    250,
                    550,
                    202
                ],
                // 重连失败弹窗完整原文（共 4 种）：
                // 与服务器重连失败，无法连接服务器 / 尝试次数过多 / 间隔时间过久 / 服务器要求重新登录
                // 與伺服器重連失敗，無法連接伺服器 / 嘗試次數過多 / 間隔時間過久 / 伺服器要求重新登入
                "expected": [
                    // @i18n-skip
                    "自动登出",
                    "自動登出",
                    "数据即将更新",
                    "數據即將更新",
                    "与服务器重连失败",
                    "與伺服器重連失敗"
                ]
            },
            "YellowConfirmButtonType1"
        ],
        "box_index": 1,
        "pre_wait_freezes": 100,
        "action": "Click"
    },
    "__ScenePrivateNoticeRewardsUpgrade": {
        "desc": "检测到升级",
        "recognition": "OCR",
        "roi": [
            500,
            0,
            280,
            200
        ],
        "expected": [
            "权限等阶",
            "權限等階",
            "Authority Level",
            "行動レベル",
            "권한 등급"
        ],
        "pre_delay": 0,
        "post_delay": 0
    },
    "__ScenePrivateNoticeRewardsUpgradeDisappear": {
        "desc": "检测到升级消失",
        "recognition": "OCR",
        "roi": [
            500,
            0,
            280,
            200
        ],
        "expected": [
            "权限等阶",
            "權限等階",
            "Authority Level",
            "行動レベル",
            "권한 등급"
        ],
        "inverse": true,
        "pre_delay": 0,
        "post_delay": 0
    },
    "__ScenePrivateNoticeRewardsUpgradeConfirm": {
        "desc": "升级奖励界面，点击确认",
        "recognition": "OCR",
        "roi": [
            500,
            -280,
            280,
            260
        ],
        "expected": [
            "点击空白处继续",
            "按下空白處繼續",
            "Click to continue",
            "クリックして続ける",
            "빈 곳을 눌러 계속하기"
        ],
        "pre_wait_freezes": 200,
        "action": "Click"
    },
    "__ScenePrivateCloseADBExit": {
        "desc": "关闭ADB控制器的退出游戏界面",
        "recognition": "And",
        "all_of": [
            {
                "recognition": "OCR",
                "roi": [
                    329,
                    243,
                    710,
                    220
                ],
                "expected": [
                    // @i18n-skip
                    "是否退出游戏",
                    "是否退出遊戲",
                    "(?i)Exit\\s*the\\s*game",
                    "ゲームを終了しますか"
                ]
            },
            "GrayCancelButton"
        ],
        "box_index": 1,
        "pre_wait_freezes": 200,
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 200
    }
}
