        "action": "Custom",
        "custom_action": "FailureCollectorRunTask",
        "custom_action_param": {
            "key": "AutoCollect",
            "task": "AutoCollectRoute1Start",
            "failure_task": "AutoCollectRoute1Failed"
        },
        "post_delay": 0
    },
