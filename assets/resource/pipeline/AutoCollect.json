{
    "AutoCollectSchedule": {
        "desc": "自动采集时间任务",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "AutoCollectScheduleEnabled",
            "AutoCollectEnd"
        ]
    },
    "AutoCollectScheduleEnabled": {
        "desc": "自动采集时间任务命中",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ScheduleRecognition",
                "custom_recognition_param": {}
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "AutoCollectResetFailures"
        ],
        "attach": {
            "monday": false,
            "tuesday": false,
            "wednesday": false,
            "thursday": false,
            "friday": false,
            "saturday": false,
            "sunday": false
        }
    },
    "AutoCollectResetFailures": {
        "desc": "重置自动采集路线执行结果",
        "action": "Custom",
        "custom_action": "FailureCollectorReset",
        "custom_action_param": {
            "key": "AutoCollect"
        },
        "next": [
            "AutoCollectBeforeStashBackpack"
        ]
    },
    "AutoCollectBeforeStashBackpack": {
        "desc": "自动采集前存放背包",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "StashBackpackSubTask"
            ]
        },
        "post_delay": 0,
        "next": [
            "AutoCollectLoop"
        ]
    },
    "AutoCollectInventoryPrepare": {
        "desc": "目标库存模式：严格执行 IMS 仓库同步，失败时由 on_error 切换为无库存门控的兼容路径",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SubTask",
                "custom_action_param": {
                    "sub": [
                        "SyncDepotItemData"
                    ],
                    "strict": true
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoCollectInventoryReady"
        ],
        "on_error": [
            "AutoCollectInventoryFallback"
        ]
    },
    "AutoCollectInventoryReady": {
        "desc": "仓库同步成功，开始按目标库存筛选采集路线",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoCollectLoop"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$task.AutoCollect.focus.inventory_ready"
        }
    },
    "AutoCollectInventoryFallback": {
        "desc": "仓库同步失败：任务级开启库存旁路，所有已勾选路线按原逻辑执行，不使用旧缓存",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PipelineOverride",
                "custom_action_param": {
                    "patch": {
                        "AutoCollectInventoryBypass": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "ExpressionRecognition",
                                    "custom_recognition_param": {
                                        "expression": "1>0"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoCollectLoop"
        ],
        "focus": {
            "Node.Action.Succeeded": "$task.AutoCollect.focus.inventory_fallback"
        }
    },
    "AutoCollectInventoryBypass": {
        "desc": "目标库存识别旁路：默认恒不命中，仅仓库同步失败后由任务级覆盖切换为恒命中",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ExpressionRecognition",
                "custom_recognition_param": {
                    "expression": "0>1"
                }
            }
        },
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0
    },
    "AutoCollectLoop": {
        "desc": "依次执行已启用的自动采集路线",
        "next": [
            "[JumpBack]AutoCollectRoute1Sub",
            "[JumpBack]AutoCollectRoute2Sub",
            "[JumpBack]AutoCollectRoute3Sub",
            "[JumpBack]AutoCollectRoute4Sub",
            "[JumpBack]AutoCollectRoute5Sub",
            "[JumpBack]AutoCollectRoute6Sub",
            "[JumpBack]AutoCollectRoute7Sub",
            "[JumpBack]AutoCollectRoute8Sub",
            "[JumpBack]AutoCollectRoute9Sub",
            "[JumpBack]AutoCollectRoute10Sub",
            "[JumpBack]AutoCollectRoute11Sub",
            "[JumpBack]AutoCollectRoute12Sub",
            "[JumpBack]AutoCollectRoute13Sub",
            "[JumpBack]AutoCollectRoute14Sub",
            "[JumpBack]AutoCollectRoute15Sub",
            "[JumpBack]AutoCollectCommonRoute1Sub",
            "[JumpBack]AutoCollectCommonRoute2Sub",
            "[JumpBack]AutoCollectCommonRoute3Sub",
            "[JumpBack]AutoCollectCommonRoute4Sub",
            "[JumpBack]AutoCollectCommonRoute5Sub",
            "[JumpBack]AutoCollectCommonRoute6Sub",
            "[JumpBack]AutoCollectCommonRoute7Sub",
            "[JumpBack]AutoCollectCommonRoute8Sub",
            "AutoCollectAfterStashBackpack"
        ]
    },
    "AutoCollectAfterStashBackpack": {
        "desc": "自动采集后存放背包",
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "StashBackpackSubTask"
            ]
        },
        "next": [
            "AutoCollectFinish"
        ]
    },
    "AutoCollectInventoryInvalidateSnapshot": {
        "desc": "目标库存模式结束：重新开启仓库同步入口，确保下一次调用不会复用采集前快照",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PipelineOverride",
                "custom_action_param": {
                    "resource_override": true,
                    "patch": {
                        "SyncDepotItemDataBegin": {
                            "enabled": true
                        }
                    }
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoCollectFinish"
        ]
    },
    "AutoCollectFinish": {
        "desc": "汇总自动采集子任务执行结果",
        "action": "Custom",
        "custom_action": "FailureCollectorFinish",
        "custom_action_param": {
            "key": "AutoCollect"
        },
        "next": [
            "AutoCollectEnd"
        ]
    },
    "AutoCollectEnd": {
        "pre_delay": 0,
        "post_delay": 0
    },
