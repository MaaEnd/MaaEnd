{
    "AutoCollectSchedule": {
        "desc": "自动采集时间任务",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "AutoCollectScheduleEnabled",
            "AutoCollectEnd"
        ]
    },
    "AutoCollectScheduleEnabled": {
        "desc": "自动采集时间任务命中",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ScheduleRecognition",
                "custom_recognition_param": {}
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "AutoCollectResetFailures"
        ],
        "attach": {
            "monday": false,
            "tuesday": false,
            "wednesday": false,
            "thursday": false,
            "friday": false,
            "saturday": false,
            "sunday": false
        }
    },
    "AutoCollectResetFailures": {
        "desc": "重置自动采集路线执行结果",
        "action": "Custom",
        "custom_action": "FailureCollectorReset",
        "custom_action_param": {
            "key": "AutoCollect"
        },
        "next": [
            "AutoCollectBeforeStashBackpack"
        ]
    },
    "AutoCollectBeforeStashBackpack": {
        "desc": "自动采集前存放背包",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "StashBackpackSubTask"
            ]
        },
        "post_delay": 0,
        "next": [
            "AutoCollectInventory",
            "AutoCollectLoop"
        ]
    },
    "AutoCollectInventory": {
        "desc": "自动采集目标库存管理入口",
        "enabled": false,
        "recognition": "DirectHit",
        "next": [
            "AutoCollectInventoryResetSnapshot"
        ]
    },
    "AutoCollectAfterStashBackpack": {
        "desc": "自动采集后存放背包",
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "StashBackpackSubTask"
            ]
        },
        "next": [
            "AutoCollectFinish"
        ]
    },
    "AutoCollectFinish": {
        "desc": "汇总自动采集子任务执行结果",
        "action": "Custom",
        "custom_action": "FailureCollectorFinish",
        "custom_action_param": {
            "key": "AutoCollect"
        },
        "next": [
            "AutoCollectEnd"
        ]
    },
    "AutoCollectEnd": {
        "pre_delay": 0,
        "post_delay": 0
