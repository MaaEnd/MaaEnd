{
    "AutoCollectSchedule": {
        "desc": "自动采集时间任务",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "AutoCollectScheduleEnabled",
            "AutoCollectEnd"
        ]
    },
    "AutoCollectScheduleEnabled": {
        "desc": "自动采集时间任务命中",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ScheduleRecognition",
                "custom_recognition_param": {}
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "AutoCollectResetFailures"
        ],
        "attach": {
            "monday": false,
            "tuesday": false,
            "wednesday": false,
            "thursday": false,
            "friday": false,
            "saturday": false,
            "sunday": false
        }
    },
    "AutoCollectResetFailures": {
