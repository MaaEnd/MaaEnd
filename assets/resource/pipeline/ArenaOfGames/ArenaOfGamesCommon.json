{
    "ArenaOfGamesInDrawMenu": {
        "desc": "确认位于百趣演武抽牌界面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    20,
                    14,
                    185,
                    35
                ],
                "expected": [
                    "百趣演武",
                    "(?i)Arena\\s*of\\s*Games",
                    "다채로운 연무"
                    // 繁中、日文标题与简中相同
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "ArenaOfGamesDailyHandText": {
        "desc": "今日好运组合牌型名文本（裸 OCR，无 expected），由手牌识别器按 attach 名单映射为当日目标牌型",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    123,
                    595,
                    160,
                    32
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        // 牌型名取自游戏 I18nTextTable（1.6.4@11343132-9）；zh_tw「同花」与国际服「Flush」同名，匹配时按名字最长优先
        // 本名单是唯一源：节点不写 expected，文本到牌型的匹配全部在 ArenaOfGames.CheckHand 中按名单完成（同 TrialOfSwordmancy 的裸 OCR 模式）
        "attach": {
            "straight_flush": [
                "同花顺",
                "同花順",
                "Straight Flush",
                "ストレートフラッシュ",
                "스트레이트 플러시"
            ],
            "four_of_a_kind": [
                "四条",
                "四條",
                "Quad",
                "フォーカード",
                "포카드"
            ],
            "flush": [
                "同花",
                "Flush",
                "フラッシュ",
                "플러시"
            ],
            "full_house": [
                "葫芦",
                "葫蘆",
                "Full House",
                "フルハウス",
                "풀하우스"
            ],
            "straight": [
                "顺子",
                "順子",
                "Straight",
                "ストレート",
                "스트레이트"
            ],
            "two_pair": [
                "两对",
                "兩對",
                "Two Pair",
                "ツーペア",
                "투 페어"
            ],
            "three_of_a_kind": [
                "三条",
                "三條",
                "Triplet",
                "スリーカード",
                "트리플"
            ],
            "pair": [
                "对子",
                "對子",
                "Pair",
                "ワンペア",
                "원 페어"
            ]
        }
    },
    "ArenaOfGamesDrawCardButton": {
        "desc": "抽牌按钮固定图形，兼容常态和悬停态",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1090,
                    505,
                    190,
                    90
                ],
                "template": [
                    "ArenaOfGames/DrawCardButton.png",
                    "ArenaOfGames/DrawCardButtonHover.png"
                ],
                "threshold": 0.9
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
