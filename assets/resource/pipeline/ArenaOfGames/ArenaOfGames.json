{
    "ArenaOfGamesMain": {
        "desc": "百趣演武抽牌任务入口，需先打开抽牌界面",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ArenaOfGamesInDrawMenu"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "ArenaOfGamesDecide"
        ]
    },
    "ArenaOfGamesDecide": {
        "desc": "单次识别手牌，按勾选目标牌型三态路由：凑成即结束（早停）、无法凑出转放弃、否则按手牌数转 DrawCard1-5；next 由 Decide 动态覆盖",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ArenaOfGames.CheckHand"
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ArenaOfGames.Decide"
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [],
        "attach": {
            "hand_of_today": false,
            "flush": false,
            "full_house": false,
            "four_of_a_kind": false,
            "straight_flush": false
        }
    },
    "ArenaOfGamesDrawCard1": {
        "desc": "点击抽牌按钮抽出第1张铭牌：识别确认第1张完整可读后放行，持续2秒未确认（点击未生效）才补点",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ArenaOfGamesDrawCardButton"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilFoundAction",
                "custom_action_param": {
                    "action": "Click",
                    "interval_ms": 2000,
                    "repeat_count": 5,
                    "wait_nodes": [
                        "ArenaOfGamesDrawCardSuccess1"
                    ]
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "ArenaOfGamesDrawCardSuccess1"
        ]
    },
