    "ArenaOfGamesStop": {
        "desc": "当前手牌已凑成任一勾选的目标牌型，保留手牌并结束（早停）",
        "recognition": {
            "type": "DirectHit"
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": []
    },
    "ArenaOfGamesAbandon": {
        "desc": "重新识别放弃挑战按钮并点击",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ArenaOfGamesInDrawMenu",
                    "ArenaOfGamesAbandonButton"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "ArenaOfGamesAbandonConfirm"
        ]
    },
    "ArenaOfGamesAbandonConfirm": {
        "desc": "确认百趣演武的放弃挑战弹窗（灰取消+黄确认双键组合即放弃弹窗特征：掉线等提示仅中央单黄键，不会误命中）",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "GrayCancelButton",
                    "YellowConfirmButtonType1"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "ArenaOfGamesWaitEmpty"
        ]
    },
    "ArenaOfGamesWaitEmpty": {
