{
    "SanityExtractorMain": {
        // 清掉遗留的计数
        "desc": "萃取理智入口：先清空上一轮任务遗留的命中计数，再进入贵重品库珍贵物品页",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClearHitCount",
                "custom_action_param": {
                    "nodes": [
                        "SanityExtractorRoundGate"
                    ],
                    "strict": false
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorInValuablesTab",
            "[JumpBack]SceneEnterMenuValuablesValuableTab",
            "[JumpBack]SceneDialogConfirm",
            "[JumpBack]SceneWaitLoadingExit"
        ],
        "focus": {
            "Node.Action.Starting": "$task.SanityExtractor.focus.start"
        }
    },
    "SanityExtractorInValuablesTab": {
        "desc": "已在珍贵物品页，进入轮次闸门",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InStashValuablesTab"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorRoundGate",
            "SanityExtractorTimesExhausted"
        ]
    },
    "SanityExtractorRoundGate": {
        "desc": "轮次闸门：唯一计数节点。每命中一次代表开始一轮萃取（查找→注入→领奖），达到设定次数后被跳过",
        "max_hit": 10,
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorFindLoop"
        ]
    },
    "SanityExtractorFindLoop": {
        "desc": "查找循环：命中萃取器则选中；列表到底则结束；否则向下翻页重试",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorFindExtractor",
            "SanityExtractorScrollFinish",
            "[JumpBack]SanityExtractorScrollDown"
        ]
    },
    "SanityExtractorScrollFinish": {
        "desc": "列表已到底：ListComplete 命中后结束查找",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ListCompleteRecognition",
                "custom_recognition_param": {
                    "threshold": 0.98
                },
                "roi": [
                    24,
                    76,
                    950,
                    520
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorNoExtractor"
        ],
        "attach": {
            "ready": false
        }
    },
    "SanityExtractorFindExtractor": {
        "desc": "在当前可见网格中定位理智萃取器并选中",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "IconRecognition",
                "custom_recognition_param": {
                    "grid_type": "valuables",
                    "item_ids": [
                        "item_ap_feed_in"
                    ],
                    "item_recheck_filters": [
                        "ValuableDepot:CommercialItem"
                    ],
                    "deduplicate": true
                },
                "roi": [
                    24,
                    76,
                    950,
                    520
                ]
            }
        },
        "pre_wait_freezes": {
            "time": 100,
            "target": [
                24,
                76,
                950,
                520
            ],
            "timeout": 3000
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 200,
        "rate_limit": 0,
        "next": [
            "SanityExtractorConfirmSelected"
        ],
        "focus": {
            "Node.Action.Starting": "$task.SanityExtractor.focus.find"
        }
    },
    "SanityExtractorConfirmSelected": {
        "desc": "确认详情栏显示的是理智萃取器；点击已发生，这里失败直接结束而不翻页",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__SanityExtractorSelectedItem"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorUse"
        ],
        "on_error": [
            "SanityExtractorNoExtractor"
        ]
    },
    "SanityExtractorScrollDown": {
        "desc": "列表未到底时向下滚动，滑动后等画面稳定再回查找循环；命中次数上限防止画面抖动导致无限滚动",
        "max_hit": 20,
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "pre_delay": 0,
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    500,
                    560
                ],
                "end": [
                    500,
                    260
                ],
                "end_hold": 300
            }
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [
                24,
                76,
                950,
                520
            ],
            "threshold": 0.97,
            "timeout": 2000
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorFindLoop"
        ],
        "focus": {
            "Node.Action.Starting": "$task.SanityExtractor.focus.scroll"
        }
    },
    "__SanityExtractorSelectedItem": {
        "desc": "详情栏右上角显示的是理智萃取器图标时，确认选中正确物品",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    971,
                    50,
                    306,
                    342
                ],
                "template": [
                    "SanityExtractor/sanityExtractorsRightUI.png"
                ],
                "threshold": 0.8
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "SanityExtractorUse": {
        "desc": "点击右下角白色圆环「使用」按钮",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "WhiteConfirmButtonType1"
                ]
            }
        },
        "pre_wait_freezes": 100,
        "action": {
            "type": "Click"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorInInjectPanel"
        ],
        "focus": {
            "Node.Action.Starting": "$task.SanityExtractor.focus.use"
        }
    },
    "SanityExtractorInInjectPanel": {
        "desc": "确认已进入注入萃取器界面：中央药水图案命中",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__SanityExtractorInjectPanelMark"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorNotEnoughSanity",
            "SanityExtractorInject",
            "SanityExtractorTimesExhausted"
        ],
        "focus": {
            "Node.Action.Starting": "$task.SanityExtractor.focus.inject_panel"
        }
    },
    "__SanityExtractorInjectPanelMark": {
        "desc": "注入界面中央的理智精粹药剂图案，用于确认当前处于注入萃取器界面",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    278,
                    35,
                    855,
                    650
                ],
                "template": [
                    "SanityExtractor/extractorUISanityEssence.png"
                ],
                "threshold": 0.8
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "SanityExtractorTimesExhausted": {
        "desc": "注入次数已用完，结束任务",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorResetHitCount"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$task.SanityExtractor.focus.times_done"
        }
    },
    "SanityExtractorInject": {
        "desc": "点击注入界面右下角的黄色注入按钮",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "YellowConfirmButtonType1"
                ]
            }
        },
        "pre_wait_freezes": 100,
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 300,
        "rate_limit": 0,
        "next": [
            "SanityExtractorRewardDialog"
        ],
        "focus": {
            "Node.Action.Starting": "$task.SanityExtractor.focus.inject"
        }
    },
    "SanityExtractorRewardDialog": {
        "desc": "注入成功后的「已获得理智精粹药剂」奖励弹窗：底部对勾是奖励界面独有元素，用它判定并点击关闭",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CloseRewardsButton"
                ]
            }
        },
        "pre_wait_freezes": 200,
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 300,
        "rate_limit": 0,
        "next": [
            "SanityExtractorAfterReward"
        ],
        "focus": {
            "Node.Action.Starting": "$task.SanityExtractor.focus.reward"
        }
    },
    "SanityExtractorAfterReward": {
        "desc": "关闭奖励弹窗后回到贵重品库；次数未用完才继续下一轮查找",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InStashValuablesTab"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorRoundGate",
            "SanityExtractorTimesExhausted"
        ]
    },
    "SanityExtractorNotEnoughSanityText": {
        "desc": "理智不足判定：读取注入界面右上角的当前理智数值，低于萃取一次所需（120）即视为不足",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ExpressionRecognition",
                "custom_recognition_param": {
                    "expression": "{__SanityExtractorInjectPanelSanity}<120",
                    "box_node": "__SanityExtractorInjectPanelSanity",
                    "focus_matched_resolved_expression": false
                }
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__SanityExtractorInjectPanelSanity": {
        "desc": "注入界面右上角的理智数值；图标模板、OCR 偏移与 CommonSanityText 一致，仅把图标 ROI 收敛到本界面位置",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "sub_name": "mind_icon",
                        "recognition": "TemplateMatch",
                        "roi": [
                            844,
                            77,
                            316,
                            120
                        ],
                        "template": [
                            "SceneManager/MapMind.png"
                        ]
                    },
                    {
                        "recognition": "OCR",
                        "roi": "mind_icon",
                        "roi_offset": [
                            30,
                            -5,
                            60,
                            10
                        ],
                        // 完整原文形如 "126/360"，OCR 只取其中数字部分
                        "expected": [
                            // @i18n-skip
                            "\\d+"
                        ]
                    }
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "SanityExtractorNotEnoughSanity": {
        "desc": "注入界面理智不足：优先按顶部理智数值判断，数值识别失败时兜底检测禁用按钮上的「理智不足」文案",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "SanityExtractorNotEnoughSanityText",
                    "__SanityExtractorNotEnoughSanityButtonText"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorCloseInjectPanel"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$task.SanityExtractor.focus.sanity_low"
        }
    },
    "__SanityExtractorNotEnoughSanityButtonText": {
        "desc": "理智不足时注入按钮置灰并显示「理智不足」文案",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    863,
                    521,
                    280,
                    115
                ],
                "expected": [
                    "理智不足"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "SanityExtractorCloseInjectPanel": {
        "desc": "理智不足收工前点击右上角叉关闭注入萃取器界面",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CloseButtonType1"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorClosedToValuables"
        ],
        "focus": {
            "Node.Action.Starting": "$task.SanityExtractor.focus.close_panel"
        }
    },
    "SanityExtractorClosedToValuables": {
        "desc": "确认已回到珍贵物品页",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InStashValuablesTab"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorResetHitCount"
        ]
    },
    "SanityExtractorNoExtractor": {
        "desc": "没有找到理智萃取器，结束任务",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorResetHitCount"
        ],
        "focus": {
            "Node.Action.Starting": "$task.SanityExtractor.focus.no_item"
        }
    },
    "SanityExtractorResetHitCount": {
        "desc": "收尾时清掉本轮命中计数，避免遗留到下一次任务",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClearHitCount",
                "custom_action_param": {
                    "nodes": [
                        "SanityExtractorRoundGate"
                    ],
                    "strict": false
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SanityExtractorFinished"
        ]
    },
    "SanityExtractorFinished": {
        "desc": "萃取任务结束",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Action.Starting": "$task.SanityExtractor.focus.finish"
        }
    }
}
