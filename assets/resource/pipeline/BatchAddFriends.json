                    375,
                    121,
                    17
                ],
                "expected": [
                    "未搜索到相关玩家",
                    "未搜尋到相關玩家",
                    "(?i)No\\s*matching\\s*players\\s*found",
                    "当該プレイヤーが見つかりませんでした"
                ],
                "threshold": 0.7
            }
        },
        "action": {
            "type": "Custom",
            "param": {
