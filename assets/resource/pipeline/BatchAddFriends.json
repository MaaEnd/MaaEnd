        ],
        "next": [
            "BatchAddFriendsStrangersResetMenuClose"
        ]
    },
    "BatchAddFriendsStrangersResetMenuClose": {
        "desc": "清理残留菜单时打开的名片：直接关掉，不做任何判定",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "BatchAddFriendsStrangersProfilePage",
                    "BatchAddFriendsStrangersProfileCloseButton"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "pre_wait_freezes": 100,
        "action": {
            "type": "Click",
            "param": {}
        },
        "post_delay": 0,
        "rate_limit": 0,
        "on_error": [
            "BatchAddFriendsStrangersScan"
        ],
        "next": [
            "BatchAddFriendsStrangersStart"
        ]
    },
    "BatchAddFriendsStrangersMenuViewProfile": {
        "desc": "头像菜单里点「查看个人名片」",
        // 菜单是弹在头像附近的上下文菜单，位置随点击点浮动，故 ROI 取宽一些。
        "recognition": {
            "type": "OCR",
            "param": {
                // 菜单跟随被点击的行弹出，纵向位置不固定，因此 ROI 覆盖左侧整片区域。
                // 文案「查看个人名片」足够独特，放宽 ROI 不会误匹配。
                "roi": [
                    2,
                    50,
                    434,
                    639
                ],
                "expected": [
                    // 已核对游戏内文本
                    "查看个人名片",
                    "查看個人名片",
                    "(?i)View\\s*Profile",
                    "個人情報",
                    "개인\\s*명함\\s*보기"
                ]
            }
        },
        "pre_delay": 0,
        "pre_wait_freezes": 100,
        "action": {
            "type": "Click",
            "param": {}
        },
        "post_delay": 0,
        "rate_limit": 0,
        "on_error": [
            "BatchAddFriendsStrangersScan"
        ],
        "next": [
            "BatchAddFriendsStrangersProfileCardOpened"
        ]
    },
    "BatchAddFriendsStrangersProfileCardOpened": {
        "desc": "名片已打开：申请好友按钮与权限等级 LOGO 同时存在",
        // 只用权限等级图标判断容易在淡入过程中误命中，
        // 两个名片独有元素同时命中才认为名片确实打开了。
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "BatchAddFriendsStrangersProfileAddFriend",
                    "BatchAddFriendsStrangersProfileReady"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        // 确认名片已打开后，等左下角信息区域稳定再读等级。
        "post_wait_freezes": {
            "time": 150,
            "target": [
                93,
                262,
                486,
                430
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "on_error": [
            "BatchAddFriendsStrangersProfileFallbackClose"
        ],
        "next": [
            "BatchAddFriendsStrangersProfileAuthorityLevel"
        ]
    },
    "BatchAddFriendsStrangersProfileReady": {
        "desc": "名片页已打开：以「权限等级」图标为标志",
        // 图标只在名片页出现、形状固定
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    150,
                    280,
                    120,
                    60
