        }
    },
    "BatchAddFriendsStrangersStart": {
        "desc": "陌生人批量添加入口：先过数量闸门，未达上限则进入扫描，达到上限直接结束",
        // 陌生人模式的第一个节点。只做数量闸门：还有名额就进 AddStrangersLoop（它带 max_hit），
        // 名额用尽时 max_hit 已满、该节点被跳过，于是落到 StrangersEnd 直接收工。
        // 只有「添加成功」这条回路会再次经过这里，所以名额只被真正添加消耗。
        "recognition": "DirectHit",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "BatchAddFriendsAddStrangersLoop",
            "BatchAddFriendsStrangersEnd"
        ]
    },
    "BatchAddFriendsAddStrangersLoop": {
        "desc": "陌生人添加计数并驱动扫描；命中一次代表本次添加占用一个名额，上限由任务选项注入",
        // 计数节点，max_hit 由 Go 的 BatchAddFriendsAction 按 MaxCount 注入。
        // 只有「添加成功」会回到本节点，因此一次命中就代表加到了一个人。
        // 挑到人就进 PickRow，挑不到就换一批。
        "recognition": "DirectHit",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "BatchAddFriendsStrangersPickRow",
            "BatchAddFriendsChangeBatch"
        ]
    },
    "BatchAddFriendsStrangersScan": {
        "desc": "拒绝/换批后的再扫描调度：不经过计数节点，因此不消耗添加名额",
        // 不计数的调度节点：被拒绝或换一批之后从这里重新开始扫描。
        // 与 AddStrangersLoop 的唯一区别是它不在计数回路上，因此不消耗名额。
        "recognition": "DirectHit",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "BatchAddFriendsStrangersPickRow",
            "BatchAddFriendsChangeBatch"
        ]
    },
    "BatchAddFriendsStrangersOnAdd": {
        "desc": "陌生人添加进度",
        // Go 侧记录进度（BatchAddFriendsStrangersOnAddAction）后回到计数节点，形成添加回路。
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "BatchAddFriendsStrangersOnAddAction"
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "BatchAddFriendsAddStrangersLoop",
            "BatchAddFriendsStrangersEnd"
        ]
    },
    "BatchAddFriendsStrangersAddButtonColumn": {
        "desc": "陌生人列表按钮列：命中项即「可添加」的行，order_by 保证取最上面那行",
        // 已申请过的行按钮会变成「等待接受」，不匹配 expected，天然被排除。
        // 本节点只负责定位行，不点击；点击点由 PickRow 识别器换算成头像坐标。
        "recognition": {
            "type": "OCR",
            "param": {
                // 高度覆盖到最底一行：收窄 ROI 会漏掉第 5 个人。
                "roi": [
                    1145,
                    145,
                    135,
                    470
                ],
                "expected": [
                    // 已核对游戏内文本
                    "添加好友",
                    "新增好友",
                    "(?i)Add\\s*Friend",
                    "フレンド追加",
                    "친구\\s*추가"
                ],
                "order_by": "Vertical"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "BatchAddFriendsStrangersPickRow": {
        "desc": "挑选最上面一个「未被拒绝」的可添加行，点击其头像展开菜单",
        // 识别器内部会：跑按钮列 OCR → 跳过黑名单里的行 → 返回该行头像的点击框。
        // 黑名单按「按钮框 y」记录（列表不滚动，位置稳定），换一批时清空。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "BatchAddFriendsStrangersPickRowRecognition"
            }
        },
        "pre_delay": 0,
        "pre_wait_freezes": 100,
        "action": {
            "type": "Click",
            "param": {}
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "BatchAddFriendsStrangersMenuViewProfile"
        ],
        "on_error": [
            "BatchAddFriendsChangeBatch"
        ]
    },
    "BatchAddFriendsStrangersResetMenuProbe": {
        "desc": "开局清理：判断列表页是否残留二级菜单",
        // 任务开始时列表可能残留上一次留下的头像菜单。此时点头像只会关闭菜单，
        // 后续点击与识别全部错位。这里只做一次判断，不点击。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    2,
                    50,
                    434,
                    639
                ],
                "expected": [
                    // 已核对游戏内文本
                    "查看个人名片",
                    "查看個人名片",
                    "(?i)View\\s*Profile",
                    "個人情報",
                    "개인\\s*명함\\s*보기"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "post_delay": 0,
        "rate_limit": 0,
        "on_error": [
            "BatchAddFriendsStrangersStart"
        ],
        "next": [
            "BatchAddFriendsStrangersResetMenuOpen"
        ]
    },
    "BatchAddFriendsStrangersResetMenuOpen": {
        "desc": "点残留菜单里的「查看个人名片」，进入名片页",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    2,
                    50,
                    434,
                    639
                ],
                "expected": [
                    "查看个人名片",
                    "查看個人名片",
                    "(?i)View\\s*Profile",
                    "個人情報",
                    "개인\\s*명함\\s*보기"
