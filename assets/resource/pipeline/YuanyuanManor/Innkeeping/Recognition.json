        "desc": "在营业设定界面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    200,
                    60
                ],
                "expected": [
                    "营业设定",
                    "(?i)Inn\\s*Settings",
                    "営業管理",
