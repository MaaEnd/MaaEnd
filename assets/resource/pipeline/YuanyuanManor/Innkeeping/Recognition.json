    "InnkeepingInThemeSetting": {
        "desc": "在主题设定界面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    200,
                    60
                ],
                "expected": [
                    "主题设定",
                    "主題設定",
                    "(?i)Theme\\s*Settings",
                    "テーマ設定",
                    "테마 설정"
                ]
            }
        }
    },
    "InnkeepingPatronCount": {
        "desc": "右上角客源数量",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1083,
                    15,
                    111,
                    29
                ],
                // 完整数值格式为当前客源/客源上限，例如 310/1000。
                "expected": [
                    // @i18n-skip
                    "^\\s*[0-9]+\\s*/\\s*[0-9]+\\s*$"
                ]
            }
        }
    },
