    // =========================================================================
    // 寻路至缘缘庄客栈，进入客栈经营界面
    // =========================================================================
    "YuanyuanManorGotoTheInnStart": {
        "desc": "开始导航到缘缘庄客栈",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SubTask",
                "custom_action_param": {
                    "sub": [
                        "YuanyuanManorQuickTeleportStart"
                    ]
                }
            }
        },
        "post_delay": 0,
        "next": [
            "YuanyuanManorGotoTheInn"
        ]
    },
    "YuanyuanManorGotoTheInn": {
        "desc": "导航到缘缘庄客栈",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "MapNavigateAction",
                "custom_action_param": {
                    "heading_source": "camera",
                    "path": [
                        {
                            "action": "NAVMESH",
                            "target": [
                                142.6,
                                138.01
                            ],
                            "target_tier": "Wuling_L10_468"
                        }
                    ]
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 100,
        "next": [
            "YuanyuanManorOpenTheInn"
        ]
    },
    "YuanyuanManorOpenTheInn": {
        "desc": "点击「开始经营」",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "YuanyuanManorOpenTheInnButton"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilNotFoundAction",
                "custom_action_param": {
                    "custom_action": "AutoAltClickAction",
                    "wait_node": "InWorld"
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 100,
        "next": [
            "YuanyuanManorOpenTheInnSuccess"
        ]
    },
    "YuanyuanManorOpenTheInnSuccess": {
        "desc": "点击「开始经营」成功，进入主题设定界面",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InnkeepingInThemeSetting"
                ]
            }
        },
        "pre_wait_freezes": {
            "time": 80,
            "target": [
                0,
                0,
                0,
                0
            ]
        },
        "pre_delay": 0,
        "post_delay": 0
    },
