    "YuanyuanManorEnterMenuInnkeeping": {
        "desc": "从任意界面进入客栈经营-主题设定",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "YuanyuanManorOpenTheInnSuccess",
            "YuanyuanManorOpenTheInn",
            "YuanyuanManorGotoTheInnStart"
        ]
    },
    "YuanyuanManorEnterMenuPantryShop": {
        "desc": "从任意界面进入堂头小铺",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "YuanyuanManorEnterPantryShopSuccess",
