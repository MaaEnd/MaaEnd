        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RestaurantOpenKitchenPanel"
        ]
    },
    // 720p 固定派单按钮坐标；最多点击 10 次（默认间隔 3 秒），覆盖约 30 秒加载动画。
    "RestaurantOpenKitchenPanel": {
        "desc": "在经营中反复点击派单位置，直到面板就绪或游戏结束。",
        "recognition": "And",
        "all_of": [
            "RestaurantBusinessStarted"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "RepeatUntilFoundAction",
        "custom_action_param": {
            "custom_action": "AutoAltClickAction",
            "wait_nodes": [
                "RestaurantKitchenPanelReady",
                "RestaurantGameEnded"
            ],
            "repeat_count": 10
        },
        "target": [
            867,
            630
        ],
        "post_wait_freezes": {
            "time": 350,
            "target": [
                140,
                140,
                1000,
                470
            ],
            "timeout": 3000
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RestaurantGameEnded",
            "RestaurantKitchenPanelReady"
        ],
        "on_error": [
            "FailedNode"
        ],
        "focus": {
            "Node.Action.Starting": "$task.YuanyuanManor.focus.business_started"
        }
    },
