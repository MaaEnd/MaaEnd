{
    "AutoSellMain": {
        "desc": "初始化自动售卖会话，再由 Pipeline 依次执行三轮",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "AutoSellSession",
        "custom_action_param": {
            "operation": "reset"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoSellRecordRound"
        ]
    },
    "AutoSellRecordRound": {
        "desc": "第一轮：只记录所有启用地区的本家物资价格",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]AutoSellScanValleyIVMain",
            "[JumpBack]AutoSellScanWulingMain",
            "AutoSellFriendsRound"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$task.AutoSell.record_round"
        }
    },
    "AutoSellFriendsRound": {
        "desc": "第二轮：按阈值和本家价格筛选好友出售",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]AutoSellExecuteValleyIVMain",
            "[JumpBack]AutoSellExecuteWulingMain",
            "AutoSellOwnRound"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$task.AutoSell.friends_round"
        }
    },
    "AutoSellOwnRound": {
        "desc": "第三轮：在本家处理第二轮未出售的物资",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]AutoSellOwnValleyIVMain",
            "[JumpBack]AutoSellOwnWulingMain",
            "AutoSellFinish"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$task.AutoSell.own_round"
        }
    },
    "AutoSellExecuteValleyIVMain": {
        "desc": "第二轮：四号谷地好友售卖",
        "max_hit": 1,
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "AutoSellSession",
        "custom_action_param": {
            "operation": "begin",
            "region": "ValleyIV",
            "moderate_price": 4600,
            "large_price": 5000,
            "massive_price": 5300
        },
        "anchor": {
            "AutoSellItemLoop": "AutoSellFriendsLoop",
            "AutoSellItemDetail": "AutoSellSellGoodsOpenSuccess",
            "AutoSellOwnRegionEntry": "AutoSellEnterOwnValleyIV",
            "AutoSellTicketOverflow": "AutoSellTicketValleyIVOverflow"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoSellFriendsUnavailable",
            "[Anchor]AutoSellOwnRegionEntry"
        ]
    },
    "AutoSellOwnValleyIVMain": {
        "desc": "第三轮：四号谷地本家售卖",
        "max_hit": 1,
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "AutoSellSession",
        "custom_action_param": {
            "operation": "begin",
            "region": "ValleyIV"
        },
        "anchor": {
            "AutoSellItemLoop": "AutoSellOwnLoop",
            "AutoSellItemDetail": "AutoSellOwnDetail",
            "AutoSellOwnRegionEntry": "AutoSellEnterOwnValleyIV",
            "AutoSellTicketOverflow": "AutoSellTicketValleyIVOverflow"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[Anchor]AutoSellOwnRegionEntry"
        ]
    },
    "AutoSellExecuteWulingMain": {
        "desc": "第二轮：武陵好友售卖",
        "max_hit": 1,
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "AutoSellSession",
        "custom_action_param": {
            "operation": "begin",
            "region": "Wuling",
            "moderate_price": 4600,
            "large_price": 5000,
            "massive_price": 5300
        },
        "anchor": {
            "AutoSellItemLoop": "AutoSellFriendsLoop",
            "AutoSellItemDetail": "AutoSellSellGoodsOpenSuccess",
            "AutoSellOwnRegionEntry": "AutoSellEnterOwnWuling",
            "AutoSellTicketOverflow": "AutoSellTicketWulingOverflow"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoSellFriendsUnavailable",
            "[Anchor]AutoSellOwnRegionEntry"
        ]
    },
    "AutoSellOwnWulingMain": {
        "desc": "第三轮：武陵本家售卖",
        "max_hit": 1,
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "AutoSellSession",
        "custom_action_param": {
            "operation": "begin",
            "region": "Wuling"
        },
        "anchor": {
            "AutoSellItemLoop": "AutoSellOwnLoop",
            "AutoSellItemDetail": "AutoSellOwnDetail",
            "AutoSellOwnRegionEntry": "AutoSellEnterOwnWuling",
            "AutoSellTicketOverflow": "AutoSellTicketWulingOverflow"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[Anchor]AutoSellOwnRegionEntry"
        ]
    },
    "AutoSellFinish": {
        "desc": "三轮售卖结束",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
