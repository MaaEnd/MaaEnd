{
    "AutoSellBudgetPrice": {
        "desc": "按预算售卖：读当前物品售价写入 IMS；读不到时由上一层 next 回退固定数量",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoSellOwnPriceRecognition"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SetItemQuantity",
                "custom_action_param": {
                    "item": "scratch_autosell_budget_price"
                }
            }
        },
        "next": [
            "AutoSellBudgetBalance"
        ]
    },
    "AutoSellBudgetBalance": {
        "desc": "按预算售卖：读当前调度券余额写入 IMS",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoSellOwnTicketCountRecognition"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SetItemQuantity",
                "custom_action_param": {
                    "item": "scratch_autosell_budget_balance"
                }
            }
        },
        "next": [
            "AutoSellBudgetLimit"
        ]
    },
    "AutoSellBudgetLimit": {
        "desc": "按预算售卖：写入目标余额 45000000",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SetItemQuantity",
                "custom_action_param": {
                    "item": "scratch_autosell_budget_limit",
                    "value": 45000000
                }
            }
        },
        "next": [
            "AutoSellBudgetPriceGuard"
        ]
    },
    "AutoSellBudgetPriceGuard": {
        "desc": "按预算售卖：单价必须 ≥1，避免除以 0 直接失败",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ItemQuantitySatisfied",
                "custom_recognition_param": {
                    "expression": "{scratch_autosell_budget_price} >= 1"
                }
            }
        },
        "next": [
            "AutoSellBudgetQuantity"
        ]
    },
    "AutoSellBudgetQuantity": {
        "desc": "按预算售卖：算出售卖数量 floor((目标余额 - 余额) / 单价)，再按每档 32 件向下取整",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SetItemQuantity",
                "custom_action_param": {
                    "item": "scratch_autosell_budget_quantity",
                    "value": "(({scratch_autosell_budget_limit}-{scratch_autosell_budget_balance})/{scratch_autosell_budget_price})/32*32"
                }
            }
        },
        "next": [
            "AutoSellBudgetDispatch"
        ]
    },
    "AutoSellBudgetDispatch": {
        "desc": "按预算售卖：数量派发；每档 32 件、共 10 档（PipelineOverride 只能写静态值），改步长要同步增删分支",
        "next": [
            "AutoSellBudgetSkip",
            "AutoSellBudgetClamp",
            "AutoSellBudgetQuantity032",
            "AutoSellBudgetQuantity064",
            "AutoSellBudgetQuantity096",
            "AutoSellBudgetQuantity128",
            "AutoSellBudgetQuantity160",
            "AutoSellBudgetQuantity192",
            "AutoSellBudgetQuantity224",
            "AutoSellBudgetQuantity256",
            "AutoSellBudgetQuantity288",
            "AutoSellBudgetQuantity320"
        ]
    },
    "AutoSellBudgetSkip": {
        "desc": "按预算售卖：余额已到目标（或不足一档），不售卖，关闭面板结束该物品",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ItemQuantitySatisfied",
                "custom_recognition_param": {
                    "expression": "{scratch_autosell_budget_quantity} <= 0"
                }
            }
        },
        "next": [
            "AutoSellFriendsPricesBackToView0"
        ]
    },
    "AutoSellBudgetClamp": {
        "desc": "按预算售卖：需求超过单件上限 320，按上限售卖",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ItemQuantitySatisfied",
                "custom_recognition_param": {
                    "expression": "{scratch_autosell_budget_quantity} > 320"
                }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PipelineOverride",
                "custom_action_param": {
                    "patch": {
                        "AutoSellFriendsPricesExpectedBuySlide": {
                            "attach": {
                                "TargetQuantity": 320
                            }
                        }
                    }
                }
            }
        },
        "next": [
            "AutoSellFriendsPricesExpectedBuySlide"
        ]
    },
    "AutoSellBudgetQuantity032": {
