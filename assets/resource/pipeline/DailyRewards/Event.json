{
    "DailyEventStart": {
        "desc": "每日奖励活动入口",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "DailyEventEnterMenu",
            "[JumpBack]SceneEnterMenuEvent"
        ]
    },
    "DailyEventEnterMenu": {
        "desc": "进入活动界面",
        "recognition": "And",
        "all_of": [
            "InEventCenter"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]DailyEventGoToHongYun", //宏运连连乐不依赖红点,所以不会进入通用识别中
            "[JumpBack]DailyEventGoTo",
            "[JumpBack]DailyEventSwipe",
            "DailyEventFinish"
        ]
    },
    "DailyEventGoTo": {
        "desc": "进入未读活动（动态识别入口名）",
        "recognition": "Custom",
        "custom_recognition": "DailyEventGoToRecognition",
        "action": "Click",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DailyEventUnreadLimitedTimeSignin",
            "DailyEventUnreadWeeklyRoutine",
            "DailyEventUnreadGuideEvent",
            "DailyEventUnreadChallengeEvent",
            "DailyEventUnreadSpaceExplorationEvent",
            "DailyEventUnreadLimitedTimeEvent",
            "DailyEventUnreadUnknown"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "进入未读活动"
        }
    },
    "DailyEventSwipe": {
        "desc": "滑动一次",
        "max_hit": 1,
        "recognition": "And",
        "all_of": [
            "InEventCenter"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "action": "Swipe",
        "post_wait_freezes": 350,
        "begin": [
            100,
            600
        ],
        "end": [
            [
                100,
                200
            ],
            [
                400,
                200
            ]
        ],
        "end_hold": 100
    },
    "DailyEventFinish": {
        "desc": "结束任务",
        "focus": {
            "Node.Recognition.Succeeded": "领取活动奖励结束"
        }
    },
    "DailyEventGoToUnreadItem": {
        "desc": "进入常规未读活动",
        "recognition": "Or",
        "any_of": [
            "DailyEventRecognitionRedDot",
            "DailyEventRecognitionNew"
        ],
        "action": "Click",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DailyEventUnreadItemSwitch"
        ]
    },
    "DailyEventUnreadItemInit": {
        "desc": "领取常规未读活动",
        "recognition": "Custom",
        "custom_recognition": "DailyEventUnreadItemInitRecognition",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "DailyEventUnreadItemInitAction",
        "post_delay": 0
    },
    "DailyEventUnreadItemSwitch": {
        "desc": "切换未处理的活动列表",
        "recognition": "OCR",
        "roi": "DailyEventGoToUnreadItem",
        "roi_offset": [
            -161,
            5,
            160,
            38
        ],
        "expected": [
            ".{3,}" // 匹配三个及以上字符
        ],
        "pre_delay": 0,
        "action": "Click",
        "target_offset": [
            10,
            0,
            -10,
            0
        ],
        "next": [
            "DailyEventUnreadItemSwitchSuccess"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "切换活动"
        }
    },
    "DailyEventUnreadItemSwitchSuccess": {
        "desc": "切换活动成功",
        "recognition": "And",
        "all_of": [
            {
                "recognition": "TemplateMatch",
                "roi": "DailyEventUnreadItemSwitch",
                "roi_offset": [
                    -20,
                    -30,
                    20,
                    55
                ],
                // 注意文字可能是一行或两行，因此roi_offset要稍微高一点
                "template": "DailyRewards/Event/EventSwitchSuccess.png",
                "threshold": 0.9
            },
            {
                "recognition": "TemplateMatch",
                "roi": [
                    -200,
                    0,
                    200,
                    200
                ],
                "template": "DailyRewards/Event/EventDetailsIcon.png",
                "green_mask": true
            }
        ],
        "box_index": 1,
        "pre_wait_freezes": 100,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "DailyEventUnreadHongYun",
            "DailyEventUnreadLimitedTimeSignin",
            "DailyEventUnreadWeeklyRoutine",
            "DailyEventUnreadGuideEvent",
            "DailyEventUnreadChallengeEvent",
            "DailyEventUnreadSpaceExplorationEvent",
            "DailyEventUnreadLimitedTimeEvent",
            "DailyEventUnreadUnknown"
        ]
    },
    "DailyEventUnreadUnknown": {
        "desc": "跳过未支持的活动",
        "pre_delay": 0,
        "post_delay": 0,
        "focus": {
            "Node.Recognition.Succeeded": "跳过未支持的活动"
        }
    },
    "DailyEventRecognitionRedDot": {
        "desc": "识别活动界面的红点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    0,
                    300,
                    666
                ],
                "template": [
                    "DailyRewards/EventRedDot.png"
                ],
                "green_mask": true
            }
        }
    },
    "DailyEventRecognitionNew": {
        "desc": "识别活动界面的新提示",
        "recognition": "OCR",
        "roi": [
            0,
            0,
            300,
            666
        ],
        "expected": [
            "NEW"
        ]
    },
    "DailyEventRecognitionUnread": {
        "desc": "识别活动列表未读标记（红点或NEW）",
        "recognition": "Or",
        "any_of": [
            "DailyEventRecognitionRedDot",
            "DailyEventRecognitionNew"
        ]
    },
    "DailyEventRecognitionItemText": {
        "desc": "识别活动列表入口名（至少3字，可由 Go 覆盖 expected 排除已访问）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    300,
                    666
                ],
                "expected": [
                    ".{3,}" // 匹配三个及以上字符
                ],
                "threshold": 0.7
            }
        }
    },
    "DailyEventRecognitionEntryRedDot": {
        "desc": "入口名附近的红点",
        "recognition": "TemplateMatch",
        "roi": "DailyEventRecognitionItemText",
        "roi_offset": [
            0,
            -20,
            120,
            55
        ],
        "template": [
            "DailyRewards/EventRedDot.png"
        ],
        "green_mask": true
    },
    "DailyEventRecognitionEntryNew": {
        "desc": "入口名附近的NEW",
        "recognition": "OCR",
        "roi": "DailyEventRecognitionItemText",
        "roi_offset": [
            0,
            -20,
            120,
            55
        ],
        "expected": [
            "NEW"
        ]
    },
    "DailyEventRecognitionEntryUnread": {
        "desc": "入口名附近未读标记（红点或NEW）",
        "recognition": "Or",
        "any_of": [
            "DailyEventRecognitionEntryRedDot",
            "DailyEventRecognitionEntryNew"
        ]
    },
    "DailyEventGoToCandidate": {
        "desc": "未读活动入口候选：入口名 ∧ 附近未读标记",
        "recognition": "And",
        "all_of": [
            "DailyEventRecognitionItemText",
            "DailyEventRecognitionEntryUnread"
        ],
        "box_index": 0
    },
    "DailyEventRecognitionGotoButton": {
        "desc": "识别活动界面是前往按钮",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "前往",
                    "Go",
                    "移動",
                    "바로가기"
                ]
            }
        }
    }
}
