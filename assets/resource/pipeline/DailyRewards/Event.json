{
    "DailyEventStart": {
        "desc": "每日奖励活动入口",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "DailyEventEnterMenu",
            "[JumpBack]SceneEnterMenuEvent"
        ]
    },
    "DailyEventEnterMenu": {
        "desc": "进入活动界面",
        "recognition": "And",
        "all_of": [
            "InEventCenter"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]DailyEventGoToHongYun", // 宏运连连乐不依赖红点,所以不会进入通用识别中
            "[JumpBack]DailyEventGoTo",
            "[JumpBack]DailyEventSwipe",
            "DailyEventFinish"
        ]
    },
    "DailyEventGoTo": {
        "desc": "进入未读活动（动态识别入口名）",
        "recognition": "Custom",
        "custom_recognition": "DailyEventGoToRecognition",
        "action": "Click",
        "attach": {
            "visited": []
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "post_wait_freezes": 200,
        "next": [
            "DailyEventUnreadLimitedTimeSignin",
            "DailyEventUnreadWeeklyRoutine",
            "DailyEventUnreadGuideEvent",
            "DailyEventUnreadChallengeEvent",
            "DailyEventUnreadSpaceExplorationEvent",
            "DailyEventUnreadLimitedTimeEvent",
            "DailyEventUnreadUnknown"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "进入未读活动"
        }
    },
    "DailyEventSwipe": {
        "desc": "滑动一次",
        "max_hit": 1,
        "recognition": "And",
        "all_of": [
            "InEventCenter"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "action": "Swipe",
        "post_wait_freezes": 350,
        "begin": [
            100,
            600
        ],
        "end": [
            [
                100,
                200
            ],
            [
                400,
                200
            ]
        ],
        "end_hold": 100
    },
    "DailyEventFinish": {
        "desc": "结束任务",
        "focus": {
            "Node.Recognition.Succeeded": "领取活动奖励结束"
        }
    },
    "DailyEventUnreadUnknown": {
        "desc": "跳过未支持的活动",
        "pre_delay": 0,
        "post_delay": 0,
        "focus": {
            "Node.Recognition.Succeeded": "跳过未支持的活动"
        }
    },
    "DailyEventRecognitionRedDot": {
        "desc": "识别活动界面的红点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    0,
                    300,
                    666
                ],
                "template": [
                    "DailyRewards/EventRedDot.png"
                ],
                "green_mask": true
            }
        }
    },
    "DailyEventRecognitionNew": {
        "desc": "识别活动界面的新提示",
        "recognition": "OCR",
        "roi": [
            0,
            0,
            300,
            666
        ],
        "expected": [
            "NEW"
        ]
    },
    "DailyEventRecognitionUnread": {
        "desc": "识别活动列表未读标记（红点或NEW）",
        "recognition": "Or",
        "any_of": [
            "DailyEventRecognitionRedDot",
            "DailyEventRecognitionNew"
        ]
    },
    "DailyEventRecognitionItemText": {
        "desc": "识别活动列表入口名（至少3字，可由 Go 覆盖 expected 排除已访问）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "DailyEventRecognitionUnread",
                "roi_offset": [
                    -161,
                    5,
                    160,
                    38
                ],
                "expected": [
                    ".{3,}" // 匹配三个及以上字符
                ],
                "threshold": 0.7
            }
        }
    },
    "DailyEventGoToCandidate": {
        "desc": "未读活动入口候选：未读标记 ∧ 左侧入口名",
        "recognition": "And",
        "all_of": [
            "DailyEventRecognitionUnread",
            "DailyEventRecognitionItemText"
        ],
        "box_index": 1
    }
}
