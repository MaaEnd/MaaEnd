{
    "SyncItemData": {
        "desc": "IMS A2 入口：业务侧只需调用本节点。首次成功后 Resource 级关闭 SyncItemDataBegin，同 Resource 后续调用走 Skipped",
        "max_hit": 1,
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SyncItemDataBegin",
            "SyncItemDataSkipped"
        ]
    },
    "SyncItemDataBegin": {
        "desc": "A2 实际执行入口：进入贵重品库培养素材页并同步；成功后由 SyncItemDataLock 关闭本节点",
        "enabled": true,
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SyncItemDataInProgressionTab",
            "[JumpBack]SceneEnterMenuValuablesProgressionTab"
        ],
        "focus": {
            "Node.Action.Starting": "即将进入贵重品库培养素材页并同步物品数据"
        }
    },
    "SyncItemDataSkipped": {
        "desc": "本次 Resource 已同步过培养道具缓存，跳过 A2",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [],
        "focus": {
            "Node.Recognition.Succeeded": "本次运行已同步过培养道具缓存，跳过 A2"
        }
    },
    "SyncItemDataInProgressionTab": {
        "desc": "确认已在培养素材页，执行缓存更新",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InStashProgressionTab"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SyncItemDataRun"
        ]
    },
    "SyncItemDataRun": {
        "desc": "IMS A2：items 为字典（键=物品 ID，值=And 识别节点）；page_dedup=true 时覆盖已有数量",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SyncItemData",
                "custom_action_param": {
                    "items": {
                        "ADVANCED_COGNITIVE_CARRIER": "ADVANCED_COGNITIVE_CARRIER",
                        "ELEMENTARY_COGNITIVE_CARRIER": "ELEMENTARY_COGNITIVE_CARRIER",
                        "ADVANCED_COMBAT_RECORD": "ADVANCED_COMBAT_RECORD",
                        "INTERMEDIATE_COMBAT_RECORD": "INTERMEDIATE_COMBAT_RECORD",
                        "ELEMENTARY_COMBAT_RECORD": "ELEMENTARY_COMBAT_RECORD",
                        "MARK_OF_PERSEVERANCE": "MARK_OF_PERSEVERANCE",
                        "PROTOSET": "PROTOSET",
                        "PROTODISK": "PROTODISK",
                        "TRIPHASIC_NANOFLAKE": "TRIPHASIC_NANOFLAKE",
                        "QUADRANT_FITTING_FLUID": "QUADRANT_FITTING_FLUID",
                        "TACHYON_SCREENING_LATTICE": "TACHYON_SCREENING_LATTICE",
                        "D96_STEEL_SAMPLE_4": "D96_STEEL_SAMPLE_4",
                        "METADIASTIMA_PHOTOEMISSION_TUBE": "METADIASTIMA_PHOTOEMISSION_TUBE",
                        "PROTOHEDRON": "PROTOHEDRON",
                        "PROTOPRISM": "PROTOPRISM",
                        "T_CREDS": "T_CREDS_NUMBER",
                        "ARMS_INSP_SET": "ARMS_INSP_SET",
                        "ARMS_INSP_KIT": "ARMS_INSP_KIT",
                        "ARMS_INSPECTOR": "ARMS_INSPECTOR",
                        "HEAVY_CAST_DIE": "HEAVY_CAST_DIE",
                        "CAST_DIE": "CAST_DIE",
                        "COOLANT_GEL": "COOLANT_GEL",
                        "WULING_ARTIFICING_CATALYST": "WULING_ARTIFICING_CATALYST"
                    },
                    "page_dedup": false
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SyncItemDataLock"
        ],
        "focus": {
            "Node.Action.Succeeded": "物品数据同步完成",
            "Node.Action.Failed": "物品数据同步失败"
        }
    },
    "SyncItemDataLock": {
        "desc": "A2 成功后 Resource 级关闭 SyncItemDataBegin，同 Resource 内不再扫库（不恢复）",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PipelineOverride",
                "custom_action_param": {
                    "resource_override": true,
                    "patch": {
                        "SyncItemDataBegin": {
                            "enabled": false
                        }
                    }
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [],
        "focus": {
            "Node.Action.Succeeded": "已关闭本次运行的 A2 入口，后续 IMS 任务将跳过缓存同步"
        }
    }
}
