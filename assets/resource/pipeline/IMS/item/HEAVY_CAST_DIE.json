{
    "HEAVY_CAST_DIE": {
        "desc": "重型强固模具",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "IMSItemColorPurple",
                    "__HEAVY_CAST_DIE_TEMPLATE",
                    "HEAVY_CAST_DIE_COUNT"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__HEAVY_CAST_DIE_TEMPLATE": {
        "desc": "IMS:重型强固模具模版匹配(roi 基于品质色)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "IMSItemColorPurple",
                "roi_offset": [
                    -30,
                    -100,
                    60,
                    100
                ],
                "template": [
                    "IMS/item/HEAVY_CAST_DIE_TEMPLATE.png"
                ],
                "green_mask": true,
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "HEAVY_CAST_DIE_COUNT": {
        "desc": "IMS:重型强固模具数量(灰色文字 And OCR；box_index 指向 OCR)",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__HEAVY_CAST_DIE_COUNT_TEXT_COLOR",
                    "HEAVY_CAST_DIE_COUNT_OCR"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__HEAVY_CAST_DIE_COUNT_TEXT_COLOR": {
        "desc": "IMS:重型强固模具数量灰色文字(roi 基于模板)",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__HEAVY_CAST_DIE_TEMPLATE",
                "roi_offset": [
                    0,
                    78,
                    0,
                    -64
                ],
                "lower": [
                    74,
                    74,
                    74
                ],
                "upper": [
                    119,
                    145,
                    157
                ],
                "count": 10
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "HEAVY_CAST_DIE_COUNT_OCR": {
        "desc": "IMS:重型强固模具数量 OCR（纯数字）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__HEAVY_CAST_DIE_COUNT_TEXT_COLOR",
                "roi_offset": [
                    -6,
                    -2,
                    12,
                    4
                ],
                "expected": [
                    "^\\d+$"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
