{
    "T_CREDS": {
        "desc": "IMS A3 物品:折金票(紫色品质；品质色 → 模板 → 数量；仅 AddItemData 注册；box_index 指向数量 And)",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "IMSItemColorPurple",
                    "__T_CREDS_TEMPLATE",
                    "T_CREDS_COUNT"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__T_CREDS_TEMPLATE": {
        "desc": "IMS A3:折金票模版匹配(roi 基于品质色)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "IMSItemColorPurple",
                "roi_offset": [
                    -30,
                    -100,
                    60,
                    100
                ],
                "template": [
                    "IMS/item/T_CREDS_TEMPLATE.png"
                ],
                "green_mask": true,
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "T_CREDS_COUNT": {
        "desc": "IMS A3:折金票数量(灰色文字 And OCR；box_index 指向 OCR)",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__T_CREDS_COUNT_TEXT_COLOR",
                    "T_CREDS_COUNT_OCR"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__T_CREDS_COUNT_TEXT_COLOR": {
        "desc": "IMS A3:折金票数量灰色文字(roi 基于模板)",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__T_CREDS_TEMPLATE",
                "roi_offset": [
                    0,
                    78,
                    0,
                    -64
                ],
                "lower": [
                    74,
                    74,
                    74
                ],
                "upper": [
                    119,
                    145,
                    157
                ],
                "count": 10
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "T_CREDS_COUNT_OCR": {
        "desc": "IMS A3:折金票数量 OCR（非0数字开头；支持小数/万等缩写，由 Go 解析）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__T_CREDS_COUNT_TEXT_COLOR",
                "roi_offset": [
                    -6,
                    -2,
                    12,
                    4
                ],
                "expected": [
                    "^[1-9]"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "T_CREDS_NUMBER": {
        "desc": "IMS A2 折金票数量（非物品卡；右上角白色文字 ColorMatch And OCR；box_index 指向 OCR）",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__T_CREDS_NUMBER_TEXT_COLOR",
                    "T_CREDS_NUMBER_OCR"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__T_CREDS_NUMBER_TEXT_COLOR": {
        "desc": "IMS A2:折金票右上角白色文字 ColorMatch",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    960,
                    0,
                    99,
                    55
                ],
                "lower": [
                    158,
                    158,
                    158
                ],
                "upper": [
                    255,
                    255,
                    255
                ],
                "count": 10
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "T_CREDS_NUMBER_OCR": {
        "desc": "IMS A2:折金票右上角数量 OCR（非0数字开头；支持小数/万等缩写，由 Go 解析）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__T_CREDS_NUMBER_TEXT_COLOR",
                "roi_offset": [
                    -6,
                    -2,
                    12,
                    4
                ],
                "expected": [
                    "^[1-9]"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
