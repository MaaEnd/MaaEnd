{
    "COOLANT_GEL": {
        "desc": "IMS 物品:冷却脂(And；黄色品质；品质色 → 模板 → 数量；box_index 指向数量 And)",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "IMSItemColorYellow",
                    "__COOLANT_GEL_TEMPLATE",
                    "COOLANT_GEL_COUNT"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__COOLANT_GEL_TEMPLATE": {
        "desc": "IMS:冷却脂模版匹配(roi 基于品质色)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "IMSItemColorYellow",
                "roi_offset": [
                    -30,
                    -100,
                    60,
                    100
                ],
                "template": [
                    "IMS/item/COOLANT_GEL_TEMPLATE.png"
                ],
                "green_mask": true,
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "COOLANT_GEL_COUNT": {
        "desc": "IMS:冷却脂数量(灰色文字 And OCR；box_index 指向 OCR)",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__COOLANT_GEL_COUNT_TEXT_COLOR",
                    "COOLANT_GEL_COUNT_OCR"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__COOLANT_GEL_COUNT_TEXT_COLOR": {
        "desc": "IMS:冷却脂数量灰色文字(roi 基于模板)",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__COOLANT_GEL_TEMPLATE",
                "roi_offset": [
                    0,
                    78,
                    0,
                    -64
                ],
                "lower": [
                    74,
                    74,
                    74
                ],
                "upper": [
                    119,
                    145,
                    157
                ],
                "count": 10
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "COOLANT_GEL_COUNT_OCR": {
        "desc": "IMS:冷却脂数量 OCR（纯数字）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__COOLANT_GEL_COUNT_TEXT_COLOR",
                "roi_offset": [
                    -6,
                    -2,
                    12,
                    4
                ],
                "expected": [
                    "^\\d+$"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
