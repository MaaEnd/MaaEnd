{
    "ELEMENTARY_COGNITIVE_CARRIER": {
        "desc": "初级认知载体",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "IMSItemColorPurple",
                    "__ELEMENTARY_COGNITIVE_CARRIER_TEMPLATE",
                    "ELEMENTARY_COGNITIVE_CARRIER_COUNT"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__ELEMENTARY_COGNITIVE_CARRIER_TEMPLATE": {
        "desc": "IMS:初级认知载体模版匹配(roi 基于品质色)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "IMSItemColorPurple",
                "roi_offset": [
                    -30,
                    -100,
                    60,
                    100
                ],
                "template": [
                    "IMS/item/ELEMENTARY_COGNITIVE_CARRIER_TEMPLATE.png"
                ],
                "green_mask": true,
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "ELEMENTARY_COGNITIVE_CARRIER_COUNT": {
        "desc": "IMS:初级认知载体数量(灰色文字 And OCR；box_index 指向 OCR)",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__ELEMENTARY_COGNITIVE_CARRIER_COUNT_TEXT_COLOR",
                    "ELEMENTARY_COGNITIVE_CARRIER_COUNT_OCR"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__ELEMENTARY_COGNITIVE_CARRIER_COUNT_TEXT_COLOR": {
        "desc": "IMS:初级认知载体数量灰色文字(roi 基于模板)",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__ELEMENTARY_COGNITIVE_CARRIER_TEMPLATE",
                "roi_offset": [
                    0,
                    78,
                    0,
                    -64
                ],
                "lower": [
                    74,
                    74,
                    74
                ],
                "upper": [
                    119,
                    145,
                    157
                ],
                "count": 10
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "ELEMENTARY_COGNITIVE_CARRIER_COUNT_OCR": {
        "desc": "IMS:初级认知载体数量 OCR（纯数字）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__ELEMENTARY_COGNITIVE_CARRIER_COUNT_TEXT_COLOR",
                "roi_offset": [
                    -6,
                    -2,
                    12,
                    4
                ],
                "expected": [
                    "^\\d+$"
                ],
                "only_rec": true
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
