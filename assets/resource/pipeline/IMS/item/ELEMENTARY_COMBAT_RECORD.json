{
    "ELEMENTARY_COMBAT_RECORD": {
        "desc": "IMS 物品:初级作战记录(And；白色品质；box_index 指向数量 OCR)",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "IMSItemColorWhite",
                    "__ELEMENTARY_COMBAT_RECORD_TEMPLATE",
                    "ELEMENTARY_COMBAT_RECORD_COUNT"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__ELEMENTARY_COMBAT_RECORD_TEMPLATE": {
        "desc": "IMS:初级作战记录模版匹配(培养素材页列表区域)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "IMSItemColorWhite",
                "roi_offset": [
                    -5,
                    -100,
                    10,
                    100
                ],
                "template": [
                    "IMS/item/ELEMENTARY_COMBAT_RECORD_TEMPLATE.png"
                ],
                "threshold": 0.85,
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "ELEMENTARY_COMBAT_RECORD_COUNT": {
        "desc": "IMS:初级作战记录数量 OCR",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__ELEMENTARY_COMBAT_RECORD_TEMPLATE",
                "roi_offset": [
                    0,
                    62,
                    0,
                    -34
                ],
                "expected": [
                    "^\\d+$"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
