{
    "PROTOSET": {
        "desc": "协议圆盘组",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "IMSItemColorPurple",
                    "__PROTOSET_TEMPLATE",
                    "PROTOSET_COUNT"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__PROTOSET_TEMPLATE": {
        "desc": "IMS:协议圆盘组模版匹配(roi 基于品质色)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "IMSItemColorPurple",
                "roi_offset": [
                    -30,
                    -100,
                    60,
                    100
                ],
                "template": [
                    "IMS/item/PROTOSET_TEMPLATE.png"
                ],
                "green_mask": true,
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "PROTOSET_COUNT": {
        "desc": "IMS:协议圆盘组数量(灰色文字 And OCR；box_index 指向 OCR)",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__PROTOSET_COUNT_TEXT_COLOR",
                    "PROTOSET_COUNT_OCR"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__PROTOSET_COUNT_TEXT_COLOR": {
        "desc": "IMS:协议圆盘组数量灰色文字(roi 基于模板)",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__PROTOSET_TEMPLATE",
                "roi_offset": [
                    0,
                    78,
                    0,
                    -64
                ],
                "lower": [
                    74,
                    74,
                    74
                ],
                "upper": [
                    119,
                    145,
                    157
                ],
                "count": 10
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "PROTOSET_COUNT_OCR": {
        "desc": "IMS:协议圆盘组数量 OCR（纯数字）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__PROTOSET_COUNT_TEXT_COLOR",
                "roi_offset": [
                    -6,
                    -2,
                    12,
                    4
                ],
                "expected": [
                    "^\\d+$"
                ],
                "only_rec": true
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
