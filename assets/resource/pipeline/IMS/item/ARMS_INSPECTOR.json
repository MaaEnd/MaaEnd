{
    "ARMS_INSPECTOR": {
        "desc": "IMS 物品:武器检查单元(And；绿色品质；box_index 指向数量 OCR)",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "IMSItemColorGreen",
                    "__ARMS_INSPECTOR_TEMPLATE",
                    "ARMS_INSPECTOR_COUNT"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__ARMS_INSPECTOR_TEMPLATE": {
        "desc": "IMS:武器检查单元模版匹配(培养素材页列表区域)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "IMSItemColorGreen",
                "roi_offset": [
                    -5,
                    -100,
                    10,
                    100
                ],
                "template": [
                    "IMS/item/ARMS_INSPECTOR_TEMPLATE.png"
                ],
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "ARMS_INSPECTOR_COUNT": {
        "desc": "IMS:武器检查单元数量 OCR",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__ARMS_INSPECTOR_TEMPLATE",
                "roi_offset": [
                    0,
                    62,
                    0,
                    -34
                ],
                "expected": [
                    "^\\d+$"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
