{
    "INTERMEDIATE_COMBAT_RECORD": {
        "desc": "IMS 物品:中级作战记录(And；绿色品质；品质色 → 模板 → 数量；box_index 指向数量 And)",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "IMSItemColorGreen",
                    "__INTERMEDIATE_COMBAT_RECORD_TEMPLATE",
                    "INTERMEDIATE_COMBAT_RECORD_COUNT"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__INTERMEDIATE_COMBAT_RECORD_TEMPLATE": {
        "desc": "IMS:中级作战记录模版匹配(roi 基于品质色)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "IMSItemColorGreen",
                "roi_offset": [
                    -30,
                    -100,
                    60,
                    100
                ],
                "template": [
                    "IMS/item/INTERMEDIATE_COMBAT_RECORD_TEMPLATE.png"
                ],
                "green_mask": true,
                "threshold": 0.85,
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "INTERMEDIATE_COMBAT_RECORD_COUNT": {
        "desc": "IMS:中级作战记录数量(灰色文字 And OCR；box_index 指向 OCR)",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__INTERMEDIATE_COMBAT_RECORD_COUNT_TEXT_COLOR",
                    "INTERMEDIATE_COMBAT_RECORD_COUNT_OCR"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__INTERMEDIATE_COMBAT_RECORD_COUNT_TEXT_COLOR": {
        "desc": "IMS:中级作战记录数量灰色文字(roi 基于模板)",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__INTERMEDIATE_COMBAT_RECORD_TEMPLATE",
                "roi_offset": [
                    0,
                    78,
                    0,
                    -64
                ],
                "method": 4,
                "lower": [
                    74,
                    74,
                    74
                ],
                "upper": [
                    119,
                    112,
                    107
                ],
                "count": 10
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "INTERMEDIATE_COMBAT_RECORD_COUNT_OCR": {
        "desc": "IMS:中级作战记录数量 OCR（纯数字）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__INTERMEDIATE_COMBAT_RECORD_COUNT_TEXT_COLOR",
                "roi_offset": [
                    -1,
                    -1,
                    2,
                    2
                ],
                "expected": [
                    "^\\d+$"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
