{
    "MARK_OF_PERSEVERANCE": {
        "desc": "IMS 物品:存续的痕迹(And；黄色品质；box_index 指向数量 OCR)",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "IMSItemColorYellow",
                    "__MARK_OF_PERSEVERANCE_TEMPLATE",
                    "MARK_OF_PERSEVERANCE_COUNT"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__MARK_OF_PERSEVERANCE_TEMPLATE": {
        "desc": "IMS:存续的痕迹模版匹配(培养素材页列表区域)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "IMSItemColorYellow",
                "roi_offset": [
                    -5,
                    -100,
                    10,
                    100
                ],
                "template": [
                    "IMS/item/MARK_OF_PERSEVERANCE_TEMPLATE.png"
                ],
                "threshold": 0.85,
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "MARK_OF_PERSEVERANCE_COUNT": {
        "desc": "IMS:存续的痕迹数量 OCR",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__MARK_OF_PERSEVERANCE_TEMPLATE",
                "roi_offset": [
                    0,
                    62,
                    0,
                    -34
                ],
                "expected": [
                    "^\\d+$"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
