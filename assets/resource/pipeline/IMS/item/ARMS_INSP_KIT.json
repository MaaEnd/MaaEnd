{
    "ARMS_INSP_KIT": {
        "desc": "IMS 物品:武器检查装置(And；蓝色品质；品质色 → 模板 → 数量；box_index 指向数量 And)",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "IMSItemColorBlue",
                    "__ARMS_INSP_KIT_TEMPLATE",
                    "ARMS_INSP_KIT_COUNT"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__ARMS_INSP_KIT_TEMPLATE": {
        "desc": "IMS:武器检查装置模版匹配(roi 基于品质色)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "IMSItemColorBlue",
                "roi_offset": [
                    -30,
                    -100,
                    60,
                    100
                ],
                "template": [
                    "IMS/item/ARMS_INSP_KIT_TEMPLATE.png"
                ],
                "green_mask": true,
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "ARMS_INSP_KIT_COUNT": {
        "desc": "IMS:武器检查装置数量(灰色文字 And OCR；box_index 指向 OCR)",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__ARMS_INSP_KIT_COUNT_TEXT_COLOR",
                    "ARMS_INSP_KIT_COUNT_OCR"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__ARMS_INSP_KIT_COUNT_TEXT_COLOR": {
        "desc": "IMS:武器检查装置数量灰色文字(roi 基于模板)",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__ARMS_INSP_KIT_TEMPLATE",
                "roi_offset": [
                    0,
                    78,
                    0,
                    -64
                ],
                "lower": [
                    74,
                    74,
                    74
                ],
                "upper": [
                    119,
                    145,
                    157
                ],
                "count": 10
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "ARMS_INSP_KIT_COUNT_OCR": {
        "desc": "IMS:武器检查装置数量 OCR（纯数字）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__ARMS_INSP_KIT_COUNT_TEXT_COLOR",
                "roi_offset": [
                    -6,
                    -2,
                    12,
                    4
                ],
                "expected": [
                    "^\\d+$"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
