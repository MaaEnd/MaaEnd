{
    "TRIPHASIC_NANOFLAKE": {
        "desc": "三相纳米片",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "IMSItemColorYellow",
                    "__TRIPHASIC_NANOFLAKE_TEMPLATE",
                    "TRIPHASIC_NANOFLAKE_COUNT"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__TRIPHASIC_NANOFLAKE_TEMPLATE": {
        "desc": "IMS:三相纳米片模版匹配(roi 基于品质色)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": "IMSItemColorYellow",
                "roi_offset": [
                    -30,
                    -100,
                    60,
                    100
                ],
                "template": [
                    "IMS/item/TRIPHASIC_NANOFLAKE_TEMPLATE.png"
                ],
                "green_mask": true,
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "TRIPHASIC_NANOFLAKE_COUNT": {
        "desc": "IMS:三相纳米片数量(灰色文字 And OCR；box_index 指向 OCR)",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__TRIPHASIC_NANOFLAKE_COUNT_TEXT_COLOR",
                    "TRIPHASIC_NANOFLAKE_COUNT_OCR"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__TRIPHASIC_NANOFLAKE_COUNT_TEXT_COLOR": {
        "desc": "IMS:三相纳米片数量灰色文字(roi 基于模板)",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "__TRIPHASIC_NANOFLAKE_TEMPLATE",
                "roi_offset": [
                    0,
                    78,
                    0,
                    -64
                ],
                "lower": [
                    74,
                    74,
                    74
                ],
                "upper": [
                    119,
                    145,
                    157
                ],
                "count": 10
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "TRIPHASIC_NANOFLAKE_COUNT_OCR": {
        "desc": "IMS:三相纳米片数量 OCR（纯数字）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__TRIPHASIC_NANOFLAKE_COUNT_TEXT_COLOR",
                "roi_offset": [
                    -6,
                    -2,
                    12,
                    4
                ],
                "expected": [
                    "^\\d+$"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
