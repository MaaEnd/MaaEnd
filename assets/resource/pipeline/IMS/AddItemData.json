{
    "IMSA3MouseMoveReset": {
        "desc": "IMS A3：识别前将鼠标移到左上角，避免遮挡奖励图标；ADB 等触摸资源包覆盖为 DoNothing",
        "pre_delay": 0,
        "action": {
            "type": "TouchMove",
            "param": {
                "target": [
                    0,
                    0,
                    1,
                    1
                ]
            }
        },
        "post_delay": 200,
        "rate_limit": 0
    },
    "AddItemDataOnRewards": {
        "desc": "IMS A3 最佳实践：奖励关闭按钮可见且奖励区静止后，用 IconRecognition(rewards) 识别屏上全部物品并 OCR 数量后累加，再关闭奖励界面",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CloseRewardsButton"
                ]
            }
        },
        "pre_wait_freezes": {
            "target": [
                528,
                299,
                222,
                131
            ],
            "time": 300,
            "threshold": 0.97,
            "timeout": 1500
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AddItemData",
                "custom_action_param": {}
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AddItemDataCloseRewards"
        ]
    },
    "AddItemDataCloseRewards": {
        "desc": "关闭奖励界面（Click CloseRewardsButton）",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CloseRewardsButton"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [],
        "focus": {
            "Node.Action.Starting": "关闭奖励界面"
        }
    }
}
