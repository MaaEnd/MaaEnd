{
    "AddItemDataOnRewards": {
        "desc": "IMS A3 最佳实践模板：奖励关闭按钮可见且奖励区静止后，累加识别到的物品数量，再关闭奖励界面。items 省略时使用 data/IMS/items.json 的 a3 全量清单；业务侧可按需覆盖 items，并替换识别节点（奖励界面 ROI 可能与培养素材页不同）",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CloseRewardsButton"
                ]
            }
        },
        "pre_wait_freezes": {
            "target": [
                528,
                299,
                222,
                131
            ],
            "time": 300,
            "threshold": 0.97,
            "timeout": 1500
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AddItemData",
                "custom_action_param": {}
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AddItemDataCloseRewards"
        ]
    },
    "AddItemDataCloseRewards": {
        "desc": "关闭奖励界面（Click CloseRewardsButton）",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CloseRewardsButton"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [],
        "focus": {
            "Node.Action.Starting": "关闭奖励界面"
        }
    }
}
