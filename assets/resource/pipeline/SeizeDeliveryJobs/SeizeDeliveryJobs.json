        "action": {
            "type": "Click",
            "param": {}
        },
        "next": [
            "SeizeDeliveryJobsSelectWuling"
        ],
        "on_error": [
            "SeizeDeliveryJobsStopTask"
        ]
    },
    "SeizeDeliveryJobsSelectWuling": {
        "desc": "在筛选列表中选择武陵",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    65,
                    523,
                    123,
                    114
                ],
                "expected": [
                    "武陵",
                    "(?i)Wuling",
