    "isSeizeDeliveryJobsExistOldTask": {
        "desc": "已有委托，结束抢单",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1020,
                    210,
                    200,
                    35
                ],
                "expected": [
                    "查看任务",
                    "查看任務",
                    "(?i)View\\s*Mission",
                    "任務確認",
                    "임무 확인"
                ]
            }
        },
        "next": [
            "SeizeDeliveryJobsStopTask"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "手里已经有单了，结束抢单"
        }
    },
    "isSeizeDeliveryJobsExhausted": {
        "desc": "运送委托已满3单，结束抢单",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1030,
                    650,
                    45,
                    40
                ],
                "expected": "3/3"
            }
        },
        "next": [
            "SeizeDeliveryJobsStopTask"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "今天的运送委托已满3单"
        }
    },
    "SeizeDeliveryJobsLoop": {
        "desc": "等待委托列表静止后再进入调度",
        "pre_wait_freezes": {
            "time": 2000,
            "target": [
                29,
                166,
                1222,
                481
            ]
        },
        "next": [
            "SeizeDeliveryJobsFindTarget",
            "[JumpBack]SeizeDeliveryJobsFindTargetIndex0",
            "[JumpBack]SeizeDeliveryJobsFindTargetIndex1",
            "[JumpBack]SeizeDeliveryJobsFindTargetIndex2",
            "[JumpBack]SeizeDeliveryJobsFindTargetIndex3",
            "[JumpBack]SeizeDeliveryJobsFindTargetIndex4",
            "SeizeDeliveryJobsRefresh"
        ]
    },
    "SeizeDeliveryJobsFindTarget": {
        "post_wait_freezes": 1000,
