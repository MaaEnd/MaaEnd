        ]
    },
    "SeizeDeliveryJobsFoundListOfDeliveryJobsButton": {
        "desc": "进入运送委托列表",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    252,
                    65,
                    170,
                    55
                ],
                "expected": [
                    "运送委托列表",
                    "運送委託清單",
                    "(?i)List\\s*of\\s*Delivery\\s*Jobs",
                    "配達依頼一覧"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "next": [
            "isSeizeDeliveryJobsExistOldTask",
            "isSeizeDeliveryJobsExhausted",
            "SeizeDeliveryJobsCheckWulingFilter",
            "SeizeDeliveryJobsOpenRegionFilter"
        ],
        "on_error": [
            "SeizeDeliveryJobsStopTask"
        ]
    },
    "SeizeDeliveryJobsCheckWulingFilter": {
        "desc": "当前已是武陵筛选，直接进入调度",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    60,
                    647,
                    132,
                    29
                ],
                "expected": [
                    "武陵",
                    "(?i)Wuling",
                    "무릉"
                ]
            }
        },
        "next": [
            "SeizeDeliveryJobsLoop"
        ],
        "on_error": [
            "SeizeDeliveryJobsStopTask"
        ]
    },
    "SeizeDeliveryJobsOpenRegionFilter": {
        "desc": "非武陵筛选则点击展开地区筛选",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    60,
                    647,
                    132,
                    29
                ],
                "roi_offset": [
                    0,
                    0,
                    33,
                    0
