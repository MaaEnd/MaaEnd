            "type": "And",
            "param": {
                "all_of": [
                    {
                        "sub_name": "RewardOcr",
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [
                                    841,
                                    177,
                                    48,
                                    424
                                ],
                                "roi_offset": [
                                    0,
                                    30,
                                    0,
                                    -20
                                ],
                                "expected": [
                                    "16.3"
                                ],
                                "only_rec": true
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": "RewardOcr",
                                "roi_offset": [
                                    -215,
                                    -6,
                                    19,
                                    -6
                                ],
                                "expected": [
                                    "武陵城",
                                    "Wuling City",
                                    "무릉성"
                                ]
                            }
                        }
                    }
                ],
                "box_index": 0
            }
        },
        "next": [
            "SeizeDeliveryJobsFoundTarget"
        ]
    },
