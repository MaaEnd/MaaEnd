        "order_by": "Vertical"
    },
    "__SeizeDeliveryJobsRecoViewLocation": {
        "desc": "查看位置按钮文本（go per-box 覆写 roi）",
        "recognition": "OCR",
        "roi": [
            625,
            212,
            34,
            410
        ],
        "expected": [
            "查看位置"
        ],
        "order_by": "Vertical"
    },
    "__SeizeDeliveryJobsMinReward": {
        "desc": "价格下限配置仓库（不实际识别；expected 由 tasks 覆写为用户输入，go 读取 expected[0]）",
        "recognition": "OCR",
        "expected": [
            "15.9"
        ]
    }
