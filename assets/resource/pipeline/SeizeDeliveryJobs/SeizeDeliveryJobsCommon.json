        "roi": [
            840,
            190,
            50,
            430
        ],
        "template": [
            "SeizeDeliveryJobs/DepotNodePage/WulingToken.png"
        ],
        "order_by": "Score"
    },
    "__SeizeDeliveryJobsRecoReward": {
        "desc": "委托奖励金额（go per-box 覆写 roi）",
