{
    "SeizeDeliveryJobsScanTarget": {
        "desc": "委托目标扫描入口点，Go 驱动扫描所有符合条件的委托（终点筛选开启时启用）",
        "enabled": false,
        "recognition": "Custom",
        "custom_recognition": "SeizeDeliveryJobsScanTargetRecognition",
        "action": "Custom",
        "custom_action": "SeizeDeliveryJobsScanTargetAction",
        "next": [
            "SeizeDeliveryJobsFoundTargetViewLocationClick"
        ],
        "on_error": [
            "SeizeDeliveryJobsNoProgress"
        ]
    },
    "SeizeDeliveryJobsFoundTargetViewLocationClick": {
        "desc": "点击委托项的查看位置按钮（由 Go 覆写 target）",
        "action": "Click",
        "target": [
            -1,
            -1
        ], // 必须覆写此字段
        "next": [
            "SeizeDeliveryJobsEndpointFilter"
        ]
    },
    // 终点筛选守卫节点 SeizeDeliveryJobsEndpointFilter、一次判全部终点的 MapFind candidates 节点
    // SeizeDeliveryJobsEndpointCandidates，以及每个终点的「开关+落点」叶子节点 SeizeDeliveryJobsEndpointFilter<终点>，
    // 均由 tools/pipeline-generate/SeizeDeliveryJobs 生成（分别输出到同目录的
    // SeizeDeliveryJobsEndpointDispatcher.json 与 SeizeDeliveryJobsDestinations.json），此处不再手写。
    // ===== 下面是结果处理的流程节点 =====
    // 终点匹配成功：此处不再清理 Go 扫描状态。接取成功时任务结束、或经 AutoDelivery 跳回
    // SeizeDeliveryJobsMain（入口会整体重置）；接取失败时由 SeizeDeliveryJobsNoProgress 清理。
    // 若在此清理会顺带把跨轮计数归零，使「匹配成功但接取失败」的循环永远达不到上限。
    "SeizeDeliveryJobsEndpointMatched": {
        "desc": "终点匹配成功，转交接取流程",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "SeizeDeliveryJobsPressEscAfterMatch"
        ]
    },
    "SeizeDeliveryJobsPressEscAfterMatch": {
        "desc": "终点匹配成功，关闭地图",
        "action": "ClickKey",
        "key": 27, // ESC
        "post_delay": 1000,
        "next": [
            "SeizeDeliveryJobsAcceptClick"
        ]
    },
    "SeizeDeliveryJobsAcceptClick": {
        "desc": "点击接取运送委托（由 Go 覆写target）",
        "action": "Click",
        "target": [
            -1,
            -1
        ], // 必须覆写此字段
        "post_wait_freezes": {
            "time": 2000,
            "target": [
                2,
                164,
                264,
                103
            ]
        },
        "timeout": 5000,
        "next": [
            "SeizeDeliveryJobsIsSeizeSuccess"
        ],
        "on_error": [
            "SeizeDeliveryJobsNoProgress"
        ]
    },
    "SeizeDeliveryJobsEndpointNotMatched": {
        "desc": "终点未匹配，继续扫描下一个委托",
        "next": [
            "SeizeDeliveryJobsPressEscAfterNotMatch"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$task.SeizeDeliveryJobs.focus.endpointNotMatched"
        }
    },
    "SeizeDeliveryJobsPressEscAfterNotMatch": {
        "desc": "终点未匹配，关闭地图",
        "action": "ClickKey",
        "key": 27, // ESC
        "post_delay": 1000,
        "next": [
            "SeizeDeliveryJobsScanTarget"
        ]
    },
    // 「本轮没有接到委托」的统一收口节点，三个入口：
    //   ① SeizeDeliveryJobsLoop 的兜底（FindTarget 未命中，列表无价格达标委托）；
    //   ② SeizeDeliveryJobsScanTarget 的 on_error（全部扫完仍未匹配到终点）；
    //   ③ SeizeDeliveryJobsAcceptClick 的 on_error（匹配到终点但接取失败）。
    // Go 侧计数：未达上限则清空单轮状态并放行到 Refresh，达上限则失败终止任务。
    "SeizeDeliveryJobsNoProgress": {
        "desc": "本轮没有接到委托：未达尝试上限则刷新重试，达上限则终止任务",
        "action": "Custom",
        "custom_action": "SeizeDeliveryJobsNoProgressAction",
        "next": [
            "SeizeDeliveryJobsRefresh"
        ],
        "on_error": [
            "FailedNode"
        ]
    }
}
