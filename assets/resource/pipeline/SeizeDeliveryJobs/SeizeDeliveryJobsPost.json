    // ===== 武陵城部分 =====
    "SeizeDeliveryJobsWalkToDepotNodeWulingCity": {
        "desc": "走到武陵城仓储节点",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "MapNavigateAction",
        // 仓储节点在河南岸，和落点分属两块互不连通的网格，直接给终点会闭眼直冲踩进河里。
        // 改走旁边那座桥：网格只铺到南北两个桥头，桥面被游戏挖空，所以桥上两点写死照走。
        "custom_action_param": {
            "path": [
                {
                    "action": "ZONE",
                    "zone_id": "Wuling_Base"
                },
                {
                    "action": "NAVMESH", // 桥北头，网格到此为止
                    "target": [
                        964.0,
                        1805.0
                    ]
                },
                [
                    964.0,
                    1813.0
                ], // 桥面正中
                [
                    964.0,
                    1824.0
                ], // 下桥，落回南岸路面
                {
                    "action": "NAVMESH", // 南岸寻路到仓储节点
                    "target": [
                        952.9,
                        1833.42
                    ]
                }
            ]
        },
        "post_delay": 500, // 等待弹出接取货物按钮
        "next": [
            "SeizeDeliveryJobsSuccessWalkDone",
            "SeizeDeliveryJobsFetchGoods",
            "[JumpBack]SeizeDeliveryJobsWalkToDepotNodeWulingCityBackward",
            "SeizeDeliveryJobsFatalCannotFetchGoods"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "正在走到武陵城仓储节点"
        }
    },
    "SeizeDeliveryJobsWalkToDepotNodeWulingCityBackward": {
        "desc": "背对武陵城仓储节点行走，随后走回去，用于未识别到接取货物按钮后的重试（需使用 JumpBack 调用）",
        "max_hit": 5, // 最大重试次数
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "MapNavigateAction",
        "custom_action_param": {
            "path": [
                {
                    "action": "ZONE",
                    "zone_id": "Wuling_Base"
                },
                {
                    "action": "NAVMESH",
                    "target": [
                        965.31,
                        1830.66
                    ]
                },
                [
                    952.9,
                    1833.42,
                    true
                ]
            ]
        },
        "post_delay": 500, // 等待弹出接取货物按钮
        "focus": {
            "Node.Recognition.Succeeded": "正在重新走到武陵城仓储节点"
        }
    },
