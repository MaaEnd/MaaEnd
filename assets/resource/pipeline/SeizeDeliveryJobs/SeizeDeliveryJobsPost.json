    "SeizeDeliveryJobsCheckCarryingGoods": {
        "desc": "返回大世界，检查是否已携带了货物",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "SeizeDeliveryJobsIsCarryingGoods",
