{
    // 转交流程：把身上已有的送货委托转交给他人
    // 进入这里时门控已经打开送货任务详情，因此直接点转交按钮
    // 认不到转交按钮说明这单不能转交（例如抢来的单不能再转交），退回后处理选项由任务选项决定后续
    "SeizeDeliveryJobsClickTransferJob": {
        "desc": "单击转交任务",
        "recognition": "OCR",
        "roi": [
            366,
            620,
            372,
            63
        ],
        "expected": [
            "转交运送委托",
            "轉交運送委託",
            "(?i)Transfer\\s*Delivery\\s*Job",
            "外部委託",
            "(?i)Transfer\\s*Job",
            "운송 의뢰 위탁"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SeizeDeliveryJobsConfirmTaskTransfer"
        ],
        "on_error": [
            "SeizeDeliveryJobsOngoingJobFound"
        ]
    },
    "SeizeDeliveryJobsCheckTaskTransferText": {
        "desc": "检查转交任务文本",
        "recognition": "OCR",
        "roi": [
            401,
            238,
            494,
            160
        ],
        "expected": [
            "是否确认将送货任务委托给他人派送?",
            "是否確定將送貨任務委託給他人運送？",
            "(?i)Transfer\\s*delivery\\s*job\\s*to\\s*another\\s*courier\\s*\\?",
            "配達任務を他人に委託しますか？",
            "给他人派送",
            "給他人運送",
            "운송 임무를 다른 사람에게 위탁하시겠습니까?"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "SeizeDeliveryJobsConfirmTaskTransfer": {
        "desc": "确认转交任务",
        "recognition": "And",
        "all_of": [
            "YellowConfirmButtonType1",
            "SeizeDeliveryJobsCheckTaskTransferText"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SeizeDeliveryJobsMain"
        ],
        "on_error": [
            "SeizeDeliveryJobsOngoingJobFound"
        ],
        "focus": {
            "Node.Action.Succeeded": "$task.SeizeDeliveryJobs.focus.transferDone"
        }
    }
}
