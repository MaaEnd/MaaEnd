{
    "GameLauncherWakeMain": {
        "desc": "Windows 第一阶段（前台截图+前台输入）：息屏时点击唤醒显示器，直到看到左侧终末地图标",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "GameLauncherEndfieldIconVisible",
            "GameLauncherBlackScreenClick"
        ]
    },
    "GameLauncherEndfieldIconVisible": {
        "desc": "左侧终末地图标可见，唤醒阶段结束",
        "recognition": "TemplateMatch",
        "roi": [
            20,
            60,
            100,
            600
        ],
        "template": "GameLauncher/EndfieldIcon.png",
        "green_mask": true,
        "pre_delay": 0,
        "post_delay": 0
    },
    "GameLauncherMain": {
        "desc": "在鹰角启动器中启动终末地；Windows 第二阶段（后台截图+后台输入）",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "GameLauncherSelectEndfield",
            "[JumpBack]GameLauncherBlackScreenClick"
        ]
    },
    "GameLauncherBlackScreenClick": {
        "desc": "DP 显示器息屏后启动器截图为黑屏，找不到左侧终末地图标时点击激活，多次点击顺带解锁屏幕",
        "max_hit": 10,
        "recognition": "TemplateMatch",
        "roi": [
            20,
            60,
            100,
            600
        ],
        "template": "GameLauncher/EndfieldIcon.png",
        "green_mask": true,
        "inverse": true,
        "action": "Click",
        "target": [
            640,
            360,
            1,
            1
        ],
        // 显示器从息屏唤醒需要 1~3 秒，期间画面一直是黑屏不变，无法用 post_wait_freezes 等待
        "post_delay": 2000,
        "next": [
            "GameLauncherEndfieldIconVisible",
            "GameLauncherBlackScreenClick"
        ]
    },
    "GameLauncherSelectEndfield": {
        "desc": "点击左侧栏的终末地图标",
        "recognition": "TemplateMatch",
        "roi": [
            20,
            60,
            100,
            600
        ],
        "template": "GameLauncher/EndfieldIcon.png",
        "green_mask": true,
        "pre_wait_freezes": 100,
        "action": "Click",
        "next": [
            "GameLauncherEndfieldSelected"
        ]
    },
    "GameLauncherEndfieldSelected": {
        "desc": "右下角出现黄色开始游戏按钮，确认已切换到终末地页面",
        "recognition": "And",
        "all_of": [
            "GameLauncherStartGameYellow"
        ],
        "pre_wait_freezes": 100,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "GameLauncherClickStartGame"
        ]
    },
    "GameLauncherClickStartGame": {
        "desc": "已选中终末地，点击右下角开始游戏",
        "recognition": "And",
        "all_of": [
            "GameLauncherStartGameYellow",
            "GameLauncherStartGameText"
        ],
        "box_index": 1,
        "pre_wait_freezes": 500,
        "action": "Click",
        "next": [
            "GameLauncherInGame",
            "GameLauncherDriverTipIgnore",
            "GameLauncherMinimized"
        ]
    },
    "GameLauncherDriverTipIgnore": {
        "desc": "点击开始游戏后弹出显卡驱动更新提示，点击忽略并继续",
        "recognition": "OCR",
        "roi": [
            360,
            405,
            320,
            95
        ],
        "expected": [
            // @i18n-skip
            "忽略并继续",
            "忽略並繼續"
        ],
        "pre_wait_freezes": 100,
        "action": "Click",
        "next": [
            "GameLauncherInGame",
            "GameLauncherMinimized"
        ]
    },
    "GameLauncherInGame": {
        "desc": "右下角按钮显示游戏中，启动成功",
        "recognition": "OCR",
        "roi": [
            -320,
            -140,
            320,
            140
        ],
        "expected": [
            // @i18n-skip
            "游戏中",
            "遊戲中",
            "(?i)\\bRunning\\b"
        ]
    },
    "GameLauncherMinimized": {
        "desc": "启动器点击开始游戏后会最小化，截图变为全黑，开始游戏按钮所在区域几乎全黑时视为启动成功",
        // 启动器窗口为圆角，未最小化时截图四角也是黑边，不能只看角落
        "recognition": "ColorMatch",
        "roi": [
            -320,
            -140,
            320,
            140
        ],
        "lower": [
            0,
            0,
            0
        ],
        "upper": [
            10,
            10,
            10
        ],
        "connected": true,
        "count": 40000
    },
    "GameLauncherExit": {
        "desc": "不写这个节点 CI 会报错"
    },
    "GameLauncherStartGameYellow": {
        "desc": "右下角开始游戏按钮的黄色底",
        "recognition": "ColorMatch",
        "roi": [
            -320,
            -140,
            320,
            140
        ],
        "lower": [
            240,
            240,
            0
        ],
        "upper": [
            255,
            255,
            100
        ],
        "connected": true,
        "count": 4000
    },
    "GameLauncherStartGameText": {
        "desc": "右下角开始游戏按钮",
        "recognition": "OCR",
        "roi": [
            -320,
            -140,
            320,
            140
        ],
        "expected": [
            // @i18n-skip
            "开始游戏",
            "開始遊戲",
            "(?i)\\bPlay\\b"
        ]
    }
}
