    "GameLauncherStartGameText": {
        "desc": "右下角开始游戏按钮",
        "recognition": "OCR",
        "roi": [
            -320,
            -140,
            320,
            140
        ],
        "expected": [
            // @i18n-skip
            "开始游戏",
