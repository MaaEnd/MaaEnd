{
    "RetrieveBackpackMain": {
        "desc": "取回背包独立任务入口",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackSnapshotsReady",
            "RetrieveBackpackMissingSnapshots"
        ]
    },
    "RetrieveBackpackSnapshotsReady": {
        "recognition": "Custom",
        "custom_recognition": "StashBackpackFullCompleteRecognition",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackEnterDepot"
        ]
    },
    "RetrieveBackpackMissingSnapshots": {
        "desc": "当前任务批次没有完整 S0/S1，警告后成功跳过",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "StashBackpackWarningAction",
        "custom_action_param": {
            "reason": "missing_retrieve_snapshot"
        },
        "post_delay": 0,
        "rate_limit": 0
    },
    "RetrieveBackpackEnterDepot": {
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackEnterDepotValleyIV",
            "RetrieveBackpackEnterDepotWuling"
        ]
    },
    "RetrieveBackpackEnterDepotValleyIV": {
        "recognition": "Custom",
        "custom_recognition": "StashBackpackDepotRecognition",
        "custom_recognition_param": {
            "depot": "ValleyIV"
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackEnterValleyIVSuccess",
            "[JumpBack]SceneEnterMenuBackpackWithDepotValleyIV"
        ]
    },
    "RetrieveBackpackEnterDepotWuling": {
        "recognition": "Custom",
        "custom_recognition": "StashBackpackDepotRecognition",
        "custom_recognition_param": {
            "depot": "Wuling"
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackEnterWulingSuccess",
            "[JumpBack]SceneEnterMenuBackpackWithDepotWuling"
        ]
    },
    "RetrieveBackpackEnterValleyIVSuccess": {
        "recognition": "And",
        "all_of": [
            "InDijiangDepotValleyIV"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackCaptureStart"
        ]
    },
    "RetrieveBackpackEnterWulingSuccess": {
        "recognition": "And",
        "all_of": [
            "InDijiangDepotWuling"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackCaptureStart"
        ]
    },
    "RetrieveBackpackCaptureStart": {
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "StashBackpackSnapshotAction",
        "custom_action_param": {
            "snapshot": "temporary"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackStoreNewSubTask"
        ]
    },
    "RetrieveBackpackStoreNewSubTask": {
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackPrepareNewItems",
            "RetrieveBackpackCaptureCurrent",
            "RetrieveBackpackReuseTemporary"
        ]
    },
    "RetrieveBackpackPrepareNewItems": {
        "desc": "准备存放任务期间新增的物品",
        "enabled": false,
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "StashBackpackStateAction",
        "custom_action_param": {
            "operation": "prepare_difference",
            "minuend_snapshot": "temporary",
            "subtrahend_snapshot": "s1"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackStoreNewSetupBagBatch"
        ]
    },
    "RetrieveBackpackStoreNewSetupBagBatch": {
        "desc": "逐页批量存放取回前检测到的新物品",
        "pre_delay": 0,
        "anchor": {
            "StashBackpackAfterBagBatchItemFound": "RetrieveBackpackStoreNewItem",
            "StashBackpackAfterBagBatchFinished": "RetrieveBackpackStoreNewFinished",
            "StashBackpackAfterBagBatchBottomReached": "RetrieveBackpackStoreNewConsumeMissing"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "StashBackpackPrepareBagBatch"
        ]
    },
    "RetrieveBackpackStoreNewFinished": {
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackCaptureCurrent",
            "RetrieveBackpackReuseTemporary"
        ]
    },
    "RetrieveBackpackStoreNewLoop": {
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackStoreNewNextItem",
            "RetrieveBackpackCaptureCurrent",
            "RetrieveBackpackReuseTemporary"
        ]
    },
    "RetrieveBackpackStoreNewNextItem": {
        "recognition": "Custom",
        "custom_recognition": "StashBackpackNextItemRecognition",
        "custom_recognition_param": {
            "bag_nodes": [
                "StashBackpackFindCurrentItemInBag",
                "StashBackpackVerifySourceItem"
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackStoreNewSetupBagSearch"
        ]
    },
    "RetrieveBackpackStoreNewSetupBagSearch": {
        "pre_delay": 0,
        "anchor": {
            "StashBackpackAfterBagFound": "RetrieveBackpackStoreNewItem",
            "StashBackpackAfterBagNotFound": "RetrieveBackpackStoreNewConsumeMissing"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "StashBackpackPrepareBagSearch"
        ]
    },
    "RetrieveBackpackStoreNewItem": {
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "AutoShiftClickAction",
        "target": "StashBackpackBagPageItem",
        "target_offset": [
            26,
            25,
            -52,
            -50
        ],
        "post_wait_freezes": 200,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackStoreNewConsumeStored"
        ]
    },
    "RetrieveBackpackStoreNewVerifyStored": {
        "pre_delay": 0,
        "anchor": {
            "StashBackpackAfterSourceItemStillPresent": "RetrieveBackpackStoreNewVerificationFailed",
            "StashBackpackAfterSourceItemMoved": "RetrieveBackpackStoreNewConsumeStored"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "StashBackpackVerifySourceItemMoved"
        ]
    },
    "RetrieveBackpackStoreNewVerificationFailed": {
        "desc": "Shift+Click 后物品仍在背包，禁止消费目标",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "FalseAction",
        "post_delay": 0,
        "rate_limit": 0
    },
    "RetrieveBackpackStoreNewConsumeStored": {
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "StashBackpackStateAction",
        "custom_action_param": {
            "operation": "mark_bag_item_clicked",
            "reason": "retrieve_new_item_stored",
            "changes_snapshot": true
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "StashBackpackBagBatchLoop"
        ]
    },
    "RetrieveBackpackStoreNewConsumeMissing": {
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "StashBackpackStateAction",
        "custom_action_param": {
            "operation": "discard_bag_targets",
            "reason": "retrieve_new_item_not_found"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackStoreNewFinished"
        ]
    },
    "RetrieveBackpackCaptureCurrent": {
        "desc": "存放新增物品后重新生成真实快照",
        "recognition": "Custom",
        "custom_recognition": "StashBackpackSnapshotChangedRecognition",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "StashBackpackSnapshotAction",
        "custom_action_param": {
            "snapshot": "retrieve_current"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackPrepareMissingItems"
        ]
    },
    "RetrieveBackpackReuseTemporary": {
        "desc": "背包未发生变更时复用取回开始快照",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "StashBackpackStateAction",
        "custom_action_param": {
            "operation": "copy_snapshot",
            "source_snapshot": "temporary",
            "snapshot": "retrieve_current"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackPrepareMissingItems"
        ]
    },
    "RetrieveBackpackPrepareMissingItems": {
        "desc": "准备从仓库取回的缺少物品",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "StashBackpackStateAction",
        "custom_action_param": {
            "operation": "prepare_difference",
            "minuend_snapshot": "s0",
            "subtrahend_snapshot": "retrieve_current"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackPrepareRestoreSearch"
        ]
    },
    "RetrieveBackpackPrepareRestoreSearch": {
        "desc": "复用当前背包快照并在取回开始前回顶一次",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "StashBackpackStateAction",
        "custom_action_param": {
            "operation": "prepare_restore",
            "snapshot": "retrieve_current"
        },
        "anchor": {
            "StashBackpackAfterRestoreSearchPrepared": "RetrieveBackpackRestoreLoop"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "StashBackpackPrepareRestoreSearch"
        ]
    },
    "RetrieveBackpackRestoreLoop": {
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackRestoreNextItem",
            "RetrieveBackpackFinished"
        ]
    },
    "RetrieveBackpackRestoreNextItem": {
        "recognition": "Custom",
        "custom_recognition": "StashBackpackNextItemRecognition",
        "custom_recognition_param": {
            "repo_nodes": [
                "StashBackpackFindCurrentItemInRepo"
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackDispatchCategory"
        ]
    },
    "RetrieveBackpackDispatchCategory": {
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackCategoryOre",
            "RetrieveBackpackCategoryPlant",
            "RetrieveBackpackCategoryProduct",
            "RetrieveBackpackCategoryDoodad",
            "RetrieveBackpackCategoryNurturance",
            "RetrieveBackpackCategoryUsable",
            "RetrieveBackpackCategoryProducer",
            "RetrieveBackpackCategoryPortableDevice",
            "RetrieveBackpackConsumeFiltered"
        ]
    },
    "RetrieveBackpackSetupRepoSearch": {
        "pre_delay": 0,
        "anchor": {
            "StashBackpackAfterRepoFound": "RetrieveBackpackMoveItemToBag",
            "StashBackpackAfterRepoNotFound": "RetrieveBackpackConsumeRepoMissing"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "StashBackpackPrepareRepoSearch"
        ]
    },
    "RetrieveBackpackMoveItemToBag": {
        "desc": "从仓库取回当前缺少物品",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "AutoShiftClickAction",
        "target": "StashBackpackFindCurrentItemInRepo",
        "target_offset": [
            26,
            25,
            -52,
            -50
        ],
        "post_wait_freezes": 200,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackVerifyInBag"
        ]
    },
    "RetrieveBackpackVerifyInBag": {
        "pre_delay": 0,
        "anchor": {
            "StashBackpackAfterRetrievedItemFound": "RetrieveBackpackConsumeRestored",
            "StashBackpackAfterRetrievedItemNotFound": "RetrieveBackpackRestoreVerificationFailed"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "StashBackpackPrepareRetrievedItemSearch"
        ]
    },
    "RetrieveBackpackConsumeRestored": {
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "StashBackpackStateAction",
        "custom_action_param": {
            "operation": "consume_target",
            "reason": "restored"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackRestoreLoop"
        ]
    },
    "RetrieveBackpackRestoreVerificationFailed": {
        "desc": "Shift+Click 后物品未出现在背包，禁止消费目标",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "FalseAction",
        "post_delay": 0,
        "rate_limit": 0
    },
    "RetrieveBackpackConsumeRepoMissing": {
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "StashBackpackStateAction",
        "custom_action_param": {
            "operation": "consume_target",
            "reason": "restore_repo_not_found"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackRestoreLoop"
        ]
    },
    "RetrieveBackpackConsumeFiltered": {
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "StashBackpackStateAction",
        "custom_action_param": {
            "operation": "consume_target",
            "reason": "restore_category_not_selected"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "RetrieveBackpackRestoreLoop"
        ]
    },
    "RetrieveBackpackFinished": {
        "desc": "保留批次级 S0/S1 状态",
        "recognition": "And",
        "all_of": [
            "InDijiangDepot"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
