{
    "AutoGetCredits": {
        "desc": "已启用购买物品买不起时自动去基建获取（由 CreditShoppingPriority1AutoGetCredits / CreditShoppingPriority2AutoGetCredits / CreditShoppingPriority3AutoGetCredits 控制）",
        "max_hit": 1,
        "recognition": "Or",
        "any_of": [
            "AutoGetCreditsBuyPriority1",
            "AutoGetCreditsBuyPriority2",
            "AutoGetCreditsBuyPriority3"
        ],
        "next": [
            "GoToNeedCredit"
        ]
    },
    "GoToNeedCredit": {
        "max_hit": 1,
        "next": [
            "[JumpBack]NeedCredit",
            "CreditShoppingShopping",
            "CreditShoppingCheckShopPage",
            "[JumpBack]SceneEnterMenuShop"
        ],
        "focus": {
            "Node.Action.Succeeded": "$task.CreditShopping.auto_get_credits"
        }
    },
    "AutoGetCreditsBuy": {
        "recognition": "Or",
        "any_of": [
            "AutoGetCreditsBuyPriority1",
            "AutoGetCreditsBuyPriority2",
            "AutoGetCreditsBuyPriority3"
        ]
    },
    "AutoGetCreditsBuyPriority1": {
        "recognition": "And",
        "all_of": [
            "CreditShoppingPriority1Item",
            "CreditShoppingPriority1NotSoldOut",
            "CreditShoppingPriority1CanNotAfford",
            "CreditShoppingPriority1DiscountCannotAfford"
        ],
        "box_index": 0
    },
    "AutoGetCreditsBuyPriority2": {
        "recognition": "And",
        "all_of": [
            "CreditShoppingPriority2Item",
            "CreditShoppingPriority2NotSoldOut",
            "CreditShoppingPriority2CanNotAfford",
            "CreditShoppingPriority2DiscountCannotAfford"
        ],
        "box_index": 0
    },
    "AutoGetCreditsBuyPriority3": {
        "recognition": "And",
        "all_of": [
            "CreditShoppingPriority3Item",
            "CreditShoppingPriority3NotSoldOut",
            "CreditShoppingPriority3CanNotAfford",
            "CreditShoppingPriority3DiscountCannotAfford"
        ],
        "box_index": 0
    }
}
