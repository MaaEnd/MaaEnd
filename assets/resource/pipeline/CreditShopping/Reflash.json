{
    "RefreshText": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1030,
                    619,
                    202,
                    93
                ],
                "expected": [
                    "立即刷新",
                    "立即更新",
                    "(?i)Refresh\\s*Now",
                    "更新"
                ]
            }
        }
    },
    "RefreshCost": {
        "desc": "刷新花费",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1140,
                    655,
                    32,
                    18
                ],
                "expected": [
                    "^80$",
                    "^120$",
                    "^160$",
                    "^200$"
                ],
                "only_rec": true
            }
        }
    },
    "RefreshUsedUp": {
        "desc": "刷新次数已用尽",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    885,
                    535,
                    395,
                    185
                ],
                "expected": [
                    "今日刷新次数已用尽",
                    "今日更新次數已用盡",
                    "(?i)Daily\\s*refreshes\\s*used\\s*up",
                    "本日のリセット回数は上限到達",
                    "刷新次数",
                    "用尽"
                ]
            }
        }
    },
    "RefreshButton": {
        "desc": "刷新按钮",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "RefreshCost",
                    "RefreshUsedUp"
                ]
            }
        }
    },
    "CreditShoppingRefreshBalanceGate": {
        "desc": "刷新前检查余额：信用点扣除下一次刷新花费后低于余额阈值（选项：刷新前检查余额）。命中后走哪条路线由 next 决定：改买=是 → 稳健改买动作节点，改买=否 → 直接结束",
        "enabled": false,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ExpressionRecognition",
                "custom_recognition_param": {
                    "expression": "{CreditShoppingReserveCreditOCRInternal}-{RefreshCost}<400"
                }
            }
        },
        "next": [
            "CreditShoppingNothingToBuy"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$task.CreditShopping.refresh_limit_reached"
        }
    },
    "CreditShoppingRefreshReserveCreditGate": {
        "desc": "刷新商品的准入判断（选项：刷新前检查余额 → 余额不足时改为购买任意物品=否）",
        "recognition": "DirectHit"
    },
    "RefreshColor": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "RefreshText",
                "roi_offset": [
                    0,
                    0,
                    60,
                    0
                ],
                "lower": [
                    243,
                    0,
                    0
                ],
                "upper": [
                    255,
                    168,
                    168
                ]
            }
        }
    },
    "CanNotFlash": {
        "desc": "无法刷新（信用点不足）",
        "recognition": "And",
        "all_of": [
            "RefreshText",
            "RefreshColor"
        ]
    }
}
