{
    "CreditShoppingBuyPriority1": {
        "desc": "优先购买1（选项：优先购买物品、折扣设置、是否检测信用点阈值）。点击物品图标格中心",
        "recognition": "And",
        "all_of": [
            "CreditShoppingPriority1Item",
            "CreditShoppingPriority1NotSoldOut",
            "CreditShoppingPriority1CanAfford",
            "CreditShoppingPriority1Discount",
            "CreditShoppingPriority1ReserveCreditGate"
        ],
        "box_index": 0,
        "pre_wait_freezes": 100,
        "action": "Click",
        "target_offset": [
            0,
            0,
            0,
            0
        ],
        "next": [
            "CreditShoppingBuyFailed",
            "CreditShoppingBuyConfirm"
        ]
    },
    "CreditShoppingBuyPriority2": {
        "desc": "优先购买2（选项：普通购买3物品、折扣设置、是否检测信用点阈值）。点击物品图标格中心",
        "recognition": "And",
        "all_of": [
            "CreditShoppingPriority2Item",
            "CreditShoppingPriority2NotSoldOut",
            "CreditShoppingPriority2CanAfford",
            "CreditShoppingPriority2Discount",
            "CreditShoppingPriority2ReserveCreditGate"
        ],
        "box_index": 0,
        "pre_wait_freezes": 100,
        "action": "Click",
        "target_offset": [
            0,
            0,
            0,
            0
        ],
        "next": [
            "CreditShoppingBuyFailed",
            "CreditShoppingBuyConfirm"
        ]
    },
    "CreditShoppingBuyPriority3": {
        "desc": "优先购买3（选项：优先购买3物品、折扣设置、是否检测信用点阈值）。点击物品图标格中心",
        "recognition": "And",
        "all_of": [
            "CreditShoppingPriority3Item",
            "CreditShoppingPriority3NotSoldOut",
            "CreditShoppingPriority3CanAfford",
            "CreditShoppingPriority3Discount",
            "CreditShoppingPriority3ReserveCreditGate"
        ],
        "box_index": 0,
        "pre_wait_freezes": 100,
        "action": "Click",
        "target_offset": [
            0,
            0,
            0,
            0
        ],
        "next": [
            "CreditShoppingBuyFailed",
            "CreditShoppingBuyConfirm"
        ]
    },
    "CreditShoppingBuyBlacklist": {
        "desc": "强制购买剩余可购物品（选项：购买选项均未命中时操作=购买任意物品）",
        "recognition": "And",
        "all_of": [
            "CreditShoppingShelfAnyItem",
            "CreditShoppingShelfAnyNotSoldOut",
            "CreditShoppingShelfAnyCanAfford"
        ],
        "box_index": 0,
        "pre_wait_freezes": 100,
        "action": "Click",
        "target_offset": [
            0,
            0,
            0,
            0
        ],
        "next": [
            "CreditShoppingBuyItemBelowReserve",
            "CreditShoppingBuyFailed",
            "CreditShoppingBuyConfirm"
        ]
    },
    "CreditShoppingPrudentRefresh": {
        "desc": "稳健模式下改为购买任意物品含无折扣（选项：稳健模式刷新、稳健刷新阈值；是否购前检查价格由刷新子选项控制）",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "Custom",
                            "param": {
                                "custom_recognition": "ExpressionRecognition",
                                "custom_recognition_param": {
                                    "expression": "{CreditShoppingReserveCreditOCRInternal}-{RefreshCost}<400"
                                }
                            }
                        }
                    },
                    "CreditShoppingShelfAnyItem",
                    "CreditShoppingShelfAnyNotSoldOut",
                    "CreditShoppingShelfAnyCanAfford"
                ],
                "box_index": 1
            }
        },
        "pre_wait_freezes": 100,
        "action": {
            "type": "Click"
        },
        "next": [
            "CreditShoppingBuyItemBelowReserve",
            "CreditShoppingBuyFailed",
            "CreditShoppingBuyConfirm"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$task.CreditShopping.prudent_refresh_triggered"
        }
    },
    "CreditShoppingRefreshCountReached": {
        "desc": "刷新次数已用尽时直接购买（选项：执行刷新；是否购前检查价格由刷新子选项控制）",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "RefreshUsedUp",
                    "CreditShoppingShelfAnyItem",
                    "CreditShoppingShelfAnyNotSoldOut",
                    "CreditShoppingShelfAnyCanAfford"
                ],
                "box_index": 1
            }
        },
        "pre_wait_freezes": 100,
        "action": {
            "type": "Click"
        },
        "next": [
            "CreditShoppingBuyItemBelowReserve",
            "CreditShoppingBuyFailed",
            "CreditShoppingBuyConfirm"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$task.CreditShopping.refresh_count_reached_triggered"
        }
    },
    "CreditShoppingNothingToBuy": {
        "desc": "没有合适的东西可以买了",
        "recognition": "DirectHit",
        "focus": {
            "Node.Recognition.Succeeded": "$task.CreditShopping.nothing_to_buy"
        }
    }
}
