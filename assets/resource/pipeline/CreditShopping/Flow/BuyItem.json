{
    // 购买页确认 / 失败；强制购买另在弹窗内用价格做保留阈值检查
    "CreditShoppingBuyItemPriceOCR": {
        "desc": "购买弹窗内物品价格（供强制购买的保留阈值表达式引用）",
        "recognition": "OCR",
        "roi": [
            921,
            470,
            179,
            95
        ],
        "expected": [
            "^\\d+$"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "CreditShoppingBuyItemBelowReserve": {
        "desc": "强制购买：持有信用点 − 弹窗价格 < 保留阈值则取消购买并停止任务（选项：保留信用点阈值）",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ExpressionRecognition",
                "custom_recognition_param": {
                    "expression": "{CreditShoppingReserveCreditOCRInternal}-{CreditShoppingBuyItemPriceOCR}<300"
                }
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CreditShoppingBuyItemCancelClose"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$task.CreditShopping.buy_item_below_reserve"
        }
    },
    "CreditShoppingBuyItemCancelClose": {
        "desc": "取消购买：关闭购买弹窗",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CloseButtonType1"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CreditShoppingBuyItemStop"
        ]
    },
    "CreditShoppingBuyItemStop": {
        "desc": "取消购买后停止任务",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "StopTask",
        "post_delay": 0,
        "rate_limit": 0
    },
    "CreditShoppingBuyFailed": {
        "desc": "购买失败（已售罄/信用点不足）",
        "max_hit": 1,
        "recognition": "ColorMatch",
        "roi": [
            571,
            497,
            133,
            95
        ],
        "lower": [
            210,
            94,
            104
        ],
        "upper": [
            210,
            94,
            104
        ],
        "action": "DoNothing",
        "next": [
            "CreditShoppingCloseDialog"
        ]
    },
    "CreditShoppingCloseDialog": {
        "desc": "关闭对话框",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CloseButtonType1"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "CreditShoppingFailed"
        ]
    },
    "CreditShoppingFailed": {
        "action": "Custom",
        "custom_action": "ERROR",
        "focus": {
            "Node.Action.Failed": "购买失败"
        }
    },
    "CreditShoppingBuyConfirm": {
        "desc": "购买确认",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "YellowConfirmButtonType1"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "CreditShoppingClaimConfirm",
            "CreditShoppingBuyFailed"
        ]
    }
}
