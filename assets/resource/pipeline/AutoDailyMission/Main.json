{
    "AutoDailyMissionMain": {
        "desc": "进入任务界面的委派任务页签",
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneEnterMenuMissionCommission"
            ]
        },
        "next": [
            "AutoDailyMissionDispatch"
        ]
    },
    "AutoDailyMissionDispatch": {
        "desc": "依次尝试已适配的日常任务",
        "recognition": "And",
        "all_of": [
            "InMenuMission"
        ],
        "pre_wait_freezes": {
            "time": 200,
            "target": [
                42,
                70,
                360,
                590
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDailyMissionTianshiPillarEntry",
            "AutoDailyMissionMissingRobotsEntry",
            "AutoDailyMissionEnd"
        ]
    },
    "AutoDailyMissionEnd": {
        "desc": "没有可做的日常任务，结束",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "AutoDailyMissionCheckFinished": {
        "desc": "日常任务做完后回到委派任务页签检查",
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneEnterMenuMissionCommission"
            ]
        },
        "next": [
            "AutoDailyMissionNotFinished",
            "AutoDailyMissionEnd"
        ]
    },
    "AutoDailyMissionListItem": {
        "desc": "委派任务列表里的日常任务",
        "recognition": "OCR",
        "roi": [
            42,
            70,
            360,
            590
        ],
        // 完整文本形如："日常·天桩追踪" / "日常·天樁追蹤" / "Daily: Sky Pole Tracking" / "日常・天杭追跡" / "일상 · 천장을 찾습니다"
        // 一天只刷新一个日常，只认标题前缀即可判断列表里还有没有日常
        "expected": [
            // @i18n-skip
            "日常",
            "(?i)^Daily",
            "^일상"
        ]
    },
    "AutoDailyMissionNotFinished": {
        "desc": "做完后列表里仍有日常任务，任务失败",
        "recognition": "And",
        "all_of": [
            "InMenuMission",
            "AutoDailyMissionListItem"
        ],
        "pre_wait_freezes": {
            "time": 200,
            "target": [
                42,
                70,
                360,
                590
            ]
        },
        "action": "Custom",
        "custom_action": "FalseAction"
    },
    "AutoDailyMissionStartTrackingButton": {
        "desc": "任务详情右下角的开始追踪按钮",
        "recognition": "TemplateMatch",
        "roi": [
            1070,
            570,
            200,
            140
        ],
        "template": [
            "Common/Button/WhiteConfirmButtonType1.png",
            "Common/Button/WhiteConfirmButtonType1Hover.png"
        ],
        "order_by": "Score"
    },
    "AutoDailyMissionQuickTeleport": {
        "desc": "在任务地图中点击前往传送",
        "recognition": "And",
        "all_of": [
            "QuickTeleportButton"
        ],
        "pre_wait_freezes": 100,
        "action": "Click",
        "post_wait_freezes": 500,
        "next": [
            "AutoDailyMissionTeleport"
        ]
    },
    "AutoDailyMissionSelectTrackedMission": {
        "desc": "任务标记和其他标记重叠时，在右侧列表中点击追踪中任务",
        "recognition": "OCR",
        "roi": [
            860,
            150,
            420,
            450
        ],
        "expected": [
            "追踪中任务",
            "追蹤中任務",
            "(?i)Tracked\\s*Mission",
            "追跡中の任務",
            "추적\\s*중인\\s*임무"
        ],
        "pre_wait_freezes": 100,
        "action": "Click",
        "post_wait_freezes": 500,
        "next": [
            "AutoDailyMissionQuickTeleport"
        ]
    },
    "AutoDailyMissionTeleport": {
        "desc": "在任务地图中点击传送",
        "recognition": "And",
        "all_of": [
            "TeleportButton"
        ],
        "action": "Click",
        "next": [
            "AutoDailyMissionArrived",
            "[JumpBack]SceneWaitLoadingExit"
        ]
    },
    "AutoDailyMissionArrived": {
        "desc": "已在大世界，执行判定出的日常任务路线",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[Anchor]AutoDailyMissionRoute"
        ]
    }
}
