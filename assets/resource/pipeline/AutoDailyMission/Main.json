{
    "AutoDailyMissionMain": {
        "desc": "进入任务界面的委派任务页签",
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneEnterMenuMissionCommission"
            ]
        },
        "next": [
            "AutoDailyMissionDispatch"
        ]
    },
    "AutoDailyMissionDispatch": {
        "desc": "依次尝试已适配的日常任务",
        "recognition": "And",
        "all_of": [
            "InMenuMission"
        ],
        "pre_wait_freezes": {
            "time": 200,
            "target": [
                42,
                70,
                360,
                590
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoDailyMissionTianshiPillarEntry",
            "AutoDailyMissionMissingRobotsEntry",
            "AutoDailyMissionSprayAndCleanEntry",
            "AutoDailyMissionHerbalRemediesEntry",
            "AutoDailyMissionAuthenticMedsEntry",
            "AutoDailyMissionLostRobotsEntry",
            "AutoDailyMissionAethilluStudiesEntry",
            "AutoDailyMissionFriendOfBotsEntry",
            "AutoDailyMissionEmergencyRepairsEntry",
            "AutoDailyMissionUnsupported",
            "AutoDailyMissionEnd"
        ]
    },
    "AutoDailyMissionUnsupported": {
        "desc": "列表里有日常任务但都不是已适配的日常，任务失败",
        "recognition": "And",
        "all_of": [
            "InMenuMission",
            "AutoDailyMissionListItem"
        ],
        "action": "Custom",
        "custom_action": "FalseAction",
        "focus": {
            "Node.Recognition.Succeeded": "$task.AutoDailyMission.focus.unsupported"
        }
    },
    "AutoDailyMissionEnd": {
        "desc": "没有可做的日常任务，结束",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "AutoDailyMissionSnsStep": {
        "desc": "任务详情当前步骤是查看某人发来的消息",
        "recognition": "OCR",
        "roi": [
            455,
            160,
            790,
            40
        ],
        // 完整文本形如："查看环卫职工发来的消息" / "查看環衛職工傳來的訊息" / "Read the urban sanitation worker's message" / "清掃員から届いたメッセージを確認する" / "환경미화원이 보낸 메시지를 확인하기"
        // 英文有的日常是复数："Read Lin Hu's messages"
        // 各日常只是人名不同，按格式匹配
        "expected": [
            "^查看.+发来的消息$",
            "^查看.+傳來的訊息$",
            "(?i)^Read\\b.*messages?$",
            "から届いたメッセージを確認する$",
            "보낸\\s*메시지를\\s*확인하기$"
        ]
    },
    "AutoDailyMissionSnsTracked": {
        "desc": "当前步骤是查看消息且任务已追踪，先点击停止追踪",
        "recognition": "And",
        "all_of": [
            "InMenuMission",
            "AutoDailyMissionSnsStep",
            "CheckAlreadyTrackingText"
        ],
        "box_index": 2,
        "pre_wait_freezes": {
            "time": 200,
            "target": [
                410,
                55,
                400,
                45
            ]
        },
        "action": "Click",
        "anchor": {
            "MouseMoveResetAnchor": "MouseMoveReset"
        },
        "next": [
            "[JumpBack][Anchor]MouseMoveResetAnchor",
            "AutoDailyMissionSnsStartTracking"
        ]
    },
    "AutoDailyMissionSnsUntracked": {
        "desc": "当前步骤是查看消息且任务未追踪，点击开始追踪进入会话",
        "recognition": "And",
        "all_of": [
            "InMenuMission",
            "AutoDailyMissionSnsStep",
            "TrackMissionButton"
        ],
        "box_index": 2,
        "pre_wait_freezes": {
            "time": 200,
            "target": [
                410,
                55,
                400,
                45
            ]
        },
        "action": "Click",
        "next": [
            "AutoDailyMissionSnsInBaker"
        ]
    },
    "AutoDailyMissionSnsStartTracking": {
        "desc": "停止追踪后再点击开始追踪进入会话",
        "recognition": "And",
        "all_of": [
            "TrackMissionButton"
        ],
        "pre_wait_freezes": 100,
        "action": "Click",
        "next": [
            "AutoDailyMissionSnsInBaker"
        ]
    },
    "AutoDailyMissionSnsInBaker": {
        "desc": "已进入 Baker，推进会话到结束后重新分发",
        "recognition": "And",
        "all_of": [
            "InBakerHome"
        ],
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "BakerChatUntilOver"
            ]
        },
        "next": [
            "AutoDailyMissionMain"
        ]
    },
    "AutoDailyMissionCheckFinished": {
        "desc": "日常任务做完后回到委派任务页签检查",
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneEnterMenuMissionCommission"
            ]
        },
        "next": [
            "AutoDailyMissionTianshiPillarNotFinished",
            "AutoDailyMissionMissingRobotsNotFinished",
            "AutoDailyMissionSprayAndCleanNotFinished",
            "AutoDailyMissionHerbalRemediesNotFinished",
            "AutoDailyMissionAuthenticMedsNotFinished",
            "AutoDailyMissionLostRobotsNotFinished",
            "AutoDailyMissionAethilluStudiesNotFinished",
            "AutoDailyMissionFriendOfBotsNotFinished",
            "AutoDailyMissionEmergencyRepairsNotFinished",
            "AutoDailyMissionNotFinished",
            "AutoDailyMissionEnd"
        ]
    },
    "AutoDailyMissionListItem": {
        "desc": "委派任务列表里的日常任务",
        "recognition": "OCR",
        "roi": [
            42,
            70,
            360,
            590
        ],
        // 完整文本形如："日常·天桩追踪" / "日常·天樁追蹤" / "Daily: Sky Pole Tracking" / "日常・天杭追跡" / "일상 · 천장을 찾습니다"
        // 一天只刷新一个日常，只认标题前缀即可判断列表里还有没有日常
        "expected": [
            "日常",
            "(?i)^Daily",
            "^일상"
        ]
    },
    "AutoDailyMissionNotFinished": {
        "desc": "做完后列表里仍有日常任务，任务失败",
        "recognition": "And",
        "all_of": [
            "InMenuMission",
            "AutoDailyMissionListItem"
        ],
        "pre_wait_freezes": {
            "time": 200,
            "target": [
                42,
                70,
                360,
                590
            ]
        },
        "action": "Custom",
        "custom_action": "FalseAction"
    },
    "AutoDailyMissionStartTrackingButton": {
        "desc": "任务详情右下角的开始追踪按钮",
        "recognition": "TemplateMatch",
        "roi": [
            1070,
            570,
            200,
            140
        ],
        "template": [
            "Common/Button/WhiteConfirmButtonType1.png",
            "Common/Button/WhiteConfirmButtonType1Hover.png"
        ],
        "order_by": "Score"
    },
    "AutoDailyMissionQuickTeleport": {
        "desc": "在任务地图中点击前往传送",
        "recognition": "And",
        "all_of": [
            "QuickTeleportButton"
        ],
        "pre_wait_freezes": 100,
        "action": "Click",
        "post_wait_freezes": 500,
        "next": [
            "AutoDailyMissionTeleport"
        ]
    },
    "AutoDailyMissionSelectTrackedMission": {
        "desc": "任务标记和其他标记重叠时，在右侧列表中点击追踪中任务",
        "recognition": "OCR",
        "roi": [
            860,
            150,
            420,
            450
        ],
        "expected": [
            "追踪中任务",
            "追蹤中任務",
            "(?i)Tracked\\s*Mission",
            "追跡中の任務",
            "추적\\s*중인\\s*임무"
        ],
        "pre_wait_freezes": 100,
        "action": "Click",
        "post_wait_freezes": 500,
        "next": [
            "AutoDailyMissionQuickTeleport"
        ]
    },
    "AutoDailyMissionTeleport": {
        "desc": "在任务地图中点击传送",
        "recognition": "And",
        "all_of": [
            "TeleportButton"
        ],
        "action": "Click",
        "next": [
            "AutoDailyMissionArrived",
            "[JumpBack]SceneWaitLoadingExit"
        ]
    },
    "AutoDailyMissionRepairRobotInteractText": {
        "desc": "故障机器人的修复交互提示",
        "recognition": "OCR",
        "roi": [
            755,
            330,
            297,
            312
        ],
        "expected": [
            "^修复$",
            "^修復$",
            "(?i)^Repair$",
            "^修理$",
            "^수리$"
        ]
    },
    "AutoDailyMissionRepairRobotPuzzle": {
        "desc": "修复故障机器人的电路拼图，有第二盘时再解一次",
        // 一个机器人最多两盘，解不出时别无限重试
        "max_hit": 4,
        "recognition": "Or",
        "any_of": [
            "PuzzleSolverOnScenePrepare",
            "PuzzleSolverOnSceneMain"
        ],
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "PuzzleSolverMain"
            ]
        },
        "next": [
            "AutoDailyMissionRepairRobotPuzzle",
            "AutoDailyMissionRepairRobotDone"
        ]
    },
    "AutoDailyMissionRepairRobotDone": {
        "desc": "拼图都解完回到大世界",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "next": [
            "AutoDailyMissionCheckFinished"
        ]
    },
    "AutoDailyMissionWaitSnsPopup": {
        "desc": "回到大世界后等待安德烈通讯弹出",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        // 通讯在回到大世界后才异步弹出，大世界画面一直在动，无法用 pre_wait_freezes 等待
        "post_delay": 5000,
        "next": [
            "AutoDailyMissionSnsPopup",
            "AutoDailyMissionSnsPopupDone"
        ]
    },
    "AutoDailyMissionSnsPopup": {
        "desc": "弹出了安德烈通讯",
        "recognition": "OCR",
        "roi": [
            680,
            70,
            300,
            90
        ],
        "expected": [
            "^安德烈$",
            "(?i)^Andre$",
            "^アンドレイ$",
            "^안드레$"
        ],
        "next": [
            "AutoDailyMissionSnsPopupDone",
            "AutoDailyMissionSnsPopupReply"
        ]
    },
    "AutoDailyMissionSnsPopupReply": {
        "desc": "点击通讯底部的白色回复按钮",
        "max_hit": 5,
        "recognition": "ColorMatch",
        "roi": [
            690,
            420,
            450,
            230
        ],
        "lower": [
            235,
            235,
            235
        ],
        "upper": [
            255,
            255,
            255
        ],
        "connected": true,
        "count": 3000,
        "action": "Click",
        "next": [
            "AutoDailyMissionSnsPopupDone",
            "AutoDailyMissionSnsPopupReply"
        ]
    },
    "AutoDailyMissionSnsPopupDone": {
        "desc": "通讯结束回到大世界",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "next": [
            "AutoDailyMissionCheckFinished"
        ]
    },
    "AutoDailyMissionArrived": {
        "desc": "已在大世界，执行判定出的日常任务路线",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[Anchor]AutoDailyMissionRoute"
        ]
    }
}
