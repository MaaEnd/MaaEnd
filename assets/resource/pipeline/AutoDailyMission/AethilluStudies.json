    "AutoDailyMissionAethilluStudiesRouteMainSection1": {
        "desc": "走到中层主区第一个异常点对面的平台上",
        "action": "Custom",
        "custom_action": "MapNavigateAction",
        "custom_action_param": {
            "heading_source": "camera",
            "path": [
                {
                    "action": "ZONE",
                    "zone_id": "IndieDg007Base"
                },
                // 从这个传送点走不到异常点那层：平台和异常点之间是深坑，往下跳会掉进坑里被拉回来。
                // 停在平台上离坑边约 2 像素的位置，隔着坑拍；离坑边太近会冲下去
                {
                    "action": "NAVMESH",
                    "target": [
                        356.3,
                        348.4
                    ],
                    "target_deck_y": 136.7
                }
            ]
        },
        "next": [
            "AutoDailyMissionAethilluStudiesTakePhoto"
        ]
    },
    "AutoDailyMissionAethilluStudiesRouteMainSection2": {
        "desc": "从传送点沿走廊走到通往第二个异常点的楼梯口",
        "action": "Custom",
        "custom_action": "MapNavigateAction",
        // 传送点在异常点正上方一层，寻路的起点楼层取的是分层地图的楼层高度，会被吸到异常点那层；
        // 启动时又按平面距离从最近的路点续走，和后面的寻路写在一起会直接跳到异常点、原地判定到达。
        // 所以先单独直线走到楼梯口，那里底下没有别的楼层，再另起一段寻路绕下去；
        // 起步时也会按吸错的楼层用 navmesh 规划一段，要关掉，才能照直走
        "custom_action_param": {
            "heading_source": "camera",
            "enable_bootstrap_navmesh": false,
            "path": [
                {
                    "action": "ZONE",
                    "zone_id": "IndieDg007Base"
                },
                {
                    "action": "RUN",
                    "target": [
                        331.0,
                        446.0
                    ]
                }
            ]
        },
        "next": [
            "AutoDailyMissionAethilluStudiesRouteMainSection2Down"
        ]
    },
