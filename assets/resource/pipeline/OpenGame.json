{
    "OpenGame": {
        "desc": "打开游戏",
        "next": [
            "EnterGame",
            "[JumpBack]EnterGameResourceInitializeComplete",
            "[JumpBack]EnterGameRecognition",
            "[JumpBack]CloudEndfieldStartGame",
            "[JumpBack]CloudEndfieldWaitStartGame",
            "[JumpBack]CloudEndfieldRetry",
            "EnterGameStuck",
            "StartUpGame"
        ]
    },
    "StuckRepairAction": {
        "desc": "尝试修复卡死",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SubTask",
                "custom_action_param": {
                    "sub": [
                        "CloseGame",
                        "ResetEnterGameRecognition"
                    ]
                }
            }
        },
        "next": [
            "StartUpGameRetry",
            "StartUpGameFailed"
        ],
        "focus": {
            "Node.Action.Starting": "$task.OpenGame.focus.stuck_repair"
        }
    },
    "ResetEnterGameRecognition": {
        "desc": "重置公告按钮的命中计数",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClearHitCount",
                "custom_action_param": {
                    "nodes": [
                        "EnterGameRecognition"
                    ]
                }
            }
        }
    },
    "StartUpGameFailed": {
        "desc": "启动游戏失败",
        "focus": {
            "Node.Action.Starting": "$task.OpenGame.focus.start_up_game_failed"
        }
    },
    "EnterGameResourceInitializeComplete": {
        "desc": "识别资源初始化完成",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "EnterGameResourceInitializeCompleteText",
                    "EnterGameResourceInitializeCompleteButton"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "EnterGameResourceInitializeCompleteText": {
        "desc": "识别资源初始化完成文本",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    403,
                    241,
                    472,
                    245
                ],
                "expected": [
                    "资源初始化更新完成，请重启游戏",
                    "資源初始化更新完成，請重啟遊戲",
                    "Resource initialization update completed. Please restart the game.",
                    "リソースの初期化・更新が完了しました。ゲームを再起動してください"
                ]
            }
        }
    },
    "EnterGameResourceInitializeCompleteButton": {
        "desc": "识别资源初始化完成按钮",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    403,
                    241,
                    472,
                    245
                ],
                "expected": [
                    "确认",
                    "確定",
                    "Confirm",
                    "確定"
                ]
            }
        }
    },
    "EnterGame": {
        "desc": "确认进入游戏",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "EnterGameOCR",
                    "EnterGameRecognition"
                ]
            }
        }
    },
    "EnterGameOCR": {
        "desc": "进入游戏识别",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    -250,
                    200,
                    250,
                    400
                ],
                "expected": [
                    "点击任意位置继续",
                    "按下任意位置繼續",
                    "Click to continue",
                    "クリックして続ける",
                    "아무 곳이나 눌러 계속하기"
                ]
            }
        }
    },
    "EnterGameRecognition": {
        // 公告按钮在却一直等不到「点击任意位置继续」（登录失败、渠道要求手动登录），不设上限会在这里无限空转
        "desc": "识别公告按钮",
        "max_hit": 60,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1067,
                    0,
                    213,
                    276
                ],
                "template": [
                    "SceneManager/News.png",
                    "SceneManager/NewsWithRedDot.png"
                ]
            }
        }
    },
    "EnterGameStuck": {
        "desc": "公告按钮还在但 EnterGameRecognition 的命中次数已用尽，按卡死处理",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "EnterGameRecognition"
                ]
            }
        },
        "next": [
            "StuckRepairAction"
        ]
    },
    "StartUpGame": {
        "desc": "启动游戏,由ADB端option进行覆盖",
        "next": [
            "StartUpGameWait"
        ],
        "focus": {
            "Node.Action.Failed": "$task.OpenGame.focus.start_app_failed" //多半是Client选错了
        }
    },
    "StartUpGameRetry": {
        // 刚强杀完没有可识别的界面，回 OpenGame 重新识别没有意义；截图若还停在被杀前的画面，更会对着残影空转
        "desc": "强杀后直接重新拉起，只重试一次",
        "max_hit": 1,
        "next": [
            "StartUpGame"
        ]
    },
    "StartUpGameWait": {
        // 加载期间重复 StartApp 会把渠道 SDK 的登录页顶掉，导致登录失败；拉起后只等不再拉
        "desc": "等游戏自己走到认得的界面",
        "timeout": 90000,
        "next": [
            "EnterGame",
            "[JumpBack]EnterGameResourceInitializeComplete",
            "[JumpBack]EnterGameRecognition",
            "[JumpBack]CloudEndfieldStartGame",
            "[JumpBack]CloudEndfieldWaitStartGame",
            "[JumpBack]CloudEndfieldRetry",
            "EnterGameStuck"
        ],
        "on_error": [
            "StuckRepairAction"
        ]
    },
    "CloudEndfieldStartGame": {
        "desc": "云终末地开始游戏",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    887,
                    522,
                    393,
                    198
                ],
                "expected": [
                    "开始游戏"
                ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "CloudEndfieldWaitStartGame": {
        "desc": "云终末地等待开始游戏",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    350,
                    233,
                    572,
                    346
                ],
                "expected": [
                    "检查网络环境",
                    "游戏启动中"
                ]
            }
        }
    },
    "CloudEndfieldRetry": {
        "desc": "云终末地重试",
        "max_hit": 20,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CloudEndfieldRetryText",
                    "CloudEndfieldRetryButton"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 5000
    },
    "CloudEndfieldRetryText": {
        "desc": "云终末地重试文本",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    410,
                    227,
                    459,
                    262
                ],
                "expected": [
                    "您上次游戏的数据正在火速处理中"
                ]
            }
        }
    },
    "CloudEndfieldRetryButton": {
        "desc": "云终末地重试按钮",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    410,
                    227,
                    459,
                    262
                ],
                "expected": [
                    "知道了"
                ]
            }
        }
    },
    "CloseGame": {
        "desc": "关闭游戏,由ADB端option进行覆盖"
    }
}
