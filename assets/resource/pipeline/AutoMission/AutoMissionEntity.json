{
    "AutoMissionEntity": {
        "desc": "从任意界面回到大世界",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneAnyEnterWorld"
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoMissionEntityTrackCurrentMission"
        ]
    },
    "AutoMissionEntityTrackCurrentMission": {
        "desc": "按追踪当前任务键",
        "pre_delay": 0,
        "action": "ClickKey",
        "key": 86, // V
        "post_delay": 1500, // 等一会看会不会跳出地图追踪
        "rate_limit": 0,
        "next": [
            "AutoMissionEntityQuickTeleportSelect",
            "AutoMissionEntityInWorld"
        ]
    },
    "AutoMissionEntityQuickTeleportSelect": {
        "desc": "不在当前地图点击前往传送",
        "recognition": "And",
        "all_of": [
            "QuickTeleportButton"
        ],
        "pre_wait_freezes": 100,
        "action": "Click",
        "post_wait_freezes": 500,
        "next": [
            "AutoMissionEntityTeleport"
        ]
    },
    "AutoMissionEntityTeleport": {
        "desc": "点击传送",
        "recognition": "And",
        "all_of": [
            "TeleportButton"
        ],
        "action": "Click",
        "next": [
            "AutoMissionEntityInWorld",
            "[JumpBack]SceneWaitLoadingExit"
        ]
    },
    "AutoMissionEntityInWorld": {
        "desc": "已返回大世界，按覆盖的区域和坐标寻路到实体，出现交互提示或进入剧情即停下",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "action": "Custom",
        "custom_action": "MapNavigateAction",
        "post_delay": 1500, // 走到目的地后等一会再继续，部分任务会进入剧情动画
        "next": [
            "AutoMissionEntityActionInteract",
            "AutoMissionEntityActionExitToWorld",
            "[JumpBack]AutoFight",
            "AutoMissionEntityActionMove",
            "AutoMissionEntityActionBackInWorld"
        ]
    },
    "AutoMissionEntityActionInteract": {
        "desc": "走到实体旁边了，出现目标交互文字，可以点击",
        "recognition": "And",
        "all_of": [
            "InWorld",
            "AutoMissionEntityActionInteractRecognition"
        ],
        "box_index": 1,
        "action": "Custom",
        "custom_action": "RepeatUntilNotFoundAction",
        "custom_action_param": {
            "custom_action": "AutoAltClickAction",
            "wait_node": "AutoMissionEntityActionInteractRecognition"
        },
        "post_delay": 1000, // 等待界面跳转
        "next": [
            "AutoMissionEntityActionTakePhoto",
            "AutoMissionEntityActionRepair",
            "AutoMissionEntityActionExitToWorld",
            "AutoMissionEntityActionBackInWorld"
        ]
    },
    "AutoMissionEntityActionTakePhoto": {
        "desc": "交互后进入拍照模式，复用环境监测的拍照流程，拍完经锚点回到本流程",
        "recognition": "And",
        "all_of": [
            "ShutterButton"
        ],
        "anchor": {
            "EnvironmentMonitoringBackToTerminal": "AutoMissionEntityActionPhotoDone"
        },
        "next": [
            "EnvironmentMonitoringWaitShutterButton"
        ]
    },
    "AutoMissionEntityActionPhotoDone": {
        "desc": "拍照完成，关闭照片预览回到大世界",
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneAnyEnterWorld"
            ]
        },
        "next": [
            "AutoMissionEntityActionExitToWorld",
            "AutoMissionEntityActionBackInWorld"
        ]
    },
    "AutoMissionEntityActionRepair": {
        "desc": "修复机器人进入电路拼图，调用拼图解谜",
        "recognition": "And",
        "all_of": [
            "PuzzleSolverOnScenePrepare"
        ],
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "PuzzleSolverMain"
            ]
        },
        "next": [
            "AutoMissionEntityActionExitToWorld",
            "AutoMissionEntityActionBackInWorld"
        ]
    },
    "AutoMissionEntityActionExitToWorld": {
        "desc": "剧情中识别到跳过按钮后，从画面中心悬停移过去并点击",
        "recognition": "TemplateMatch",
        "roi": [
            1140,
            0,
            120,
            90
        ],
        "template": "RealTimeTask/AutoSkipEsc.png",
        "pre_delay": 1000, // 刚进剧情时跳过按钮点了不生效，等一会再点
        "action": "Custom",
        "custom_action": "AutoSwipeClickAction",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoMissionEntityActionExitToWorldConfirm"
        ]
    },
    "AutoMissionEntityActionExitToWorldConfirm": {
        "desc": "确认跳过剧情",
        "recognition": "And",
        "all_of": [
            "YellowConfirmButtonType1"
        ],
        "pre_wait_freezes": 100,
        "action": "Click",
        "post_delay": 1000, // 等待画面过度
        "next": [
            "AutoMissionEntityActionTakePhoto",
            "AutoMissionEntityActionBackInWorld",
            "AutoMissionEntityActionExitToWorld"
        ]
    },
    "AutoMissionEntityActionBackInWorld": {
        "desc": "已回到大世界",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ]
    },
    "AutoMissionEntityActionMove": {
        "desc": "按屏幕上的任务追踪图标走近，直到出现实体交互提示",
        "recognition": "And",
        "all_of": [
            "AutoMissionWorldTrackRecognition"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "MapNavigateAction",
        "custom_action_param": {
            "heading_source": "camera",
            "path": [
                {
                    "action": "FIND",
                    "find_target": "AutoMissionWorldTrackRecognition",
                    "find_stop": "AutoMissionEntityActionInteractRecognition"
                }
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoMissionEntityActionInteract"
        ]
    }
}
