{
    "AutoMissionNpcProxy": {
        "desc": "从任意界面回到大世界",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneAnyEnterWorld"
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoMissionNpcProxyTrackCurrentMission"
        ]
    },
    "AutoMissionNpcProxyTrackCurrentMission": {
        "desc": "按追踪当前任务键",
        "pre_delay": 0,
        "action": "ClickKey",
        "key": 86, // V
        "post_delay": 1500, // 等一会看会不会跳出地图追踪
        "rate_limit": 0,
        "next": [
            "AutoMissionNpcProxyQuickTeleportSelect",
            "AutoMissionNpcProxyInWorld"
        ]
    },
    "AutoMissionNpcProxyQuickTeleportSelect": {
        "desc": "不在当前地图点击前往传送",
        "recognition": "And",
        "all_of": [
            "QuickTeleportButton"
        ],
        "pre_wait_freezes": 100,
        "action": "Click",
        "post_wait_freezes": 500,
        "next": [
            "AutoMissionNpcProxyTeleport"
        ]
    },
    "AutoMissionNpcProxyTeleport": {
        "desc": "点击传送",
        "recognition": "And",
        "all_of": [
            "TeleportButton"
        ],
        "action": "Click",
        "next": [
            "AutoMissionNpcProxyInWorld",
            "[JumpBack]SceneWaitLoadingExit"
        ]
    },
    "AutoMissionNpcProxyInWorld": {
        "desc": "已返回大世界，按覆盖的区域和坐标寻路，进入剧情界面即结束",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "action": "Custom",
        "custom_action": "MapNavigateAction",
        "post_delay": 1500, // 走到目的地后等一会再继续，部分任务会进入剧情动画
        "next": [
            "AutoMissionNpcProxyActionInteract",
            "AutoMissionNpcProxyActionExitToWorld",
            "AutoMissionNpcProxyActionMove"
        ]
    },
    "AutoMissionNpcProxyActionInteract": {
        "desc": "走到NPC旁边了，出现目标交互名称，可以点击",
        "recognition": "And",
        "all_of": [
            "InWorld",
            "AutoMissionNpcProxyActionInteractRecognition"
        ],
        "box_index": 1,
        "action": "Custom",
        "custom_action": "RepeatUntilNotFoundAction",
        "custom_action_param": {
            "custom_action": "AutoAltClickAction",
            "wait_node": "AutoMissionNpcProxyActionInteractRecognition"
        },
        "post_delay": 1000, // 等待界面跳转
        "next": [
            "AutoMissionNpcProxyActionExitToWorld",
            "AutoMissionNpcProxyActionBackInWorld"
        ]
    },
    "AutoMissionNpcProxyActionExitToWorld": {
        "desc": "剧情中识别到跳过按钮后，从画面中心悬停移过去并点击",
        "recognition": "TemplateMatch",
        "roi": [
            1140,
            0,
            120,
            90
        ],
        "template": "RealTimeTask/AutoSkipEsc.png",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "AutoSwipeClickAction",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoMissionNpcProxyActionExitToWorldConfirm"
        ]
    },
    "AutoMissionNpcProxyActionExitToWorldConfirm": {
        "desc": "确认跳过剧情",
        "recognition": "And",
        "all_of": [
            "YellowConfirmButtonType1"
        ],
        "pre_wait_freezes": 100,
        "action": "Click",
        "post_delay": 1000, // 等待画面过度
        "next": [
            "AutoMissionNpcProxyActionBackInWorld",
            "AutoMissionNpcProxyActionExitToWorld"
        ]
    },
    "AutoMissionNpcProxyActionBackInWorld": {
        "desc": "已回到大世界",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ]
    },
    "AutoMissionNpcProxyActionMove": {
        "desc": "按屏幕上的任务追踪图标走近，直到出现 NPC 交互提示",
        "recognition": "And",
        "all_of": [
            "AutoMissionWorldTrackRecognition"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "MapNavigateAction",
        "custom_action_param": {
            "heading_source": "camera",
            "path": [
                {
                    "action": "FIND",
                    "find_target": "AutoMissionWorldTrackRecognition",
                    "find_stop": "AutoMissionNpcProxyActionInteractRecognition"
                }
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoMissionNpcProxyActionInteract"
        ]
    }
}
