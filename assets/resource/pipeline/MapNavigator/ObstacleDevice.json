                "roi": [
                    530,
                    580,
                    130,
                    120
                ],
                "template": [
                    "MapNavigator/ObstacleDevice/MoveAICCoreButton.png"
                ],
                "order_by": "Score"
            }
        }
    },
    "__MapNavigatorObstacleDevice_IsInChatDialog": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    20,
