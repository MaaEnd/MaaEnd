{
    "MapNavigatorObstacleDevice": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "__MapNavigatorObstacleDevice_InteractPre",
            "__MapNavigatorObstacleDevice_NoHit"
        ]
    },
    "__MapNavigatorObstacleDevice_NoHit": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            // Finish pipeline execution
        ]
    },
    "__MapNavigatorObstacleDevice_InteractPre": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    760,
                    330,
                    170,
                    310
                ],
                "template": [
                    "MapNavigator/ObstacleDevice/InteractButton.png"
                ],
                "order_by": "Score"
            }
        },
        "action": {
            "type": "KeyDown",
            "param": {
                "key": 18 // Alt
            }
        },
        "next": [
            "__MapNavigatorObstacleDevice_Interact"
        ]
    },
    "__MapNavigatorObstacleDevice_Interact": {
        "action": {
            "type": "Click",
            "param": {
                "target": "__MapNavigatorObstacleDevice_InteractPre"
            }
        },
        "next": [
            "__MapNavigatorObstacleDevice_InteractPost"
        ]
    },
    "__MapNavigatorObstacleDevice_InteractPost": {
        "action": {
            "type": "KeyUp",
            "param": {
                "key": 18 // Alt
            }
        },
        // 设备框内容淡入慢：实测点击后 0.79s 时按钮只有 0.53~0.65 认不出，1.28s 已到 0.97。
        // 等淡入结束再看，否则会落到兜底的关闭按钮上，框刚开就被关掉。
        "post_delay": 1000,
        "timeout": 5000,
        "rate_limit": 500,
        "next": [
            "__MapNavigatorObstacleDevice_DeleteDevice",
            "__MapNavigatorObstacleDevice_MoveDevice",
            "__MapNavigatorObstacleDevice_MoveAICCore",
            "__MapNavigatorObstacleDevice_SkipChat",
            "__MapNavigatorObstacleDevice_CloseBagDialog",
            "__MapNavigatorObstacleDevice_CloseUnknownDeviceDialog"
        ]
    },
    "__MapNavigatorObstacleDevice_IsInFactoryDeviceDialog": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    950,
                    30,
                    270,
                    230
                ],
                "template": [
                    "MapNavigator/ObstacleDevice/FactoryDeviceDialog.png"
                ],
                "order_by": "Score"
            }
        }
    },
    "__MapNavigatorObstacleDevice_IsDeleteSharedDeviceButton": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    700,
                    120,
                    200,
                    180
                ],
                "template": [
                    "MapNavigator/ObstacleDevice/DeleteSharedDeviceButton.png"
                ],
                "order_by": "Score"
            }
        }
    },
    "__MapNavigatorObstacleDevice_IsMoveDeviceButton": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    700,
                    120,
                    200,
                    180
                ],
                "template": [
                    "MapNavigator/ObstacleDevice/MoveDeviceButton.png"
                ],
                "order_by": "Score"
            }
        }
    },
    "__MapNavigatorObstacleDevice_IsInAICCoreDialog": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    10,
