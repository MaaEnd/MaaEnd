                "order_by": "Score"
            }
        }
    },
    "__MapNavigatorObstacleDevice_IsInBagDialog": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    700,
                    70,
                    130,
                    130
                ],
                "template": [
                    "MapNavigator/ObstacleDevice/BagDialog.png"
                ],
                "order_by": "Score"
            }
        }
    },
    "__MapNavigatorObstacleDevice_IsCloseBagDialogButton": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1050,
