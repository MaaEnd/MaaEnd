                    130,
                    130
                ],
                "template": [
                    "MapNavigator/ObstacleDevice/CloseBagDialogButton.png"
                ],
                "order_by": "Score"
            }
        }
    },
    "__MapNavigatorObstacleDevice_DeleteDevice": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__MapNavigatorObstacleDevice_IsInFactoryDeviceDialog",
                    "__MapNavigatorObstacleDevice_IsDeleteSharedDeviceButton"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "target": [
                520,
                300,
                240,
                120
            ],
            "time": 500,
            "timeout": 10000
        },
        "next": [
            "__MapNavigatorObstacleDevice_DeleteDeviceConfirm"
        ]
    },
    "__MapNavigatorObstacleDevice_DeleteDeviceConfirm": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    750,
                    390,
                    170,
                    160
                ],
                "template": [
                    "Common/Button/YellowConfirmButtonType1.png",
                    "Common/Button/YellowConfirmButtonType1Hover.png"
                ],
                "order_by": "Score"
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500
    },
    "__MapNavigatorObstacleDevice_MoveDevice": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__MapNavigatorObstacleDevice_IsInFactoryDeviceDialog",
