                    90,
                    90
                ],
                "template": [
                    "MapNavigator/ObstacleDevice/ChatDialog.png"
                ],
                "green_mask": true,
                "threshold": 0.6,
                "order_by": "Score"
            }
        }
    },
    "__MapNavigatorObstacleDevice_IsSkipChatButton": {
        "recognition": {
