                ],
                "template": [
                    "MapNavigator/ObstacleDevice/AICCoreDialog.png"
                ],
                "order_by": "Score"
            }
        }
    },
    "__MapNavigatorObstacleDevice_IsMoveAICCoreButton": {
        "recognition": {
