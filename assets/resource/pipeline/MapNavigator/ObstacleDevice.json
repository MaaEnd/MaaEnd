                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 300,
        "next": [
            "__MapNavigatorObstacleDevice_CancelMove"
        ]
    },
    "__MapNavigatorObstacleDevice_MoveAICCore": {
        "recognition": {
