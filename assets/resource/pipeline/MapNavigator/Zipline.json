{
    "MapNavigatorZiplineMountStart": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "MapNavigatorZiplineMountWaitFreezes",
            "MapNavigatorZiplineMountRetryWaitFreezes"
        ]
    },
    "MapNavigatorZiplineMountWaitFreezes": {
        "desc": "上索：识别滑索架交互提示，并等待提示区域稳定",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    755,
                    330,
                    297,
                    312
                ],
                "expected": [
                    "登上滑索架"
                ]
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                755,
                330,
                297,
                312
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "MapNavigatorZiplineMount"
        ]
    },
    "MapNavigatorZiplineMountRetryWaitFreezes": {
        "desc": "上索：首次 OCR 未命中时等待提示区域稳定，随后复核一次",
        "recognition": "DirectHit",
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                755,
                330,
                297,
                312
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "MapNavigatorZiplineMount",
            "MapNavigatorZiplineMountEnd"
        ]
    },
    "MapNavigatorZiplineMount": {
        "desc": "上索：重新识别滑索架交互提示后按住 Alt 点击该提示",
        "recognition": "And",
        "all_of": [
            "MapNavigatorZiplineMountWaitFreezes"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "AutoAltClickAction",
        "post_delay": 0,
        "next": [
            "MapNavigatorZiplineMountEnd"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "识别到滑索架交互提示",
            "Node.Action.Succeeded": {
                "trace": true
            },
            "Node.Action.Failed": {
                "trace": true
            }
        }
    },
    //子任务出口：由 MapNavigator 以 MaaContextRunTask 调起，跑到这里就结束、返回引擎
    "MapNavigatorZiplineMountEnd": {
        "pre_delay": 0,
        "post_delay": 0
    },
    // 上索确认：人站上架子后这条提示就没了，所以「还认得出」等于那一下没按上。
    // 认不出才是想要的结果，所以照样挂上面那个直通的出口兜底，认不出立刻返回而不是耗满超时。
    "MapNavigatorZiplineMountScanStart": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "MapNavigatorZiplineMountScan",
            "MapNavigatorZiplineMountEnd"
        ]
    },
    // 只认图标不认字，为的是不必为一次确认付 OCR 的钱。roi 写 1280x720 基准帧的绝对坐标。
    "MapNavigatorZiplineMountScan": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    755,
                    330,
                    297,
                    312
                ],
                "template": "MapNavigator/Zipline/InteractButton.png",
                "threshold": 0.75
            }
        },
        "pre_delay": 0,
        "post_delay": 0
    },
    "MapNavigatorZiplinePitchReset": {
        "desc": "首次上索后通过相对鼠标移动将镜头拉到俯仰上限，以天空方向作为固定基准；dy 由 MapNavigator 按分辨率覆盖",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "CharacterControllerRelativeMoveAction",
        "custom_action_param": {
            "dx": 0,
            "dy": -1500
        },
        "post_delay": 200,
        "rate_limit": 0
    }
}
