{
    // 仅在 SupplyPlanMain 入口选择一次，领奖后返回已固定的 SupplyPlanDispatch。
    // 数量表达式由 ProtocolSpace 的 SupplyPlanLimits 注入并交给既有 IMS R1 求值。
    // 比例比较采用 库存A * 目标B <= 库存B * 目标A；目标为 0 的项不参与比较。
    // Select 节点固定目标，Continue 节点仅在开关开启且其余目标均达标时取消库存停止条件。
    "SupplyPlanStopWhenAllTargetsMet": {
        "desc": "继续刷取开关关闭时，全部达标则结束；数量表达式由 SupplyPlanLimits 注入",
        "enabled": true,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ItemQuantitySatisfied",
                "custom_recognition_param": {
                    "expression": "false"
                }
            }
        },
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SupplyPlanAllTargetsMet"
        ]
    },
    "SupplyPlanSelect_T_CREDS": {
