{
    "ListCompleteRecognitionExampleGate": {
        "desc": "ListCompleteRecognition 示例：首次截取 roi 模板并返回 true；之后模板相似度 >= threshold 视为到底返回 false，低于阈值则重新截图覆盖模板并返回 true",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ListCompleteRecognition",
                "custom_recognition_param": {
                    // 可选；缺省全屏 [0,0,1280,720]
                    "roi": [
                        480,
                        160,
                        320,
                        400
                    ],
                    // 可选；缺省 0.9。命中（相似度 >= 阈值）视为列表到底
                    "threshold": 0.9
                }
            }
        },
        "action": "DoNothing",
        "next": [
            "ListCompleteRecognitionPass"
        ],
        "attach": {
            "ready": false
        }
    },
    "ListCompleteRecognitionPass": {
        "desc": "列表仍有变化时的后续流程（例如继续滑动）",
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": []
    }
}
