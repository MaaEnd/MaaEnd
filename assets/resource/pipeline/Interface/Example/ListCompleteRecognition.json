{
    "ListCompleteRecognitionExampleScan": {
        "desc": "示例扫描入口：先判到底（ListComplete 命中=已到底），未命中再滑动。滑动须 post_wait_freezes",
        "next": [
            "ListCompleteRecognitionExampleGate",
            "[JumpBack]ListCompleteRecognitionExampleScroll"
        ]
    },
    "ListCompleteRecognitionExampleGate": {
        "desc": "ListCompleteRecognition：命中表示列表已到底；首次只建模板并返回未命中。滑动后须静止再识别",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ListCompleteRecognition",
                "custom_recognition_param": {
                    // 可选；缺省 0.9。命中（相似度 >= 阈值）视为列表到底
                    "threshold": 0.9
                },
                // 识别区域用原生 roi（与 custom_recognition 同级）；省略则为全屏
                "roi": [
                    480,
                    160,
                    320,
                    400
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "ListCompleteRecognitionPass"
        ],
        "attach": {
            "ready": false
        }
    },
    "ListCompleteRecognitionExampleScroll": {
        "desc": "未到底时滑动；post_wait_freezes 后再回到扫描识别",
        "recognition": "DirectHit",
        "action": "Swipe",
        "begin": [
            650,
            470
        ],
        "end": [
            650,
            150
        ],
        "post_wait_freezes": 200
    },
    "ListCompleteRecognitionPass": {
        "desc": "列表已到底后的后续流程",
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": []
    }
}
