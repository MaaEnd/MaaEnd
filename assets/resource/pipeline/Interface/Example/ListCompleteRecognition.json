{
    "ListCompleteRecognitionExampleGate": {
        "desc": "ListCompleteRecognition 示例：首次截取原生 roi 模板并返回 true；之后模板相似度 >= threshold 视为到底返回 false，低于阈值则重新截图覆盖模板并返回 true。滑动后必须 post_wait_freezes 等画面静止，再进入下一轮识别",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ListCompleteRecognition",
                "custom_recognition_param": {
                    // 可选；缺省 0.9。命中（相似度 >= 阈值）视为列表到底
                    "threshold": 0.9
                },
                // 识别区域用原生 roi（与 custom_recognition 同级）；省略则为全屏
                "roi": [
                    480,
                    160,
                    320,
                    400
                ]
            }
        },
        "action": "Swipe",
        "begin": [
            650,
            470
        ],
        "end": [
            650,
            150
        ],
        // 识别依赖静止画面；滑动惯性未停会被当成区域变化而持续滑动
        "post_wait_freezes": 200,
        "next": [
            "ListCompleteRecognitionPass"
        ],
        "attach": {
            "ready": false
        }
    },
    "ListCompleteRecognitionPass": {
        "desc": "列表仍有变化时的后续流程（例如继续滑动）",
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": []
    }
}
