        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__ScenePrivateMpWorldEnterMenuList",
            "[JumpBack]SceneMpAnyEnterWorld"
        ]
    },
    "SceneMpEnterSettings": {
        "desc": "【Mp】从任意界面进入设置的性能与画面页",
