            "[JumpBack]__ScenePrivateMpWorldStorySkip",
            "[JumpBack]__ScenePrivateMpLoggedOutConfirm",
            "[JumpBack]SceneMpWaitLoadingExit",
            "[JumpBack]__ScenePrivateMpAnyExit"
        ]
    },
    "SceneMpEnterMenuList": {
        "desc": "【Mp】从任意界面进入手表菜单（菜单总列表 InMenuList）",
