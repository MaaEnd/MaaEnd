            "__ScenePrivateWorldDijiangEnterFactoryActive",
            "[JumpBack]SceneAnyEnterWorld"
        ]
    },
    "SceneDialogConfirm": {
        "desc": "点击对话框的确认按钮",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "GrayCancelButton",
                    "YellowConfirmButtonType1"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "SceneDialogCancel": {
        "desc": "点击对话框的取消按钮",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "GrayCancelButton",
                    "YellowConfirmButtonType1"
                ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "SceneNoticeRewardsConfirm": {
        "desc": "奖励界面：IMS A3 累加培养道具后，再点击关闭",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InNoticeRewards",
                    "CloseRewardsButton"
                ],
                "box_index": 1
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "threshold": 0.97,
            "timeout": 1500,
            "target": [
                528,
                299,
                222,
                131
            ]
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AddItemData",
                "custom_action_param": {}
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SceneNoticeRewardsConfirmClick"
        ]
    },
    "SceneNoticeRewardsConfirmClick": {
        "desc": "奖励界面：点击 CloseRewardsButton 关闭",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InNoticeRewards",
                    "CloseRewardsButton"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 400,
            "timeout": 2000,
            "target": [
                500,
                0,
                280,
                200
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]SceneNoticeRewardsUpgrade",
            "__ScenePrivateNextTrue"
        ]
    },
