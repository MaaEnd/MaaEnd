{
    // 只能使用本文件中定义的接口，禁止引用 SceneManager 文件夹内的 __ScenePrivate 节点
    "SceneAnyEnterWorld": {
        "desc": "从任意界面进入谷地/武陵/帝江任意一个大世界",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__ScenePrivateCloseADBExit",
            "__ScenePrivateMenuListLoadingEnterWorld",
            "__ScenePrivateMenuListEnterWorld",
            "__ScenePrivateTrialOfSwordmancyEnterWorld",
            "__ScenePrivateAnyEnterWorldSuccess",
            "[JumpBack]__ScenePrivateLogin",
            "[JumpBack]__ScenePrivateNoticeRewardsUpgrade",
            "[JumpBack]__ScenePrivateWorldSpaceExit",
            "[JumpBack]__ScenePrivateWorldStorySkip",
            "[JumpBack]__ScenePrivateLoggedOutConfirm",
            "[JumpBack]SceneWaitLoadingExit",
            "[JumpBack]__ScenePrivateAnyExit"
        ]
    },
    "SceneEnterMapAny": {
        "desc": "从任意界面进入任意一个地图界面",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__ScenePrivateWorldEnterMapAny",
            "[JumpBack]SceneAnyEnterWorld"
        ]
    },
    "SceneEnterWorldFactory": {
        "desc": "从任意界面进入大世界工厂模式",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__ScenePrivateAnyEnterWorldFactorySuccess",
            "__ScenePrivateWorldFactoryDisableEnterFactoryActive",
            "__ScenePrivateWorldFactoryNotActiveEnterFactoryActive",
            "__ScenePrivateWorldDijiangEnterFactoryActive",
            "[JumpBack]SceneAnyEnterWorld"
        ]
    },
    "SceneDialogConfirm": {
        "desc": "点击对话框的确认按钮",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "GrayCancelButton",
                    "YellowConfirmButtonType1"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "SceneDialogCancel": {
        "desc": "点击对话框的取消按钮",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "GrayCancelButton",
                    "YellowConfirmButtonType1"
                ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "SceneNoticeRewardsConfirm": {
        "desc": "奖励界面：IMS A3 累加培养道具后，再点击关闭",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InNoticeRewards",
                    "CloseRewardsButton"
                ],
                "box_index": 1
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "threshold": 0.97,
            "timeout": 1500,
            "target": [
                528,
                299,
                222,
                131
            ]
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AddItemData",
                "custom_action_param": {
                    "items": {
                        "ADVANCED_COGNITIVE_CARRIER": "ADVANCED_COGNITIVE_CARRIER",
                        "ELEMENTARY_COGNITIVE_CARRIER": "ELEMENTARY_COGNITIVE_CARRIER",
                        "ADVANCED_COMBAT_RECORD": "ADVANCED_COMBAT_RECORD",
                        "INTERMEDIATE_COMBAT_RECORD": "INTERMEDIATE_COMBAT_RECORD",
                        "ELEMENTARY_COMBAT_RECORD": "ELEMENTARY_COMBAT_RECORD",
                        "MARK_OF_PERSEVERANCE": "MARK_OF_PERSEVERANCE",
                        "PROTOSET": "PROTOSET",
                        "PROTODISK": "PROTODISK",
                        "TRIPHASIC_NANOFLAKE": "TRIPHASIC_NANOFLAKE",
                        "QUADRANT_FITTING_FLUID": "QUADRANT_FITTING_FLUID",
                        "TACHYON_SCREENING_LATTICE": "TACHYON_SCREENING_LATTICE",
                        "D96_STEEL_SAMPLE_4": "D96_STEEL_SAMPLE_4",
                        "METADIASTIMA_PHOTOEMISSION_TUBE": "METADIASTIMA_PHOTOEMISSION_TUBE",
                        "PROTOHEDRON": "PROTOHEDRON",
                        "PROTOPRISM": "PROTOPRISM",
                        "T_CREDS": "T_CREDS",
                        "OROBERYL": "OROBERYL",
                        "ARMS_INSP_SET": "ARMS_INSP_SET",
                        "ARMS_INSP_KIT": "ARMS_INSP_KIT",
                        "ARMS_INSPECTOR": "ARMS_INSPECTOR",
                        "HEAVY_CAST_DIE": "HEAVY_CAST_DIE",
                        "CAST_DIE": "CAST_DIE",
                        "COOLANT_GEL": "COOLANT_GEL",
                        "WULING_ARTIFICING_CATALYST": "WULING_ARTIFICING_CATALYST"
                    }
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SceneNoticeRewardsConfirmClick"
        ]
    },
    "SceneNoticeRewardsConfirmClick": {
        "desc": "奖励界面：点击 CloseRewardsButton 关闭",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InNoticeRewards",
                    "CloseRewardsButton"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 400,
            "timeout": 2000,
            "target": [
                500,
                0,
                280,
                200
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]__ScenePrivateNoticeRewardsUpgrade",
            "__ScenePrivateNextTrue"
        ]
    },
