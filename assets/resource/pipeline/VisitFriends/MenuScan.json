{
    "VisitFriendsMenuScan": {
        "desc": "识别当前好友列表；备注优先开启时首轮仅 TargetFriendOpenRemark，到底后 RemarkFallback 重开列表再走任意好友",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "[JumpBack]VisitFriendsAssistFullInit",
            "[JumpBack]VisitFriendsAssistFull",
            "[JumpBack]VisitFriendsClueExchangeFull",
            "VisitFriendsMenuScanFriendsFull",
            "[JumpBack]VisitFriendsMenuScanTargetFriendOpenRemark",
            "[JumpBack]VisitFriendsMenuScanTargetFriendOpen",
            "VisitFriendsMenuScanScrollFinish",
            "[JumpBack]VisitFriendsMenuScanScrollList"
        ]
    },
    "VisitFriendsAssistFullInit": {
        "desc": "三舱助力均未勾选时：仅将 AssistCountZero 设为 DirectHit，复用 AssistFull 的关闭/线索模板覆盖",
        "enabled": true,
        "max_hit": 1,
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PipelineOverrideAction",
        "custom_action_param": {
            "patch": {
                "VisitFriendsAssistCountZero": {
                    "recognition": "DirectHit",
                    "focsu": {}
                }
            }
        },
        "post_delay": 0,
        "focus": {
            "Node.Action.Succeeded": "未开启设施助力"
        }
    },
    "VisitFriendsMenuScanVisited": {
        "desc": "选友共享黑名单（attach.visited）；备注/普通消费节点经 visited_node 共用",
        "recognition": "DirectHit",
        "attach": {
            "visited": []
        }
    },
    "VisitFriendsMenuScanSelectFriendRemarkConsumable": {
        "desc": "消费性选友（仅备注）：与普通选友共享 visited；由 TargetFriendOpenRemark 链路调用",
        "recognition": "Custom",
        "custom_recognition": "ExpendableRecognition",
        "custom_recognition_param": {
            "candidate": "VisitFriendsRecognitionItemWithRemark",
            "visited_node": "VisitFriendsMenuScanVisited",
            // 备注形如 小明(Alice#1001)；按第一个 )／）截断，去掉 ) 后 OCR 尾噪。
            "key_regex": ".*?[)）]"
        }
    },
    "VisitFriendsMenuScanSelectFriendConsumable": {
        "desc": "消费性选友（任意好友）：与备注选友共享 visited",
        "recognition": "Custom",
        "custom_recognition": "ExpendableRecognition",
        "custom_recognition_param": {
            "candidate": "VisitFriendsRecognitionItemWithName",
            "visited_node": "VisitFriendsMenuScanVisited",
            // 普通形如 Alice#1001；截到 #数字，去掉 UID 后 OCR 尾噪（Alice#1001小）。
            "key_regex": ".*?\\#\\d+"
        }
    },
    "VisitFriendsMenuScanTargetFriendOpenRemark": {
        "desc": "备注选友链路：名字框 ∧ 进船图标；VisitFriendsRemark=Yes 时仅走本链路；进船点击走 EnterShipRemark",
        "enabled": true,
        "recognition": "And",
        "all_of": [
            "VisitFriendsMenuScanSelectFriendRemarkConsumable",
            "VisitFriendsRecognitionItemEnterButtonByNameRemark"
        ],
        "box_index": 1,
        "pre_delay": 0,
        "action": "Click",
        "post_wait_freezes": 200,
        "post_delay": 0,
        "next": [
            "VisitFriendsCheckAssistRemark",
            "VisitFriendsMenuScanDetailClose"
        ]
    },
    "VisitFriendsMenuScanTargetFriendOpen": {
        "desc": "普通选友链路：名字框 ∧ 进船图标；box_index=1 点击飞船按钮；VisitFriendsRemark=Yes 首轮关闭，Fallback 后开启",
        "recognition": "And",
        "all_of": [
            "VisitFriendsMenuScanSelectFriendConsumable",
            "VisitFriendsRecognitionItemEnterButtonByName"
        ],
        "box_index": 1,
        "pre_delay": 0,
        "action": "Click",
        "post_wait_freezes": 200,
        "post_delay": 0,
        "next": [
            "VisitFriendsCheckAssist",
            "VisitFriendsMenuScanDetailClose"
        ]
    },
    "VisitFriendsCheckAssistRemark": {
        "desc": "备注链路打开详情后检查可访问资源，进船点击复用备注选中的飞船框",
        "recognition": "And",
        "all_of": [
            "VisitFriendsCheckAssist"
        ],
        "pre_wait_freezes": 100,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "VisitFriendsEnterShipRemark"
        ]
    },
    "VisitFriendsMenuScanScrollFinish": {
        "desc": "列表已到底：ListComplete 命中（好友列表区域与上一帧静止模板相似度 >= 0.98）后走备注回退或结束。attach.ready 由 ListCompleteRecognition 维护；备注回退重开前会清空。识别前须由滑动节点 post_wait_freezes 保证画面静止",
        "recognition": "Custom",
        "custom_recognition": "ListCompleteRecognition",
        "custom_recognition_param": {
            "threshold": 0.98
        },
        "roi": [
            46,
            114,
            1052,
            498
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "attach": {
            "ready": false
        },
        "next": [
            "VisitFriendsMenuScanRemarkFallback",
            "VisitFriendsMenuScanScrollFinishDone"
        ]
    },
    "VisitFriendsMenuScanScrollFinishDone": {
        "desc": "好友列表已滚动到底部，拜访完成",
        "pre_delay": 0,
        "post_delay": 0,
        "focus": {
            "Node.Recognition.Succeeded": "好友列表已滚动到底部，拜访完成"
        }
    },
    "VisitFriendsMenuScanRemarkFallback": {
        "desc": "备注优先回退：首轮仅备注扫到底后，关闭备注选友、开启任意选友，清空 visited/滚动模板；max_hit=1 只回退一次；VisitFriendsRemark=Yes 时开启",
        "enabled": false,
        "max_hit": 1,
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PipelineOverrideAction",
        "custom_action_param": {
            "patch": {
                "VisitFriendsMenuScanTargetFriendOpenRemark": {
                    "enabled": false
                },
                "VisitFriendsMenuScanTargetFriendOpen": {
                    "enabled": true
                },
                "VisitFriendsMenuScanVisited": {
                    "attach": {
                        "visited": []
                    }
                },
                "VisitFriendsMenuScanScrollFinish": {
                    "attach": {
                        "ready": false
                    }
                }
            }
        },
        "post_delay": 0,
        "next": [
            "VisitFriendsMenuScanRemarkFallbackReopen"
        ],
        "focus": {
            "Node.Action.Succeeded": "备注好友已扫完，重新打开列表并拜访任意好友"
        }
    },
    "VisitFriendsMenuScanRemarkFallbackReopen": {
        "desc": "退出至大世界后重新打开好友列表，使列表回到顶部后再进入扫描",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneAnyEnterWorld",
                "SceneEnterMenuFriendsList"
            ]
        },
        "post_delay": 0,
        "next": [
            "VisitFriendsMenu"
        ]
    },
    "VisitFriendsMenuScanFriendsFull": {
        "desc": "拜访好友已达到上限：助力次数与线索交换次数均归零",
        "recognition": "And",
        "all_of": [
            "VisitFriendsAssistCountZero",
            "VisitFriendsClueExchangeCountZero"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "focus": {
            "Node.Recognition.Succeeded": "拜访好友次数已满，停止拜访"
        }
    },
    "VisitFriendsMenuScanScrollList": {
        "desc": "列表未到底时向下滚动：ListComplete 未命中时落到本节点。滑动后 post_wait_freezes 等列表静止再回到扫描，否则惯性会被当成画面变化而无法判定到底",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Swipe",
        "begin": [
            650,
            470
        ],
        "end": [
            650,
            150
        ],
        "end_hold": 600, // 太短了松开会晃动
        "post_wait_freezes": 200,
        "post_delay": 0
    },
    "VisitFriendsCheckAssist": {
        "desc": "打开好友详情后检查可访问资源（识别②）：线索交换固定开启；助力子节点未勾选时为 OCR a^，勾选后覆盖为 TemplateMatch",
        "recognition": "Or",
        "any_of": [
            "VisitFriendsCheckAssistClueExchange",
            "VisitFriendsCheckAssistControlNexus",
            "VisitFriendsCheckAssistMFGCabin",
            "VisitFriendsCheckAssistGrowthChamber"
        ],
        "pre_wait_freezes": 100,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "VisitFriendsEnterShip"
        ]
    },
    "VisitFriendsCheckAssistClueExchange": {
        "desc": "检查是否可线索交换（固定开启，不可关闭）",
        "recognition": "OCR",
        "roi": [
            312,
            316,
            658,
            172
        ],
        "expected": [
            "情报交流进行中",
            "情報交流進行中",
            "Clue Exchange in Progress",
            "情報共有中",
            "정보 교류 중"
        ]
    },
    "VisitFriendsCheckAssistControlNexus": {
        "desc": "检查总控中枢可助力；默认 OCR a^ 永不命中，由 ProductionAssistControl 选项覆盖为模板识别",
        "recognition": "OCR",
        "expected": [
            "a^"
        ]
    },
    "VisitFriendsCheckAssistMFGCabin": {
        "desc": "检查制造舱可助力；默认 OCR a^ 永不命中，由 ProductionAssistControl 选项覆盖为模板识别",
        "recognition": "OCR",
        "expected": [
            "a^"
        ]
    },
    "VisitFriendsCheckAssistGrowthChamber": {
        "desc": "检查培养舱可助力；默认 OCR a^ 永不命中，由 ProductionAssistControl 选项覆盖为模板识别",
        "recognition": "OCR",
        "expected": [
            "a^"
        ]
    },
    "VisitFriendsMenuScanDetailClose": {
        "desc": "关闭好友船详情",
        "recognition": "And",
        "all_of": [
            "GrayCancelButton"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_wait_freezes": 400,
        "post_delay": 0
    }
}
