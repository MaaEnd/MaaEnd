{
    "ProtocolSpaceOperationalManualOpen": {
        "desc": "进入行动手册菜单；每次进入时清零右侧列表的滚动次数上限",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    215,
                    60
                ],
                "expected": [
                    "行动手册",
                    "行動手冊",
                    "(?i)Operational\\s*Manual",
                    "案内所",
                    "작전 매뉴얼"
                ]
            }
        },
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "ClearHitCount",
        "custom_action_param": {
            "nodes": [
                "ProtocolSpaceOperationalManualScrollList"
            ]
        },
        "post_delay": 0,
        "next": [
            "ProtocolSpaceOperationalManualSwitchIndexTab"
        ]
    },
    "ProtocolSpaceOperationalManualSwitchIndexTab": {
        "desc": "在行动手册界面，切换到索引标签页",
        "recognition": "OCR",
        "roi": [
            150,
            50,
            1000,
            150
        ],
        "expected": [
            "索引",
            "(?i)Index",
            "協約空間"
        ],
        "action": "Custom",
        "custom_action": "RepeatUntilFoundAction",
        "custom_action_param": {
            "action": "Click",
            "wait_nodes": [
                "ProtocolSpaceOperationalManualSwitchProtocolSpaceTab"
            ]
        },
        "next": [
            "ProtocolSpaceOperationalManualSwitchProtocolSpaceTab"
        ]
    },
    "ProtocolSpaceOperationalManualSwitchProtocolSpaceTab": {
        "desc": "在行动手册界面，切换到协议空间对应标签页",
        "recognition": "OCR",
        "roi": [
            60,
            190,
            350,
            430
        ],
        "expected": [
            "员养成",
            "員養成",
            "Operator Progression"
        ],
        "pre_wait_freezes": 200,
        "action": "Click",
        "anchor": {
            "ProtocolSpaceOperationalManualFindProtocolSpaceEnableAnchor": "ProtocolSpaceOperationalManualFindProtocolSpaceNormalEnable",
            "ProtocolSpaceOperationalManualFindProtocolSpaceDisableAnchor": "ProtocolSpaceOperationalManualFindProtocolSpaceNormalDisable"
        },
        "post_wait_freezes": 400,
        "next": [
            "[Anchor]ProtocolSpaceOperationalManualFindProtocolSpaceEnableAnchor",
            "[Anchor]ProtocolSpaceOperationalManualFindProtocolSpaceDisableAnchor",
            "ProtocolSpaceOperationalManualScrollEnd",
            "[JumpBack]ProtocolSpaceOperationalManualScrollList",
            "ProtocolSpaceOperationalManualScrollNotFound"
        ]
    },
    "ProtocolSpaceOperationalManualScrollList": {
        "desc": "滚动右侧模拟空间列表；最多 12 次（max_hit，每次进入行动手册时由 ProtocolSpaceOperationalManualOpen 清零），用尽后由 ProtocolSpaceOperationalManualScrollNotFound 按未找到收尾，避免模板不命中时无限滚动",
        "max_hit": 12,
        "action": "Swipe",
        "begin": [
            950,
            500
        ],
        "end": [
            950,
            280
        ],
        "end_hold": 200,
        "post_wait_freezes": {
            "time": 200,
            "target": [
                825,
                210,
                280,
                350
            ]
        }
    },
    "ProtocolSpaceOperationalManualScrollNotFound": {
        "desc": "滚动次数用尽仍未找到目标条目，按未找到收尾",
        "recognition": "DirectHit",
        "focus": {
            "Node.Recognition.Succeeded": "$task.ProtocolSpace.focus.sim_entry_not_found"
        }
    },
    "ProtocolSpaceOperationalManualScrollEnd": {
        "desc": "右侧滚动模拟空间列表找到最后一个item图标，表示到末尾了",
        "recognition": "TemplateMatch",
        "roi": [
            400,
            180,
            200,
            500
        ],
        "template": "ProtocolSpace/SkillUp.png",
        "threshold": 0.8, // 条目图标边缘细节密集，半像素错位就会掉 0.05~0.10，0.9 没有余量（PlayCover 实测 0.85），回落到协议默认值 0.8
        "focus": {
            "Node.Recognition.Succeeded": "$task.ProtocolSpace.focus.sim_entry_not_found"
        }
    },
    "ProtocolSpaceFindTargetRecognition": {
        "desc": "找协议空间入口图标",
        "recognition": "TemplateMatch",
        "roi": [
            400,
            180,
            200,
            500
        ],
        "template": "ProtocolSpace/OperatorEXP.png",
        "threshold": 0.8 // 同为行动手册条目图标，0.9 对跨平台渲染差异没有余量
    },
    "ProtocolSpaceEnterButtonEnableRecognition": {
        "desc": "找协议空间入口已解锁按钮",
        "recognition": "OCR",
        "roi": "ProtocolSpaceFindTargetRecognition",
        "roi_offset": [
            400,
            0,
            150,
            0
        ],
        "expected": [
            "前往",
            "Go"
        ]
    },
    "ProtocolSpaceEnterButtonDisableRecognition": {
        "desc": "找协议空间入口未解锁按钮",
        "recognition": "OCR",
        "roi": "ProtocolSpaceFindTargetRecognition",
        "roi_offset": [
            400,
            0,
            150,
            0
        ],
        "expected": [
            "查看",
            "View"
        ]
    },
    "ProtocolSpaceOperationalManualFindProtocolSpaceNormalEntryColor": {
        "desc": "在当前页面找协议空间入口的颜色特征",
        "recognition": "ColorMatch",
        "roi": "ProtocolSpaceFindTargetRecognition",
        "roi_offset": [
            300,
            -50,
            150,
            0
        ],
        "lower": [
            30,
            30,
            30
        ],
        "upper": [
            70,
            70,
            70
        ],
        "count": 500
    },
    "ProtocolSpaceOperationalManualFindProtocolSpaceNormalDisable": {
        "desc": "在当前页面找普通协议空间入口，未开启",
        "recognition": "And",
        "all_of": [
            "ProtocolSpaceFindTargetRecognition",
            "ProtocolSpaceEnterButtonDisableRecognition",
            "ProtocolSpaceOperationalManualFindProtocolSpaceNormalEntryColor"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$task.ProtocolSpace.focus.not_open"
        }
    },
    "ProtocolSpaceOperationalManualFindProtocolSpaceNormalEnable": {
        "desc": "在当前页面找普通协议空间入口，已开启",
        "recognition": "And",
        "all_of": [
            "ProtocolSpaceFindTargetRecognition",
            "ProtocolSpaceEnterButtonEnableRecognition",
            "ProtocolSpaceOperationalManualFindProtocolSpaceNormalEntryColor"
        ],
        "box_index": 1,
        "action": "Click",
        "next": [
            "ProtocolSpaceNormalPrepareEnter"
        ]
    },
    "ProtocolSpaceOperationalManualFindProtocolSpaceDeepDiveEntryColor": {
        "desc": "在当前页面找协议空间入口危境在现的颜色特征",
        "recognition": "ColorMatch",
        "roi": "ProtocolSpaceFindTargetRecognition",
        "roi_offset": [
            300,
            -50,
            150,
            0
        ],
        // 该条目红色与灰色两种状态都要算命中，任一色域命中即可
        "lower": [
            [
                180,
                5,
                45
            ],
            [
                30,
                30,
                30
            ]
        ],
        "upper": [
            [
                255,
                40,
                65
            ],
            [
                70,
                70,
                70
            ]
        ],
        "count": 500
    },
    "ProtocolSpaceOperationalManualFindProtocolSpaceDeepDiveDisable": {
        "desc": "在当前页面找深潜协议空间入口，未开启",
        "recognition": "And",
        "all_of": [
            "ProtocolSpaceFindTargetRecognition",
            "ProtocolSpaceEnterButtonEnableRecognition",
            "ProtocolSpaceOperationalManualFindProtocolSpaceDeepDiveEntryColor"
        ],
        "box_index": 1,
        "focus": {
            "Node.Recognition.Succeeded": "$task.ProtocolSpace.focus.not_open"
        }
    },
    "ProtocolSpaceOperationalManualFindProtocolSpaceDeepDiveEnable": {
        "desc": "在当前页面找深潜协议空间入口，已开启",
        "recognition": "And",
        "all_of": [
            "ProtocolSpaceFindTargetRecognition",
            "ProtocolSpaceEnterButtonEnableRecognition",
            "ProtocolSpaceOperationalManualFindProtocolSpaceDeepDiveEntryColor"
        ],
        "box_index": 1,
        "action": "Click",
        "next": [
            "ProtocolSpaceDeepDivePrepareEnter"
        ]
    }
}
