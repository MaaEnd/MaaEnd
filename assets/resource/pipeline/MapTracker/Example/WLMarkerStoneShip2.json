{
    "SceneEnterWorldWulingMarkerStone_Ship2Destination": {
        "desc": "从任意界面通过首墩【湖心岛】宏2摆渡船前往【栖云林地】西侧港口",
        "pre_delay": 0,
        "anchor": {
            "__WLMarkerStoneShip2_ShipGetOffSuccess": "__WLMarkerStoneShip2_Exit"
        },
        "post_delay": 0,
        "next": [
            "__WLMarkerStoneShip2_Teleport"
        ]
    },
    "SceneEnterWorldWulingMarkerStone_Ship2DestinationThenWalkAndFight": {
        "desc": "从任意界面通过首墩【湖心岛】宏2摆渡船前往【栖云林地】西侧港口，到达后向东走到交叉路口并战斗",
        "pre_delay": 0,
        "anchor": {
            "__WLMarkerStoneShip2_ShipGetOffSuccess": "__WLMarkerStoneShip2_WalkAndFight"
        },
        "post_delay": 0,
        "next": [
            "__WLMarkerStoneShip2_Teleport"
        ]
    },
    "__WLMarkerStoneShip2_Teleport": {
        "desc": "传送到首墩湖心岛",
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneEnterWorldWulingMarkerStone2"
            ]
        },
        "next": [
            "__WLMarkerStoneShip2_TeleportSuccess"
        ]
    },
    "__WLMarkerStoneShip2_TeleportSuccess": {
        "desc": "断言传送后的位置正确",
        "recognition": "Custom",
        "custom_recognition": "MapTrackerAssertLocation",
        "custom_recognition_param": {
            "expected": [
                {
                    "map_name": "map02_lv004",
                    "target": [
                        408.9,
                        307.8,
                        18.3,
                        19.1
                    ]
                }
            ]
        },
        "next": [
            "__WLMarkerStoneShip2_ShipCheckIn"
        ]
    },
    "__WLShip_IsInteractButtonIcon": {
        "desc": "寻找通用交互按钮图标（仅识别）",
        "recognition": "TemplateMatch",
        "roi": [
            760,
            330,
            170,
            310
        ],
        "template": "MapNavigator/ObstacleDevice/InteractButton.png",
        "order_by": "Score"
    },
    "__WLMarkerStoneShip2_IsInteractButtonText": {
        "desc": "寻找传播交互按钮文字“林地北”或“呼叫竹筏”（仅识别）",
        "recognition": "OCR",
        "roi": "__WLShip_IsInteractButtonIcon",
        "roi_offset": [
            0,
            0,
            150,
            0
        ],
        "expected": [
            "呼|叫|竹|筏", // 简体中文
            "林地|北", // 简体中文
            "呼|叫|竹|筏", // 繁體中文
            "林地|北", // 繁體中文
            "Call|Raft", // English
            "Cloudrest|Woods\\s+N", // English
            "いかだ|を呼ぶ", // 日本語
            "栖雲林|北" // 日本語
        ]
    },
    "__WLMarkerStoneShip2_ShipCheckIn": {
        "desc": "走到船只停靠处，随后寻找交互按钮（如果没找到则重头来过）",
        "action": "Custom",
        "custom_action": "MapTrackerMove",
        "custom_action_param": {
            "map_name": "map02_lv004",
            "path": [
                [
                    419.3,
                    319.3
                ],
                [
                    423.1,
                    317.6
                ]
            ],
            "rotation_lower_threshold": 3,
            "rotation_upper_threshold": 15,
            "no_ensure_initial_movement_state": true,
            "on_finish": {
                "action": "Custom",
                "custom_action": "MapTrackerToward",
                "custom_action_param": {
                    "angle": 0, // 面向北方
                    "rotation_threshold": 30 // 不用面向得那么精确
                }
            }
        },
        "post_delay": 1500, // 等待玩家止步
        "timeout": 4000, // 随后要求在 4 秒内找到 ShipDeparture 节点中的按钮
        "rate_limit": 500, // 每 0.5 秒尝试找一次
        "next": [
            "__WLMarkerStoneShip2_ShipDeparture"
        ],
        "on_error": [
            "__WLMarkerStoneShip2_ShipDepartureFailure"
        ]
    },
    "__WLMarkerStoneShip2_ShipDeparture": {
        "desc": "点击交互按钮，随后等待离港成功（如果点到呼叫船只按钮而非下一站按钮，则会离港失败，此时重头来过）",
        "recognition": "And",
        "all_of": [
            "__WLShip_IsInteractButtonIcon",
            "__WLMarkerStoneShip2_IsInteractButtonText"
        ],
        "box_index": 1,
        "action": "Custom",
        "custom_action": "AutoAltClickAction",
        "timeout": 5500, // 随后要求在 5.5 秒内离港成功
        "rate_limit": 500, // 每 0.5 秒判断一次离港状态
        "next": [
            "__WLMarkerStoneShip2_ShipDepartureSuccess"
        ],
        "on_error": [
            "__WLMarkerStoneShip2_ShipDepartureFailure"
        ]
    },
    "__WLMarkerStoneShip2_ShipDepartureSuccess": {
        "desc": "判断是否离港成功，让角色视角回正",
        "recognition": "And",
        "all_of": [
            "__WLMarkerStoneShip2_TeleportSuccess"
        ],
        "inverse": true, // 反转表示离开了传送点范围，也就是离港成功
        "action": "Click",
        "target": [
            600,
            320,
            80,
            80
        ],
        "contact": 2, // 鼠标中键
        "next": [
            "__WLMarkerStoneShip2_ShipDepartureSuccessPost"
        ]
    },
    "__WLMarkerStoneShip2_ShipDepartureSuccessPost": {
        "desc": "让角色面向南方以方便下船，随后等待到站",
        "action": "Custom",
        "custom_action": "MapTrackerToward",
        "custom_action_param": {
            "angle": 180,
            "rotation_threshold": 30
        },
        "timeout": 45000, // 随后要求在 45 秒内到站
        "rate_limit": 2000, // 每 2 秒判断一次到站状态
        "next": [
            "__WLMarkerStoneShip2_ShipArrival"
        ]
    },
    "__WLMarkerStoneShip2_ShipDepartureFailure": {
        "desc": "登船或离港失败，尝试重新走一边流程",
        "max_hit": 5, // 最多重试 5 次
        "next": [
            "__WLMarkerStoneShip2_Teleport"
        ]
    },
    "__WLMarkerStoneShip2_ShipArrival": {
        "desc": "判断是否到站，随后走到下船位置",
        "recognition": "Custom",
        "custom_recognition": "MapTrackerAssertLocation",
        "custom_recognition_param": {
            "expected": [
                {
                    "map_name": "map02_lv004",
                    "target": [
                        384.2,
                        445.6,
                        8.5,
                        12.5
                    ]
                }
            ]
        },
        "post_delay": 1500, // 等待船只停稳
        "next": [
            "__WLMarkerStoneShip2_ShipGetOff"
        ]
    },
    "__WLMarkerStoneShip2_ShipGetOff": {
        "desc": "走到下船位置",
        "action": "Custom",
        "custom_action": "MapTrackerMove",
        "custom_action_param": {
            "map_name": "map02_lv004",
            "path": [
                [
                    390.9,
                    454.3
                ]
            ],
            "rotation_lower_threshold": 3,
            "rotation_upper_threshold": 15,
            "no_ensure_initial_movement_state": true,
            "stuck_threshold": 6000
        },
        "next": [
            "[Anchor]__WLMarkerStoneShip2_ShipGetOffSuccess"
        ]
    },
    "__WLMarkerStoneShip2_WalkAndFight": {
        "desc": "从下船港口向东走到交叉路口，随后解决可能的战斗",
        "action": "Custom",
        "custom_action": "MapTrackerGoal",
        "custom_action_param": {
            "map_name": "map02_lv004",
            "target": [
                436.8,
                471.7
            ],
            "arrival_threshold": 5.0, // 附近可能有敌人，所以先不用那么精确到位
            "fine_approach": "Never",
            "no_ensure_initial_movement_state": true
        },
        "next": [
            "[JumpBack]AutoFight",
            "__WLMarkerStoneShip2_WalkAndFightSuccess"
        ]
    },
    "__WLMarkerStoneShip2_WalkAndFightSuccess": {
        "desc": "可能的战斗结束后，恢复性地走回刚才的交叉路口",
        "action": "Custom",
        "custom_action": "MapTrackerGoal",
        "custom_action_param": {
            "map_name": "map02_lv004",
            "target": [
                436.8,
                471.7
            ]
        },
        "next": [
            "__WLMarkerStoneShip2_Exit"
        ]
    },
    "__WLMarkerStoneShip2_Exit": {
        "desc": "所有流程结束",
        "pre_delay": 0,
        "post_delay": 0
    }
}
