{
    "MapTrackerBigMap_OpenBigMap": {
        "desc": "打开大地图界面",
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 5000,
        "next": [
            "SceneEnterMapAny"
        ]
    },
    "MapTrackerBigMap_FilterNone": {
        "desc": "在大地图界面，确保不显示任何图标",
        "pre_delay": 0,
        "anchor": {
            "MapTrackerAfterOpenFiltersDialog": "__MapTrackerBigMap_InFiltersDialog",
            "MapTrackerAfterInFiltersDialog": "__MapTrackerBigMap_ClearFilters",
            "MapTrackerAfterClearFilters": "__MapTrackerBigMap_CloseFilterDialog"
        },
        "post_delay": 0,
        "timeout": 5000,
        "next": [
            "__MapTrackerBigMap_OpenFiltersDialog",
            "__MapTrackerBigMap_InFiltersDialog"
        ]
    },
    "MapTrackerBigMap_FilterOnlyZipline": {
        "desc": "在大地图界面，确保仅显示滑索架图标",
        "pre_delay": 0,
        "anchor": {
            "MapTrackerAfterOpenFiltersDialog": "__MapTrackerBigMap_InFiltersDialog",
            "MapTrackerAfterInFiltersDialog": "__MapTrackerBigMap_ClearFilters",
            "MapTrackerAfterClearFilters": "__MapTrackerBigMap_SwipeDownFiltersDialog",
            "MapTrackerAfterSwipeDownFiltersDialog": "__MapTrackerBigMap_ClickFilterZipline",
            "MapTrackerAfterClickFilterZipline": "__MapTrackerBigMap_CloseFilterDialog"
        },
        "post_delay": 0,
        "timeout": 5000,
        "next": [
            "__MapTrackerBigMap_OpenFiltersDialog",
            "__MapTrackerBigMap_InFiltersDialog"
        ]
    },
    "MapTrackerBigMap_DeleteSelectedSharedZipline": {
        "desc": "等待候选点交互稳定；存在删除按钮时删除，否则视为非滑索并结束共享滑索清理",
        "pre_wait_freezes": {
            "target": [
                930,
                0,
                350,
                720
            ],
            "time": 200,
            "timeout": 5000
        },
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 5000,
        "rate_limit": 0,
        "next": [
            "__MapTrackerBigMap_ClickDeleteSelectedSharedZipline",
            "__MapTrackerBigMap_HandleNonZiplineCandidate"
        ]
    },
    "__MapTrackerBigMap_ClickDeleteSelectedSharedZipline": {
        "desc": "点击已选中共享滑索架的删除按钮",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    960,
                    610,
                    180,
                    100
                ],
                "template": "MapTracker/BigMap/DeleteSharedZiplineButton.png",
                "green_mask": true,
                "threshold": 0.7,
                "order_by": "Score"
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "target": [
                1060,
                640,
                50,
                50
            ],
            "time": 200,
            "timeout": 5000
        },
        "timeout": 5000,
        "next": [
            "__MapTrackerBigMap_AfterHandleSharedZiplineCandidate"
        ]
    },
    "__MapTrackerBigMap_HandleNonZiplineCandidate": {
        "desc": "画面稳定后未识别到删除按钮，关闭当前非滑索交互",
        "recognition": {
            "type": "DirectHit"
        },
        "pre_delay": 0,
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 27
            }
        },
        "post_wait_freezes": {
            "target": [
                930,
                0,
                350,
                720
            ],
            "time": 200,
            "timeout": 5000
        },
        "post_delay": 0,
        "timeout": 5000,
        "rate_limit": 0,
        "next": [
            "__MapTrackerBigMap_AfterHandleSharedZiplineCandidate"
        ]
    },
    "__MapTrackerBigMap_AfterHandleSharedZiplineCandidate": {
        "desc": "确认共享滑索架详情或非滑索交互已关闭并回到大地图",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1210,
                    160,
                    70,
                    400
                ],
                "template": [
                    "MapTracker/BigMapZoomIn.png",
                    "MapTracker/BigMapZoomOut.png"
                ],
                "threshold": 0.75,
                "order_by": "Score"
            }
        },
        "timeout": 5000
    },
    "__MapTrackerBigMap_OpenFiltersDialog": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    50,
                    600,
                    300,
                    100
                ],
                "template": [
                    "MapTracker/BigMap/FiltersOff.png",
                    "MapTracker/BigMap/FiltersOn.png"
                ],
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "next": [
            "[Anchor]MapTrackerAfterOpenFiltersDialog"
        ]
    },
    "__MapTrackerBigMap_InFiltersDialog": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    5,
                    5,
                    95,
                    95
                ],
                "template": "MapTracker/BigMap/FiltersDialog.png",
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "[Anchor]MapTrackerAfterInFiltersDialog"
        ]
    },
    "__MapTrackerBigMap_ClearFilters": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    50,
                    600,
                    350,
                    100
                ],
                "template": [
                    "Common/Button/WhiteConfirmButtonType1.png",
                    "Common/Button/WhiteConfirmButtonType1Hover.png"
                ],
                "order_by": "Horizontal",
                "index": 0
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "next": [
            "[Anchor]MapTrackerAfterClearFilters"
        ]
    },
    "__MapTrackerBigMap_SwipeDownFiltersDialog": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    50,
                    600,
                    350,
                    100
                ],
                "template": "Common/Button/WhiteConfirmButtonType1.png",
                "order_by": "Random"
            }
        },
        "pre_delay": 250,
        "action": {
            "type": "Swipe",
            "param": {
                "begin_offset": [
                    0,
                    -200,
                    0,
                    0
                ],
                "end_offset": [
                    0,
                    -400,
                    0,
                    0
                ]
            }
        },
        "post_delay": 250,
        "next": [
            "[Anchor]MapTrackerAfterSwipeDownFiltersDialog"
        ]
    },
    "__MapTrackerBigMap_ClickFilterZipline": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    10,
                    40,
                    490,
                    630
                ],
                "template": "MapTracker/BigMap/FilterZiplineOff.png",
                "order_by": "Score"
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "next": [
            "[Anchor]MapTrackerAfterClickFilterZipline"
        ]
    },
    "__MapTrackerBigMap_CloseFilterDialog": {
        "pre_delay": 0,
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    -41,
                    1,
                    40,
                    40
                ]
            }
        }
    }
}
