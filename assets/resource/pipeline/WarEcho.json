    "WarEchoChallenge": {
        "desc": "已选中普通或困难（青色竖条在这两行），点击开始挑战；残酷选中时也可能有开始挑战按钮，必须排除",
        "recognition": "And",
        "all_of": [
            "WarEchoDetailIn",
            {
                "recognition": "ColorMatch",
                "roi": [
                    18,
                    150,
                    16,
                    116
                ],
                "lower": [
                    0,
                    200,
                    200
                ],
                "upper": [
                    80,
                    255,
                    255
                ],
                "count": 400
            },
            {
                "recognition": "OCR",
                "roi": [
                    960,
                    625,
                    320,
                    80
                ],
                "expected": [
                    "开始挑战",
                    "開始挑戰"
                ]
            }
        ],
        "box_index": 2,
        "action": "Click",
        "next": [
            "WarEchoPrepareIn"
        ]
    },
    "WarEchoPrepareIn": {
        "desc": "在编队准备界面：左上角队伍图标；每次进入编队（即开始新的难度）清零失败重试计数",
        "recognition": "TemplateMatch",
        "roi": [
            0,
            0,
            100,
            100
        ],
        "template": "ProtocolSpace/TeamChooseIcon.png",
        "threshold": 0.9,
        "pre_wait_freezes": 300,
        "action": "Custom",
        "custom_action": "ClearHitCount",
        "custom_action_param": {
            "nodes": [
                "WarEchoFightFailedRetry"
            ]
        },
        "next": [
            "[JumpBack]PrepareTeamChoose",
            "WarEchoConfirm"
        ]
    },
    "WarEchoConfirm": {
        "desc": "在编队准备界面，点击开始挑战进入战斗",
        "recognition": "And",
        "all_of": [
            "WarEchoPrepareIn",
            "YellowConfirmButtonType2"
        ],
        "box_index": 1,
        "pre_wait_freezes": 300,
        "action": "Click",
        "next": [
            "WarEchoStageStart"
        ]
    },
    "WarEchoStageStart": {
        "desc": "进入关卡后（新开一关或失败重试都会经过）：清零向光点移动的步数，等待加载，关闭机制特性弹窗，已开战则进入战斗，关卡目标为触摸光点则先走触摸路径",
        "action": "Custom",
        "custom_action": "ClearHitCount",
        "custom_action_param": {
            "nodes": [
                "WarEchoTouchMove"
            ]
        },
        "next": [
            "[JumpBack]WarEchoMechanismPopupClose",
            "WarEchoFightStart",
            "WarEchoTouchMove",
            "[JumpBack]SceneWaitLoadingExit"
        ]
    },
    "WarEchoMechanismPopupClose": {
        "desc": "部分设备在关卡开始时会弹出「机制特性」提示，点击右上角 X 关闭；识别复用协议空间的同名弹窗节点，关闭后回到 WarEchoStageStart 继续判断",
        "recognition": "And",
        "all_of": [
            "ProtocolSpaceMechanismPopupClose"
        ],
        "action": "Click",
        "post_delay": 400 // 等待提示关闭，大世界界面无法使用wait_freeze
    },
    "WarEchoFightStart": {
        "desc": "左侧出现重开按钮，说明战斗已开始",
        "recognition": "TemplateMatch",
        "roi": [
            0,
            200,
            160,
            200
        ],
        "template": "ProtocolSpace/SpaceResart.png",
        "green_mask": true,
        "next": [
            "WarEchoFighting"
        ]
    },
    "WarEchoFighting": {
        "desc": "战斗开始后：自动战斗，直到出现胜利或失败结算界面",
        "next": [
            "WarEchoFightSuccess",
            "WarEchoFightFailed",
            "[JumpBack]SceneWaitLoadingExit",
            "[JumpBack]AutoFight"
        ]
    },
    "WarEchoTouchObjective": {
        "desc": "左侧关卡目标为触摸光点，需要先触碰光点才会开始战斗",
        "recognition": "OCR",
        "roi": [
            50,
            200,
            240,
            35
        ],
        "expected": [
            "触摸光点",
            "觸摸光點",
            "(?i)Touch\\s*the\\s*light",
            "光に触れる",
            "빛나는 점과 접촉하기"
        ]
    },
    "WarEchoTouchStart": {
        "desc": "出现触碰提示，触碰光点开始战斗",
        "recognition": "And",
        "all_of": [
            "InProtocolSpace",
            "ProtocolSpaceTouchStartPrompt"
        ],
        "box_index": 1,
        "action": "Custom",
        "custom_action": "RepeatUntilNotFoundAction",
        "custom_action_param": {
            "custom_action": "AutoAltClickAction",
            "wait_node": "ProtocolSpaceTouchStartPrompt"
        },
        "next": [
            "WarEchoFightStart"
        ]
    },
    "WarEchoTouchMove": {
        "desc": "关卡目标为触摸光点，向前移动一步；存在视角锁定，锁定过程中没有什么特征可以识别，因此最多前进 12 步（max_hit，在 WarEchoStageStart 清零），之后改为识别光点并向其移动",
        "max_hit": 12,
        "recognition": "And",
        "all_of": [
            "InProtocolSpace",
            "WarEchoTouchObjective"
        ],
        "action": "Custom",
        "custom_action": "CharacterControllerForwardAxisAction",
        "custom_action_param": {
            "axis": 1
        },
        "post_delay": 800, // 等待移动结束，大世界界面无法使用wait_freeze
        "next": [
            "WarEchoTouchStart",
            "WarEchoTouchMove",
            "[JumpBack]WarEchoTouchMoveToTarget",
            "[JumpBack]WarEchoTouchNotFound"
        ]
    },
    "WarEchoTouchMoveToTarget": {
        "desc": "向前移动后仍未出现触碰提示，识别光点并向其移动",
        "recognition": "And",
        "all_of": [
            "InProtocolSpace",
