{
    "WarEchoEntry": {
        "desc": "战争回响任务入口，强制重新进入战争回响首页",
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneEnterMenuOperationalManualWarEcho"
            ]
        },
        "next": [
            "WarEchoSelectFirstBoss"
        ]
    },
    "WarEchoSelectFirstBoss": {
        "desc": "在战争回响首页，点击第一个 Boss 的名字进入详情",
        "recognition": "And",
        "all_of": [
            "InOperationalManualWarEcho",
            {
                "recognition": "OCR",
                "roi": [
                    0,
                    490,
                    1280,
                    60
                ],
                "order_by": "Horizontal"
            }
        ],
        "box_index": 1,
        "action": "Click",
        "next": [
            "WarEchoSelectCruel"
        ]
    },
    "WarEchoDetailIn": {
        "desc": "在战争回响 Boss 详情界面：左上角当前星数",
        "recognition": "OCR",
        "roi": [
            0,
            90,
            320,
            55
        ],
        "expected": [
            "当前星数",
            "當前星數"
        ]
    },
    "WarEchoSelectCruel": {
        "desc": "在详情界面残酷行未选中时点击残酷行：选中状态的对勾有动画，先把选中移到残酷，普通、困难两行的对勾才是静态的；残酷未解锁时也能选中",
        "recognition": "And",
        "all_of": [
            "WarEchoDetailIn",
            {
                "recognition": "OCR",
                "roi": [
                    40,
                    272,
                    270,
                    60
                ],
                "expected": [
                    "残酷",
                    "殘酷"
                ]
            }
        ],
        "box_index": 1,
        // 等残酷行文字停止滑入；不等整个难度列表，已通关且选中的行对勾有动画
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                100,
                280,
                110,
                40
            ]
        },
        "action": "Click",
        "next": [
            "WarEchoCruelSelected"
        ]
    },
    "WarEchoCruelSelected": {
        "desc": "残酷行已选中：行左侧出现青色竖条",
        "recognition": "And",
        "all_of": [
            "WarEchoDetailIn",
            {
                "recognition": "ColorMatch",
                "roi": [
                    18,
                    278,
                    16,
                    52
                ],
                "lower": [
                    0,
                    200,
                    200
                ],
                "upper": [
                    80,
                    255,
                    255
                ],
                "count": 400
            }
        ],
        // 等普通、困难两行从选中状态退回静止，此时两行对勾都是静态的
        "pre_wait_freezes": {
            "time": 200,
            "target": [
                0,
                145,
                320,
                125
            ]
        },
        "next": [
            "WarEchoNormalUncleared",
            "WarEchoHardUncleared",
            "WarEchoNextBoss1",
            "WarEchoNextBoss2",
            "WarEchoAllCleared"
        ]
    },
    "WarEchoNormalCleared": {
        "desc": "普通行右侧有已通关对勾（仅在该行未选中时可靠）",
