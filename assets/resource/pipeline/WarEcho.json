        "box_index": 1,
        "action": "Custom",
        "custom_action": "CharacterMoveToTargetAction",
        "custom_action_param": {
            "align_threshold": 120
        },
        "post_delay": 600
    },
    "WarEchoTouchNotFound": {
        "desc": "光点未找到，向右旋转",
        "recognition": "And",
