            "InProtocolSpace",
            "WarEchoTouchObjective"
        ],
        "action": "Custom",
        "custom_action": "CharacterMoveToTargetNotFoundAction",
        "custom_action_param": {
            "delta": 45
        }
    },
    "WarEchoFightFinished": {
        "desc": "战斗结算界面（胜利或失败），供 AutoFight 的 pause_exit_nodes 使用",
        "recognition": "Or",
        "any_of": [
            "WarEchoFightSuccessText",
            "CheckOperationFailedText"
        ]
