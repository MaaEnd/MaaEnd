        ],
        "focus": {
            "Node.Action.Failed": "$task.AutoStockStaple.focus.quantity_control.purchase_page_failed"
        }
    },
    "AutoStockSwipeWuling": {
        "desc": "向下滑动寻找商品，直到找到商品或到达底部",
        "max_hit": 25,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InWulingText",
                    "InStapleColor"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    240,
                    500
                ],
                "end": [
                    [
                        240,
                        400
                    ],
                    [
                        360,
                        400
                    ]
                ],
                "end_hold": 200
            }
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [
                89,
                200,
                99,
                176
            ]
        }
    },
    "AutoStockNoMoreTargetWuling": {
        "desc": "滑动次数用完仍在物资调度页：列表已到底且没有符合条件的商品，结束当前区域",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InWulingText",
                    "InStapleColor"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    // 售罄文案只出现在列表末尾，命中即表示已经滑到底：先点分类图标把列表重置回顶部，再按右上角「余额/上限」分流。
    "AutoStockSoldOutWuling": {
        "desc": "武陵已售罄：重置列表后判断调度券是否已超过上限",
        "max_hit": 1, // 命中后回到列表继续购买，次数用尽可避免再次进入本分支死循环
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    274,
                    720
                ],
                "expected": [
                    "已售罄",
                    "已售完",
                    "(?i)Sold\\s*Out",
                    "完売"
                ],
                "replace": [
                    "馨",
                    "罄"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockResetListViewWuling",
            "AutoStockResetListViewViaLastWuling",
            "AutoStockStockBillOverflowWuling",
            "EmptyNode"
        ]
    },
    "AutoStockResetListViewWuling": {
        "desc": "武陵重置列表：点击第一个分类图标回到顶部",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    10,
                    120,
                    50,
                    480
                ],
                "template": "AutoStockStaple/CategoryFirstButton.png",
                "threshold": 0.85
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockStockBillOverflowWuling",
            "EmptyNode"
        ]
    },
    "AutoStockResetListViewViaLastWuling": {
        "desc": "武陵第一个分类已选中时：先点最后一个分类再点第一个，强制列表回到顶部",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    10,
                    120,
                    50,
                    480
                ],
                "template": "AutoStockStaple/CategoryLastButton.png",
                "threshold": 0.85
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockResetListViewWuling"
        ]
    },
    "AutoStockStockBillOverflowWuling": {
        "desc": "武陵调度券余额大于上限（券已溢出）",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ExpressionRecognition",
                "custom_recognition_param": {
                    "expression": "{AutoStockCurrentStockBill}>{AutoStockCurrentStockBillCap}"
                }
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "$task.AutoStockStaple.focus.stock_bill_overflow.wuling",
                "display": [
                    "log",
                    "notification"
                ]
            }
        }
    }
}
