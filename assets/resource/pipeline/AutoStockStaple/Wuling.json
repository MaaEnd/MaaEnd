    "AutoStockListCompleteWuling": {
        "desc": "比较列表静止画面，确认武陵物资列表已经到底",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ListCompleteRecognition",
                "custom_recognition_param": {
                    "threshold": 0.95
                },
                "roi": [
                    65,
                    200,
                    1075,
                    360
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "attach": {
            "ready": false
        }
    },
    "AutoStockSwipeWuling": {
        "desc": "向下滑动寻找商品；不设次数上限，何时停止由售罄与列表到底识别器决定",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InWulingText",
                    "InStapleColor"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    1200,
                    500
                ],
                "end": [
                    1200,
                    400
                ],
                "end_hold": 200,
                "duration": 100
            }
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [
                89,
                200,
                99,
                176
            ]
        }
    }
}
