{
    "AutoStockInStapleWuling": {
        "desc": "识别当前处于武陵界面，并进入囤货界面",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InWulingText",
                    "InStapleColor",
                    "InStockStaple"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockTargetCanNotBuyWuling",
            "[JumpBack]AutoStockBuyItemWulingTaskEngravingPermit",
            "[JumpBack]AutoStockBuyItemWulingTaskArtificingCatalyst",
            "[JumpBack]AutoStockBuyItemWulingTaskDaily",
            "[JumpBack]AutoStockBuyItemWulingTaskIndustrial",
            "[JumpBack]AutoStockBuyItemWulingTaskCultural",
            "SoldOut",
            "AutoStockListCompleteWuling",
            "[JumpBack]AutoStockSwipeWuling"
        ]
    },
    "AutoStockTargetCompareWuling": {
        "desc": "识别目标调度券是否不可购买",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ExpressionRecognition",
                "custom_recognition_param": {
                    "expression": "240000> {AutoStockCurrentStockBill}"
                }
            }
        }
    },
    "AutoStockTargetCanNotBuyWuling": {
        "desc": "识别目标调度券是否不可购买",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InStapleColor",
                    "AutoStockTargetCompareWuling"
                ]
            }
        }
    },
    // 每个折扣分组对应一条购买任务：命中该分组的商品名白名单 + 该分组折扣档位后才点击商品。
    "AutoStockBuyItemWulingTaskEngravingPermit": {
        "desc": "识别武陵刻写券，并进入购买流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoStockInStapleItem",
                    "AutoStockInStapleItemNameEngravingPermit_Expected",
                    "AutoStockInStapleItemDiscountsWulingEngravingPermit"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilFoundAction",
                "custom_action_param": {
                    "action": "Click",
                    "wait_nodes": [
                        "AutoStockStapleQuantityControl"
                    ]
                },
                "target_offset": [
                    -45,
                    85,
                    -30,
                    0
                ]
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockStapleQuantityControl"
        ],
        "focus": {
            "Node.Action.Failed": "$task.AutoStockStaple.focus.quantity_control.purchase_page_failed"
        }
    },
    "AutoStockBuyItemWulingTaskArtificingCatalyst": {
        "desc": "识别武陵精锻助剂，并进入购买流程",
