    "AutoStockSwipeToMax": {
        "desc": "识别滑动按钮，用于滑动到最大库存",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    55,
                    53,
                    333,
                    167
                ],
                "expected": [
                    "购买商品",
                    "購買商品",
                    "(?i)Purchase",
                    "購入"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "BetterSliding",
                "custom_action_param": {
                    "Direction": "right"
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockSwipeBuy"
        ]
    },
    "AutoStockSwipeBuy": {
        "desc": "识别确认购买按钮，用于确认购买",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "YellowConfirmButtonType1",
                    "ConfirmBuyText"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "AutoStockpileCheckBuyResult"
        ]
    },
    "AutoStockCurrentStockBill": {
        "desc": "识别当前库存票据，用于获取当前库存",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CurrentStockBillColor",
                    "CurrentStockBillText"
                ],
                "box_index": 1
            }
        }
    },
    "AutoStockStapleBetterSliding": {
        "desc": "自动购买稳定物资 - BetterSliding 精确滑动到指定数量",
        "enabled": false,
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "BetterSliding",
                "custom_action_param": {
                    "ClampTargetToSliderMax": true,
                    "DecreaseButton": {
                        "template": "AutoStockpile/DecreaseButton.png"
                    },
                    "Direction": "right",
                    "IncreaseButton": {
                        "template": "AutoStockpile/IncreaseButton.png"
                    },
                    "SliderQuantity": {
                        "roi": [
                            375,
                            508,
                            36,
                            24
                        ],
                        "only_rec": true
                    }
                    //"SliderQuantity": {
                    //    "roi": [
                    //        375,
                    //        508,
                    //        36,
                    //        24
                    //    ],
                    //    "only_rec": true
                    //},
                    //"SliderQuantityFilter": {
                    //    "lower": [
                    //        28,
                    //        100,
                    //        100
                    //    ],
                    //    "upper": [
                    //        28,
                    //        255,
                    //        255
                    //    ],
                    //    "method": 40
                    //}
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockStapleQuantityControlConfirmBuy"
        ],
        "focus": {
            "Node.Action.Failed": "$task.AutoStockStaple.focus.quantity_control.better_sliding_failed"
        },
        "attach": {
            "TargetQuantity": 10 //这里会被 custom 程序覆盖后运行
        }
    }
