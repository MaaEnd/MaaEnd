{
    "AutoStockInStapleItem": {
        "desc": "识别商品基准点(剩余刷新时间框)，用于后续识别",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "method": 40,
                "lower": [
                    [
                        76,
                        200,
                        200
                    ],
                    [
                        24,
                        250,
                        250
                    ],
                    [
                        160,
                        255,
                        217
                    ]
                ],
                "upper": [
                    [
                        76,
                        255,
                        215
                    ],
                    [
                        24,
                        255,
                        255
                    ],
                    [
                        160,
                        255,
                        217
                    ]
                ],
                "connected": true,
                "count": 300,
                "order_by": "Vertical"
            }
        }
    },
    "AutoStockInStapleItemNameLabelColor": {
        "desc": "稳定物资商品名称标签颜色（相对刷新时间锚点）",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "AutoStockInStapleItem",
                "roi_offset": [
                    -4,
                    163,
                    88,
                    22
                ],
                "method": 6,
                "lower": [
                    0
                ],
                "upper": [
                    160
                ],
                "connected": true,
                "count": 1500,
                "order_by": "Area"
            }
        }
    },
    "AutoStockInStapleItemNameTextColor": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "AutoStockInStapleItemNameLabelColor",
                "method": 6,
                "lower": [
                    180
                ],
                "upper": [
                    255
                ],
                "count": 10
            }
        }
    },
    // 折扣分组：每个分组自带 attach 白名单与折扣档位，勾选商品时把别名写入所属分组的商品名 OCR 节点，
    // 折扣节点再按该分组的档位筛选，因此日用/工业/特产与刻写券/精锻助剂可以分别设置折扣。
    "AutoStockInStapleItemNameDaily": {
        "desc": "识别日用消耗组商品名称",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "AutoStockInStapleItemNameTextColor",
                "roi_offset": [
                    -2,
                    -2,
                    4,
                    4
                ],
                "expected": [],
                "only_rec": true,
                "order_by": "Vertical"
            }
        }
    },
