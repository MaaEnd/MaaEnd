{
    "AutoStockStapleBagFullDetect": {
        "desc": "识别背包已满提示",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    482,
                    85,
                    308,
                    78
                ],
                "expected": [
                    "背包已满，无法购买",
                    "背包已滿，無法購買"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "AutoStockStapleBagFullCloseBuyWindow": {
        "desc": "关闭购买窗口",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CloseButtonType1"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 200,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockStapleBagFullStash"
        ]
    },
    "AutoStockStapleBagFullStash": {
        "desc": "调用存放背包子任务整理背包",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SubTask",
                "custom_action_param": {
                    "sub": [
                        "StashBackpackSubTask"
                    ]
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockStapleBagFullResetLocation"
        ]
    },
    "AutoStockStapleBagFullResetLocation": {
        "desc": "清空谷地与武陵购买阶段的命中计数，重启后两地可重新执行",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClearHitCount",
                "custom_action_param": {
                    "nodes": [
                        "AutoStockStapleValleyIV",
                        "AutoStockStapleWuling"
                    ]
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockStapleMain"
        ]
    },
    "AutoStockStapleBagFullHandler": {
        "desc": "背包已满处理入口，整理一次无效则放弃",
        "max_hit": 1,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoStockStapleBagFullDetect"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockStapleBagFullCloseBuyWindow"
        ]
    },
    "AutoStockStapleBagFullGiveUp": {
        "desc": "整理背包无效后放弃本次购买",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoStockStapleBagFullDetect"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockStapleBagFullCloseBuyWindowGiveUp"
        ]
    },
    "AutoStockStapleBagFullCloseBuyWindowGiveUp": {
        "desc": "关闭购买窗口并结束本次任务",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CloseButtonType1"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 200,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "StopNode"
        ]
    }
}
