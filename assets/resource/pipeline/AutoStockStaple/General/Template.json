{
    "ConfirmBuyText": {
        "desc": "识别当前确认购买按钮文本",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "YellowConfirmButtonType1",
                "roi_offset": [
                    -163,
                    -25,
                    176,
                    43
                ],
                "expected": [
                    "确认购买",
                    "確定購買",
                    "(?i)Purchase",
                    "確定"
                ]
            }
        }
    },
    "CurrentStockBillColor": {
        "desc": "识别当前调度券颜色",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    1073,
                    0,
                    123,
                    49
                ],
                "method": 6,
                "lower": [
                    170
                ],
                "upper": [
                    255
                ]
            }
        }
    },
    "CurrentStockBillText": {
        "desc": "识别当前调度券数量",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "CurrentStockBillColor",
                "roi_offset": [
                    -2,
                    -2,
                    4,
                    4
                ],
                "expected": [
                    "\\d+"
                ],
                "only_rec": true,
                "color_filter": "CurrentStockBillColor"
            }
        }
    },
    // 右上角读数形如「4504万/4600万」，斜杠左为余额、右为本地区上限。
    // 上限文字是灰色，加 color_filter 会被连同斜杠一起过滤掉，所以下面两个节点不加颜色过滤，
    // 改用 roi_offset 把 CurrentStockBillColor 的框向右扩到「/上限」处，再用 replace 各取一侧。
    "CurrentStockBillBalanceText": {
        "desc": "识别右上角调度券余额（当前/上限 中斜杠左侧）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "CurrentStockBillColor",
                "roi_offset": [
                    -2,
                    -2,
                    96,
                    4
                ],
                "expected": [
                    "\\d"
                ],
                "replace": [
                    [
                        "/.*",
                        ""
                    ]
                ],
                "only_rec": true
            }
        }
    },
    "CurrentStockBillCapText": {
        "desc": "识别右上角调度券上限（当前/上限 中斜杠右侧）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "CurrentStockBillColor",
                "roi_offset": [
                    -2,
                    -2,
                    96,
                    4
                ],
                "expected": [
                    "\\d"
                ],
                "replace": [
                    [
                        "^[^/]*/",
                        ""
                    ]
                ],
                "only_rec": true
            }
        }
    }
}
