{
    "ConfirmBuyText": {
        "desc": "识别当前确认购买按钮文本",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "YellowConfirmButtonType1",
                "roi_offset": [
                    -163,
                    -25,
                    176,
                    43
                ],
                "expected": [
                    "确认购买",
                    "確定購買",
                    "(?i)Purchase",
                    "確定"
                ]
            }
        }
    },
    "CurrentStockBillColor": {
        "desc": "识别当前调度券颜色",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    1073,
                    0,
                    123,
                    49
                ],
                "method": 6,
                "lower": [
                    170
                ],
                "upper": [
                    255
                ]
            }
        }
    },
    "CurrentStockBillText": {
        "desc": "识别当前调度券数量",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "CurrentStockBillColor",
                "roi_offset": [
                    -2,
                    -2,
                    4,
                    4
                ],
                "expected": [
                    "\\d+"
                ],
                "only_rec": true,
                "color_filter": "CurrentStockBillColor"
            }
        }
    },
    // 右上角读数形如「4504万/4600万」，斜杠左为余额、右为本地区上限。
    // 余额直接复用上面的 AutoStockCurrentStockBill（亮色数字）；上限是灰色数字，亮色过滤拿不到，
    // 所以用一个大范围 RGB 灰阶匹配把「/上限」这段灰字框出来，再按这个框做 OCR。
    "CurrentStockBillCapColor": {
        "desc": "识别调度券上限文字颜色（「余额/上限」斜杠右侧的灰色数字）",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    1040,
                    0,
                    220,
                    60
                ],
                "method": 4,
                "lower": [
                    140,
                    140,
                    140
                ],
                "upper": [
                    185,
                    185,
                    185
                ]
            }
        }
    },
    "CurrentStockBillCapText": {
        "desc": "识别右上角调度券上限（当前/上限 中斜杠右侧）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "CurrentStockBillCapColor",
                "roi_offset": [
                    -2,
                    -2,
                    4,
                    4
                ],
                "expected": [
                    "\\d+"
                ],
                "color_filter": "CurrentStockBillCapColor"
            }
        }
    },
    "AutoStockCurrentStockBillCap": {
        "desc": "识别当前调度券上限，用于和余额比较是否溢出",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CurrentStockBillCapColor",
                    "CurrentStockBillCapText"
                ],
                "box_index": 1
            }
        }
    }
}
