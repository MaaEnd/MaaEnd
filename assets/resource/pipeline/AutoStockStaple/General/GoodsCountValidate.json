{
    "AutoStockStapleGoodsCountValidate": {
        "desc": "物品数量验证",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoStockStapleGoodsCountValidateArea",
                    "AutoStockStapleGoodsCountValidateColor",
                    "AutoStockStapleGoodsCountValidateText"
                ],
                "box_index": 2
            }
        }
    },
    "AutoStockStapleGoodsCountValidateArea": {
        "desc": "物品数量验证区域",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    1036,
                    189,
                    50,
                    17
                ],
                "method": 6,
                "lower": [
                    90
                ],
                "upper": [
                    100
                ],
                "connected": true,
                "count": 10
            }
        }
    },
    "AutoStockStapleGoodsCountValidateText": {
        "desc": "物品数量验证文本",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "AutoStockStapleGoodsCountValidateColor",
                "roi_offset": [
                    -2,
                    -2,
                    4,
                    4
                ],
                "expected": [
                    "\\d+"
                ],
                "only_rec": true
            }
        }
    },
    "AutoStockStapleGoodsCountValidateColor": {
        "desc": "物品数量验证颜色",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "AutoStockStapleGoodsCountValidateArea",
                "method": 6,
                "lower": [
                    160
                ],
                "upper": [
                    255
                ]
            }
        }
    },
