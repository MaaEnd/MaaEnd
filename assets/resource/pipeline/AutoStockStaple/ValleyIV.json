{
    "AutoStockInStapleValleyIV": {
        "desc": "识别当前处于四号谷地界面，并进入囤货界面",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InValleyIVText",
                    "InStapleColor",
                    "InStockStaple"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockTargetCanNotBuyValleyIV",
            "[JumpBack]AutoStockBuyItemValleyIVTaskEngravingPermit",
            "[JumpBack]AutoStockBuyItemValleyIVTaskDaily",
            "[JumpBack]AutoStockBuyItemValleyIVTaskIndustrial",
            "[JumpBack]AutoStockBuyItemValleyIVTaskCultural",
            "AutoStockSoldOutValleyIV",
            "[JumpBack]AutoStockSwipeValleyIV",
            "AutoStockNoMoreTargetValleyIV"
        ]
    },
    "AutoStockTargetCompareValleyIV": {
        "desc": "识别目标调度券是否不可购买",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ExpressionRecognition",
                "custom_recognition_param": {
                    "expression": "240000> {AutoStockCurrentStockBill}"
                }
            }
        }
    },
    "AutoStockTargetCanNotBuyValleyIV": {
        "desc": "识别目标调度券是否不可购买",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InStapleColor",
                    "AutoStockTargetCompareValleyIV"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    // 每个折扣分组对应一条购买任务：命中该分组的商品名白名单 + 该分组折扣档位后才点击商品。
    "AutoStockBuyItemValleyIVTaskEngravingPermit": {
        "desc": "识别四号谷地刻写券，并进入购买流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoStockInStapleItem",
                    "AutoStockInStapleItemNameEngravingPermit_Expected",
                    "AutoStockInStapleItemDiscountsValleyIVEngravingPermit"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilFoundAction",
                "custom_action_param": {
                    "action": "Click",
                    "wait_nodes": [
                        "AutoStockStapleQuantityControl"
                    ]
                },
                "target_offset": [
                    -45,
                    85,
                    -30,
                    0
                ]
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockStapleQuantityControl"
        ],
        "focus": {
            "Node.Action.Failed": "$task.AutoStockStaple.focus.quantity_control.purchase_page_failed"
        }
    },
    "AutoStockBuyItemValleyIVTaskDaily": {
        "desc": "识别四号谷地日用消耗类商品，并进入购买流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoStockInStapleItem",
                    "AutoStockInStapleItemNameDaily_Expected",
                    "AutoStockInStapleItemDiscountsValleyIVDaily"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilFoundAction",
                "custom_action_param": {
                    "action": "Click",
                    "wait_nodes": [
                        "AutoStockStapleQuantityControl"
                    ]
                },
                "target_offset": [
                    -45,
                    85,
                    -30,
                    0
                ]
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockStapleQuantityControl"
        ],
        "focus": {
            "Node.Action.Failed": "$task.AutoStockStaple.focus.quantity_control.purchase_page_failed"
        }
    },
    "AutoStockBuyItemValleyIVTaskIndustrial": {
        "desc": "识别四号谷地工业货品类商品，并进入购买流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoStockInStapleItem",
                    "AutoStockInStapleItemNameIndustrial_Expected",
                    "AutoStockInStapleItemDiscountsValleyIVIndustrial"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilFoundAction",
                "custom_action_param": {
                    "action": "Click",
                    "wait_nodes": [
                        "AutoStockStapleQuantityControl"
                    ]
                },
                "target_offset": [
                    -45,
                    85,
                    -30,
                    0
                ]
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockStapleQuantityControl"
        ],
        "focus": {
            "Node.Action.Failed": "$task.AutoStockStaple.focus.quantity_control.purchase_page_failed"
        }
    },
    "AutoStockBuyItemValleyIVTaskCultural": {
        "desc": "识别四号谷地人文物产类商品，并进入购买流程",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoStockInStapleItem",
                    "AutoStockInStapleItemNameCultural_Expected",
                    "AutoStockInStapleItemDiscountsValleyIVCultural"
                ],
                "box_index": 2
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilFoundAction",
                "custom_action_param": {
                    "action": "Click",
                    "wait_nodes": [
                        "AutoStockStapleQuantityControl"
                    ]
                },
                "target_offset": [
                    -45,
                    85,
                    -30,
                    0
                ]
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockStapleQuantityControl"
        ],
        "focus": {
            "Node.Action.Failed": "$task.AutoStockStaple.focus.quantity_control.purchase_page_failed"
        }
    },
    "AutoStockSwipeValleyIV": {
        "desc": "向下滑动寻找商品，直到找到商品或到达底部",
        "max_hit": 25,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InValleyIVText",
                    "InStapleColor"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    240,
                    500
                ],
                "end": [
                    [
                        240,
                        400
                    ],
                    [
                        360,
                        400
                    ]
                ],
                "end_hold": 200
            }
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [
                89,
                200,
                99,
                176
            ]
        }
    },
    "AutoStockNoMoreTargetValleyIV": {
        "desc": "滑动次数用完仍在物资调度页：列表已到底且没有符合条件的商品，结束当前区域",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InValleyIVText",
                    "InStapleColor"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    // 售罄文案只出现在列表末尾，命中即表示已经滑到底：先点分类图标把列表重置回顶部，再按右上角「余额/上限」分流。
    "AutoStockSoldOutValleyIV": {
        "desc": "四号谷地已售罄：重置列表后判断调度券是否已超过上限",
        "max_hit": 1, // 命中后回到列表继续购买，次数用尽可避免再次进入本分支死循环
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    274,
                    720
                ],
                "expected": [
                    "已售罄",
                    "已售完",
                    "(?i)Sold\\s*Out",
                    "完売"
                ],
                "replace": [
                    "馨",
                    "罄"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockResetListViewValleyIV",
            "AutoStockResetListViewViaLastValleyIV",
            "AutoStockStockBillOverflowValleyIV",
            "EmptyNode"
        ]
    },
    "AutoStockResetListViewValleyIV": {
        "desc": "四号谷地重置列表：点击第一个分类图标回到顶部",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    10,
                    120,
                    50,
                    480
                ],
                "template": "AutoStockStaple/CategoryFirstButton.png",
                "threshold": 0.85
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockStockBillOverflowValleyIV",
            "EmptyNode"
        ]
    },
    "AutoStockResetListViewViaLastValleyIV": {
        "desc": "四号谷地第一个分类已选中时：先点最后一个分类再点第一个，强制列表回到顶部",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    10,
                    120,
                    50,
                    480
                ],
                "template": "AutoStockStaple/CategoryLastButton.png",
                "threshold": 0.85
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoStockResetListViewValleyIV"
        ]
    },
    "AutoStockStockBillOverflowValleyIV": {
        "desc": "四号谷地调度券余额大于上限（券已溢出）",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ExpressionRecognition",
                "custom_recognition_param": {
                    "expression": "{CurrentStockBillBalanceText}>{CurrentStockBillCapText}"
                }
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "$task.AutoStockStaple.focus.stock_bill_overflow.valley_iv",
                "display": [
                    "log",
                    "notification"
                ]
            }
        }
    }
}
