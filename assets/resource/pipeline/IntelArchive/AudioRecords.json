{
    "IntelArchiveSyncAudioRecords": {
        "desc": "同步音像存档",
        "enabled": false,
        "max_hit": 1,
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SubTask",
                "custom_action_param": {
                    "sub": [
                        "SceneEnterMenuIntelArchiveAudioRecords"
                    ]
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]IntelArchiveSyncAudioRecordsClickMediaTab",
            "EmptyNode"
        ]
    },
    "IntelArchiveSyncAudioRecordsClickMediaTab": {
        "desc": "点击左侧「多媒体」页签（ROI 侧栏，需实机微调）",
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    16,
                    80,
                    230,
                    400
                ],
                "expected": [
                    "多媒体"
                ]
            }
        },
        "pre_delay": 0,
        "action": "Click",
        "post_wait_freezes": {
            "time": 100,
            "target": [
                280,
                100,
                960,
                560
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "IntelArchiveSyncAudioRecordsScanMedia"
        ]
    },
    "IntelArchiveSyncAudioRecordsScanMedia": {
        "desc": "「多媒体」页签扫描循环：先判到底，未到底则扫一屏并下滑",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "IntelArchiveSyncAudioRecordsScrollFinishMedia",
            "[JumpBack]IntelArchiveSyncAudioRecordsScanAndScroll"
        ]
    },
    "IntelArchiveSyncAudioRecordsScrollFinishMedia": {
        "desc": "「多媒体」列表已到底，结束本页签 JumpBack",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ListCompleteRecognition",
                "custom_recognition_param": {
                    "threshold": 0.98
                },
                "roi": [
                    280,
                    100,
                    960,
                    560
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Recognition.Succeeded": "多媒体列表已滚动到底部"
        },
        "attach": {
            "ready": false
        }
    },
    "IntelArchiveSyncAudioRecordsScanAndScroll": {
        "desc": "本屏 OCR 入库；省略号条目交给 ResolveTruncatedItems",
        "max_hit": 100,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "IntelArchiveScanItems"
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "IntelArchiveResolveTruncatedItems"
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "IntelArchiveSyncAudioRecordsScroll"
        ]
    },
    "IntelArchiveSyncAudioRecordsScroll": {
        "desc": "列表下滑；静止后移鼠标到左上角复位",
        "recognition": {
            "type": "DirectHit"
        },
        "pre_delay": 0,
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    760,
                    520
                ],
                "end": [
                    760,
                    200
                ],
                "end_hold": 600
            }
        },
        "post_wait_freezes": {
            "time": 200,
            "target": [
                280,
                100,
                960,
                560
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "MouseMoveReset"
        ]
    }
}
