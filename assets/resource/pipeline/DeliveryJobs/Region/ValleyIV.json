{
    "DeliveryJobsAutoValleyIV": {
        "desc": "自动选择四号谷地运送委托",
        "recognition": "Or",
        "any_of": [
            "InRegionalDevelopmentValleyIV",
            "DeliveryJobsInValleyIVLocalDepotNode"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsValleyIV",
            "DeliveryJobsLoop"
        ]
    },
    "DeliveryJobsValleyIV": {
        "desc": "四号谷地运送委托",
        "max_hit": 1,
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneEnterMenuRegionalDevelopmentValleyIV"
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsDepotLocked",
            "DeliveryJobsValleyIVLoop"
        ]
    },
    "DeliveryJobsValleyIVLoop": {
        "desc": "四号谷地运送委托主循环",
        "max_hit": 1,
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneEnterMenuRegionalDevelopmentValleyIVDepotNode"
            ]
        },
        "anchor": {
            "DeliveryJobsGoToDepot": "SceneEnterMenuRegionalDevelopmentValleyIVDepotNode"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]DeliveryJobsEnterOriginiumScienceParkDeliveryJob",
            "[JumpBack]DeliveryJobsEnterOriginLodespringDeliveryJob",
            "[JumpBack]DeliveryJobsEnterPowerPlateauDeliveryJob",
            "[JumpBack]DeliveryJobsEnterOriginiumScienceParkCargo",
            "[JumpBack]DeliveryJobsEnterOriginLodespringCargo",
            "[JumpBack]DeliveryJobsEnterPowerPlateauCargo",
            "DeliveryJobsLoop",
            "[JumpBack]SceneEnterMenuRegionalDevelopment"
        ]
    },
    "DeliveryJobsSelectPriorityItemsValleyIV": {
        "desc": "四号谷地未启用指定货物优先级，使用游戏默认填充至满",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsCargoFillToMax"
        ]
    },
    "DeliveryJobsInValleyIVLocalDepotNode": {
        "desc": "在四号谷地本地仓储节点界面",
        "recognition": "And",
        "all_of": [
            "InLocalDepotNode",
            "DeliveryJobsCheckLocalDepotNodeOriginiumScienceParkText"
        ],
        // 刚进入界面时可能会遇到元素未加载完成，必须等待页面稳定后才能继续
        "pre_wait_freezes": {
            "time": 80,
            "target": [
                66,
                221,
                166,
                124
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
