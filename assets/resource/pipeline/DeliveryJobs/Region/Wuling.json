{
    "DeliveryJobsAutoWuling": {
        "desc": "自动选择武陵运送委托",
        "recognition": "Or",
        "any_of": [
            "InRegionalDevelopmentWuling",
            "DeliveryJobsInWulingLocalDepotNode"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsWuling",
            "DeliveryJobsLoop"
        ]
    },
    "DeliveryJobsWuling": {
        "desc": "武陵运送委托",
        "max_hit": 1,
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneEnterMenuRegionalDevelopmentWuling"
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsDepotLocked",
            "DeliveryJobsWulingLoop"
        ]
    },
    "DeliveryJobsWulingLoop": {
        "desc": "武陵运送委托主循环",
        "max_hit": 1,
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneEnterMenuRegionalDevelopmentWulingDepotNode"
            ]
        },
        "anchor": {
            "DeliveryJobsGoToDepot": "SceneEnterMenuRegionalDevelopmentWulingDepotNode"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]DeliveryJobsEnterWulingCityDeliveryJob",
            "[JumpBack]DeliveryJobsEnterTestAreaDeliveryJob",
            "[JumpBack]DeliveryJobsEnterWulingCityCargo",
            "[JumpBack]DeliveryJobsEnterTestAreaCargo",
            "DeliveryJobsLoop",
            "[JumpBack]SceneEnterMenuRegionalDevelopment"
        ]
    },
    "DeliveryJobsSelectPriorityItemsWuling": {
        "desc": "武陵未启用指定货物优先级，使用游戏默认填充至满",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsCargoFillToMax"
        ]
    },
    "DeliveryJobsInWulingLocalDepotNode": {
        "desc": "在武陵本地仓储节点界面",
        "recognition": "And",
        "all_of": [
            "InLocalDepotNode",
            "DeliveryJobsCheckLocalDepotNodeWulingCityText"
        ],
        // 刚进入界面时可能会遇到元素未加载完成，必须等待页面稳定后才能继续
        "pre_wait_freezes": {
            "time": 80,
            "target": [
                66,
                221,
                166,
                124
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
