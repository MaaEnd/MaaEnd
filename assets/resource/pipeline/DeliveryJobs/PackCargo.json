{
    // 装箱货物的流程如下：
    // 选择装箱货物类型->下一步->装满货物->下一步->货物竞价->调度申请->下一步->提示尽快送达单击屏幕->回到大世界界面
    // 每次单击下一步前都需要确认页面稳定，否则会因为按钮错位导致单击失败
    "DeliveryJobsPackCargo": {
        "desc": "装箱货物",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsInCargoPackGoods",
            "DeliveryJobsInCargoRedistributionBid"
        ]
    },
    "DeliveryJobsInCargoPackGoods": {
        "desc": "检查是否在货物装箱界面，货物装箱时进入的界面",
        "recognition": "OCR",
        "roi": [
            20,
            1,
            391,
            54
        ],
        "expected": [
            "货物装箱",
            "貨物裝箱",
            "(?i)Pack\\s*Goods",
            "パッキング",
            "화물 포장"
        ],
        "pre_wait_freezes": {
            "time": 80,
            "target": [
                5,
                140,
                223,
                157
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsSelectTypeOfGoodsToPackNextStep"
        ]
    },
    "DeliveryJobsInCargoRedistributionBid": {
        "desc": "检查是否在调度申请界面，查看报价时进入的界面",
        "recognition": "OCR",
        "roi": [
            20,
            1,
            391,
            54
        ],
        "expected": [
            "调度申请",
            "調度申請",
            "(?i)Redistribution\\s*Bid",
            "取引申請",
            "관리 신청"
        ],
        "pre_wait_freezes": {
            "time": 80,
            "target": [
                5,
                140,
                223,
                157
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsOngoingDelivery",
            "[Anchor]DeliveryJobsRedistributionBidAction"
        ]
    },
