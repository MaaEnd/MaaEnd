            474
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsSelectPriorityItemLoop"
        ],
        // attach.ready 是识别器的运行期状态，不是静态配置：
        // 本节点第一次执行时，ListCompleteRecognition 会把 roi 内画面截成模板
        // ListCompleteRecognition/DeliveryJobsItemListAtTop.png 并把 ready 置为 true；
        // 此后每轮都用该模板与当前画面比对，判断列表是否已停住，比对不过就重新截模板。
        // 装箱流程开始新一轮扫描时（DeliveryJobsStartFill{地区}Priority{N} 的 PipelineOverrideAction）置回 false，
        // 强制重新截模板。这里写死只会影响首次运行前的初值，改动不影响运行期判定。
        "attach": {
            "ready": false
        }
    },
