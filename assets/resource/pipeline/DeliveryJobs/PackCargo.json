{
    // 装箱货物的流程如下：
    // 选择装箱货物类型->下一步->装满货物->下一步->货物竞价->调度申请->(见下)
    // 每次单击下一步前都需要确认页面稳定，否则会因为按钮错位导致单击失败
    // 调度申请界面按本仓储节点的处理方式分两条路：
    // ・「接取并转交」先走 DeliveryJobsDecideQuickTransfer：等底部按钮稳定后看有没有白底「快速转交」，
    //   有（仓储节点 3 级起）走 DeliveryJobsQuickTransfer：快速转交->确认->获得奖励->我转交的委托->点回本地仓储节点；
    //   没有（仓储节点未满 3 级）回退到下面的接取流程，与其它模式走同一条路；
    // ・「仅接取委托」「全自动送货」「按报价处理」走 DeliveryJobsRedistributionBidNextStep：
    //   确认接取任务->尽快送达单击屏幕->回到大世界->由 anchor 决定接取后去向。
    "DeliveryJobsPackCargo": {
        "desc": "装箱货物",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsInCargoPackGoods",
            "DeliveryJobsInCargoRedistributionBid"
        ]
    },
