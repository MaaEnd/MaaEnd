    "DeliveryJobsRedistributionBidNextStep": {
        "desc": "确认接取任务后，处理接取提示并等回到大世界，再由 [Anchor]DeliveryJobsGoToDepot 决定接取后去向",
        "recognition": "And",
        "all_of": [
            "YellowConfirmButtonType1",
            "DeliveryJobsInCargoRedistributionBid"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        // 「仅接取委托」「全自动送货」「按报价处理」必定走这里；
        // 「接取并转交」在仓储节点未满 3 级时也会落到这里，因此不必再读 DeliveryJobsAfterAcceptJob。
        "next": [
            "DeliveryJobsDeliverQuickly",
            "DeliveryJobsBackToDepot"
        ]
    },
    // 仓储节点满 3 级后，调度申请界面才会把白底「快速转交」与黄底「开始运送」并排给出；
    // 未满 3 级只有黄底「开始运送」，这时必须回退老流程：先接取，再由后续的残留委托检测转交。
    // 按钮出现前界面还在渲染，此刻就判会把「快速转交」当成不存在而误走接取，所以先等底部按钮区稳定再判。
    "DeliveryJobsDecideQuickTransfer": {
        "desc": "调度申请界面等底部按钮稳定后判断是否走「快速转交」：有白底快速转交就快速转交，没有就接取",
        "recognition": "And",
        "all_of": [
            // 「开始运送」任何等级都有，用它确认底部按钮已经渲染出来，避免在按钮出现前就下判断
            "YellowConfirmButtonType1",
            "DeliveryJobsInCargoRedistributionBid"
        ],
        "pre_wait_freezes": {
            "time": 200,
            // 白底「快速转交」与黄底「开始运送」所在的一整行按钮区；ADB 的位置更靠左下，见 resource_adb 的覆盖
            "target": [
                820,
                632,
                450,
                62
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsQuickTransfer",
            "DeliveryJobsRedistributionBidNextStep"
        ]
    },
    // 调度申请界面上的「快速转交」把本次委托立刻转交出去，是「接取并转交」专用的捷径：
    // 单击后弹确认框，确认直接落在获得奖励界面，关掉奖励停在我转交的委托页，再点回本地仓储节点标签页。
    // 「仅接取委托」「全自动送货」「按报价处理」不能转交，仍走 DeliveryJobsRedistributionBidNextStep 接取。
    "DeliveryJobsQuickTransfer": {
        "desc": "调度申请界面单击「快速转交」，把本次委托立刻转交出去",
        "recognition": "And",
        "all_of": [
            // 「快速转交」与「开始运送」同形状、图标同为圆环，只差底色：
            // 这里认白底的 WhiteConfirmButtonType1，开始运送是黄底的 YellowConfirmButtonType1。
            "WhiteConfirmButtonType1",
            "DeliveryJobsInCargoRedistributionBid"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsQuickTransferConfirm"
        ]
    },
