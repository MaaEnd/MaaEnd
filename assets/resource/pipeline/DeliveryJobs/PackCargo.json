    "DeliveryJobsItemListAtTop": {
        "desc": "[运行时覆盖] 本地仓储列表已滚动到顶部；识别器比较连续两次向下滑动后的静止列表",
        "recognition": "Custom",
        "custom_recognition": "ListCompleteRecognition",
        "custom_recognition_param": {
            "threshold": 0.98
        },
        "roi": [
            34,
