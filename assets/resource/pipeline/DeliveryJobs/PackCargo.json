{
    // 装箱货物的流程如下：
    // 选择装箱货物类型->下一步->装满货物->下一步->货物竞价->调度申请->下一步->提示尽快送达单击屏幕->回到大世界界面
    // 每次单击下一步前都需要确认页面稳定，否则会因为按钮错位导致单击失败
    "DeliveryJobsPackCargo": {
        "desc": "装箱货物",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsInCargoPackGoods",
            "DeliveryJobsInCargoRedistributionBid"
        ]
    },
    "DeliveryJobsInCargoPackGoods": {
        "desc": "检查是否在货物装箱界面，货物装箱时进入的界面",
        "recognition": "OCR",
        "roi": [
            20,
            1,
            391,
            54
        ],
        "expected": [
            "货物装箱",
            "貨物裝箱",
            "(?i)Pack\\s*Goods",
            "パッキング",
            "화물 포장"
        ],
        "pre_wait_freezes": {
            "time": 80,
            "target": [
                5,
                140,
                223,
                157
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsSelectTypeOfGoodsToPackNextStep"
        ]
    },
    "DeliveryJobsInCargoRedistributionBid": {
        "desc": "检查是否在调度申请界面，查看报价时进入的界面",
        "recognition": "OCR",
        "roi": [
            20,
            1,
            391,
            54
        ],
        "expected": [
            "调度申请",
            "調度申請",
            "(?i)Redistribution\\s*Bid",
            "取引申請",
            "관리 신청"
        ],
        "pre_wait_freezes": {
            "time": 80,
            "target": [
                5,
                140,
                223,
                157
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsOngoingDelivery",
            "[Anchor]DeliveryJobsRedistributionBidAction"
        ]
    },
    "DeliveryJobsSelectedBidLocationIcon": {
        "desc": "识别当前选中的运送委托报价的地点图标",
        "recognition": "TemplateMatch",
        "roi": [
            970,
            132,
            223,
            106
        ],
        "template": "DeliveryJobs/LocationIcon.png",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "DeliveryJobsSelectedBidPriceOCR": {
        "desc": "识别当前选中的运送委托报价",
        "recognition": "OCR",
        "roi": "DeliveryJobsSelectedBidLocationIcon",
        "roi_offset": [
            137,
            16,
            28,
            -2
        ],
        "expected": [
            // @i18n-skip
            "\\d+(?:[.,]\\d+)?"
        ],
        "replace": [
            [
                "方",
                "万"
            ]
        ],
        "only_rec": true,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "DeliveryJobsSelectedBidPrice": {
        "desc": "获取当前选中的运送委托报价",
        "recognition": "And",
        "all_of": [
            "DeliveryJobsSelectedBidLocationIcon",
            "DeliveryJobsSelectedBidPriceOCR"
        ],
        "box_index": 1,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "DeliveryJobsSelectTypeOfGoodsToPackNextStep": {
        "desc": "选择装箱货物类型后下一步",
        "recognition": "And",
        "all_of": [
            "YellowConfirmButtonType2",
            "DeliveryJobsInCargoPackGoods"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsCargoFillToMax"
        ]
    },
    "DeliveryJobsSelectItemLoop": {
        "desc": "选择要填充的物品，如果不在第一屏，向上滑动，再次寻找，直到找到或者滑动 10 次",
        "recognition": "OCR",
        "roi": [
            53,
            180,
            463,
            392
        ],
        "expected": [
            "本地仓储",
            "本地區倉儲",
            "(?i)Local\\s*Depot",
            "地域在庫",
            "지역 저장고"
        ],
        "pre_wait_freezes": {
            "time": 200,
            "target": [
                53,
                180,
                463,
                392
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[Anchor]DeliveryJobsSelectItemToFill",
            "[JumpBack]DeliveryJobsSelectItemScrollUp"
        ]
    },
    "DeliveryJobsSelectItemToFillValleyIV": {
        "desc": "选择要填充的物品（四号谷地）",
        "recognition": "TemplateMatch",
        "roi": [
