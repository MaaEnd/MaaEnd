{
    // 转交任务的流程
    // 打开送货任务详情由 DeliveryJobsTransferOngoingJob 完成，进入它的入口有两个：
    // 装箱时发现残留委托（DeliveryJobsOngoingDeliveryFor* 分派而来）、
    // 自动送货失败（DeliveryJobsDeliverByAutoDelivery 的 on_error）。
    // 本文件负责：点击转交任务 -> 确认转交任务 -> 按 DeliveryJobsReturnToDepotNode 跳转
    "DeliveryJobsTransferOngoingJob": {
        "desc": "进入任务界面选中送货任务，再转交它",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "AutoDeliveryOpenDeliveryMission"
            ],
            "continue": false,
            "strict": true
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsWaitMissionDetailForTransfer"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$task.DeliveryJobs.OngoingDeliveryTransferred"
        }
    },
    // 打开送货任务详情后先等界面稳定，再判断有没有「转交运送委托」按钮。
    // 组件里的 AutoDeliveryInDeliveryMissionDetail 只保证「已在任务界面且选中送货任务」，
    // 右侧详情此时可能还在渲染；不等稳定就找按钮，会把慢一拍的界面误判成「没有按钮」。
    "DeliveryJobsWaitMissionDetailForTransfer": {
        "desc": "等待送货任务详情界面稳定后再判断转交按钮",
        "recognition": "And",
        "all_of": [
            "AutoDeliveryInDeliveryMissionDetail"
        ],
        // 等待区域与组件里 AutoDeliveryInDeliveryMissionDetail 的等待区域相同
        "pre_wait_freezes": {
            "time": 200,
            "target": [
                417,
                51,
                547,
                279
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsClickTransferJob",
            "DeliveryJobsTransferUnavailable"
        ]
    },
    // 货物已在手上（例如抢单后已取货）时游戏不提供「转交运送委托」，此时不点按钮、也不终止整个任务
    "DeliveryJobsTransferUnavailable": {
        "desc": "任务界面上没有转交按钮时跳过这条委托并回仓储节点",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[Anchor]DeliveryJobsReturnToDepotNode"
        ]
    },
    "DeliveryJobsClickTransferJob": {
        "desc": "单击转交任务",
        "recognition": "OCR",
        "roi": [
            366,
            620,
            372,
            63
        ],
        "expected": [
            "转交运送委托",
            "轉交運送委託",
            "(?i)Transfer\\s*Delivery\\s*Job",
            "外部委託",
            "(?i)Transfer\\s*Job",
            "운송 의뢰 위탁"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsConfirmTaskTransfer"
        ]
    },
    "DeliveryJobsCheckTaskTransferText": {
        "desc": "检查转交任务文本",
        "recognition": "OCR",
        "roi": [
            401,
            238,
            494,
            160
        ],
        "expected": [
            "是否确认将送货任务委托给他人派送?",
            "是否確定將送貨任務委託給他人運送？",
            "(?i)Transfer\\s*delivery\\s*job\\s*to\\s*another\\s*courier\\s*\\?",
            "配達任務を他人に委託しますか？",
            "给他人派送",
            "給他人運送",
            "운송 임무를 다른 사람에게 위탁하시겠습니까?"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "DeliveryJobsConfirmTaskTransfer": {
        "desc": "确认转交任务",
        "recognition": "And",
        "all_of": [
            "YellowConfirmButtonType1",
            "DeliveryJobsCheckTaskTransferText"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            // 落点由发起方声明为本仓储节点的落点：仓储节点界面发起的转交声明 InLocalDepotNode，
            // 需要等待本地仓储界面完全加载完成，才继续后面的流程，
            // 否则会因为无法识别到相关货物，导致退出去重新进入本地仓储界面
            // 任务界面发起的转交会回到菜单列表，发起方声明本仓储节点的场景节点
            "[Anchor]DeliveryJobsReturnToDepotNode"
        ]
    }
}
