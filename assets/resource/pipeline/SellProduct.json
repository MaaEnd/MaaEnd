{
    "SellProductSchedule": {
        "desc": "售卖产品计划任务",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SellProductScheduleEnabled",
            "SellProductScheduleEnd"
        ]
    },
    "SellProductScheduleEnabled": {
        "desc": "售卖产品计划任务命中",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ScheduleRecognition",
                "custom_recognition_param": {}
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SellProductMain"
        ],
        "attach": {
            "monday": false,
            "tuesday": false,
            "wednesday": false,
            "thursday": false,
            "friday": false,
            "saturday": false,
            "sunday": false
        }
    },
    "SellProductScheduleEnd": {
        "desc": "售卖产品计划任务跳过",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "SellProductMain": {
        "desc": "脚本入口",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SellProductEnterRegionalDevelopment"
        ]
    },
    "SellProductEnterRegionalDevelopment": {
        "desc": "进入地区建设界面并准备捕获 UID",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneEnterMenuRegionalDevelopment"
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SellProductCaptureUid"
        ]
    },
    "SellProductCaptureUid": {
        "desc": "捕获当前账号 UID，用于隔离自动干员缓存",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "CaptureUid",
        "custom_action_param": {
            "use_cache": true,
            "stay_on_current_screen": true,
            "allow_unknown": true
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SellProductPrepareSession"
        ]
    },
    "SellProductPrepareSession": {
        "desc": "初始化保留规则、优先售卖与干员会话",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SellProductInitializeReserveSession",
                "SellProductInitializeOperatorSession",
                "SellProductConfigurePrioritySession",
                "SellProductConfigureSelectionStrategy"
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SellProductLoop"
        ]
    },
    "SellProductConfigureSelectionStrategy": {
        "desc": "配置选品策略",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SellProductPrioritySession",
        "custom_action_param": {
            "operation": "configure_strategy",
            "strategy": "rarity"
        },
        "post_delay": 0,
        "rate_limit": 0
    },
    "SellProductTaskEnd": {
        "desc": "任务结束",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Recognition.Succeeded": "$task.SellProduct.TaskEnd"
        }
    }
}
