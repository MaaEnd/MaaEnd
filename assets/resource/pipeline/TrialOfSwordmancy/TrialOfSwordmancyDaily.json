{
    "TrialOfSwordmancyDailyMain": {
        "desc": "日常选剑演武入口",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDailyCheckRewardMode",
            "[JumpBack]TrialOfSwordmancyEnterTrialMenu",
            "[JumpBack]TrialOfSwordmancyGotoTrialArenaStart"
        ]
    },
    "TrialOfSwordmancyDailyCheckRewardMode": {
        "desc": "检查是否处于奖励演算模式",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyDrawCard"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDailyRewardMode",
            "TrialOfSwordmancyRetryRewardMode",
            "TrialOfSwordmancyDailyFinish"
        ]
    },
    "TrialOfSwordmancyRetryRewardMode": {
        "desc": "仅一次，放弃当前自由演算（跨日残局）",
        "max_hit": 1,
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyEnemyCard1"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyCoatingGiveUp"
        ]
    },
    // 奖励耗尽 → 结束（CheckRewardMode 见非奖励模式 / Fight.json 战后 RewardExhausted 汇入）
    "TrialOfSwordmancyDailyFinish": {
        "desc": "演算结束",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyDrawCard"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "focus": {
            "Node.Action.Succeeded": "今日奖励次数已用尽"
        }
    },
    "TrialOfSwordmancyDailyRewardMode": {
        "desc": "处于奖励演算模式",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyRewardMode"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDailyRecognizeDeck"
        ]
    },
    "TrialOfSwordmancyDailyRecognizeDeck": {
        "desc": "识别完整牌库",
        "recognition": "Custom",
        "custom_recognition": "TrialOfSwordmancy.RecognizeDeck",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyEnsureFirstCard",
            "TrialOfSwordmancyAbandProbeClickGiveUp",
            "TrialOfSwordmancyDecide"
        ]
    },
    // 若尚未抽牌（第1张 Lv 不在）则先抽一张，保证探测放弃次数时有牌；已有牌则 fall through 到 AbandProbe
    "TrialOfSwordmancyEnsureFirstCard": {
        "desc": "空手则先抽一张",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyEnemyCard1"
        ],
        "inverse": true,
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "RepeatUntilNotFoundAction",
        "custom_action_param": {
            "action": "Click",
            "interval_ms": 600,
            "repeat_count": 6,
            "wait_node": "TrialOfSwordmancyBattlePts0"
        },
        "target": "TrialOfSwordmancyDrawCard",
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDrawFirstCardSuccess"
        ]
    },
    "TrialOfSwordmancyDrawFirstCardSuccess": {
        "desc": "抽取第一张牌成功",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyEnemyCard1"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyAbandProbeClickGiveUp",
            "TrialOfSwordmancyDecide"
        ]
    },
    // （仅一次）探测放弃次数 → 回 Decide
    "TrialOfSwordmancyAbandProbeClickGiveUp": {
        "desc": "探测放弃次数①：点放弃按钮",
        "max_hit": 1,
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyGiveUp"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "RepeatUntilFoundAction",
        "custom_action_param": {
            "action": "Click",
            "interval_ms": 1500,
            "wait_nodes": [
                "TrialOfSwordmancyAbandProbePopup"
            ]
        },
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyAbandProbePopup"
        ]
    },
    "TrialOfSwordmancyAbandProbePopup": {
        "desc": "探测放弃次数①：等放弃确认弹窗出现",
        "recognition": "And",
        "all_of": [
            "CancelButton",
            "YellowConfirmButtonType1"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyAbandProbeRecognize"
        ]
    },
    "TrialOfSwordmancyAbandProbeRecognize": {
        "desc": "识别放弃次数",
        "recognition": "Custom",
        "custom_recognition": "TrialOfSwordmancy.RecognizeAband",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyAbandProbeClickCancel"
        ]
    },
    "TrialOfSwordmancyAbandProbeClickCancel": {
        "desc": "探测放弃次数②：点取消按钮",
        "recognition": "And",
        "all_of": [
            "CancelButton"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyAbandProbeWaitBackFreeze"
        ]
    },
    "TrialOfSwordmancyAbandProbeWaitBackFreeze": {
        "desc": "探测放弃次数②：等回抽牌页并 freeze",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyEnemyCard1"
        ],
        "pre_delay": 0,
        "post_delay": 400, // 过渡状态就会被识别命中，需要等待动画结束，但 wait_freezes 也是永远命中，不如写明只是单纯 delay
        "next": [
            "TrialOfSwordmancyDecide"
        ]
    },
    "TrialOfSwordmancyDecide": {
        "desc": "选剑演武单步决策",
        "recognition": "Custom",
        "custom_recognition": "TrialOfSwordmancy.Recognize",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "TrialOfSwordmancy.Decide",
        "custom_action_param": {
            "overflowMode": "OverflowTwice"
        },
        "post_delay": 0,
        // next 由 go 运行时 override，按决策分派到：
        //   抽牌 → DoDrawCard ｜ 翻倍 → DoDoubleReward ｜ 放弃 → DailyGiveUp ｜ 开始演算 → StartTrial（Fight.json）
        "next": []
    },
    // 抽牌 → 回 Decide（同局继续）
    "TrialOfSwordmancyDoDrawCard": {
        "desc": "抽取一张铭牌",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyDrawCard"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "RepeatUntilNotFoundAction",
        "custom_action_param": {
            "action": "Click",
            "interval_ms": 600,
            "repeat_count": 6,
            "wait_node": "TrialOfSwordmancyBattlePts0" // go 运行时覆盖
        },
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDoDrawCardConfirm",
            "TrialOfSwordmancyDoDrawCardSuccess"
        ]
    },
    "TrialOfSwordmancyDoDrawCardConfirm": {
        "desc": "抽取后无法更改翻倍确认",
        "recognition": "And",
        "all_of": [
            "YellowConfirmButtonType1"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "RepeatUntilFoundAction",
        "custom_action_param": {
            "action": "Click",
            "interval_ms": 1500,
            "wait_nodes": [
                "TrialOfSwordmancyEnemyCard3"
            ]
        },
        "post_delay": 600, // 无法识别战力点消失，只能用延迟确保右侧牌库已刷新
        "next": [
            "TrialOfSwordmancyDoDrawCardSuccess"
        ]
    },
    "TrialOfSwordmancyDoDrawCardSuccess": {
        "desc": "等待抽牌动画结束",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyEnemyCard1" // go 运行时覆盖
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDecide"
        ]
    },
    // 翻倍 → 回 Decide（同局继续）
    "TrialOfSwordmancyDoDoubleReward": {
        "desc": "选择本局翻倍",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyDoubleReward"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "RepeatUntilFoundAction",
        "custom_action_param": {
            "action": "Click",
            "interval_ms": 1500,
            "wait_nodes": [
                "TrialOfSwordmancyIsDoubled"
            ]
        },
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDecide"
        ]
    },
    // 放弃本局 → 退出演算 → 回主入口（开新局）
    "TrialOfSwordmancyDailyGiveUp": {
        "desc": "放弃当前演算",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyGiveUp"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "RepeatUntilFoundAction",
        "custom_action_param": {
            "action": "Click",
            "interval_ms": 1500,
            "wait_nodes": [
                "TrialOfSwordmancyDailyConfirmGiveUp"
            ]
        },
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDailyConfirmGiveUp"
        ]
    },
    "TrialOfSwordmancyDailyConfirmGiveUp": {
        "desc": "确认放弃",
        "recognition": "And",
        "all_of": [
            "YellowConfirmButtonType1"
        ],
        "pre_wait_freezes": 100,
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDailyResetNavigator"
        ]
    },
    "TrialOfSwordmancyDailyResetNavigator": {
        "desc": "重置寻路maxhit",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "ClearHitCount",
        "custom_action_param": {
            "nodes": [
                "TrialOfSwordmancyGotoTrialArenaCpp"
            ]
        },
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyMain"
        ]
    }
}
