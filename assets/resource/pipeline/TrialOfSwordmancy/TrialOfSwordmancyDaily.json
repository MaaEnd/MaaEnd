{
    "TrialOfSwordmancyDailyMain": {
        "desc": "日常选剑演武入口",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDailyCheckRewardMode",
            "[JumpBack]TrialOfSwordmancyEnterTrialMenu",
            "[JumpBack]TrialOfSwordmancyGotoTrialArenaStart"
        ]
    },
    "TrialOfSwordmancyDailyCheckRewardMode": {
        "desc": "检查是否处于奖励演算模式",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyDrawCard"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDailyRewardMode",
            "TrialOfSwordmancyDailyFinish"
        ]
    },
    "TrialOfSwordmancyDailyFinish": {
        "desc": "演算结束",
        "pre_delay": 0,
        "post_delay": 0,
        "focus": {
            "Node.Action.Succeeded": "今日奖励次数已用尽"
        }
    },
    "TrialOfSwordmancyDailyRewardMode": {
        "desc": "处于奖励演算模式，进入 MDP 单步决策循环",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyRewardMode"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDecide"
        ]
    },
    // ===== MDP 单步决策循环（go-service：识别 → 求解 → 路由执行 → 回到本节点）=====
    // next 由 TrialOfSwordmancy.Decide 动作运行时用 OverrideNext 动态指向下面的执行节点。
    // custom_action_param 为基础设定（均可选，缺省走等级 4 默认）；task option 的
    // pipeline_override 可覆写以换牌库/换溢出模式，无需改代码。
    "TrialOfSwordmancyDecide": {
        "desc": "选剑演武 MDP 单步决策",
        "recognition": "Custom",
        "custom_recognition": "TrialOfSwordmancy.Recognize",
        "action": "Custom",
        "custom_action": "TrialOfSwordmancy.Decide",
        "custom_action_param": {
            "deck": [4, 5, 6, 6, 7],
            "overflowMode": "OverflowTwice"
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": []
    },
    // —— 决策执行节点（DrawCard / Double 后回到 Decide 同局继续）——
    // 抽牌等待策略移植自 v2 #3710：点抽牌/确认后先 post_delay 400ms 让动画起飞，
    // 再进 DoWaitDrawCardFreezes 用 post_wait_freezes(200) 等画面稳定，
    // 比单次 post_wait_freezes(100) 更不易在动画中途误判稳定。
    "TrialOfSwordmancyDoDrawCard": {
        "desc": "MDP 决策：抽取一张铭牌",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyDrawCard"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 400,
        "next": [
            "TrialOfSwordmancyDoDrawCardConfirm",
            "TrialOfSwordmancyDoWaitDrawCardFreezes"
        ]
    },
    "TrialOfSwordmancyDoDrawCardConfirm": {
        "desc": "抽牌到第三抽时可能弹出「抽取后无法更改翻倍」确认",
        "recognition": "And",
        "all_of": [
            "YellowConfirmButtonType1"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 400,
        "next": [
            "TrialOfSwordmancyDoWaitDrawCardFreezes"
        ]
    },
    "TrialOfSwordmancyDoWaitDrawCardFreezes": {
        "desc": "等待抽牌动画结束",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyDrawCard"
        ],
        "pre_delay": 0,
        "post_wait_freezes": {
            "time": 200,
            "target": [
                460,
                146,
                793,
                289
            ]
        },
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDecide"
        ]
    },
    "TrialOfSwordmancyDoDoubleReward": {
        "desc": "MDP 决策：选择本局翻倍",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyDoubleReward"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_wait_freezes": {
            "time": 100,
            "target": [
                690,
                613,
                280,
                50
            ]
        },
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDecide"
        ]
    },
    // —— 放弃当前演算（MDP 决策 Abandon 复用；等待策略移植自 v2 #3710：
    //    GiveUp 点击后不再等待，改由 ConfirmGiveUp 在点击前 pre_wait_freezes 等确认菜单稳定）——
    "TrialOfSwordmancyDailyGiveUp": {
        "desc": "放弃当前演算",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyGiveUp"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDailyConfirmGiveUp"
        ]
    },
    "TrialOfSwordmancyDailyConfirmGiveUp": {
        "desc": "确认放弃",
        "recognition": "And",
        "all_of": [
            "YellowConfirmButtonType1"
        ],
        "pre_wait_freezes": 100,
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDailyResetNavigator"
        ]
    },
    "TrialOfSwordmancyDailyResetNavigator": {
        "desc": "重置寻路maxhit",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "ClearHitCount",
        "custom_action_param": {
            "nodes": [
                "TrialOfSwordmancyGotoTrialArenaCpp"
            ]
        },
        "post_delay": 0,
        "next": [
            "TrialOfSwordmancyDailyMain"
        ]
    }
}
