{
    "TrialOfSwordmancyDailyMain": {
        "desc": "日常选剑演武入口",
        "next": [
            "TrialOfSwordmancyEnterTrialMenu"
        ]
    },
    "TrialOfSwordmancyEnterTrialMenu": {
        "desc": "点击进入演算",
        "max_hit": 3,
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": "TemplateMatch",
                        "roi": [
                            840,
                            448,
                            30,
                            30
                        ],
                        "template": "TrialOfSwordmancy/TrialTrigger1.png"
                    },
                    {
                        "recognition": "TemplateMatch",
                        "roi": [
                            840,
                            448,
                            30,
                            30
                        ],
                        "template": "TrialOfSwordmancy/TrialTrigger2.png"
                    }
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AutoAltClickAction"
            }
        },
        "post_wait_freezes": 100,
        "next": [
            "TrialOfSwordmancyInTrialMenu"
        ]
    },
    "TrialOfSwordmancyInTrialMenu": {
        "desc": "确认已在演算菜单界面",
        "recognition": "OCR",
        "roi": [
            49,
            21,
            57,
            16
        ],
        "expected": "选剑演武",
        "next": [
            "TrialOfSwordmancyDailyMainLoop"
        ]
    },
    "TrialOfSwordmancyDailyMainLoop": {
        "desc": "日常选剑演武主循环",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyHasResource"
        ],
        "next": [
            "[JumpBack]TrialOfSwordmancyShouldDrawCard",
            "TrialOfSwordmancyStartTrial"
        ]
    },
    "TrialOfSwordmancyShouldDrawCard": {
        "desc": "应该抽取铭牌",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyBattlePtsLessThan6",
            {
                "type": "Not",
                "param": "TrialOfSwordmancyCantDrawCard"
            }
        ],
        "next": [
            "TrialOfSwordmancyDrawCard"
        ]
    },
    "TrialOfSwordmancyDrawCard": {
        "desc": "抽取铭牌",
        "recognition": "OCR",
        "roi": [
            1161,
            535,
            77,
            20
        ],
        "expected": "抽取铭牌",
        "pre_delay": 0,
        "action": "Click",
        "post_wait_freezes": 500, // 多等一会儿，抽牌动画比较长
        "post_delay": 0
    }
}
