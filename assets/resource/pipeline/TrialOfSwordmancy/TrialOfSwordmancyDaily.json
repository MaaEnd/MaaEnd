{
    "TrialOfSwordmancyDailyMain": {
        "desc": "日常选剑演武入口",
        "next": [
            "TrialOfSwordmancyEnterTrialMenu"
        ]
    },
    "TrialOfSwordmancyEnterTrialMenu": {
        "desc": "点击进入演算",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": "TemplateMatch",
                        "roi": [
                            840,
                            448,
                            30,
                            30
                        ],
                        "template": "TrialOfSwordmancy/TrialTrigger1.png"
                    },
                    {
                        "recognition": "TemplateMatch",
                        "roi": [
                            840,
                            448,
                            30,
                            30
                        ],
                        "template": "TrialOfSwordmancy/TrialTrigger2.png"
                    }
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AutoAltClickAction"
            }
        },
        "post_wait_freezes": 100,
        "next": [
            "TrialOfSwordmancyInTrialMenu"
        ]
    },
    "TrialOfSwordmancyInTrialMenu": {
        "desc": "确认已在演算菜单界面",
        "recognition": "OCR",
        "roi": [
            49,
            21,
            57,
            16
        ],
        "expected": "选剑演武",
        "max_hit": 3, // 此处意为 3 次奖励领取机会
        "next": [
            "TrialOfSwordmancyAggressiveEntry",
            "TrialOfSwordmancyConservativeMainLoop"
        ]
    },
    // 激进模式：每日3次免费放弃期间，仅8/9/10时开战以利用放弃次数
    "TrialOfSwordmancyAggressiveEntry": {
        "desc": "激进模式入口（3次放弃机会）",
        "max_hit": 3, // 此处意为 3 次免费放弃机会
        "next": [
            "TrialOfSwordmancyAggressiveMainLoop"
        ]
    },
    "TrialOfSwordmancyAggressiveMainLoop": {
        "desc": "激进模式抽牌循环",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyHasResource"
        ],
        "next": [
            "TrialOfSwordmancyDailyBattlePtsOverflow",
            "TrialOfSwordmancyAggressiveShouldDrawCard",
            "TrialOfSwordmancyStartTrial"
        ]
    },
    "TrialOfSwordmancyAggressiveShouldDrawCard": {
        "desc": "激进模式检查是否抽牌",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyBattlePtsLessThan8",
            {
                "type": "Not",
                "param": "TrialOfSwordmancyCantDrawCard"
            }
        ],
        "next": [
            "TrialOfSwordmancyAggressiveDrawCard"
        ]
    },
    "TrialOfSwordmancyAggressiveDrawCard": {
        "desc": "激进模式抽取铭牌",
        "recognition": "OCR",
        "roi": [
            1161,
            535,
            77,
            20
        ],
        "expected": "抽取铭牌",
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 800,
        "next": [
            "TrialOfSwordmancyAggressiveMainLoop"
        ]
    },
    "TrialOfSwordmancyDailyBattlePtsOverflow": {
        "desc": "检测战力点溢出",
        "recognition": "OCR",
        "roi": [546, 573, 180, 25],
        "expected": [
            "溢出"
        ],
        "next": [
            "TrialOfSwordmancyDailyGiveUp",
            "TrialOfSwordmancyConservativeMainLoop"
        ]
    },
    "TrialOfSwordmancyDailyGiveUp": {
        "desc": "日常放弃当前抽取",
        "recognition": "OCR",
        "roi": [154, 593, 114, 87],
        "expected": [
            "放弃"
        ],
        "action": "Click",
        "next": [
            "TrialOfSwordmancyDailyConfirmGiveUp"
        ]
    },
    "TrialOfSwordmancyDailyConfirmGiveUp": {
        "desc": "确认放弃",
        "recognition": "And",
        "all_of": [
            "YellowConfirmButtonType1"
        ],
        "action": "Click",
        "next": [
            "TrialOfSwordmancyDailyReEnterTrialMenu"
        ]
    },
    "TrialOfSwordmancyDailyReEnterTrialMenu": {
        "desc": "放弃后重新进入演算",
        "recognition": "Or",
        "any_of": ["TrialOfSwordmancyEnterTrialMenu"],
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AutoAltClickAction"
            }
        },
        "post_wait_freezes": 100,
        "next": [
            "TrialOfSwordmancyAggressiveEntry",
            "TrialOfSwordmancyConservativeMainLoop"
        ]
    },
    // 保守模式：重试耗尽后，6-10均接单
    "TrialOfSwordmancyConservativeMainLoop": {
        "desc": "保守模式抽牌循环",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyHasResource"
        ],
        "next": [
            "TrialOfSwordmancyConservativeShouldDrawCard",
            "TrialOfSwordmancyStartTrial"
        ]
    },
    "TrialOfSwordmancyConservativeShouldDrawCard": {
        "desc": "保守模式检查是否抽牌",
        "recognition": "And",
        "all_of": [
            "TrialOfSwordmancyBattlePtsLessThan6",
            {
                "type": "Not",
                "param": "TrialOfSwordmancyCantDrawCard"
            }
        ],
        "next": [
            "TrialOfSwordmancyConservativeDrawCard"
        ]
    },
    "TrialOfSwordmancyConservativeDrawCard": {
        "desc": "保守模式抽取铭牌",
        "recognition": "OCR",
        "roi": [
            1161,
            535,
            77,
            20
        ],
        "expected": "抽取铭牌",
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 800,
        "next": [
            "TrialOfSwordmancyConservativeMainLoop"
        ]
    }
}
