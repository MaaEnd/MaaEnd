{
    // 传送按钮。
    // 根据 ROI 区分传送按钮与快速传送按钮
    "TeleportButton": {
        "desc": "传送按钮",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__TeleportMapAny",
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "roi": [
                                    1160,
                                    600,
                                    120,
                                    120
                                ],
                                "template": [
                                    "Common/Button/WhiteConfirmButtonType1.png",
                                    "Common/Button/WhiteConfirmButtonType1Hover.png"
                                ],
                                "threshold": 0.9
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "QuickTeleportButton": {
        "desc": "前往传送的按钮（快速传送）",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__TeleportMapAny",
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "roi": [
                                    1000,
                                    600,
                                    120,
                                    120
                                ],
                                "template": [
                                    "Common/Button/WhiteConfirmButtonType1.png",
                                    "Common/Button/WhiteConfirmButtonType1Hover.png"
                                ],
                                "threshold": 0.87 // 快速传送按钮的匹配分数略低
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    // 不能直接使用 InMapAny
    "__TeleportMapAny": {
        "desc": "传送按钮只会在地图界面出现",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    0,
                    220,
                    100
                ],
                "template": [
                    "SceneManager/MapMissionReminder.png"
                ],
                "threshold": 0.8
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
