{
    // 拍照接口的实现，对外入口见 Interface/TakePhoto.json
    "__TakePhotoEnterCameraModeClick": {
        "desc": "通过点击进入拍照模式",
        "recognition": "And",
        "all_of": [
            "EnterCameraModeButton",
            "InWorld"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "AutoAltClickAction",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__TakePhotoWaitShutterButton"
        ]
    },
    "__TakePhotoHoldR": {
        "desc": "通过长按进入拍照模式",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "pre_delay": 0,
        "action": "KeyDown",
        "key": 82, // R 0x52
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__TakePhotoInSelectTool"
        ],
        "auto_up": true
    },
    "__TakePhotoInSelectTool": {
        "desc": "进入拍照模式，在选择工具界面中",
        "recognition": "And",
        "all_of": [
            "InSelectTool"
        ],
        "pre_wait_freezes": 80,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__TakePhotoChooseCamera"
        ]
    },
    "__TakePhotoChooseCamera": {
        "desc": "进入拍照模式，选择拍照",
        "recognition": "TemplateMatch",
        "roi": [
            404,
            117,
            463,
            464
        ],
        "template": "Common/CameraMode.png",
        "threshold": 0.8,
        "order_by": "Score",
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__TakePhotoKeyUp"
        ]
    },
    "__TakePhotoKeyUp": {
        "desc": "进入拍照模式，退出按键",
        "pre_delay": 0,
        "action": "KeyUp",
        "key": 82, // R 0x52
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__TakePhotoWaitShutterButton"
        ]
    },
    "__TakePhotoWaitShutterButton": {
        "desc": "拍照按钮出现后等待稳定",
        "recognition": "And",
        "all_of": [
            "ShutterButton"
        ],
        "pre_wait_freezes": 200,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__TakePhotoShutter",
            // 入口设置：隐藏干员时先去画面设置，不隐藏时直接扫描镜头
            "[Anchor]__TakePhotoTargetMissedAnchor"
        ]
    },
    "__TakePhotoSettingsTab": {
        "desc": "拍照设置中的画面标签",
        "recognition": "OCR",
        "roi": [
            20,
            20,
            110,
            70
        ],
        "expected": [
            "画面",
            "畫面",
            "(?i)Scene",
            "화면"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__TakePhotoSettingsPanelClosed": {
        "desc": "拍照画面设置已关闭，inverse 必须由该节点独立执行",
        "recognition": "OCR",
        "roi": [
            20,
            60,
            220,
            90
        ],
        "expected": [
            "显示干员",
            "顯示幹員",
            "(?i)Show\\s*Operator",
            "オペレーターを表示",
            "오퍼레이터 표시"
        ],
        "inverse": true,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__TakePhotoWaitShutterButtonAfterHidingOperators"
        ]
    },
    "__TakePhotoOpenSettings": {
        "desc": "拍照目标未达成，打开画面设置",
        "recognition": "And",
        "all_of": [
            "__TakePhotoSettingsTab"
        ],
        "box_index": 0,
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__TakePhotoSettingsOpened"
        ]
    },
    "__TakePhotoSettingsOpened": {
        "desc": "拍照目标未达成，画面设置已打开",
        "recognition": "ColorMatch",
        "roi": [
            12,
            33,
            101,
            45
        ],
        "method": 40,
        "lower": [
            28,
            190,
            240
        ],
        "upper": [
            33,
            255,
            255
        ],
        "connected": true,
        "count": 90,
        "pre_delay": 0,
        // 展开面板有动画，动画中间帧同样会命中颜色判据，等右侧下拉列静止后再判定
        "post_wait_freezes": {
            "time": 200,
            "target": [
                199,
                69,
                120,
                25
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__TakePhotoSettingsShowAllOperators",
            "__TakePhotoCloseSettingsWithOperatorsHidden"
        ]
    },
    "__TakePhotoSettingsShowAllOperators": {
        "desc": "拍照画面设置当前显示全部干员",
        "recognition": "OCR",
        "roi": [
            180,
            60,
            240,
            75
        ],
        "expected": [
            "显示全部",
            "顯示全部",
            "(?i)Show\\s*All",
            "全て表示",
            "전체 표시"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__TakePhotoSettingsHideAllOperators"
        ]
    },
    "__TakePhotoSettingsHideAllOperators": {
        "desc": "在显示干员下拉框中选择隐藏全部",
        "recognition": "OCR",
        "roi": [
            180,
            165,
            240,
            130
        ],
        "expected": [
            "隐藏全部",
            "隱藏全部",
            "(?i)Hide\\s*All",
            "全て非表示",
            "전체 숨기기"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__TakePhotoCloseSettingsWithOperatorsHidden"
        ]
    },
    "__TakePhotoSettingsOperatorsHidden": {
        "desc": "拍照画面设置当前隐藏全部干员",
        "recognition": "OCR",
        "roi": [
            180,
            60,
            240,
            75
        ],
        "expected": [
            "隐藏全部",
            "隱藏全部",
            "(?i)Hide\\s*All",
            "全て非表示",
            "전체 숨기기"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__TakePhotoCloseSettingsWithOperatorsHidden": {
        "desc": "确认干员已全部隐藏后关闭画面设置",
        "recognition": "And",
        "all_of": [
            "__TakePhotoSettingsOperatorsHidden",
            "__TakePhotoSettingsTab"
        ],
        "box_index": 1,
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__TakePhotoSettingsPanelClosed"
        ]
    },
    "__TakePhotoWaitShutterButtonAfterHidingOperators": {
        "desc": "隐藏全部干员后重新检查拍照目标",
        "recognition": "And",
        "all_of": [
            "ShutterButton"
        ],
        "pre_wait_freezes": 200,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__TakePhotoShutter",
            "__TakePhotoCameraScan"
        ]
    },
    "__TakePhotoCameraScan": {
        "desc": "扫描拍照视角并检查是否达成拍照目标",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "CameraScanAction",
        "custom_action_param": {
            "wait_nodes": [
                "__TakePhotoShutter"
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__TakePhotoShutter"
        ]
    },
    "__TakePhotoCheckTarget": {
        "desc": "检查是否达成拍照目标",
        "recognition": "TemplateMatch",
        "roi": [
            0,
            100,
            150,
            580
        ],
        "template": "Common/TakePhoto/TargetChecked.png",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__TakePhotoShutter": {
        "desc": "拍照目标达成，拍照",
        "recognition": "And",
        "all_of": [
            "ShutterButton",
            "__TakePhotoCheckTarget"
        ],
        "pre_delay": 0,
        "action": "Click",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[Anchor]TakePhotoDone"
        ]
    }
}
