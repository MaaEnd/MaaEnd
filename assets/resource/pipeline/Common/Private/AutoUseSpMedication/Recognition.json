            "Valuables/EmergencySpBooster.png",
            "Valuables/EmergencySpBoosterInCombat.png"
        ],
        "green_mask": true,
        "threshold": 0.84,
        "order_by": "Vertical"
    },
    "__AutoUseSpMedicationColorRecognitionEmergencySanityBoosterDeadline": {
        "desc": "颜色识别,确认是时限应急理智加强剂(绿色或红色时限)",
        "recognition": "ColorMatch",
        "roi": "__AutoUseSpMedicationFindEmergencySanityBooster",
        "method": 40,
        "lower": [
            [
                50,
                200,
                150
            ],
            [
                161,
                0,
                0
            ]
        ],
        "upper": [
            [
                90,
                255,
                255
            ],
            [
                191,
                255,
                255
            ]
        ],
        "connected": true,
        "count": 100
    },
    "__AutoUseSpMedicationOCRRecognitionEmergencySanityBoosterRemainingTime": {
        "desc": "识别应急理智加强剂剩余时间,由选项覆盖expected",
        "recognition": "OCR",
        "roi": "__AutoUseSpMedicationColorRecognitionEmergencySanityBoosterDeadline",
        "roi_offset": [
            15,
            -1,
            -14,
            2
        ],
        "expected": [
            // 剩余时间 OCR：行首锚定，避免匹配「剩余23小时」「剩余1天」等带前缀文本
            // @i18n-skip
            "^(\\d+小时|([1-9]|1[0-3])天)"
        ],
        "only_rec": true,
        "order_by": "Expected"
    },
    "__AutoUseSpMedicationFindDeadlineEmergencySanityBooster": {
        "desc": "识别带时限的应急理智加强剂",
        "recognition": "And",
        "all_of": [
            "__AutoUseSpMedicationFindEmergencySanityBooster",
            "__AutoUseSpMedicationColorRecognitionEmergencySanityBoosterDeadline",
            "__AutoUseSpMedicationOCRRecognitionEmergencySanityBoosterRemainingTime"
        ],
        "box_index": 2
    },
    // 恢复理智对话框中「当前理智 » 用药后理智」两个数字
    // 关卡消耗只有 80 和 160 两档：当前 <80 时补到 80，当前 ≥80 时补到 160
    "__AutoUseSpMedicationSanityAfterBelow80": {
        "desc": "用药后理智低于 80",
        "recognition": "OCR",
        "roi": [
            750,
            245,
            115,
            65
        ],
        "expected": [
            "^[1-7]?\\d(?!\\d)"
        ]
    },
    "__AutoUseSpMedicationSanityAfterBelow160": {
        "desc": "用药后理智低于 160",
        "recognition": "OCR",
        "roi": [
            750,
            245,
            115,
            65
        ],
        "expected": [
            "^(1[0-5]|[1-9])?\\d(?!\\d)"
        ]
    },
    "__AutoUseSpMedicationSanityCurrentAtLeast80": {
        "desc": "当前理智不低于 80",
        "recognition": "OCR",
        "roi": [
            525,
            245,
            110,
            65
        ],
        "expected": [
            "^([89]|[1-9]\\d)\\d(?!\\d)"
        ]
    },
    "__AutoUseSpMedicationSanityNotEnough": {
        "desc": "用药后理智仍未达到阈值",
        "recognition": "Or",
        "any_of": [
            "__AutoUseSpMedicationSanityAfterBelow80",
            {
                "recognition": "And",
                "all_of": [
                    "__AutoUseSpMedicationSanityCurrentAtLeast80",
                    "__AutoUseSpMedicationSanityAfterBelow160"
                ]
            }
        ]
    },
    "AutoUseSpMedicationDialogText": {
        "desc": "识别恢复理智界面标题",
        "recognition": "OCR",
        "roi": [
            50,
            150,
            330,
            130
        ],
        "expected": [
            "恢复理智"
        ]
    }
