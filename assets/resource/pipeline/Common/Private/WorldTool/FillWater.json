        ]
    },
    "__WorldToolFillWaterCloseReward": {
        "desc": "关闭装水结算",
        "recognition": "And",
        "all_of": [
            "CloseRewardsButton"
        ],
        "pre_wait_freezes": 200,
        "action": "Click",
        "next": [
            "__WorldToolFillWaterSelectContainer",
            "__WorldToolFillWaterClosePanel"
        ]
    },
    "__WorldToolFillWaterClosePanel": {
        "desc": "一级菜单点右上角关闭液体盛装面板",
        "recognition": "And",
        "all_of": [
            "__WorldToolFillWaterPanel",
            "CloseButtonType1"
