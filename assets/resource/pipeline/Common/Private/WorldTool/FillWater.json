        ]
    },
    "__WorldToolFillWaterBackToWorld": {
        "desc": "已关闭液体盛装面板回到大世界",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "next": [
            "[Anchor]WorldToolFillWaterDone"
        ]
    }
}
