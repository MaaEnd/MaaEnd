                0,
                500,
                1280,
                140
            ]
        },
        "next": [
            "__WorldToolFillWaterHoldBottle",
            "__WorldToolFillWaterCloseList"
        ]
    },
    "__WorldToolFillWaterHoldBottle": {
        "desc": "长按空蓝铁瓶选满 10 份",
        "recognition": "OCR",
        "roi": [
            0,
            605,
            1280,
            35
        ],
        "expected": [
            "^蓝铁瓶$",
            "^藍鐵瓶$",
            "(?i)^Ferrium\\s*Bottle$",
            "^青鉄製ボトル$",
            "^페리움\\s*병$"
        ],
        "action": "LongPress",
        "target_offset": [
            0,
            -60,
            0,
            0
        ],
        "duration": 3000,
        "next": [
            "__WorldToolFillWaterConfirm"
        ]
    },
    "__WorldToolFillWaterContainerList": {
        "desc": "左下角有背包，处于选择空容器的二级菜单",
        "recognition": "TemplateMatch",
        "roi": [
            0,
            460,
            60,
            45
        ],
        "template": "Common/WorldTool/ContainerListBackpack.png",
        "threshold": 0.8
    },
    "__WorldToolFillWaterCloseList": {
        "desc": "二级菜单里没有空蓝铁瓶，点右上角退回一级菜单",
        "recognition": "And",
        "all_of": [
            "__WorldToolFillWaterContainerList",
