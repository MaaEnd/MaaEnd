{
    "__WorldToolFillWaterQuickStash": {
        "desc": "点击一键存放，防止背包满了放不下蓝铁瓶",
        "recognition": "TemplateMatch",
        "roi": [
            871,
            472,
            162,
            125
        ],
        "template": "StashBackpack/QuickStash.png",
        "order_by": "Score",
        "pre_wait_freezes": 200,
        "action": "Click",
        // 一键存放会改变仓库格子排布，等格子稳定后再找蓝铁瓶
        "post_wait_freezes": {
            "time": 400,
            "target": [
                154,
                202,
                585,
                291
            ],
            "timeout": 3000
        },
        "next": [
            "__WorldToolFillWaterShiftDown"
        ],
        // next 只有找蓝铁瓶，超时未命中即为仓库里找不到蓝铁瓶
        "focus": {
            "Node.NextList.Failed": "$task.WorldTool.focus.no_iron_bottle"
        }
    },
    "__WorldToolFillWaterShiftDown": {
        "desc": "在仓库中找到空蓝铁瓶，按住 Shift 准备快速移动",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "IconRecognition",
                "custom_recognition_param": {
                    "grid_type": "transfer",
                    "item_ids": [
                        "item_iron_bottle"
                    ],
                    // 装了液体的蓝铁瓶外观相近，用产物分类复核，避免取成装了液体的瓶子
                    "item_recheck_filters": [
                        "Normal:Product"
                    ],
                    "deduplicate": true
                },
                "roi": [
                    154,
                    202,
                    585,
                    291
                ]
            }
        },
        "action": "KeyDown",
        "auto_up": true,
        "key": 16, // Shift
        "post_delay": 50,
        "next": [
            "__WorldToolFillWaterTakeBottleClick"
        ]
    },
    "__WorldToolFillWaterTakeBottleClick": {
        "desc": "Shift + 单击空蓝铁瓶移一组到背包",
        "action": "Click",
        "target": "__WorldToolFillWaterShiftDown",
        "target_offset": [
            26,
            25,
            -52,
            -50
        ],
        "post_delay": 50,
        "next": [
            "__WorldToolFillWaterShiftUp"
        ]
    },
    "__WorldToolFillWaterShiftUp": {
        "desc": "松开 Shift 并等待物品移动完成",
        "action": "KeyUp",
        "key": 16, // Shift
        "next": [
            "__WorldToolFillWaterTeleport"
        ]
    },
    "__WorldToolFillWaterTeleport": {
        "desc": "传送到武陵城方兴衢",
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneEnterWorldWulingWulingCityFangxingAvenue"
            ]
        },
        "next": [
            "__WorldToolFillWaterRoute"
        ],
        "focus": {
            "Node.Action.Starting": "$task.WorldTool.focus.fill_water"
        }
    },
    "__WorldToolFillWaterRoute": {
        "desc": "走到方兴衢的水池里",
        "action": "Custom",
        "custom_action": "MapNavigateAction",
        "custom_action_param": {
            "heading_source": "camera",
            "path": [
                {
                    "action": "ZONE",
                    "zone_id": "Wuling_Base"
                },
                {
                    "action": "NAVMESH",
                    "target": [
                        799.5,
                        1601.2
                    ],
                    "required": true
                }
            ]
        },
        "next": [
            "__WorldToolFillWaterReset"
        ]
    },
    "__WorldToolFillWaterReset": {
        "desc": "重置装水轮数",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "action": "Custom",
        "custom_action": "ClearHitCount",
        "custom_action_param": {
            "nodes": [
                "__WorldToolFillWaterSelectContainer"
            ]
        },
        "next": [
            "__WorldToolFillWaterHoldR"
        ]
    },
    "__WorldToolFillWaterHoldR": {
        "desc": "长按 R 打开工具轮盘准备装水",
        "action": "KeyDown",
        "auto_up": true,
        "key": 82, // R 0x52
        "next": [
            "__WorldToolFillWaterInSelectTool"
        ]
    },
    "__WorldToolFillWaterInSelectTool": {
        "desc": "已打开工具轮盘",
        "recognition": "And",
        "all_of": [
            "InSelectTool"
        ],
        "next": [
            "__WorldToolFillWaterChooseFill"
        ]
    },
    "__WorldToolFillWaterChooseFill": {
        "desc": "在工具轮盘中选择盛装",
        "recognition": "TemplateMatch",
        "roi": [
            404,
            117,
            463,
            464
        ],
        "template": "Common/WorldTool/FillToolIcon.png",
        "threshold": 0.8,
        "order_by": "Score",
        "pre_wait_freezes": 80,
        "action": "Click",
        "next": [
            "__WorldToolFillWaterKeyUp"
        ]
    },
    "__WorldToolFillWaterKeyUp": {
        "desc": "松开 R 打开液体盛装面板",
        "action": "KeyUp",
        "key": 82, // R 0x52
        "next": [
            "__WorldToolFillWaterSelectContainer"
        ]
    },
    "__WorldToolFillWaterPanel": {
        "desc": "液体盛装面板",
        "recognition": "TemplateMatch",
        "roi": [
            840,
            40,
            100,
            90
        ],
        "template": "Common/WorldTool/LiquidFillTitle.png",
        "threshold": 0.8
    },
    "__WorldToolFillWaterSelectContainer": {
        "desc": "点击选择空容器",
        "max_hit": 5, // 每轮装 10 份，最多装 50 份
        "recognition": "And",
        "all_of": [
            "__WorldToolFillWaterPanel",
            {
                "recognition": "TemplateMatch",
                "roi": [
                    1030,
                    205,
                    215,
                    220
                ],
                "template": "Common/WorldTool/SelectContainerPlus.png",
                "threshold": 0.8
            }
