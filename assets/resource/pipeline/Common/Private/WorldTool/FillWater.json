    "__WorldToolFillWaterStart": {
        "desc": "点击盛装",
        "recognition": "And",
        "all_of": [
            "__WorldToolFillWaterPanel",
            "YellowConfirmButtonType1"
        ],
        "box_index": 1,
        "pre_wait_freezes": 200,
        "action": "Click",
        "next": [
