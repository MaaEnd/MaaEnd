        "action": "Click",
        "next": [
            "__WorldToolFillWaterClosePanel"
        ]
    },
    "__WorldToolFillWaterConfirm": {
        "desc": "确认选择的容器",
        "recognition": "And",
        "all_of": [
            "WhiteConfirmButtonType1"
        ],
        "pre_wait_freezes": 200,
        "action": "Click",
        "next": [
            "__WorldToolFillWaterStart"
        ]
