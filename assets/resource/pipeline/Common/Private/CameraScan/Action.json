{
    "__CameraScanMoveUp": {
        "desc": "CameraScanAction 上移镜头一格（半格，约 22.5°）",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Swipe",
        "begin": [
            520,
            360
        ],
        "end": [
            520,
            240
        ],
        "end_hold": 0,
        "duration": 60,
        // 静止判定的比较区域取拍照停止节点 __TakePhotoShutter 的搜索范围并集
        // （ShutterButton 961,465,213,183 ∪ __TakePhotoCheckTarget 0,100,150,580），
        // 不用全屏：全屏会把界面动画一起算进去，每格都会等满 timeout。
        // 换用别的 wait_nodes 时，把这里的 target 改成对应节点的 roi。
        "post_wait_freezes": {
            "time": 40,
            "timeout": 200,
            "target": [
                0,
                100,
                1174,
                580
            ],
            "threshold": 0.95,
            "rate_limit": 40
        },
        "post_delay": 0,
        "rate_limit": 0
    },
