{
    "PullCountCalculatorMain": {
        "desc": "抽数计算入口：先申请 IMS 扫描嵌晶玉/衍质源石，再进入珍贵物品页当场识别抽卡资源并计算",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]SyncShopItemData",
            "PullCountCalculatorEnterValuables"
        ],
        "focus": {
            "Node.Action.Starting": "$task.PullCountCalculator.focus.start",
            "Node.Action.Failed": "$task.PullCountCalculator.focus.failed"
        }
    },
    "PullCountCalculatorEnterValuables": {
        "desc": "进入贵重品库珍贵物品页，不扫库；界面跳转交由 SceneManager 处理",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "PullCountCalculatorInStashValuablesTab",
            "[JumpBack]SceneEnterMenuValuablesValuableTab"
        ]
    },
    "PullCountCalculatorInStashValuablesTab": {
        "desc": "已在珍贵物品页：现场识别抽卡资源，并用 IMS 中的嵌晶玉/衍质源石计算抽数",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InStashValuablesTab"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PullCountCalculatorAction",
                "custom_action_param": {}
            }
        },
        "post_delay": 0,
        "rate_limit": 0
    }
}
