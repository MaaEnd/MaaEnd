{
    "PullCountCalculatorMain": {
        "desc": "抽数计算入口：IMS 扫采购中心与珍贵物品页后，用 A4 公式估算下版本池总抽数",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "PullCountCalculatorSyncShop"
        ],
        "focus": {
            "Node.Action.Starting": "$task.PullCountCalculator.focus.start",
            "Node.Action.Failed": "$task.PullCountCalculator.focus.failed"
        }
    },
    "PullCountCalculatorSyncShop": {
        "desc": "同步采购中心衍质源石与嵌晶玉",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]SyncShopItemData",
            "PullCountCalculatorSyncValuables"
        ]
    },
    "PullCountCalculatorSyncValuables": {
        "desc": "同步珍贵物品页特许寻访凭证（不翻页）",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]SyncValuablesItemData",
            "PullCountCalculatorEvaluate"
        ]
    },
    "PullCountCalculatorEvaluate": {
        "desc": "A4：按库存公式计算下版本池总抽数并播报",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EvaluateItemQuantity",
                "custom_action_param": {
                    "expression": "{CHARTERED_HH_PERMIT}+({OROBERYL}+max({ORIGEOMETRY}-29,0)*75)/500+5+5"
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [],
        "focus": {
            "Node.Action.Succeeded": "$task.PullCountCalculator.focus.succeeded",
            "Node.Action.Failed": "$task.PullCountCalculator.focus.failed"
        }
    }
}
