{
    "PullCountCalculatorMain": {
        "desc": "抽数计算入口：读取当前干员寻访界面顶部资源栏，再进入贵重品库扫描寻访券并输出当前池/下版本池抽数估算",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "init",
            "reserved_originium": 29,
            "originium_to_oroberyl": 75,
            "oroberyl_per_pull": 500,
            "next_pool_shop_pulls": 5,
            "next_pool_signin_pulls": 5,
            "scan_max_pages": 8
        },
        "post_delay": 0,
        "next": [
            "PullCountCalculatorOriginiumOCR"
        ],
        "focus": {
            "Node.Action.Starting": "$task.PullCountCalculator.focus.start",
            "Node.Action.Failed": "$task.PullCountCalculator.focus.failed"
        }
    },
    "PullCountCalculatorOriginiumOCR": {
        "desc": "识别顶部衍质源石换算嵌晶玉数量",
        "recognition": "OCR",
        "roi": [
            982,
            8,
            68,
            40
        ],
        "expected": [
            "^\\d+$"
        ],
        "only_rec": true,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_originium"
        },
        "next": [
            "PullCountCalculatorOroberylOCR"
        ]
    },
    "PullCountCalculatorOroberylOCR": {
        "desc": "识别顶部嵌晶玉数量",
        "recognition": "OCR",
        "roi": [
            1084,
            8,
            78,
            40
        ],
        "expected": [
            "^\\d+$"
        ],
        "only_rec": true,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_oroberyl"
        },
        "next": [
            "PullCountCalculatorEnterValuables"
        ]
    },
    "PullCountCalculatorEnterValuables": {
        "desc": "进入贵重品库珍贵物品页，界面跳转交由 SceneManager Pipeline 处理",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "PullCountCalculatorInStashValuablesTab",
            "[JumpBack]SceneStashValuablesTab"
        ],
        "focus": {
            "Node.Action.Starting": "即将进入贵重品库珍贵物品页"
        }
    },
    "PullCountCalculatorInStashValuablesTab": {
        "desc": "确认当前已经在贵重品库珍贵物品页",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InStashValuablesTab"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "PullCountCalculatorScanPage"
        ]
    },
    "PullCountCalculatorScanPage": {
        "desc": "开始扫描当前页的寻访相关券图标",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClearHitCount",
                "custom_action_param": {
                    "nodes": [
                        "PullCountCalculatorFindCurrentOnlyVoucher",
                        "PullCountCalculatorFindCarryToNextVoucher",
                        "PullCountCalculatorFindNextOnlyVoucher"
                    ]
                }
            }
        },
        "post_delay": 0,
        "next": [
            "PullCountCalculatorFindCurrentOnlyVoucher",
            "PullCountCalculatorFindCarryToNextVoucher",
            "PullCountCalculatorFindNextOnlyVoucher",
            "PullCountCalculatorPageDone"
        ]
    },
    "PullCountCalculatorFindCurrentOnlyVoucher": {
        "desc": "查找当前池限时寻访凭证图标",
        "max_hit": 1,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    30,
                    80,
                    950,
                    560
                ],
                "template": "PullCountCalculator/CurrentOnly",
                "green_mask": true,
                "threshold": 0.78,
                "order_by": "Vertical"
            }
        },
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "next": [
            "PullCountCalculatorClickCurrentOnlyVoucher",
            "PullCountCalculatorFindCarryToNextVoucher"
        ]
    },
    "PullCountCalculatorClickCurrentOnlyVoucher": {
        "desc": "点击当前池限时寻访凭证图标",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InStashValuablesTab",
                    "PullCountCalculatorFindCurrentOnlyVoucher"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click",
            "param": {
                "target": "PullCountCalculatorFindCurrentOnlyVoucher"
            }
        },
        "post_wait_freezes": 150,
        "post_delay": 0,
        "next": [
            "PullCountCalculatorCurrentOnlyVoucherQuantityOCR",
            "PullCountCalculatorRecordCurrentOnlyVoucher"
        ]
    },
    "PullCountCalculatorCurrentOnlyVoucherQuantityOCR": {
        "desc": "识别当前池限时寻访凭证堆叠数量",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "PullCountCalculatorFindCurrentOnlyVoucher",
                "roi_offset": [
                    16,
                    60,
                    20,
                    -50
                ],
                "expected": [
                    ".*\\d+.*"
                ],
                "only_rec": true
            }
        },
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_quantity",
            "pool_scope": "current_only"
        },
        "next": [
            "PullCountCalculatorRecordCurrentOnlyVoucher"
        ]
    },
    "PullCountCalculatorRecordCurrentOnlyVoucher": {
        "desc": "记录当前池限时寻访凭证",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_voucher",
            "pool_scope": "current_only",
            "pull_value": 1
        },
        "target": "PullCountCalculatorFindCurrentOnlyVoucher",
        "post_delay": 0,
        "next": [
            "PullCountCalculatorFindCarryToNextVoucher"
        ]
    },
    "PullCountCalculatorFindCarryToNextVoucher": {
        "desc": "查找可留到后续池子的特许寻访凭证图标",
        "max_hit": 1,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    30,
                    80,
                    950,
                    560
                ],
                "template": "PullCountCalculator/CarryToNextVoucher.Template.png",
                "green_mask": true,
                "threshold": 0.78,
                "order_by": "Vertical"
            }
        },
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "next": [
            "PullCountCalculatorClickCarryToNextVoucher",
            "PullCountCalculatorFindNextOnlyVoucher"
        ]
    },
    "PullCountCalculatorClickCarryToNextVoucher": {
        "desc": "点击可留到后续池子的特许寻访凭证图标",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InStashValuablesTab",
                    "PullCountCalculatorFindCarryToNextVoucher"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click",
            "param": {
                "target": "PullCountCalculatorFindCarryToNextVoucher"
            }
        },
        "post_wait_freezes": 150,
        "post_delay": 0,
        "next": [
            "PullCountCalculatorCarryToNextVoucherQuantityOCR",
            "PullCountCalculatorCarryToNextVoucherTitleOCR",
            "PullCountCalculatorFindNextOnlyVoucher"
        ]
    },
    "PullCountCalculatorCarryToNextVoucherQuantityOCR": {
        "desc": "识别可留到后续池子的特许寻访凭证堆叠数量",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "PullCountCalculatorFindCarryToNextVoucher",
                "roi_offset": [
                    16,
                    60,
                    20,
                    -50
                ],
                "expected": [
                    ".*\\d+.*"
                ],
                "only_rec": true
            }
        },
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_quantity",
            "pool_scope": "carry_to_next"
        },
        "next": [
            "PullCountCalculatorCarryToNextVoucherTitleOCR",
            "PullCountCalculatorFindNextOnlyVoucher"
        ]
    },
    "PullCountCalculatorCarryToNextVoucherTitleOCR": {
        "desc": "确认选中的券是特许寻访凭证，排除基础寻访凭证",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    980,
                    82,
                    250,
                    48
                ],
                "expected": [
                    ".*(特许寻访凭证|特許尋訪憑證).*"
                ],
                "only_rec": true
            }
        },
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_voucher",
            "pool_scope": "carry_to_next",
            "pull_value": 1
        },
        "target": "PullCountCalculatorFindCarryToNextVoucher",
        "next": [
            "PullCountCalculatorFindNextOnlyVoucher"
        ]
    },
    "PullCountCalculatorFindNextOnlyVoucher": {
        "desc": "查找下版本专用寻访情报书图标",
        "max_hit": 1,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    30,
                    80,
                    950,
                    560
                ],
                "template": "PullCountCalculator/NextOnlyVoucher.Template.png",
                "green_mask": true,
                "threshold": 0.78,
                "order_by": "Vertical"
            }
        },
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "next": [
            "PullCountCalculatorClickNextOnlyVoucher",
            "PullCountCalculatorPageDone"
        ]
    },
    "PullCountCalculatorClickNextOnlyVoucher": {
        "desc": "点击下版本专用寻访情报书图标",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InStashValuablesTab",
                    "PullCountCalculatorFindNextOnlyVoucher"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click",
            "param": {
                "target": "PullCountCalculatorFindNextOnlyVoucher"
            }
        },
        "post_wait_freezes": 150,
        "post_delay": 0,
        "next": [
            "PullCountCalculatorNextOnlyVoucherQuantityOCR",
            "PullCountCalculatorRecordNextOnlyVoucher"
        ]
    },
    "PullCountCalculatorNextOnlyVoucherQuantityOCR": {
        "desc": "识别下版本专用寻访情报书堆叠数量",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "PullCountCalculatorFindNextOnlyVoucher",
                "roi_offset": [
                    16,
                    60,
                    20,
                    -50
                ],
                "expected": [
                    ".*\\d+.*"
                ],
                "only_rec": true
            }
        },
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_quantity",
            "pool_scope": "next_only"
        },
        "next": [
            "PullCountCalculatorRecordNextOnlyVoucher"
        ]
    },
    "PullCountCalculatorRecordNextOnlyVoucher": {
        "desc": "记录下版本专用寻访情报书",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_voucher",
            "pool_scope": "next_only",
            "pull_value": 10
        },
        "target": "PullCountCalculatorFindNextOnlyVoucher",
        "post_delay": 0,
        "next": [
            "PullCountCalculatorPageDone"
        ]
    },
    "PullCountCalculatorPageDone": {
        "desc": "记录本页图标扫描结果并判断继续滚动或完成",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "page_done"
        },
        "post_delay": 0,
        "next": [
            "PullCountCalculatorPageShouldFinish",
            "PullCountCalculatorWarehouseScrollDown"
        ]
    },
    "PullCountCalculatorPageShouldFinish": {
        "desc": "Go 仅判断本页扫描是否应结束，流程分支由 Pipeline next 处理",
        "recognition": "Custom",
        "custom_recognition": "PullCountCalculatorRecognition",
        "custom_recognition_param": {
            "stage": "page_should_finish"
        },
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "next": [
            "PullCountCalculatorFinish"
        ]
    },
    "PullCountCalculatorWarehouseScrollDown": {
        "desc": "向下滚动贵重品库列表，继续扫描下一页",
        "max_hit": 7,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InStashValuablesTab"
                ]
            }
        },
        "action": "Scroll",
        "target": [
            640,
            350
        ],
        "dy": -360,
        "post_wait_freezes": 650,
        "next": [
            "PullCountCalculatorScanPage"
        ]
    },
    "PullCountCalculatorFinish": {
        "desc": "汇总资源与仓库券并输出抽数计算结果",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "finish"
        },
        "post_delay": 0
    }
}
