{
    "PullCountCalculatorMain": {
        "desc": "抽数计算入口：同步采购中心与珍贵物品页库存后，按自定义保留量估算当前池/下版本池抽数",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "PullCountCalculatorSyncShop"
        ],
        "focus": {
            "Node.Action.Starting": "$task.PullCountCalculator.focus.start",
            "Node.Action.Failed": "$task.PullCountCalculator.focus.failed"
        }
    },
    "PullCountCalculatorSyncShop": {
        "desc": "同步采购中心衍质源石与嵌晶玉",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]SyncShopItemData",
            "PullCountCalculatorSyncValuables"
        ]
    },
    "PullCountCalculatorSyncValuables": {
        "desc": "同步贵重品库珍贵物品页特许寻访凭证",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]SyncValuablesItemData",
            "PullCountCalculatorEvaluate"
        ]
    },
    "PullCountCalculatorEvaluate": {
        "desc": "按 IMS 库存与 attach 保留量计算抽数并 Focus 播报",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PullCountCalculatorAction",
                "custom_action_param": {}
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [],
        "focus": {
            "Node.Action.Succeeded": "$task.PullCountCalculator.focus.succeeded",
            "Node.Action.Failed": "$task.PullCountCalculator.focus.failed"
        },
        "attach": {
            "reserve_originium": 29,
            "reserve_oroberyl": 0
        }
    }
}
