{
    "PullCountCalculatorMain": {
        "desc": "抽数计算入口：从大世界进入寻访读取顶部资源，再返回大世界打开菜单进入贵重品库扫描保障配额、寻访情报书和特许寻访凭证并输出估算",
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "init"
        },
        "next": [
            "PullCountCalculatorFocusWorldBeforeRecruitment"
        ],
        "focus": {
            "Node.Action.Starting": "$task.PullCountCalculator.focus.start",
            "Node.Action.Failed": "$task.PullCountCalculator.focus.failed"
        }
    },
    "PullCountCalculatorFocusWorldBeforeRecruitment": {
        "desc": "进入寻访前聚焦 Endfield 游戏窗口",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InWorld"
                ]
            }
        },
        "action": "Custom",
        "custom_action": "AccountSwitchWindowAction",
        "custom_action_param": {
            "op": "focus",
            "window": "main"
        },
        "next": [
            "PullCountCalculatorEnterRecruitmentFromWorld"
        ]
    },
    "PullCountCalculatorEnterRecruitmentFromWorld": {
        "desc": "从大世界点击右上角寻访入口下方真实 UI 图标进入寻访界面，适配普通态和 Hover 态",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__PullCountCalculatorRecruitmentButton",
                    "__PullCountCalculatorRecruitmentButtonHover"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AutoAltClickAction"
            }
        },
        "next": [
            "PullCountCalculatorOriginiumOCR"
        ]
    },
    "__PullCountCalculatorRecruitmentButton": {
        "desc": "右上角寻访入口普通态模板",
        "recognition": "TemplateMatch",
        "roi": [
            1066,
            24,
            50,
            48
        ],
        "template": "PullCountCalculator/RecruitmentButton.Template.png",
        "threshold": 0.78
    },
    "__PullCountCalculatorRecruitmentButtonHover": {
        "desc": "右上角寻访入口 Hover 态模板",
        "recognition": "TemplateMatch",
        "roi": [
            1066,
            24,
            50,
            48
        ],
        "template": "PullCountCalculator/RecruitmentButtonHover.Template.png",
        "threshold": 0.78
    },
    "PullCountCalculatorOriginiumOCR": {
        "desc": "识别顶部衍质源石换算嵌晶玉数量",
        "recognition": "OCR",
        "roi": [
            982,
            8,
            68,
            40
        ],
        "expected": [
            "^\\d+$"
        ],
        "only_rec": true,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_originium"
        },
        "next": [
            "PullCountCalculatorOroberylOCR"
        ]
    },
    "PullCountCalculatorOroberylOCR": {
        "desc": "识别顶部嵌晶玉数量",
        "recognition": "OCR",
        "roi": [
            1084,
            8,
            78,
            40
        ],
        "expected": [
            "^\\d+$"
        ],
        "only_rec": true,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_oroberyl"
        },
        "next": [
            "PullCountCalculatorBackToWorld"
        ]
    },
    "PullCountCalculatorBackToWorld": {
        "desc": "读取寻访顶部资源后返回大世界",
        "next": [
            "PullCountCalculatorFocusWorldBeforeMenu",
            "[JumpBack]SceneAnyEnterWorld"
        ]
    },
    "PullCountCalculatorFocusWorldBeforeMenu": {
        "desc": "打开主菜单前聚焦 Endfield 游戏窗口",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InWorld"
                ]
            }
        },
        "action": "Custom",
        "custom_action": "AccountSwitchWindowAction",
        "custom_action_param": {
            "op": "focus",
            "window": "main"
        },
        "next": [
            "PullCountCalculatorOpenMenuListByEsc"
        ]
    },
    "PullCountCalculatorOpenMenuListByEsc": {
        "desc": "从大世界按 ESC 打开主菜单列表",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InWorld"
                ]
            }
        },
        "action": "ClickKey",
        "key": 27,
        "next": [
            "PullCountCalculatorInMenuList"
        ]
    },
    "PullCountCalculatorInMenuList": {
        "desc": "确认主菜单列表已打开",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InMenuList"
                ]
            }
        },
        "next": [
            "PullCountCalculatorEnterValuables"
        ]
    },
    "PullCountCalculatorEnterValuables": {
        "desc": "从主菜单列表进入贵重品库珍贵物品页，界面跳转交由 SceneManager Pipeline 处理",
        "next": [
            "PullCountCalculatorInStashValuablesTab",
            "[JumpBack]SceneEnterMenuValuablesValuableTabFromMenuList"
        ],
        "focus": {
            "Node.Action.Starting": "即将进入贵重品库珍贵物品页"
        }
    },
    "PullCountCalculatorInStashValuablesTab": {
        "desc": "确认当前已经在贵重品库珍贵物品页",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InStashValuablesTab"
                ]
            }
        },
        "next": [
            "PullCountCalculatorScanPage"
        ]
    },
    "PullCountCalculatorScanPage": {
        "desc": "扫描当前页的保障配额、寻访情报书与特许寻访凭证数量",
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_voucher"
        },
        "next": [
            "PullCountCalculatorFinish"
        ]
    },
    "PullCountCalculatorFindCarryToNextPermit": {
        "desc": "查找当前页可留到后续池子的特许寻访凭证图标",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    30,
                    80,
                    950,
                    560
                ],
                "template": "PullCountCalculator/CarryToNextVoucher.Template.png",
                "green_mask": true,
                "threshold": 0.78,
                "order_by": "Vertical"
            }
        }
    },
    "PullCountCalculatorFindHeadhuntingDossier": {
        "desc": "查找当前页可在下版本转换的寻访情报书图标",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    30,
                    80,
                    950,
                    560
                ],
                "template": "PullCountCalculator/HeadhuntingDossier.Template.png",
                "green_mask": true,
                "threshold": 0.78,
                "order_by": "Vertical"
            }
        }
    },
    "PullCountCalculatorFindBondQuota": {
        "desc": "查找当前页保障配额图标",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    30,
                    80,
                    950,
                    560
                ],
                "template": "PullCountCalculator/BondQuota.Template.png",
                "green_mask": true,
                "threshold": 0.78,
                "order_by": "Vertical"
            }
        }
    },
    "PullCountCalculatorVoucherQuantityOCR": {
        "desc": "识别抽数相关物品格内数量，roi 由 Go 根据模板命中框覆盖",
        "recognition": "OCR",
        "expected": [
            ".*\\d+.*"
        ],
        "only_rec": true
    },
    "PullCountCalculatorFinish": {
        "desc": "汇总资源与仓库券并输出抽数计算结果",
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "finish"
        }
    }
}
