{
    "PullCountCalculatorMain": {
        "desc": "抽数计算入口：读取当前干员寻访界面顶部资源栏，再进入贵重品库扫描寻访券并输出当前池/下版本池抽数估算",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "init",
            "voucher_config_path": "data/PullCountCalculator/vouchers.json",
            "warehouse_scan_path": "data/PullCountCalculator/warehouse_scan.json",
            "reserved_originium": 29,
            "originium_to_oroberyl": 75,
            "oroberyl_per_pull": 500,
            "next_pool_shop_pulls": 5,
            "next_pool_signin_pulls": 5
        },
        "post_delay": 0,
        "next": [
            "PullCountCalculatorOriginiumOCR"
        ],
        "focus": {
            "Node.Action.Starting": "$task.PullCountCalculator.focus.start",
            "Node.Action.Failed": "$task.PullCountCalculator.focus.failed"
        }
    },
    "PullCountCalculatorOriginiumOCR": {
        "desc": "识别顶部衍质源石换算嵌晶玉数量",
        "recognition": "OCR",
        "roi": [
            982,
            8,
            68,
            40
        ],
        "expected": [
            "^\\d+$"
        ],
        "only_rec": true,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_originium"
        },
        "next": [
            "PullCountCalculatorOroberylOCR"
        ]
    },
    "PullCountCalculatorOroberylOCR": {
        "desc": "识别顶部嵌晶玉数量",
        "recognition": "OCR",
        "roi": [
            1084,
            8,
            78,
            40
        ],
        "expected": [
            "^\\d+$"
        ],
        "only_rec": true,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_oroberyl"
        },
        "next": [
            "PullCountCalculatorEnterValuables"
        ]
    },
    "PullCountCalculatorEnterValuables": {
        "desc": "进入贵重品库珍贵物品页，界面跳转交由 SceneManager Pipeline 处理",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "PullCountCalculatorInStashValuablesTab",
            "[JumpBack]SceneStashValuablesTab"
        ],
        "focus": {
            "Node.Action.Starting": "即将进入贵重品库珍贵物品页"
        }
    },
    "PullCountCalculatorInStashValuablesTab": {
        "desc": "确认当前已经在贵重品库珍贵物品页",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InStashValuablesTab"
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "PullCountCalculatorPageBegin"
        ]
    },
    "PullCountCalculatorPageBegin": {
        "desc": "开始扫描当前可见贵重品页面",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "page_begin"
        },
        "post_delay": 0,
        "next": [
            "PullCountCalculatorCellPrepare"
        ]
    },
    "PullCountCalculatorCellPrepare": {
        "desc": "[Go覆盖] 准备当前格子的识别、点击和记录参数",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "cell_prepare"
        },
        "post_delay": 0,
        "next": [
            "PullCountCalculatorCellClick",
            "PullCountCalculatorCellSkip"
        ]
    },
    "PullCountCalculatorCellClick": {
        "desc": "[Go覆盖] 点击当前可见贵重品格子",
        "recognition": "And",
        "all_of": [
            "InStashValuablesTab",
            "PullCountCalculatorCellPresent"
        ],
        "box_index": 1,
        "pre_delay": 0,
        "action": "Click",
        "target": [
            85,
            168,
            1,
            1
        ],
        "post_wait_freezes": 150,
        "post_delay": 0,
        "next": [
            "PullCountCalculatorCellQuantityOCR",
            "PullCountCalculatorCellTitleOCR",
            "PullCountCalculatorCellAdvance"
        ]
    },
    "PullCountCalculatorCellSkip": {
        "desc": "当前格子不存在时跳过并推进到下一格",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "cell_advance"
        },
        "post_delay": 0,
        "next": [
            "PullCountCalculatorCellPrepare",
            "PullCountCalculatorPageDone"
        ]
    },
    "PullCountCalculatorCellQuantityOCR": {
        "desc": "[Go覆盖] 识别当前格子的堆叠数量",
        "recognition": "OCR",
        "roi": [
            61,
            186,
            58,
            32
        ],
        "expected": [
            ".*\\d+.*"
        ],
        "only_rec": true,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_quantity",
            "cell": 1
        },
        "next": [
            "PullCountCalculatorCellTitleOCR",
            "PullCountCalculatorCellAdvance"
        ]
    },
    "PullCountCalculatorCellTitleOCR": {
        "desc": "[Go覆盖] 识别当前格子的右侧详情标题",
        "recognition": "OCR",
        "roi": [
            980,
            82,
            250,
            48
        ],
        "expected": [
            ".*(寻访|尋訪|凭证|憑證|情报书|情報書|recruit|voucher|ticket).*"
        ],
        "only_rec": true,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_item",
            "cell": 1
        },
        "next": [
            "PullCountCalculatorCellAdvance"
        ]
    },
    "PullCountCalculatorCellAdvance": {
        "desc": "推进到下一格，或在本页扫描完成后进入翻页流程",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "cell_advance"
        },
        "post_delay": 0,
        "next": [
            "PullCountCalculatorCellPrepare",
            "PullCountCalculatorPageDone"
        ]
    },
    "PullCountCalculatorCellPresent": {
        "desc": "[Go覆盖] 判断当前贵重品格子是否存在",
        "recognition": "ColorMatch",
        "roi": [
            44,
            127,
            82,
            82
        ],
        "method": 6,
        "lower": [
            65
        ],
        "upper": [
            255
        ],
        "connected": true,
        "count": 80,
        "order_by": "Vertical"
    },
    "PullCountCalculatorPageDone": {
        "desc": "记录本页扫描结果并准备滚动探测",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "page_done"
        },
        "post_delay": 0,
        "next": [
            "PullCountCalculatorWarehouseScrollDown",
            "PullCountCalculatorFinish"
        ]
    },
    "PullCountCalculatorWarehouseScrollDown": {
        "desc": "向下滚动贵重品库列表，继续扫描下一页",
        "max_hit": 7,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InStashValuablesTab"
                ]
            }
        },
        "action": "Scroll",
        "target": [
            640,
            350
        ],
        "dy": -360,
        "post_wait_freezes": 650,
        "next": [
            "PullCountCalculatorScrollProbeBegin"
        ]
    },
    "PullCountCalculatorScrollProbeBegin": {
        "desc": "滚动后开始轻量探测页首数量，用于判断是否已经到达仓库底部",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "probe_begin"
        },
        "post_delay": 0,
        "next": [
            "PullCountCalculatorScrollProbePrepare"
        ]
    },
    "PullCountCalculatorScrollProbePrepare": {
        "desc": "[Go覆盖] 准备当前页首探针格子的数量 OCR 参数",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "probe_prepare"
        },
        "post_delay": 0,
        "next": [
            "PullCountCalculatorScrollProbeQuantityOCR",
            "PullCountCalculatorScrollProbeSkip"
        ]
    },
    "PullCountCalculatorScrollProbeQuantityOCR": {
        "desc": "[Go覆盖] 探测滚动后当前页首格子的堆叠数量",
        "recognition": "OCR",
        "roi": [
            61,
            186,
            58,
            32
        ],
        "expected": [
            ".*\\d+.*"
        ],
        "only_rec": true,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "record_probe_quantity",
            "cell": 1
        },
        "next": [
            "PullCountCalculatorScrollProbeAdvance"
        ]
    },
    "PullCountCalculatorScrollProbeSkip": {
        "desc": "当前页首探针格子没有数量命中时跳过并推进",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "probe_advance"
        },
        "post_delay": 0,
        "next": [
            "PullCountCalculatorScrollProbePrepare",
            "PullCountCalculatorScrollProbeDone"
        ]
    },
    "PullCountCalculatorScrollProbeAdvance": {
        "desc": "推进到下一个页首探针格子，或结束本轮滚动探测",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "probe_advance"
        },
        "post_delay": 0,
        "next": [
            "PullCountCalculatorScrollProbePrepare",
            "PullCountCalculatorScrollProbeDone"
        ]
    },
    "PullCountCalculatorScrollProbeDone": {
        "desc": "滚动后页首探测结束，判断继续扫描或结束",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "scroll_probe_done"
        },
        "post_delay": 0,
        "next": [
            "PullCountCalculatorPageBegin",
            "PullCountCalculatorFinish"
        ]
    },
    "PullCountCalculatorFinish": {
        "desc": "汇总资源与仓库券并输出抽数计算结果",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "PullCountCalculatorAction",
        "custom_action_param": {
            "stage": "finish"
        },
        "post_delay": 0
    }
}
