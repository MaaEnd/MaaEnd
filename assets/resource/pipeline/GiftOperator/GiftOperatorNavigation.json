{
    "GiftOperatorMoveAhead": {
        "desc": "FIND 寻找白色干员名称并接近",
        "max_hit": 3,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MapLocateAssertLocation",
                "custom_recognition_param": {
                    "zone_id": "OMVBase01",
                    "target": [
                        177.62,
                        168.76,
                        19.3,
                        11.62
                    ]
                }
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "MapNavigateAction",
                "custom_action_param": {
                    "path": [
                        {
                            "action": "ZONE",
                            "zone_id": "OMVBase01"
                        },
                        {
                            "action": "FIND",
                            "find_target": "GiftOperatorFindName",
                            "find_stop": "GiftOperatorChat"
                        }
                    ]
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Action.Succeeded": {
                "trace": true
            },
            "Node.Action.Failed": {
                "trace": true
            }
        }
    },
    "GiftOperatorMoveRetry": {
        "desc": "寻路失败重试",
        "max_hit": 5,
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "GiftOperatorEntry"
        ],
        "focus": {
            "Node.Action.Starting": "$task.GiftOperator.focus.move_retry"
        }
    },
    "GiftOperatorMoveFail": {
        "desc": "移动未能接触到干员，炸掉程序",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "ERROR",
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Recognition.Succeeded": "$task.GiftOperator.focus.move_fail"
        }
    },
    "GiftOperatorMove": {
        "desc": "寻路走到干员联络台",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "MapNavigateAction",
                "custom_action_param": {
                    "path": [
                        {
                            "action": "ZONE",
                            "zone_id": "OMVBase01"
                        },
                        {
                            "action": "NAVMESH",
                            "target": [
                                182.52,
                                180.5
                            ]
                        },
                        [
                            182.52,
                            173.4,
                            true
                        ]
                    ]
                }
            }
        },
        "next": [
            "GiftOperatorClickContact"
        ],
        "focus": {
            "Node.Action.Succeeded": {
                "trace": true
            },
            "Node.Action.Failed": {
                "trace": true
            }
        }
    },
    "GiftOperatorMoveBackward": {
        "desc": "向后(S)一步，一般都是走过了，先转身退一步试试",
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 83
            }
        },
        "timeout": 5000,
        "next": [
            "GiftOperatorClickContact"
        ],
        "on_error": [
            "GiftOperatorMoveRetry",
            "GiftOperatorMoveFail"
        ]
    },
    "GiftOperatorGoAheadContact": {
        "desc": "继续向前走尝试接触联络台",
        "max_hit": 6,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "MapNavigateAction",
                "custom_action_param": {
                    "path": [
                        {
                            "action": "HEADING",
                            "target": [
                                183,
                                174
                            ],
                            "zone_id": "OMVBase01"
                        }
                    ]
                }
            }
        },
        "focus": {
            "Node.Action.Succeeded": {
                "trace": true
            },
            "Node.Action.Failed": {
                "trace": true
            }
        }
    },
    "GiftOperatorMoveSCAway": {
        "desc": "短途寻路先走开几步避免识别精度问题",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "MapNavigateAction",
                "custom_action_param": {
                    "path": [
                        {
                            "action": "ZONE",
                            "zone_id": "OMVBase01"
                        },
                        [
                            182,
                            179,
                            true
                        ]
                    ]
                }
            }
        },
        "next": [
            "GiftOperatorMoveSC"
        ],
        "on_error": [
            "GiftOperatorMoveRetry",
            "GiftOperatorMoveFail"
        ],
        "focus": {
            "Node.Action.Succeeded": {
                "trace": true
            },
            "Node.Action.Failed": {
                "trace": true
            }
        }
    },
    "GiftOperatorMoveSC": {
        "desc": "寻路走到干员联络台",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "MapNavigateAction",
                "custom_action_param": {
                    "path": [
                        {
                            "action": "ZONE",
                            "zone_id": "OMVBase01"
                        },
                        [
                            183.14,
                            173.88,
                            true
                        ]
                    ]
                }
            }
        },
        "next": [
            "GiftOperatorClickContact"
        ],
        "focus": {
            "Node.Action.Succeeded": {
                "trace": true
            },
            "Node.Action.Failed": {
                "trace": true
            }
        }
    },
    "GiftOperatorShiftToRun": {
        "desc": "按 Shift 恢复跑步模式，等待后再寻路",
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 16
            }
        },
        "post_delay": 500,
        "next": [
            "GiftOperatorMove"
        ]
    },
    "GiftOperatorShiftToRunSC": {
        "desc": "短路优化版本寻路,从干员联络站开始",
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 16
            }
        },
        "post_delay": 500,
        "next": [
            "GiftOperatorMoveSCAway"
        ]
    }
}
