{
    "GiftOperatorMoveAhead": {
        "desc": "移动尝试接触到干员",
        "max_hit": 8, // 子节点到 max_hit 之后此节点仍然会空执行报错，所以要设置一个和它的子节点次数一样多的值，让它的父节点正常跳出
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MapLocateAssertLocation",
                "custom_recognition_param": {
                    "zone_id": "OMVBase01",
                    "target": [
                        177.62,
                        168.76,
                        19.3,
                        11.62
                    ]
                }
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            //"GiftOperatorMoveResetBackward",
            "GiftOperatorTurnEast",
            //"GiftOperatorMoveLocation3Move",
            "GiftOperatorTurnNorthwest",
            "GiftOperatorTurnNorthByWest",
            "GiftOperatorTurnWest",
            "GiftOperatorTurnSoutheast"
        ]
    },
    "GiftOperatorMoveResetBackward": {
        "desc": "向后(S)一步，再向前(W)重置视角",
        "max_hit": 1,
        "pre_delay": 0,
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 83
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "GiftOperatorMoveResetForward"
        ]
    },
    "GiftOperatorMoveResetForward": {
        "desc": "向前(W)一步，完成视角重置",
        "pre_delay": 0,
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 87
            }
        },
        "post_delay": 0,
        "rate_limit": 0
    },
    "GiftOperatorMoveRetry": {
        "desc": "寻路失败重试",
        "max_hit": 5,
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "GiftOperatorEntry"
        ],
        "focus": {
            "Node.Action.Starting": "$task.GiftOperator.focus.move_retry"
        }
    },
    "GiftOperatorMoveFail": {
        "desc": "移动未能接触到干员，炸掉程序",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "ERROR", // 引发一个错误来结束当前任务并留下截图
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Recognition.Succeeded": "$task.GiftOperator.focus.move_fail"
        }
    },
    "GiftOperatorTurnWest": {
        "desc": "转向270度(正西)尝试接触到干员",
        "max_hit": 2,
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "MapNavigateAction",
                "custom_action_param": {
                    "path": [
                        {
                            "action": "HEADING",
                            "angle": 270,
                            "zone_id": "OMVBase01"
                        }
                    ]
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Action.Succeeded": {
                "trace": true
            },
            "Node.Action.Failed": {
                "trace": true
            }
        }
    },
