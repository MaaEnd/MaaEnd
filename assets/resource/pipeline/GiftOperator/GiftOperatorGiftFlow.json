{
    "GiftOperatorBranchGift": {
        "desc": "分支1：可以赠送礼物",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    900,
                    334,
                    350,
                    318
                ],
                "expected": [
                    "赠送礼物",
                    "贈送禮物",
                    "(?i)Offering\\s*Gifts",
                    "プレゼントを贈る"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "GiftOperatorGiftUI"
        ]
    },
    "GiftOperatorBranchReceive": {
        "desc": "分支2：干员给你送礼，点击领取",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    900,
                    334,
                    350,
                    318
                ],
                "expected": [
                    "收下礼物",
                    "收下禮物",
                    "(?i)Accept\\s*gift",
                    "プレゼントを受け取る",
                    "收下"
                ]
            }
        },
        "pre_wait_freezes": {
            "time": 200,
            "timeout": 3000,
            "target": [
                1008,
                474,
                84,
                38
            ]
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 200,
        "next": [
            "GiftOperatorReceiveDialog",
            "GiftOperatorBagFull"
        ]
    },
    "GiftOperatorClickGift": {
        "desc": "选择礼物",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "GiftOperatorClickGiftColor",
                    "GiftOperatorClickGiftColorNumber"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "GiftOperatorGiftSelected"
        ]
    },
    "GiftOperatorClickGiftColorNumber": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "GiftOperatorClickGiftColor",
                "roi_offset": [
                    26,
                    -24,
                    -50,
                    24
                ],
                "expected": [
                    "[1-9]\\d*"
                ]
            }
        }
    },
    "GiftOperatorClickGiftColor": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    0,
                    466,
                    1280,
                    254
                ],
                "method": 40,
                "lower": [
                    20,
                    250,
                    250
                ],
                "upper": [
                    30,
                    255,
                    255
                ],
                "connected": true,
                "count": 10
            }
        }
    },
    "GiftOperatorConfirmGift": {
        "desc": "点击赠送按钮",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "YellowButtonBackground",
                    "GiftOperatorConfirmGiftText"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 200,
            "timeout": 3000
        },
        "next": [
            "[JumpBack]GiftOperatorConfirmDialog",
            "[JumpBack]GiftOperatorGiftDialog",
            "GiftOperatorLeave"
        ]
    },
    "GiftOperatorConfirmDialog": {
        "desc": "赠送后二次确认弹窗：黄底圆环确认按钮，文字为确认",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "YellowConfirmButtonType1",
