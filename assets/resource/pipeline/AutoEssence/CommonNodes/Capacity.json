{
    "DecomposeWeaponEssenceStart": {
        "desc": "进入贵重品库，按阈值分解武器基质",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoEssenceCapacityEnter"
        ]
    },
    "AutoEssenceCapacityEnter": {
        "desc": "进入贵重品库的武器基质页",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoEssenceCapacityOnWeaponTab",
            "AutoEssenceCapacitySwitchToWeaponTab",
            "[JumpBack]SceneEnterMenuValuables"
        ]
    },
    "AutoEssenceCapacityOnWeaponTab": {
        "desc": "已在武器基质页，读取当前/2000",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    435,
                    3,
                    150,
                    49
                ],
                "template": "EssenceFilter/EssenceTabChoose.png",
                "threshold": 0.9
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoEssenceCapacityOverflow",
            "AutoEssenceCapacityEnough",
            "AutoEssenceCapacityReadFailed"
        ]
    },
    "AutoEssenceCapacitySwitchToWeaponTab": {
        "desc": "切换到武器基质标签页",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    350,
                    0,
                    500,
                    80
                ],
                "template": "EssenceFilter/EssenceTabNotChoose.png",
                "threshold": 0.9
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": 400,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoEssenceCapacityOnWeaponTab"
        ]
    },
    "AutoEssenceCapacityCountOCR": {
        "desc": "识别武器基质当前数量。只取左上角当前/2000里的当前值",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    70,
                    40,
                    150,
                    36
                ],
                "expected": [
                    // 武器基质 2004/2000，只取当前值
                    // @i18n-skip
                    "\\d+"
                ],
                "only_rec": true
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "AutoEssenceCapacityOverflow": {
        "desc": "武器基质数量高于阈值",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ExpressionRecognition",
                "custom_recognition_param": {
                    "expression": "1800 < {AutoEssenceCapacityCountOCR}",
                    "focus_matched_resolved_expression": true
                }
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoEssenceCapacityClickRecycle"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "武器基质高于阈值，分解 200 个"
        }
    },
    "AutoEssenceCapacityEnough": {
        "desc": "武器基质数量未高于阈值",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ExpressionRecognition",
                "custom_recognition_param": {
                    "expression": "{AutoEssenceCapacityCountOCR} <= 1800"
                }
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoEssenceCapacityReturnWorld"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "武器基质未高于阈值，返回大世界"
        }
    },
    "AutoEssenceCapacityReadFailed": {
        "desc": "读不到武器基质数量",
