{
    "__AutoEssenceRecoEssenceTriggerButton": {
        "desc": "寻找激发的大世界按钮（仅识别）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    800,
                    450,
                    100,
                    180
                ],
                "template": "AutoEssence/EssenceTrigger.png",
                "green_mask": true,
                "order_by": "Score"
            }
        }
    },
    "__AutoEssenceRecoEssenceTriggerText": {
        "desc": "寻找激发的文字（仅识别）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__AutoEssenceRecoEssenceTriggerButton",
                "roi_offset": [
                    0,
                    0,
                    150,
                    0
                ],
                "expected": [
                    "激发", // 激发
                    "觸發", // 觸發
                    "Trigger", // Trigger
                    "トリガー" // トリガー
                ]
            }
        }
    },
    "AutoEssenceClickEssenceStartButtonText": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "WhiteConfirmButtonType1",
                "roi_offset": [
                    -100,
                    -25,
                    100,
                    50
                ],
                "expected": [
                    "开启挑战",
                    "開啟挑戰",
                    "Start",
                    "挑戦"
                ]
            }
        }
    },
    "__AutoEssenceRecoEssenceOngoing": {
        "desc": "寻找挑战进行中的状态（仅识别）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    40,
                    260,
                    330
                ],
                "template": "AutoEssence/EssenceOngoing.png",
                "green_mask": true
            }
        }
    },
    "__AutoEssenceRecoEssenceObtainButton": {
        "desc": "寻找领取奖励的状态（仅识别）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    780,
                    340,
                    170,
                    310
                ],
                "template": "AutoEssence/EssenceObtain.png",
                "green_mask": true,
                "threshold": 0.45,
                "order_by": "Score"
            }
        }
    },
    "__AutoEssenceRecoEssenceObtainText": {
        "desc": "寻找领取奖励的文字（仅识别）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__AutoEssenceRecoEssenceObtainButton",
                "roi_offset": [
                    0,
                    0,
                    150,
                    0
                ],
                "expected": [
                    "领取", // 领取奖励
                    "領取", // 領取獎勵
                    "Claim", // Claim Rewards
                    "報酬" // 報酬受取
                ]
            }
        }
    },
    "__AutoEssenceRecoEssenceDiscardText": {
        "desc": "寻找放弃领取奖励的文字（仅识别）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__AutoEssenceRecoEssenceObtainButton",
                "roi_offset": [
                    0,
                    0,
                    150,
                    0
                ],
                "expected": [
                    "放弃|重置", // 放弃奖励并重置
                    "放棄|重置", // 放棄獎勵並重置
                    "Abandon|Reset", // Abandon Rewards and Reset
                    "受取せず|にリセット" // 受取せずにリセット
                ]
            }
        }
    },
    "__AutoEssenceRecoEngravePermitInsufficient": {
        "desc": "识别刻写券不足弹窗文案（仅识别）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    250,
                    1280,
                    200
                ],
                "expected": [
                    "对应地区刻写券不足，本次挑战奖励预刻写将不生效，确认直接开启挑战吗？",
                    "對應地區刻寫券不足，本次挑戰獎勵預刻寫將不生效，確定直接開啟挑戰嗎？",
                    "(?i)Insufficient\\s*regional\\s*engraving\\s*permits\\s*to\\s*validate\\s*pre-engrave\\s*rewards\\s*from\\s*this\\s*challenge\\.\\s*Start\\s*the\\s*challenge\\s*anyway\\?",
                    "該当地域の刻印券が不足しているため、刻印指定は適用されませんが、続行しますか？",
                    "해당 지역 각인권이 부족하여 이번 도전에서는 사전 각인이 적용되지 않습니다. 정말 이대로 도전을 시작하시겠습니까?"
                ]
            }
        }
    },
    "__AutoEssenceLowSpDialog": {
        "desc": "识别体力不足弹窗的图标（仅识别）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    400,
                    210,
                    200,
                    210
                ],
                "template": "AutoEssence/SpDialog.png"
            }
        }
    },
    "__AutoEssenceLowSpDialogCloseButton": {
        "desc": "识别体力不足弹窗的按钮（仅识别）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1030,
                    90,
                    245,
                    200
                ],
                "template": "AutoEssence/SpDialogCloseButton.png"
            }
        }
    }
}
