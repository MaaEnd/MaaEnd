{
    "AutoEssenceSchedule": {
        "desc": "基质刷取计划任务",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "AutoEssenceScheduleEnabled",
            "AutoEssenceScheduleEnd"
        ]
    },
    "AutoEssenceScheduleEnabled": {
        "desc": "基质刷取计划任务命中",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ScheduleRecognition",
                "custom_recognition_param": {}
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "AutoEssenceMain"
        ],
        "attach": {
            "monday": false,
            "tuesday": false,
            "wednesday": false,
            "thursday": false,
            "friday": false,
            "saturday": false,
            "sunday": false
        }
    },
    "AutoEssenceScheduleEnd": {
        "desc": "基质刷取计划任务跳过",
        "pre_delay": 0,
        "post_delay": 0
    },
    "AutoEssenceMain": {
        "desc": "自动基质刷取的主入口",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            // 在 SetupLocation 节点的 max_hit 未耗尽时，先经过该节点进行初始化步骤
            "AutoEssenceSetupLocation",
            // 如果 SetupLocation 节点的 max_hit 已耗尽，则会直接进入交互分发
            "AutoEssenceDispatcher"
        ],
        "focus": {
            "Node.Action.Starting": "▶️**准备开始本次基质刷取**"
        }
    },
    "AutoEssenceSetupLocation": {
        "desc": "抽取一个已启用的淤积点，调用其 Anchor 赋值节点，为自动导航的节点赋值（此节点默认最多执行 1 次）",
        "max_hit": 1, // 设为 1 表示全程只刷取一个地区；若修改此值为一个很大的数，即可实现每次循环刷取都重新选地区
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SubTask",
                "custom_action_param": {
                    // 根据 SubTask 的内部执行逻辑，若节点 enabled 字段为 false，则会被过滤掉，便不会被抽到
                    "sub": [
                        "GotoTriggerPointSetAnchor_VFTheHub",
                        "GotoTriggerPointSetAnchor_VFOriginiumSciencePark",
                        "GotoTriggerPointSetAnchor_VFOriginLodespring",
                        "GotoTriggerPointSetAnchor_VFPowerPlateau",
                        "GotoTriggerPointSetAnchor_WLWulingCity",
                        "GotoTriggerPointSetAnchor_WLQingboStockade",
                        "GotoTriggerPointSetAnchor_WLMarkerStone",
                        "GotoTriggerPointSetAnchor_WLTestArea",
                        "GotoTriggerPointSetAnchor_WLSwordVaultDale",
                        "GotoTriggerPointSetAnchor_WLYinglungPass",
                        "GotoTriggerPointSetAnchor_WLNorthWulingExclusionZone",
                        "GotoTriggerPointSetAnchor_WLSnowyForest"
                    ],
                    "continue": false,
                    "strict": true,
                    "random_choice": 1
                }
            }
        },
        "post_delay": 0,
        "next": [
            "AutoEssenceDispatcher"
        ],
        "on_error": [
            "AutoEssenceSetupLocationFailed"
        ]
    },
    "AutoEssenceSetupLocationFailed": {
        "desc": "抽取淤积点失败（通常是因为所有淤积点均未启用），此时结束任务",
        "action": "StopTask",
        "focus": {
            "Node.Action.Starting": "🤔**未选择任何地区**\n请在任务设置中至少勾选一个地区后重试~"
        }
    },
    "AutoEssenceTargetPrepare": {
        "desc": "目标模式：首次强制盘点无暇基质库存（export_inventory）后加载内存仓储；max_hit=1",
        "max_hit": 1,
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PipelineOverride",
                "custom_action_param": {
                    "patch": {
                        "EssenceFilterInit": {
                            "attach": {
                                "export_inventory": true
                            }
                        },
                        "EssenceFilterCheckItemOCRFallback": {
                            "action": "StopTask"
                        },
                        "EssenceGridClickPending": {
                            "on_error": [
                                "EssenceFilterCheckItemOCRFallback"
                            ]
                        },
                        "EssenceFilterMainFailed": {
                            "action": "StopTask"
                        },
                        "EssenceFilterNavigateToInventory": {
                            "action": "StopTask"
                        }
                    }
                }
            }
        },
        "post_delay": 0,
        "next": [
            "AutoEssenceTargetRunInventoryFilter"
        ],
        "on_error": [
            "AutoEssenceTargetPrepareFailed"
        ],
        "focus": {
            "Node.Action.Starting": "📦目标模式：开始盘点基质库存"
        }
    },
    "AutoEssenceTargetRunInventoryFilter": {
        "desc": "目标模式：SubTask 跑 EssenceFilterMain（库存导出）",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SubTask",
                "custom_action_param": {
                    "sub": [
                        "EssenceFilterMain"
                    ],
                    "continue": false,
                    "strict": true
                }
            }
        },
        "post_delay": 0,
        "next": [
            "AutoEssenceTargetLoadInventory"
        ],
        "on_error": [
            "AutoEssenceTargetPrepareFailed"
        ]
    },
    "AutoEssenceTargetLoadInventory": {
        "desc": "目标模式：将 EssenceInventory.json 载入内存仓储",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AutoEssenceLoadInventoryAction"
            }
        },
        "post_delay": 0,
        "next": [
            "AutoEssenceTargetPlan"
        ],
        "on_error": [
            "AutoEssenceTargetPrepareFailed"
        ],
        "focus": {
            "Node.Action.Succeeded": "📦目标模式：基质仓储已加载"
        }
    },
    "AutoEssenceTargetPrepareFailed": {
        "desc": "目标模式库存盘点失败，禁止空库存开刷",
        "action": "StopTask",
        "focus": {
            "Node.Action.Starting": "❌**目标模式：基质库存盘点失败**\n请确认已在基质界面可盘点后重试"
        }
    },
    "AutoEssenceTargetPlan": {
        "desc": "目标模式 A1：按缺口选刷取点与预刻写条件，OverrideNext 交还 Pipeline",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AutoEssenceTargetPlanAction"
            }
        },
        "post_delay": 0,
        "attach": {}
    },
    "AutoEssenceDispatcher": {
        "desc": "基质刷取分发：首次强制传送；之后认开挑战/激发/领取等，未命中则纯寻路",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            // 整次任务首次：只强制传送+寻路，不识别其它界面
            "__AutoEssenceForceTeleportOnce",
            // 淤积点交互：激发 / 领取 / 放弃
            "AutoEssenceClickTriggerButton",
            "AutoEssenceClickObtainButton",
            "AutoEssenceClickDiscardButton",
            "[JumpBack]AutoEssenceInObtain",
            // 无交互图标则纯寻路
            "[Anchor]AutoEssenceMoveToTriggerPoint"
        ],
        "focus": {
            "Node.Action.Starting": "🧠正在判断当前状态"
        }
    },
    "__AutoEssenceForceTeleportOnce": {
        "desc": "整次任务仅一次：强制传送到目标锚点后再寻路",
        "max_hit": 1,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "[Anchor]AutoEssenceMoveToTriggerPointMaybeTeleport"
        ]
    },
    "AutoEssenceClickTriggerButton": {
        "desc": "识别并点击激发的大世界按钮",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__AutoEssenceRecoEssenceTriggerButton",
                    "__AutoEssenceRecoEssenceTriggerText"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilFoundAction",
                "custom_action_param": {
                    "custom_action": "AutoAltClickAction",
                    "wait_nodes": [
                        "AutoEssenceClickEssenceStartPrepare",
                        "AutoEssenceMistakeFactoryDevice"
                    ]
                }
            }
        },
        "next": [
            "AutoEssenceMistakeFactoryDevice",
            "AutoEssenceReadyToStart"
        ],
        "focus": {
            "Node.Action.Starting": "👆点击激发按钮"
        }
    },
    "AutoEssenceReadyToStart": {
        "desc": "点击了激发的大世界按钮之后的守卫节点",
        "pre_delay": 0,
        "post_wait_freezes": 500,
        "post_delay": 0,
        "next": [
            "AutoEssenceMistakeFactoryDevice",
            "AutoEssenceClickEssenceStartPrepare"
        ]
    },
    "AutoEssenceMistakeFactoryDevice": {
        "desc": "识别是否误入工业设备界面，并将其关闭",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    950,
                    30,
                    270,
                    230
                ],
                "template": "AutoEssence/FactoryDeviceDialog.png"
            }
        },
        "action": {
            "type": "Click", // 此处点击的是工业设备界面的关闭按钮
            "param": {
                "target_offset": [
                    50,
                    5,
                    -50,
                    -10
                ]
            }
        },
        "next": [
            "[Anchor]AutoEssenceMoveToTriggerPoint"
        ],
        "focus": {
            "Node.Action.Starting": "😕误入工业设备界面，点击关闭按钮"
        }
    },
    "AutoEssenceClickEssenceStartPrepare": {
        "desc": "识别开始挑战界面，播报当前理智",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "WhiteConfirmButtonType1",
                    "AutoEssenceClickEssenceStartButtonText"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "FocusOCRAction",
                "custom_action_param": {
                    "node": "CommonSanityText",
                    "focus": "当前理智 %s"
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoEssenceAdjustEngraveConditions"
        ]
    },
    "AutoEssenceAdjustEngraveConditions": {
        "desc": "检查基质预刻写条件（DirectHit 无条件命中，默认开启）",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoEssenceEngraveConditionsMatched",
            "AutoEssenceEngraveConditionsAdjust"
        ]
    },
    "AutoEssenceEngraveConditionsMatched": {
        "desc": "识别预刻写条件正确（基础属性默认 OCR 全部，勾选后收窄）",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoEssenceEngraveCondition1Matched",
                    "AutoEssenceEngraveCondition2Matched"
                ]
            }
        },
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoEssenceClickEssenceStartButton"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "✅预刻写条件正确"
        }
    },
