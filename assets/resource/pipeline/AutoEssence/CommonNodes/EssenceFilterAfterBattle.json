{
    "EssenceFilterAfterBattleStart": {
        "desc": "识别画面中是否有基质，是的话开始任务,完成后会自动退出战利品界面",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "EssenceFullScreenDetectAll"
                ]
            }
        },
        "next": [
            "EssenceFilterAfterBattleInit"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$task.AutoEssence.focus.essence_filter_after_battle_start"
        }
    },
    //目标模式开启锁定名额时先暂存整批奖励，执行遍按库存和本批掉落计算名额
    "EssenceFilterAfterBattleReadonlyInit": {
        "desc": "只读遍初始化：加载数据与预设，只记录本轮持有份数",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EssenceFilterInitAction"
            }
        },
        //两个锚点固定指向当前遍的首尾：只读遍与执行遍共用同一套单格节点，回落边与收尾边据此各回各的遍
        "anchor": {
            "EssenceFilterAfterBattleCurrentPassHead": "EssenceFilterAfterBattleRowNextItem",
            "EssenceFilterAfterBattleCurrentPassTail": "EssenceFilterAfterBattleReadonlyCommitInventory"
        },
        "post_wait_freezes": {
            "time": 50,
            "target": [
                38,
                398,
                922,
                198
            ]
        },
        "post_delay": 0,
        "next": [
            "EssenceFilterAfterBattleRowNextItem"
        ],
        "focus": {
            "Node.Action.Succeeded": "$task.AutoEssence.focus.essence_filter_after_battle_init_succeeded"
        },
        //默认配置
        "attach": {
            //初始化模式：战后筛选（同一任务内重复进入时只清本轮状态）
            "mode": "after_battle",
            "after_battle_pass": "readonly"
        }
    },
    "EssenceFilterAfterBattleInit": {
        "desc": "初始化：加载数据与预设[刷完基质版]",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EssenceFilterInitAction"
            }
        },
        //两个锚点固定指向当前遍的首尾：只读遍与执行遍共用同一套单格节点，回落边与收尾边据此各回各的遍
        "anchor": {
            "EssenceFilterAfterBattleCurrentPassHead": "EssenceFilterAfterBattleRowNextItem",
            "EssenceFilterAfterBattleCurrentPassTail": "EssenceFilterAfterBattleCommitInventory"
        },
        "post_wait_freezes": {
            "time": 50,
            "target": [
                38,
                398,
                922,
                198
            ]
        },
        "post_delay": 0,
        "next": [
            "EssenceFilterAfterBattleRowNextItem"
        ],
        "focus": {
            "Node.Action.Succeeded": "$task.AutoEssence.focus.essence_filter_after_battle_init_succeeded"
        },
        //默认配置
        "attach": {
            //初始化模式：战后筛选（同一任务内重复进入时只清本轮状态）
            "mode": "after_battle"
        }
    },
    "EssenceFilterAfterBattleReadonlyCommitInventory": {
        "desc": "核对并暂存本批奖励，进入执行遍",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EssenceFilterAfterBattleInventoryCommitAction"
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "EssenceFilterAfterBattleInit"
        ]
    },
    //离开战利品界面之前，先并入本轮筛选结果
    "EssenceFilterAfterBattleCommitInventory": {
        "desc": "核对奖励覆盖并更新账号库存",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EssenceFilterAfterBattleInventoryCommitAction"
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "EssenceFilterAfterBattleExit"
        ]
    },
    //节点出口，如果不加jumpback，那就得把这个出口节点的next接到你想要的下一个节点上
    "EssenceFilterAfterBattleExit": {
        "desc": "任务完成,点击离开",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    803,
                    616,
                    124,
                    83
                ],
                "template": [
                    "Common/Button/CancelButtonType1.png",
                    "Common/Button/CancelButtonType1Hover.png"
                ],
                "method": 5,
                "threshold": 0.7
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilNotFoundAction",
                "custom_action_param": {
                    "action": "Click",
                    "wait_node": "EssenceFilterAfterBattleExit"
                }
            }
        },
        "post_wait_freezes": 200,
        "post_delay": 0,
        "next": [
            "AutoEssenceOnSuccess"
        ]
    }
}
