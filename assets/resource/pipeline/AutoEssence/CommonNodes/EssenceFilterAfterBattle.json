{
    "EssenceFilterAfterBattleStart": {
        "desc": "识别领奖界面，交给战后筛选逐格读取",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "EssenceRewardExitButton",
                    "CloseRewardsButton",
                    "EssenceFullScreenDetectAll"
                ]
            }
        },
        "next": [
            "EssenceFilterAfterBattleInit"
        ],
        "on_error": [
            "EssenceFilterAfterBattleFailed"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$task.AutoEssence.focus.essence_filter_after_battle_start"
        }
    },
    "EssenceFilterAfterBattleInit": {
        "desc": "初始化：加载数据与预设[刷完基质版]",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EssenceFilterInitAction"
            }
        },
        "post_wait_freezes": {
            "time": 50,
            "target": [
                38,
                398,
                922,
                198
            ]
        },
        "post_delay": 0,
        "next": [
            "EssenceFilterAfterBattleRowNextItem"
        ],
        "on_error": [
            "EssenceFilterAfterBattleFailed"
        ],
        "focus": {
            "Node.Action.Succeeded": "$task.AutoEssence.focus.essence_filter_after_battle_init_succeeded"
        },
        "attach": {
            "mode": "after_battle",
            "discard_unmatched": true
        }
    },
    "EssenceFilterAfterBattleCommitInventory": {
        "desc": "核对奖励覆盖并更新账号库存",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EssenceFilterAfterBattleInventoryCommitAction"
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "EssenceFilterAfterBattleExit",
            "EssenceFilterAfterBattleReturnWorld"
        ],
        "on_error": [
            "EssenceFilterAfterBattleFailed"
        ]
    },
    "EssenceFilterAfterBattleExit": {
        "desc": "任务完成,点击离开",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "EssenceRewardExitButton",
                    "CloseRewardsButton"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilNotFoundAction",
                "custom_action_param": {
                    "action": "Click",
                    "wait_node": "EssenceFilterAfterBattleExit"
                }
            }
        },
        "post_wait_freezes": 200,
        "post_delay": 0,
        "next": [
            "AutoEssenceOnSuccess"
        ],
        "on_error": [
            "EssenceFilterAfterBattleReturnWorld"
        ]
    },
    "EssenceRewardExitButton": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    803,
                    616,
                    124,
                    83
                ],
                "template": [
                    "Common/Button/CancelButtonType1.png",
                    "Common/Button/CancelButtonType1Hover.png"
                ],
                "method": 5,
                "threshold": 0.7
            }
        }
    },
    "EssenceFilterAfterBattleFailed": {
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EssenceRewardFailedAction"
            }
        },
        "post_delay": 0,
        "next": [
            "[JumpBack]EssenceFilterAfterBattleCloseDetailJumpback",
            "EssenceFilterAfterBattleExit",
            "EssenceFilterAfterBattleReturnWorld"
        ]
    },
    "EssenceFilterAfterBattleReturnWorld": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SubTask",
                "custom_action_param": {
                    "sub": [
                        "SceneAnyEnterWorld"
                    ],
                    "strict": false
                }
            }
        },
        "next": [
            "AutoEssenceOnSuccess"
        ]
    }
}
