    "GrayCancelButton": {
        "desc": "CloudWeb：灰色取消按钮改为按文字识别，云端灰底与图标模板不匹配时仍可取消",
        "recognition": "Or",
        "any_of": [
            {
                "recognition": "OCR",
                "roi": [
                    0,
                    360,
                    1280,
                    360
                ],
                "expected": [
                    "取消",
                    "Cancel",
                    "cancel"
                ],
                "threshold": 0.8
            },
            {
                "recognition": "And",
                "all_of": [
                    "GrayButtonBackground",
                    "__GrayCancelButtonIcon"
                ],
                "box_index": 1
            }
        ]
