{
    "InMenuList": {
        "desc": "CloudWeb：菜单总列表（模板检测 + 右侧 OCR 兜底）",
        "recognition": "Or",
        "any_of": [
            {
                "recognition": "And",
                "all_of": [
                    "CheckMenuListText",
                    "CheckMenuListText2",
                    "CheckMenuListColor"
                ]
            },
            {
                "recognition": "OCR",
                "roi": [
                    1000,
                    120,
                    280,
                    200
                ],
                // 完整文本：Regional Development / Operational Manual / Protocol Pass / Friends /
                // 行动手册 / 行動手冊 / 地区建设 / 地區建設 / 地域建設 / 지역 건설。
                // 云画面 OCR 可能只返回单词片段；片段匹配跳过自动 i18n 展开。
                "expected": [
                    // @i18n-skip
                    "Regional Development",
                    "Regional",
                    "Development",
                    "Operational Manual",
                    "Operational",
                    "Protocol Pass",
                    "Protocol",
                    "Friends",
                    "行动手册",
                    "行動手冊",
                    "地区建设",
                    "地區建設",
                    "地域建設",
                    "지역 건설"
                ]
            },
            {
                "recognition": "OCR",
                "roi": [
                    0,
                    120,
                    320,
                    400
                ],
                // 完整文本：Operators / Events / Headhunt / Acquisition Center / 干员 / 活动 / 寻访。
                // 云画面 OCR 可能只返回单词片段；片段匹配跳过自动 i18n 展开。
                "expected": [
                    // @i18n-skip
                    "Operators",
                    "Events",
                    "Headhunt",
                    "Acquisition",
                    "Center",
                    "干员",
                    "活动",
                    "寻访"
                ]
            }
        ]
    },
    "__ScenePrivateWorldEnterMenuRegionalDevelopment": {
        "desc": "CloudWeb：大世界或已打开的菜单列表都可进入地区建设（Escape 打开列表后原地识别）",
        "recognition": "Or",
        "any_of": [
            "InWorld",
            "InMenuList"
        ],
        "next": [
            "__ScenePrivateMenuListEnterMenuRegionalDevelopment",
            "[JumpBack]__ScenePrivateWorldEnterMenuList"
        ]
    },
    "__ScenePrivateWorldEnterMenuList": {
        "desc": "CloudWeb：用 Escape 打开菜单总列表（网页不接收 Alt+click）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    -200,
                    0,
                    200,
                    200
                ],
                "template": [
                    "SceneManager/WorldMenu.png"
                ],
                "green_mask": true,
                "threshold": 0.65
            }
        },
        "pre_wait_freezes": {
            "time": 100,
            "timeout": 1000
        },
        "action": "ClickKey",
        "key": 27,
        "rate_limit": 0,
        // Escape 后由 next 的菜单列表成功节点确认，不再固定等待
        "next": [
            "__SceneImageCheck",
            "__ScenePrivateAnyEnterMenuListSuccess"
        ]
    },
    "__ScenePrivateMenuListEnterWorld": {
        "desc": "CloudWeb：用 Escape 关闭菜单总列表；帝江号总控中枢也按 Escape 返回",
        "recognition": "Or",
        "any_of": [
            "InMenuList",
            "InDijiangControlNexus"
        ],
        "pre_wait_freezes": {
            "time": 100,
            "timeout": 1000
        },
        "action": "ClickKey",
        "key": 27,
        // 关闭菜单/退出总控中枢后留出动画时间，避免下一拍在过渡帧误判
        "post_delay": 1500,
        "rate_limit": 0,
        "next": [
            "[JumpBack]SceneNoticeRewardsUpgrade",
            "__ScenePrivateAnyEnterWorldSuccess"
        ]
    },
