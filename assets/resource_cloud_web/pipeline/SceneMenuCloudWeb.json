    "__ScenePrivateMenuListEnterMenuRegionalDevelopment": {
        "desc": "CloudWeb：从菜单列表进入地区建设",
        "recognition": "And",
        "all_of": [
            "InMenuList",
            {
                "recognition": "OCR",
                "roi": [
                    -400,
                    0,
                    400,
                    720
                ],
                // 完整文本：地区建设 / 地區建設 / Regional Development / 地域建設 / 지역 건설。
                // 云画面 OCR 可能只返回单词片段；片段匹配跳过自动 i18n 展开。
                "expected": [
                    // @i18n-skip
                    "地区建设",
                    "地區建設",
                    "(?i)Regional\\s*Development",
                    "地域建設",
                    "지역 건설"
                ]
            }
        ],
        "box_index": 1,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilFoundAction",
                "custom_action_param": {
                    "action": "Click",
                    "wait_nodes": [
                        "InRegionalDevelopment"
                    ],
                    "repeat_count": 2,
                    "interval_ms": 3500
                },
                // 注意：共享的 RepeatUntilFoundAction 目前不会把 target_offset 转发给内部 Click，
                // 这里保留偏移意图并保证 schema 合法；若要真正生效需扩展该共享 Action。
                "target_offset": [
                    -22,
                    -17,
                    0,
                    0
                ]
            }
        },
        "next": [
            "__ScenePrivateMenuRegionalDevelopmentUnlockClose",
            "__ScenePrivateAnyEnterMenuRegionalDevelopmentSuccess"
        ]
    },
    "__ScenePrivateMenuRegionalDevelopmentWulingEnterOverview": {
