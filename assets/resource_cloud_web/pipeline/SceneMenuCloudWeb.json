    // 队列里紧接 IntelArchive 等全屏菜单时，好友列表会挡住地区总览链；
    // 快速传送前先走通用入世界复位，再进事务总览。
    // 拍照模式/画面设置可能残留到下一个终端；切换终端前先回大世界再进菜单链
    "EnvironmentMonitoringGoToOutskirtsMonitoringTerminal": {
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {"sub": ["SceneAnyEnterWorld"]}
    },
    "EnvironmentMonitoringGoToMarkerStoneMonitoringTerminal": {
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {"sub": ["SceneAnyEnterWorld"]}
    },
    "__QuickTeleportButton": {
        "desc": "CloudWeb：前往传送按钮（文字 OCR，避免模板命中追踪图标）",
        "recognition": "OCR",
        "roi": [
            960,
            630,
            180,
            60
        ],
        // 完整文本：前往传送 / 前往傳送 / Quick Teleport（JP/KR 译名在语言表中不一致，保持人工维护）。
        // 云画面 OCR 可能只返回单词片段；片段匹配跳过自动 i18n 展开。
        "expected": [
            // @i18n-skip
            "前往传送",
            "前往傳送",
            "(?i)Quick\\s*Teleport"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    // 云上地图切换/传送转场明显慢于本地；默认 20s 会在“其他地图跳转中”时超时
    "__ScenePrivateMapAnyEnterMapWulingMarkerStone": {"timeout": 60000},
    "__ScenePrivateMapOverviewEnterMapWulingMarkerStone": {"timeout": 60000},
    "__ScenePrivateMapOverviewSwitchMapOverviewWuling": {"timeout": 60000},
    "__ScenePrivateMapWulingMarkerStoneEnterWorldAnchorWithPick": {"timeout": 60000},
    "__ScenePrivateMapWulingMarkerStoneEnterWorldWulingMarkerStoneCloudrestGrotto": {"timeout": 60000},
    "__ScenePrivateMapTeleportSuccess": {"timeout": 60000},
    "SceneMapLayerSwitchToMain": {"timeout": 60000},
    "__ScenePrivateMapZoomOut": {"timeout": 60000},
    // CloudWeb 地图底部的“地区总览”按钮；基座按帝江/其他区域模板进入总览，云画面不匹配
    "__ScenePrivateMapAnyEnterMapOverview": {
        "next": [
            "CloudWebMapEnterOverview",
            "__ScenePrivateMapDijiangEnterMapOverview",
            "__ScenePrivateMapOtherAreaEnterMapOverview"
        ]
    },
