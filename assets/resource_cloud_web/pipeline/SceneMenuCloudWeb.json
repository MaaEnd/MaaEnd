    "__ScenePrivateWorldEnterMenuList": {
        "desc": "CloudWeb：用 Escape 打开菜单总列表（网页不接收 Alt+click）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    -200,
                    0,
                    200,
                    200
                ],
                "template": [
                    "SceneManager/WorldMenu.png"
                ],
                "green_mask": true,
                "threshold": 0.65
            }
        },
        "pre_wait_freezes": {
            "time": 100,
            "timeout": 1000
