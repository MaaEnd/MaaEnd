{
    // 云画面右下角的网络延迟指示（信号格 + 毫秒文本）会间歇性压住传送按钮，
    // 基座 __TeleportButton 的图标模板（阈值 0.9）因此不稳定，改用按钮文字 OCR。
    // 基座 TeleportButton = And[__TeleportMapAny, __TeleportButton] 且 box_index 1，
    // 会自动取到这里的文字框，无需再覆盖一层。
    // 前往传送按钮 __QuickTeleportButton 的 OCR 覆盖在 SceneMenuCloudWeb.json。
    "__TeleportButtonText": {
        "desc": "CloudWeb：传送按钮文字（ROI 对齐基座按钮框，排除本地地图的“前往传送”）",
        "recognition": "OCR",
        // 文字行 ROI 落在基座 __TeleportButton 的按钮框 [1160,600,120,120] 内。
        // 宽度取 120 而非 44：44px 只够约两个汉字，放不下 Teleport（约 88px）。
        "roi": [
            1160,
            646,
            120,
            32
        ],
        "expected": [
            "传送",
            "傳送",
            "(?i)Teleport",
            "転送"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__TeleportButton": {
        "desc": "CloudWeb：传送按钮（OCR 文字，返回文字框）",
        "recognition": "And",
        "all_of": [
            "__TeleportButtonText"
        ]
    }
}
