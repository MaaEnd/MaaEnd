{
    // CloudWeb：调度申请界面的黄底「开始运送」/白底「快速转交」图标在云画面下
    // 模板匹配不稳定，但按钮底色稳定可辨。这里只覆盖转交委托的按钮门控，
    // 改用底色 ColorMatch + 基座的调度申请标题；不动基座阈值，也不影响 Win32/ADB。
    "__CloudWebDeliveryJobsYellowButton": {
        "desc": "CloudWeb：调度申请底部黄底开始运送按钮（底色识别）",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    1040,
                    636,
                    220,
                    52
                ],
                "method": 40,
                "lower": [
                    28,
                    100,
                    100
                ],
                "upper": [
                    29,
                    255,
                    255
                ],
                "connected": true,
                "count": 1200
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__CloudWebDeliveryJobsWhiteButton": {
        "desc": "CloudWeb：调度申请底部白底快速转交按钮（底色识别）",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    830,
                    636,
                    210,
                    52
                ],
                "lower": [
                    [
                        255,
                        253,
                        253
                    ],
                    [
                        238,
                        236,
                        236
                    ],
                    [
                        153,
                        152,
                        152
                    ]
                ],
                "upper": [
                    [
                        255,
                        253,
                        253
                    ],
                    [
                        239,
                        237,
                        237
                    ],
                    [
                        167,
                        165,
                        165
                    ]
                ],
                "connected": true,
                "count": 800
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "DeliveryJobsRedistributionBidNextStep": {
        "all_of": [
            "__CloudWebDeliveryJobsYellowButton",
            "DeliveryJobsInCargoRedistributionBid"
        ]
    },
    "DeliveryJobsDecideQuickTransfer": {
        "all_of": [
            "__CloudWebDeliveryJobsYellowButton",
            "DeliveryJobsInCargoRedistributionBid"
        ]
    },
    "DeliveryJobsQuickTransfer": {
        "all_of": [
            "__CloudWebDeliveryJobsWhiteButton",
            "DeliveryJobsInCargoRedistributionBid"
        ]
    }
