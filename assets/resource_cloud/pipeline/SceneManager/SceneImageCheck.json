{
    // 云终末地没有退出键：菜单列表里点不到退出按钮，也不会弹出「是否退出至登录界面」。
    // 因此画面检查只保留 UID 捕获，语言/颜色/MOD/OSD/激活水印等检查全部禁用。
    "__SceneImageCheck": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "focus": {
            "Node.Recognition.Succeeded": ""
        }
    },
    "__SceneImageCheckDialogIn": {
        "recognition": "DirectHit",
        "action": "DoNothing"
    },
    "__SceneImageCheckFinishExit": {
        "recognition": "DirectHit",
        "action": "DoNothing"
    },
    // 云上没有弹窗，等灰色取消按钮消失会误判，直接命中结束
    "__SceneImageCheckFinishExitSuccess": {
        "recognition": "DirectHit",
        "inverse": false
    },
    // 以下检查在云上禁用：其他节点的 next 引用到它们时直接跳过，不识别也不执行
    "__SceneCheckOSD": {
        "enabled": false
    },
    "__SceneImageCheckWindowsActivation": {
        "enabled": false
    },
    "__SceneImageCheckAICPlanColor": {
        "enabled": false
    },
    "__SceneImageCheckMod": {
        "enabled": false
    },
    "__SceneImageCheckLanguage": {
        "enabled": false
    }
}
