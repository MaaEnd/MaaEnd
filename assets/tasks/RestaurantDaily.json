{
    "task": [
        {
            "name": "RestaurantDaily",
            "label": "$task.RestaurantDaily.label",
            "entry": "RestaurantInitialize",
            "description": "$task.RestaurantDaily.description",
            "group": [
                "other_menu"
            ],
            "controller": [
                "Win32-Front",
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots"
            ],
            "option": [
                "RestaurantMaxRounds",
                "RestaurantBuyShopDiscountedItems"
            ]
        }
    ],
    "option": {
        "RestaurantMaxRounds": {
            "type": "input",
            "label": "$task.RestaurantDaily.option.MaxRounds.label",
            "inputs": [
                {
                    "name": "MaxRounds",
                    "label": "$task.RestaurantDaily.option.MaxRounds.pattern_msg",
                    "default": "5",
                    "pipeline_type": "int",
                    "verify": "^(?:[1-9]|1[0-9]|20)$",
                    "pattern_msg": "$task.RestaurantDaily.option.MaxRounds.pattern_msg"
                }
            ],
            "pipeline_override": {
                "RestaurantInitialize": {
                    "custom_action_param": {
                        "step": "initialize",
                        "max_rounds": "{MaxRounds}"
                    }
                }
            }
        },
        "RestaurantBuyShopDiscountedItems": {
            "type": "switch",
            "label": "$task.RestaurantDaily.option.BuyShopDiscountedItems.label",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "RestaurantUseDailyRefresh"
                    ],
                    "pipeline_override": {
                        "RestaurantShopAfterRounds": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "RestaurantShopAfterRounds": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "RestaurantUseDailyRefresh": {
            "type": "switch",
            "label": "$task.RestaurantDaily.option.UseDailyRefresh.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "RestaurantShopRefreshAvailable": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "RestaurantShopRefreshAvailable": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "No"
        }
    }
}
