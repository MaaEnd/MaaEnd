{
    "task": [
        {
            "name": "RestaurantDaily",
            "label": "$task.RestaurantDaily.label",
            "entry": "RestaurantSchedule",
            "description": "$task.RestaurantDaily.description",
            "group": [
                "other_menu"
            ],
            "controller": [
                "Win32-Front",
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots"
            ],
            "option": [
                "RestaurantSchedule",
                "RestaurantMaxRounds",
                "RestaurantBuyShopDiscountedItems"
            ]
        }
    ],
    "option": {
        "RestaurantSchedule": {
            "type": "checkbox",
            "label": "$option.TaskSchedule.label",
            "cases": [
                {
                    "name": "RestaurantScheduleMonday",
                    "label": "$option.TaskScheduleMonday.label",
                    "pipeline_override": {
                        "RestaurantScheduleEnabled": {
                            "attach": {
                                "monday": true
                            }
                        }
                    }
                },
                {
                    "name": "RestaurantScheduleTuesday",
                    "label": "$option.TaskScheduleTuesday.label",
                    "pipeline_override": {
                        "RestaurantScheduleEnabled": {
                            "attach": {
                                "tuesday": true
                            }
                        }
                    }
                },
                {
                    "name": "RestaurantScheduleWednesday",
                    "label": "$option.TaskScheduleWednesday.label",
                    "pipeline_override": {
                        "RestaurantScheduleEnabled": {
                            "attach": {
                                "wednesday": true
                            }
                        }
                    }
                },
                {
                    "name": "RestaurantScheduleThursday",
                    "label": "$option.TaskScheduleThursday.label",
                    "pipeline_override": {
                        "RestaurantScheduleEnabled": {
                            "attach": {
                                "thursday": true
                            }
                        }
                    }
                },
                {
                    "name": "RestaurantScheduleFriday",
                    "label": "$option.TaskScheduleFriday.label",
                    "pipeline_override": {
                        "RestaurantScheduleEnabled": {
                            "attach": {
                                "friday": true
                            }
                        }
                    }
                },
                {
                    "name": "RestaurantScheduleSaturday",
                    "label": "$option.TaskScheduleSaturday.label",
                    "pipeline_override": {
                        "RestaurantScheduleEnabled": {
                            "attach": {
                                "saturday": true
                            }
                        }
                    }
                },
                {
                    "name": "RestaurantScheduleSunday",
                    "label": "$option.TaskScheduleSunday.label",
                    "pipeline_override": {
                        "RestaurantScheduleEnabled": {
                            "attach": {
                                "sunday": true
                            }
                        }
                    }
                }
            ],
            "default_case": [
                "RestaurantScheduleMonday",
                "RestaurantScheduleTuesday",
                "RestaurantScheduleWednesday",
                "RestaurantScheduleThursday",
                "RestaurantScheduleFriday",
                "RestaurantScheduleSaturday",
                "RestaurantScheduleSunday"
            ]
        },
        "RestaurantMaxRounds": {
            "type": "input",
            "label": "$task.RestaurantDaily.option.MaxRounds.label",
            "inputs": [
                {
                    "name": "MaxRounds",
                    "label": "$task.RestaurantDaily.option.MaxRounds.input_label",
                    "default": "5",
                    "pipeline_type": "int",
                    "verify": "^(?:0|[1-9]|1[0-9]|20)$",
                    "pattern_msg": "$task.RestaurantDaily.option.MaxRounds.pattern_msg"
                }
            ],
            "pipeline_override": {
                "RestaurantInitialize": {
                    "custom_action_param": {
                        "step": "initialize",
                        "max_rounds": "{MaxRounds}"
                    }
                }
            }
        },
        "RestaurantBuyShopDiscountedItems": {
            "type": "switch",
            "label": "$task.RestaurantDaily.option.BuyShopDiscountedItems.label",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "RestaurantUseDailyRefresh"
                    ],
                    "pipeline_override": {
                        "RestaurantShopAfterRounds": {
                            "enabled": true
                        },
                        "RestaurantNoTasksConfigured": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "RestaurantShopAfterRounds": {
                            "enabled": false
                        },
                        "RestaurantNoTasksConfigured": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "RestaurantUseDailyRefresh": {
            "type": "switch",
            "label": "$task.RestaurantDaily.option.UseDailyRefresh.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "RestaurantShopRefreshAvailable": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "RestaurantShopRefreshAvailable": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "No"
        }
    }
}
