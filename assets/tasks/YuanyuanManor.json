{
    "task": [
        {
            "name": "YuanyuanManor",
            "label": "$task.YuanyuanManor.label",
            "entry": "YuanyuanManorSchedule",
            "description": "$task.YuanyuanManor.description",
            "group": [
                "other_menu"
            ],
            "controller": [
                // TODO: CloudWeb 尚未实机验证，验证通过后取消注释
                // "CloudWeb",
                "Win32-Front",
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots"
            ],
            "option": [
                "YuanyuanManorSchedule",
                "InnkeepingMaxRounds",
                "PantryShop"
            ]
        }
    ],
    "option": {
        "YuanyuanManorSchedule": {
            "type": "checkbox",
            "label": "$option.TaskSchedule.label",
            "cases": [
                {
                    "name": "YuanyuanManorScheduleMonday",
                    "label": "$option.TaskScheduleMonday.label",
                    "pipeline_override": {
                        "YuanyuanManorScheduleEnabled": {
                            "attach": {
                                "monday": true
                            }
                        }
                    }
                },
                {
                    "name": "YuanyuanManorScheduleTuesday",
                    "label": "$option.TaskScheduleTuesday.label",
                    "pipeline_override": {
                        "YuanyuanManorScheduleEnabled": {
                            "attach": {
                                "tuesday": true
                            }
                        }
                    }
                },
                {
                    "name": "YuanyuanManorScheduleWednesday",
                    "label": "$option.TaskScheduleWednesday.label",
                    "pipeline_override": {
                        "YuanyuanManorScheduleEnabled": {
                            "attach": {
                                "wednesday": true
                            }
                        }
                    }
                },
                {
                    "name": "YuanyuanManorScheduleThursday",
                    "label": "$option.TaskScheduleThursday.label",
                    "pipeline_override": {
                        "YuanyuanManorScheduleEnabled": {
                            "attach": {
                                "thursday": true
                            }
                        }
                    }
                },
                {
                    "name": "YuanyuanManorScheduleFriday",
                    "label": "$option.TaskScheduleFriday.label",
                    "pipeline_override": {
                        "YuanyuanManorScheduleEnabled": {
                            "attach": {
                                "friday": true
                            }
                        }
                    }
                },
                {
                    "name": "YuanyuanManorScheduleSaturday",
                    "label": "$option.TaskScheduleSaturday.label",
                    "pipeline_override": {
                        "YuanyuanManorScheduleEnabled": {
                            "attach": {
                                "saturday": true
                            }
                        }
                    }
                },
                {
                    "name": "YuanyuanManorScheduleSunday",
                    "label": "$option.TaskScheduleSunday.label",
                    "pipeline_override": {
                        "YuanyuanManorScheduleEnabled": {
                            "attach": {
                                "sunday": true
                            }
                        }
                    }
                }
            ],
            "default_case": [
                "YuanyuanManorScheduleMonday",
                "YuanyuanManorScheduleTuesday",
                "YuanyuanManorScheduleWednesday",
                "YuanyuanManorScheduleThursday",
                "YuanyuanManorScheduleFriday",
                "YuanyuanManorScheduleSaturday",
                "YuanyuanManorScheduleSunday"
            ]
        },
        "InnkeepingMaxRounds": {
            "type": "input",
            "label": "$task.YuanyuanManor.option.MaxRounds.label",
            "inputs": [
                {
                    "name": "MaxRounds",
                    "label": "$task.YuanyuanManor.option.MaxRounds.input_label",
                    "default": "5",
                    "pipeline_type": "int",
                    "verify": "^(?:0|[1-9]|1[0-9]|20)$",
                    "pattern_msg": "$task.YuanyuanManor.option.MaxRounds.pattern_msg"
                }
            ],
            "pipeline_override": {
                "InnkeepingMain": {
                    "max_hit": "{MaxRounds}"
                }
            }
        },
        "PantryShop": {
            "type": "switch",
            "label": "$task.YuanyuanManor.option.BuyShopDiscountedItems.label",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "PantryShopUseDailyRefresh"
                    ],
                    "pipeline_override": {
                        "PantryShopMain": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No"
                }
            ],
            "default_case": "No"
        },
        "PantryShopUseDailyRefresh": {
            "type": "switch",
            "label": "$task.YuanyuanManor.option.UseDailyRefresh.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "RestaurantShopRefreshAvailable": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "RestaurantShopRefreshAvailable": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "No"
        }
    }
}
