{
    "task": [
        {
            "name": "AutoEcoFarm",
            "label": "$task.AutoEcoFarm.label",
            "entry": "AutoEcoFarmTask",
            "description": "$task.AutoEcoFarm.description",
            "group": [
                "open_world"
            ],
            "controller": [
                "ADB",
                "CloudADB",
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "PlayCover",
                "Win32-Front"
            ],
            "option": [
                "CollectWulingCityFarm",
                "CollectSisPaintingFarm",
                "CollectRanch"
            ]
        }
    ],
    "option": {
        "CollectWulingCityFarm": {
            "type": "switch",
            "label": "$task.AutoEcoFarm.option.CollectWulingCityFarm.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "__AutoEcoFarmWulingCityFarmStart": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "__AutoEcoFarmWulingCityFarmStart": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "CollectSisPaintingFarm": {
            "type": "switch",
            "label": "$task.AutoEcoFarm.option.CollectSisPaintingFarm.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "__AutoEcoFarmSisPaintingFarmStart": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "__AutoEcoFarmSisPaintingFarmStart": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "CollectRanch": {
            "type": "switch",
            "label": "$task.AutoEcoFarm.option.CollectRanch.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "__AutoEcoFarmRanchStart": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "__AutoEcoFarmRanchStart": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        }
    }
}
