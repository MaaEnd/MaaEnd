{
    "task": [
        {
            "name": "SupplyPlan",
            "label": "$task.SupplyPlan.label",
            "entry": "SupplyPlanMain",
            "description": "$task.SupplyPlan.description",
            "controller": [
                "ADB",
                "PlayCover",
                "Win32-Front",
                "Wlroots"
            ],
            "option": [
                "SupplyPlanRefreshDays",
                "SupplyPlanLimits",
                "SupplyPlanEssenceLocation",
                "AutoEssenceObtainMode",
                "AutoFightSettingFull"
            ],
            "group": [
                "sanity_sink"
            ]
        }
    ],
    "option": {
        "SupplyPlanRefreshDays": {
            "type": "select",
            "label": "$option.SupplyPlanRefreshDays.label",
            "description": "$option.SupplyPlanRefreshDays.description",
            "default_case": "Days7",
            "cases": [
                {
                    "name": "Days7",
                    "label": "$option.IMSRefreshDays.7.label",
                    "pipeline_override": {
                        "ItemDataReady": {
                            "recognition": {
                                "param": {
                                    "custom_recognition_param": {
                                        "refresh_days": 7
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Days1",
                    "label": "$option.IMSRefreshDays.1.label",
                    "pipeline_override": {
                        "ItemDataReady": {
                            "recognition": {
                                "param": {
                                    "custom_recognition_param": {
                                        "refresh_days": 1
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Days30",
                    "label": "$option.IMSRefreshDays.30.label",
                    "pipeline_override": {
                        "ItemDataReady": {
                            "recognition": {
                                "param": {
                                    "custom_recognition_param": {
                                        "refresh_days": 30
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "NeverExpire",
                    "label": "$option.IMSRefreshDays.0.label",
                    "pipeline_override": {
                        "ItemDataReady": {
                            "recognition": {
                                "param": {
                                    "custom_recognition_param": {
                                        "refresh_days": 0
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "SupplyPlanEssenceLocation": {
            "type": "select",
            "label": "$option.SupplyPlanEssenceLocation.label",
            "description": "$option.SupplyPlanEssenceLocation.description",
            "default_case": "VFTheHub",
            "cases": [
                {
                    "name": "VFTheHub",
                    "label": "$global.region.TheHub",
                    "pipeline_override": {
                        "GotoTriggerPointSetAnchor_VFTheHub": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "VFOriginiumSciencePark",
                    "label": "$global.region.OriginiumSciencePark",
                    "pipeline_override": {
                        "GotoTriggerPointSetAnchor_VFOriginiumSciencePark": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "VFOriginLodespring",
                    "label": "$global.region.OriginLodespring",
                    "pipeline_override": {
                        "GotoTriggerPointSetAnchor_VFOriginLodespring": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "VFPowerPlateau",
                    "label": "$global.region.PowerPlateau",
                    "pipeline_override": {
                        "GotoTriggerPointSetAnchor_VFPowerPlateau": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "WLWulingCity",
                    "label": "$global.region.WulingCity",
                    "pipeline_override": {
                        "GotoTriggerPointSetAnchor_WLWulingCity": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "WLQingboStockade",
                    "label": "$global.region.QingboStockade",
                    "pipeline_override": {
                        "GotoTriggerPointSetAnchor_WLQingboStockade": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "WLMarkerStone",
                    "label": "$global.region.MarkerStone",
                    "pipeline_override": {
                        "GotoTriggerPointSetAnchor_WLMarkerStone": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "WLTestArea",
                    "label": "$global.region.TestArea",
                    "pipeline_override": {
                        "GotoTriggerPointSetAnchor_WLTestArea": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "WLSwordVaultDale",
                    "label": "$global.region.SwordVaultDale",
                    "pipeline_override": {
                        "GotoTriggerPointSetAnchor_WLSwordVaultDale": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "SupplyPlanLimits": {
            "type": "input",
            "label": "$option.SupplyPlanLimits.label",
            "description": "$option.SupplyPlanLimits.description",
            "inputs": [
                {
                    "name": "SupplyPlanLimit_ADVANCED_COGNITIVE_CARRIER",
                    "label": "$option.SupplyPlanLimits.inputs.ADVANCED_COGNITIVE_CARRIER.label",
                    "pipeline_type": "int",
                    "default": "210",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_ELEMENTARY_COGNITIVE_CARRIER",
                    "label": "$option.SupplyPlanLimits.inputs.ELEMENTARY_COGNITIVE_CARRIER.label",
                    "pipeline_type": "int",
                    "default": "12",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_ADVANCED_COMBAT_RECORD",
                    "label": "$option.SupplyPlanLimits.inputs.ADVANCED_COMBAT_RECORD.label",
                    "pipeline_type": "int",
                    "default": "150",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_PROTOSET",
                    "label": "$option.SupplyPlanLimits.inputs.PROTOSET.label",
                    "pipeline_type": "int",
                    "default": "120",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_PROTODISK",
                    "label": "$option.SupplyPlanLimits.inputs.PROTODISK.label",
                    "pipeline_type": "int",
                    "default": "65",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_TRIPHASIC_NANOFLAKE",
                    "label": "$option.SupplyPlanLimits.inputs.TRIPHASIC_NANOFLAKE.label",
                    "pipeline_type": "int",
                    "default": "260",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_QUADRANT_FITTING_FLUID",
                    "label": "$option.SupplyPlanLimits.inputs.QUADRANT_FITTING_FLUID.label",
                    "pipeline_type": "int",
                    "default": "260",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_TACHYON_SCREENING_LATTICE",
                    "label": "$option.SupplyPlanLimits.inputs.TACHYON_SCREENING_LATTICE.label",
                    "pipeline_type": "int",
                    "default": "260",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_D96_STEEL_SAMPLE_4",
                    "label": "$option.SupplyPlanLimits.inputs.D96_STEEL_SAMPLE_4.label",
                    "pipeline_type": "int",
                    "default": "260",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_METADIASTIMA_PHOTOEMISSION_TUBE",
                    "label": "$option.SupplyPlanLimits.inputs.METADIASTIMA_PHOTOEMISSION_TUBE.label",
                    "pipeline_type": "int",
                    "default": "40",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_PROTOHEDRON",
                    "label": "$option.SupplyPlanLimits.inputs.PROTOHEDRON.label",
                    "pipeline_type": "int",
                    "default": "1100",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_PROTOPRISM",
                    "label": "$option.SupplyPlanLimits.inputs.PROTOPRISM.label",
                    "pipeline_type": "int",
                    "default": "920",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_T_CREDS",
                    "label": "$option.SupplyPlanLimits.inputs.T_CREDS.label",
                    "pipeline_type": "int",
                    "default": "3580000",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_ARMS_INSP_SET",
                    "label": "$option.SupplyPlanLimits.inputs.ARMS_INSP_SET.label",
                    "pipeline_type": "int",
                    "default": "500",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_ARMS_INSP_KIT",
                    "label": "$option.SupplyPlanLimits.inputs.ARMS_INSP_KIT.label",
                    "pipeline_type": "int",
                    "default": "45",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_HEAVY_CAST_DIE",
                    "label": "$option.SupplyPlanLimits.inputs.HEAVY_CAST_DIE.label",
                    "pipeline_type": "int",
                    "default": "100",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "SupplyPlanLimit_CAST_DIE",
                    "label": "$option.SupplyPlanLimits.inputs.CAST_DIE.label",
                    "pipeline_type": "int",
                    "default": "45",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                }
            ],
            "pipeline_override": {
                "SupplyPlanInsufficient_ADVANCED_COGNITIVE_CARRIER": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "ADVANCED_COGNITIVE_CARRIER",
                                "quantity": "{SupplyPlanLimit_ADVANCED_COGNITIVE_CARRIER}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_ELEMENTARY_COGNITIVE_CARRIER": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "ELEMENTARY_COGNITIVE_CARRIER",
                                "quantity": "{SupplyPlanLimit_ELEMENTARY_COGNITIVE_CARRIER}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_ADVANCED_COMBAT_RECORD": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "ADVANCED_COMBAT_RECORD",
                                "quantity": "{SupplyPlanLimit_ADVANCED_COMBAT_RECORD}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_PROTOSET": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "PROTOSET",
                                "quantity": "{SupplyPlanLimit_PROTOSET}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_PROTODISK": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "PROTODISK",
                                "quantity": "{SupplyPlanLimit_PROTODISK}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_TRIPHASIC_NANOFLAKE": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "TRIPHASIC_NANOFLAKE",
                                "quantity": "{SupplyPlanLimit_TRIPHASIC_NANOFLAKE}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_QUADRANT_FITTING_FLUID": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "QUADRANT_FITTING_FLUID",
                                "quantity": "{SupplyPlanLimit_QUADRANT_FITTING_FLUID}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_TACHYON_SCREENING_LATTICE": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "TACHYON_SCREENING_LATTICE",
                                "quantity": "{SupplyPlanLimit_TACHYON_SCREENING_LATTICE}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_D96_STEEL_SAMPLE_4": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "D96_STEEL_SAMPLE_4",
                                "quantity": "{SupplyPlanLimit_D96_STEEL_SAMPLE_4}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_METADIASTIMA_PHOTOEMISSION_TUBE": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "METADIASTIMA_PHOTOEMISSION_TUBE",
                                "quantity": "{SupplyPlanLimit_METADIASTIMA_PHOTOEMISSION_TUBE}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_PROTOHEDRON": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "PROTOHEDRON",
                                "quantity": "{SupplyPlanLimit_PROTOHEDRON}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_PROTOPRISM": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "PROTOPRISM",
                                "quantity": "{SupplyPlanLimit_PROTOPRISM}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_T_CREDS": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "T_CREDS",
                                "quantity": "{SupplyPlanLimit_T_CREDS}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_ARMS_INSP_SET": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "ARMS_INSP_SET",
                                "quantity": "{SupplyPlanLimit_ARMS_INSP_SET}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_ARMS_INSP_KIT": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "ARMS_INSP_KIT",
                                "quantity": "{SupplyPlanLimit_ARMS_INSP_KIT}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_HEAVY_CAST_DIE": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "HEAVY_CAST_DIE",
                                "quantity": "{SupplyPlanLimit_HEAVY_CAST_DIE}"
                            }
                        }
                    }
                },
                "SupplyPlanInsufficient_CAST_DIE": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "item": "CAST_DIE",
                                "quantity": "{SupplyPlanLimit_CAST_DIE}"
