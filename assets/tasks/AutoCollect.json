            "pipeline_override": {
                "AutoCollectRoute1Needed": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "expression": "{item_plant_crylplant_2_1}>={AutoCollectLimit_Route1} && {AutoCollectLimit_Route1}>0"
                            }
                        }
                    }
                },
                "AutoCollectRoute2Needed": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
