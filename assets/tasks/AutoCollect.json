                    "pipeline_type": "int",
                    "default": "0",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "AutoCollectLimit_Route6",
                    "label": "$option.AutoCollectTargetInventory.inputs.Route6.label",
                    "pipeline_type": "int",
                    "default": "0",
                    "verify": "^\\d+$",
