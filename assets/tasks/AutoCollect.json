{
    "task": [
        {
            "name": "AutoCollect",
            "label": "$task.AutoCollect.label",
            "entry": "AutoCollectSchedule",
            "description": "$task.AutoCollect.description",
            "controller": [
                "ADB",
                "PlayCover",
                "Win32-Front",
                "Wlroots"
            ],
            "option": [
                "AutoCollectSchedule",
                "AutoCollectRoutes",
                "AutoCollectCommonRoutes",
                "AutoCollectStashBackpackSubTask",
                "AutoCollectTargetInventory"
            ],
            "group": [
                "open_world"
            ]
        }
    ],
    "option": {
        "AutoCollectSchedule": {
            "type": "checkbox",
            "label": "$option.TaskSchedule.label",
            "default_case": [
                "AutoCollectScheduleMonday",
                "AutoCollectScheduleTuesday",
                "AutoCollectScheduleWednesday",
                "AutoCollectScheduleThursday",
                "AutoCollectScheduleFriday",
                "AutoCollectScheduleSaturday",
                "AutoCollectScheduleSunday"
            ],
            "cases": [
                {
                    "name": "AutoCollectScheduleMonday",
                    "label": "$option.TaskScheduleMonday.label",
                    "pipeline_override": {
                        "AutoCollectScheduleEnabled": {
                            "attach": {
                                "monday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoCollectScheduleTuesday",
                    "label": "$option.TaskScheduleTuesday.label",
                    "pipeline_override": {
                        "AutoCollectScheduleEnabled": {
                            "attach": {
                                "tuesday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoCollectScheduleWednesday",
                    "label": "$option.TaskScheduleWednesday.label",
                    "pipeline_override": {
                        "AutoCollectScheduleEnabled": {
                            "attach": {
                                "wednesday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoCollectScheduleThursday",
                    "label": "$option.TaskScheduleThursday.label",
                    "pipeline_override": {
                        "AutoCollectScheduleEnabled": {
                            "attach": {
                                "thursday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoCollectScheduleFriday",
                    "label": "$option.TaskScheduleFriday.label",
                    "pipeline_override": {
                        "AutoCollectScheduleEnabled": {
                            "attach": {
                                "friday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoCollectScheduleSaturday",
                    "label": "$option.TaskScheduleSaturday.label",
                    "pipeline_override": {
                        "AutoCollectScheduleEnabled": {
                            "attach": {
                                "saturday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoCollectScheduleSunday",
                    "label": "$option.TaskScheduleSunday.label",
                    "pipeline_override": {
                        "AutoCollectScheduleEnabled": {
                            "attach": {
                                "sunday": true
                            }
                        }
                    }
                }
            ]
        },
        "AutoCollectStashBackpackSubTask": {
            "type": "switch",
            "label": "$task.AutoCollect.option.AutoCollectStashBackpackSubTask.label",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "StashBackpackMain": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "StashBackpackType"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "StashBackpackMain": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        // 采集物目标库存：任务开始时先同步仓库（AutoCollectSyncDepot），达标路线自动跳过。
        // 表达式里 {AutoCollectLimit_*} 由界面输入替换，{item_plant_*} 留给 R1 boolexpr 读 IMS 缓存；
        // 输入 0（默认）时表达式恒假 → inverse 恒命中 → 恒执行，与未配置时行为一致。
        "AutoCollectTargetInventory": {
            "type": "input",
            "label": "$option.AutoCollectTargetInventory.label",
            "description": "$option.AutoCollectTargetInventory.description",
            "inputs": [
                {
                    "name": "AutoCollectLimit_Route1",
                    "label": "$option.AutoCollectTargetInventory.inputs.Route1.label",
                    "pipeline_type": "int",
                    "default": "0",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "AutoCollectLimit_Route2",
                    "label": "$option.AutoCollectTargetInventory.inputs.Route2.label",
                    "pipeline_type": "int",
                    "default": "0",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "AutoCollectLimit_Route3",
                    "label": "$option.AutoCollectTargetInventory.inputs.Route3.label",
                    "pipeline_type": "int",
                    "default": "0",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "AutoCollectLimit_Route4",
                    "label": "$option.AutoCollectTargetInventory.inputs.Route4.label",
                    "pipeline_type": "int",
                    "default": "0",
                    "verify": "^\\d+$",
                    "pattern_msg": "$option.SupplyPlanLimits.pattern_msg"
                },
                {
                    "name": "AutoCollectLimit_Route5",
