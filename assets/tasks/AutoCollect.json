                "AutoCollectRoute6Needed": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "expression": "{item_plant_mushroom_1_1}>={AutoCollectLimit_Route6} && {AutoCollectLimit_Route6}>0"
                            }
                        }
                    }
                },
                // 路线7 双产出（血菌+武陵石）：任一侧填 0 表示不限该侧，两侧都为 0 时恒执行
                "AutoCollectRoute7Needed": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "expression": "(({AutoCollectLimit_Route7Bloodcap}>0 && {item_plant_mushroom_2_1}>={AutoCollectLimit_Route7Bloodcap}) || {AutoCollectLimit_Route7Bloodcap}==0) && (({AutoCollectLimit_Route7Wulingstone}>0 && {item_plant_spcstone_2_2}>={AutoCollectLimit_Route7Wulingstone}) || {AutoCollectLimit_Route7Wulingstone}==0) && ({AutoCollectLimit_Route7Bloodcap}>0 || {AutoCollectLimit_Route7Wulingstone}>0)"
                            }
                        }
                    }
                },
                "AutoCollectRoute8Needed": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
