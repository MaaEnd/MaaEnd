{
    "task": [
        {
            "name": "EnvironmentMonitoring",
            "label": "$task.EnvironmentMonitoring.label",
            "entry": "EnvironmentMonitoringMain",
            "description": "$task.EnvironmentMonitoring.description",
            "option": [
                "OutskirtsMonitoringTerminalMonitoring",
                "MarkerStoneMonitoringTerminalMonitoring"
            ],
            "controller": [
                "Win32-Front",
                "Wlroots",
                "ADB",
                "PlayCover"
            ],
            "group": [
                "regional_development"
            ]
        }
    ],
    "option": {
        "OutskirtsMonitoringTerminalMonitoring": {
            "type": "switch",
            "label": "$task.EnvironmentMonitoring.option.OutskirtsMonitoringTerminal",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "BeaconDamagedInTheBlightTideJob": {
                            "enabled": false
                        },
                        "CisternOriginiumSlugsJob": {
                            "enabled": false
                        },
                        "RainbowFinJob": {
                            "enabled": false
                        },
                        "IndoorCropsJob": {
                            "enabled": false
                        },
                        "AncientTreeJob": {
                            "enabled": false
                        },
                        "CollapsedTianshiPillarJob": {
                            "enabled": false
                        },
                        "EternalSunsetJob": {
                            "enabled": false
                        },
                        "CleansingJadeJob": {
                            "enabled": false
                        },
                        "VigorousCisternOriginiumSlugJob": {
                            "enabled": false
                        },
                        "InflatedAndGlowingBugspittingLankybeastJob": {
                            "enabled": false
                        },
                        "ObservantSableChestedFowlbeastJob": {
                            "enabled": false
                        },
                        "EcologyNearTheFieldLogisticsDepotJob": {
                            "enabled": false
                        },
                        "WaterlampJob": {
                            "enabled": false
                        },
                        "XiraniteNexusJob": {
                            "enabled": false
                        },
                        "PierWaterwheelJob": {
                            "enabled": false
                        },
                        "MiniShellbeastJob": {
                            "enabled": false
                        }
