                {
                    "name": "No",
                    "pipeline_override": {
                        "OutskirtsMonitoringTerminal": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "OutskirtsMonitoringTerminalMonitoringTasks": {
