{
    "pretask": {
        "exec": "agent/go-service",
        "args": [
            "--pretask",
            "GameSetting"
        ],
        "name": "GameSetting",
        "description": "$pretask.GameSetting.description",
        "label": "$pretask.GameSetting.label",
        "controller": [
            "Win32-Front"
        ],
        "option": [
            "GameSettingRegion",
            "GameSettingDisplayType",
            "GameSettingGraphicsQuality",
            "GameSettingFrameRate"
        ]
    },
    "option": {
        "GameSettingRegion": {
            "label": "$option.GameSettingRegion.label",
            "type": "select",
            "default_case": "CN",
            "cases": [
                {
                    "name": "CN",
                    "label": "$option.GameSettingRegion.cases.CN.label"
                },
                {
                    "name": "Global",
                    "label": "$option.GameSettingRegion.cases.Global.label"
                }
            ]
        },
        "GameSettingDisplayType": {
            "label": "$option.GameSettingDisplayType.label",
            "type": "select",
            "default_case": "Window",
            "cases": [
                {
                    "name": "Window",
                    "label": "$option.GameSettingDisplayType.cases.Window.label",
                    "option": [
                        "GameSettingResolution"
                    ]
                },
                {
                    "name": "Fullscreen",
                    "label": "$option.GameSettingDisplayType.cases.Fullscreen.label",
                    "option": [
                        "GameSettingResolution"
                    ]
                }
            ]
        },
        "GameSettingResolution": {
            "label": "$option.GameSettingResolution.label",
            "type": "select",
            "default_case": "1280x720",
            "cases": [
                {
                    "name": "1280x720"
                },
                {
                    "name": "1920x1080"
                },
                {
                    "name": "2560x1440"
                }
            ]
        },
        "GameSettingGraphicsQuality": {
            "label": "$option.GameSettingGraphicsQuality.label",
            "type": "select",
            "default_case": "Unchanged",
            "cases": [
                {
                    "name": "Unchanged",
                    "label": "$option.GameSettingGraphicsQuality.cases.Unchanged.label"
                },
                {
                    "name": "VeryLow",
                    "label": "$option.GameSettingGraphicsQuality.cases.VeryLow.label"
                },
                {
                    "name": "Low",
                    "label": "$option.GameSettingGraphicsQuality.cases.Low.label"
                },
                {
                    "name": "Medium",
                    "label": "$option.GameSettingGraphicsQuality.cases.Medium.label"
                },
                {
                    "name": "High",
                    "label": "$option.GameSettingGraphicsQuality.cases.High.label"
                },
                {
                    "name": "Ultra",
                    "label": "$option.GameSettingGraphicsQuality.cases.Ultra.label"
                }
            ]
        },
        "GameSettingFrameRate": {
            "label": "$option.GameSettingFrameRate.label",
            "type": "select",
            "default_case": "Unchanged",
            "cases": [
                {
                    "name": "Unchanged",
                    "label": "$option.GameSettingFrameRate.cases.Unchanged.label"
                },
                {
                    "name": "Fps30",
                    "label": "$option.GameSettingFrameRate.cases.Fps30.label"
                },
                {
                    "name": "Fps60",
                    "label": "$option.GameSettingFrameRate.cases.Fps60.label"
                },
                {
                    "name": "Fps120",
                    "label": "$option.GameSettingFrameRate.cases.Fps120.label"
                }
            ]
        }
    }
}
