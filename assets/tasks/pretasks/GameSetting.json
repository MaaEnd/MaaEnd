{
    "pretask": {
        "controller": [
            "Win32-Front"
        ],
        "exec": "agent/go-service",
        "args": [
            "--pretask",
            "GameSetting"
        ],
        "name": "GameSetting",
        "label": "$pretask.GameSetting.label",
        "description": "$pretask.GameSetting.description",
        "option": [
            "GameSettingRegion",
            "GameSettingLanguage",
            "GameSettingDisplayType",
            "GameSettingGraphicsQuality",
            "GameSettingFrameRate",
            "GameSettingAutoHDR"
        ]
    },
    "option": {
        "GameSettingRegion": {
            "type": "select",
            "label": "$option.GameSettingRegion.label",
            "cases": [
                {
                    "name": "CN",
                    "label": "$option.GameSettingRegion.cases.CN.label"
                },
                {
                    "name": "Global",
                    "label": "$option.GameSettingRegion.cases.Global.label"
                }
            ],
            "default_case": "CN"
        },
        "GameSettingLanguage": {
            "type": "select",
            "label": "$option.GameSettingLanguage.label",
            "cases": [
                {
                    "name": "Unchanged",
                    "label": "$option.GameSettingLanguage.cases.Unchanged.label"
                },
                {
                    "name": "CN",
                    "label": "简体中文"
                },
                {
                    "name": "TC",
                    "label": "繁體中文"
                },
                {
                    "name": "DE",
                    "label": "Deutsch"
                },
                {
                    "name": "EN",
                    "label": "English"
                },
                {
                    "name": "MX",
                    "label": "Español"
                },
                {
                    "name": "FR",
                    "label": "Français"
                },
                {
                    "name": "ID",
                    "label": "Bahasa Indonesia"
                },
                {
                    "name": "IT",
                    "label": "Italiano"
                },
                {
                    "name": "JP",
                    "label": "日本語"
                },
                {
                    "name": "KR",
                    "label": "한국어"
                },
                {
                    "name": "BR",
                    "label": "Português (Brasil)"
                },
                {
                    "name": "RU",
                    "label": "Русский"
                },
                {
                    "name": "TH",
                    "label": "ภาษาไทย"
                },
                {
                    "name": "VN",
                    "label": "Tiếng Việt"
                }
            ],
            "default_case": "Unchanged"
        },
        "GameSettingDisplayType": {
            "type": "select",
            "label": "$option.GameSettingDisplayType.label",
            "cases": [
                {
                    "name": "Window",
                    "label": "$option.GameSettingDisplayType.cases.Window.label",
                    "option": [
                        "GameSettingResolution"
                    ]
                },
                {
                    "name": "Fullscreen",
                    "label": "$option.GameSettingDisplayType.cases.Fullscreen.label",
                    "option": [
                        "GameSettingResolution"
                    ]
                }
            ],
            "default_case": "Window"
        },
        "GameSettingResolution": {
            "type": "select",
            "label": "$option.GameSettingResolution.label",
            "cases": [
                {
                    "name": "1280x720"
                },
                {
                    "name": "1920x1080"
                },
                {
                    "name": "2560x1440"
                }
            ],
            "default_case": "1280x720"
        },
        "GameSettingGraphicsQuality": {
            "type": "select",
            "label": "$option.GameSettingGraphicsQuality.label",
            "cases": [
                {
                    "name": "Unchanged",
                    "label": "$option.GameSettingGraphicsQuality.cases.Unchanged.label"
                },
                {
                    "name": "VeryLow",
                    "label": "$option.GameSettingGraphicsQuality.cases.VeryLow.label"
                },
                {
                    "name": "Low",
                    "label": "$option.GameSettingGraphicsQuality.cases.Low.label"
                },
                {
                    "name": "Medium",
                    "label": "$option.GameSettingGraphicsQuality.cases.Medium.label"
                },
                {
                    "name": "High",
                    "label": "$option.GameSettingGraphicsQuality.cases.High.label"
                },
                {
                    "name": "Ultra",
                    "label": "$option.GameSettingGraphicsQuality.cases.Ultra.label"
                }
            ],
            "default_case": "Unchanged"
        },
        "GameSettingFrameRate": {
            "type": "select",
            "label": "$option.GameSettingFrameRate.label",
            "cases": [
                {
                    "name": "Unchanged",
                    "label": "$option.GameSettingFrameRate.cases.Unchanged.label"
                },
                {
                    "name": "Fps30",
                    "label": "$option.GameSettingFrameRate.cases.Fps30.label"
                },
                {
                    "name": "Fps60",
                    "label": "$option.GameSettingFrameRate.cases.Fps60.label"
                },
                {
                    "name": "Fps120",
                    "label": "$option.GameSettingFrameRate.cases.Fps120.label"
                }
            ],
            "default_case": "Unchanged"
        },
        "GameSettingAutoHDR": {
            "type": "select",
            "label": "$option.GameSettingAutoHDR.label",
            "description": "$option.GameSettingAutoHDR.description",
            "cases": [
                {
                    "name": "Unchanged",
                    "label": "$option.GameSettingAutoHDR.cases.Unchanged.label"
                },
                {
                    "name": "Disable",
                    "label": "$option.GameSettingAutoHDR.cases.Disable.label"
                },
                {
                    "name": "Enable",
                    "label": "$option.GameSettingAutoHDR.cases.Enable.label"
                }
            ],
            "default_case": "Unchanged"
        }
    }
}
