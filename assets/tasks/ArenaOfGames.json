{
    "task": [
        {
            "name": "ArenaOfGames",
            "label": "$task.ArenaOfGames.label",
            "entry": "ArenaOfGamesMain",
            "description": "$task.ArenaOfGames.description",
            "group": [
                "other_menu"
            ],
            "controller": [
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "Win32-Front"
            ],
            "option": [
                "ArenaOfGamesMode"
            ]
        }
    ],
    "option": {
        "ArenaOfGamesMode": {
            "type": "select",
            "label": "$option.ArenaOfGamesMode.label",
            "cases": [
                {
                    "name": "Preset",
                    "label": "$option.ArenaOfGamesMode.cases.Preset.label",
                    "option": [
                        "ArenaOfGamesTarget"
                    ],
                    "pipeline_override": {
                        "ArenaOfGamesDecide": {
                            "attach": {
                                "mode": "preset"
                            }
                        }
                    }
                },
                {
                    "name": "Regex",
                    "label": "$option.ArenaOfGamesMode.cases.Regex.label",
                    "option": [
                        "ArenaOfGamesRegex",
                        "ArenaOfGamesRegexUnordered"
                    ],
                    "pipeline_override": {
                        "ArenaOfGamesDecide": {
                            "attach": {
                                "mode": "regex"
                            }
                        }
                    }
                }
            ],
            "default_case": "Preset"
        },
        "ArenaOfGamesRegex": {
            "type": "input",
            "label": "$option.ArenaOfGamesRegex.label",
            "description": "$option.ArenaOfGamesRegex.description",
            "inputs": [
                {
                    "name": "Pattern",
                    "label": "$option.ArenaOfGamesRegex.Pattern.label",
                    "default": "",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "ArenaOfGamesDecide": {
                    "attach": {
                        "regex": "{Pattern}"
                    }
                }
            }
        },
        "ArenaOfGamesRegexUnordered": {
            "type": "switch",
            "label": "$option.ArenaOfGamesRegexUnordered.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "ArenaOfGamesDecide": {
                            "attach": {
                                "unordered": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "ArenaOfGamesDecide": {
                            "attach": {
                                "unordered": false
                            }
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "ArenaOfGamesTarget": {
            "type": "checkbox",
            "label": "$option.ArenaOfGamesTarget.label",
            "cases": [
                {
                    "name": "HandOfToday",
                    "label": "$option.ArenaOfGamesTarget.cases.HandOfToday.label",
                    "pipeline_override": {
                        "ArenaOfGamesDecide": {
                            "attach": {
                                "hand_of_today": true
                            }
                        }
                    }
                },
                {
                    "name": "Flush",
                    "label": "$option.ArenaOfGamesTarget.cases.Flush.label",
                    "pipeline_override": {
                        "ArenaOfGamesDecide": {
                            "attach": {
                                "flush": true
                            }
                        }
                    }
                },
                {
                    "name": "FullHouse",
                    "label": "$option.ArenaOfGamesTarget.cases.FullHouse.label",
                    "pipeline_override": {
                        "ArenaOfGamesDecide": {
                            "attach": {
                                "full_house": true
                            }
                        }
                    }
                },
                {
                    "name": "FourOfAKind",
                    "label": "$option.ArenaOfGamesTarget.cases.FourOfAKind.label",
                    "pipeline_override": {
                        "ArenaOfGamesDecide": {
                            "attach": {
                                "four_of_a_kind": true
                            }
                        }
                    }
                },
                {
                    "name": "StraightFlush",
                    "label": "$option.ArenaOfGamesTarget.cases.StraightFlush.label",
                    "pipeline_override": {
                        "ArenaOfGamesDecide": {
                            "attach": {
                                "straight_flush": true
                            }
                        }
                    }
                }
            ],
            "default_case": [
                "HandOfToday",
                "Flush",
                "FullHouse",
                "FourOfAKind"
            ],
            "min_count": 1
        }
    }
}
