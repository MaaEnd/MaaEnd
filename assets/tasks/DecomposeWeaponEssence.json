{
    "task": [
        {
            "name": "DecomposeWeaponEssence",
            "label": "$task.DecomposeWeaponEssence.label",
            "entry": "DecomposeWeaponEssenceSchedule",
            "description": "$task.DecomposeWeaponEssence.description",
            "group": [
                "valuables_vault"
            ],
            "controller": [
                "ADB",
                "CloudADB",
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "MacOS-Background",
                "MacOS-Front",
                "PlayCover",
                "Win32-Front"
            ],
            "option": [
                "DecomposeWeaponEssenceSchedule",
                "DecomposeWeaponEssenceThreshold"
            ]
        }
    ],
    "option": {
        "DecomposeWeaponEssenceSchedule": {
            "type": "checkbox",
            "label": "$option.TaskSchedule.label",
            "cases": [
                {
                    "name": "DecomposeWeaponEssenceScheduleMonday",
                    "label": "$option.TaskScheduleMonday.label",
                    "pipeline_override": {
                        "DecomposeWeaponEssenceScheduleEnabled": {
                            "attach": {
                                "monday": true
                            }
                        }
                    }
                },
                {
                    "name": "DecomposeWeaponEssenceScheduleTuesday",
                    "label": "$option.TaskScheduleTuesday.label",
                    "pipeline_override": {
                        "DecomposeWeaponEssenceScheduleEnabled": {
                            "attach": {
                                "tuesday": true
                            }
                        }
                    }
                },
                {
                    "name": "DecomposeWeaponEssenceScheduleWednesday",
                    "label": "$option.TaskScheduleWednesday.label",
                    "pipeline_override": {
                        "DecomposeWeaponEssenceScheduleEnabled": {
                            "attach": {
                                "wednesday": true
                            }
                        }
                    }
                },
                {
                    "name": "DecomposeWeaponEssenceScheduleThursday",
                    "label": "$option.TaskScheduleThursday.label",
                    "pipeline_override": {
                        "DecomposeWeaponEssenceScheduleEnabled": {
                            "attach": {
                                "thursday": true
                            }
                        }
                    }
                },
                {
                    "name": "DecomposeWeaponEssenceScheduleFriday",
                    "label": "$option.TaskScheduleFriday.label",
                    "pipeline_override": {
                        "DecomposeWeaponEssenceScheduleEnabled": {
                            "attach": {
                                "friday": true
                            }
                        }
                    }
                },
                {
                    "name": "DecomposeWeaponEssenceScheduleSaturday",
                    "label": "$option.TaskScheduleSaturday.label",
                    "pipeline_override": {
                        "DecomposeWeaponEssenceScheduleEnabled": {
                            "attach": {
                                "saturday": true
                            }
                        }
                    }
                },
                {
                    "name": "DecomposeWeaponEssenceScheduleSunday",
                    "label": "$option.TaskScheduleSunday.label",
                    "pipeline_override": {
                        "DecomposeWeaponEssenceScheduleEnabled": {
                            "attach": {
                                "sunday": true
                            }
                        }
                    }
                }
            ],
            "default_case": [
                "DecomposeWeaponEssenceScheduleMonday",
                "DecomposeWeaponEssenceScheduleTuesday",
                "DecomposeWeaponEssenceScheduleWednesday",
                "DecomposeWeaponEssenceScheduleThursday",
                "DecomposeWeaponEssenceScheduleFriday",
                "DecomposeWeaponEssenceScheduleSaturday",
                "DecomposeWeaponEssenceScheduleSunday"
            ]
        },
        "DecomposeWeaponEssenceThreshold": {
            "type": "input",
            "label": "$option.DecomposeWeaponEssenceThreshold.label",
            "inputs": [
                {
                    "name": "DecomposeWeaponEssenceThreshold",
                    "label": "$option.DecomposeWeaponEssenceThreshold.inputs.DecomposeWeaponEssenceThreshold.label",
                    "default": "1800",
                    "pipeline_type": "int",
                    "verify": "^(0|[1-9][0-9]{0,3})$"
                }
            ],
            "pipeline_override": {
                "AutoEssenceCapacityOverflow": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "expression": "{DecomposeWeaponEssenceThreshold} < {AutoEssenceCapacityCountOCR}",
                                "focus_matched_resolved_expression": true
                            }
                        }
                    }
                },
                "AutoEssenceCapacityEnough": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "expression": "{AutoEssenceCapacityCountOCR} <= {DecomposeWeaponEssenceThreshold}"
                            }
                        }
                    }
                },
                "AutoEssenceCapacityCannotReach": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "expression": "{AutoEssenceCapacitySelectedCountOCR} == 0 && {DecomposeWeaponEssenceThreshold} < {AutoEssenceCapacityCountOCR}"
                            }
                        }
                    }
                },
                "AutoEssenceCapacityNothingLeft": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "expression": "{AutoEssenceCapacitySelectedCountOCR} == 0 && {AutoEssenceCapacityCountOCR} <= {DecomposeWeaponEssenceThreshold}"
                            }
                        }
                    }
                }
            }
        }
    }
}
