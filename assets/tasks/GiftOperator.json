                    "pipeline_override": {
                        "GiftOperatorContacSortOrder": {
                            "enabled": false
                        },
                        "GiftOperatorContacSortBy": {
                            "enabled": false
                        },
                        "GiftOperatorSelectOp1": {
                            "enabled": false
                        },
                        "GiftOperatorSelectSpecifiedOp": {
                            "template": [
                                "GiftOperator/Operators/Arcane.png"
                            ]
                        },
                        "GiftOperatorSelectGiftOp": {
                            "enabled": false
                        },
                        "GiftOperatorSelectSpecifiedGiftOp_Jue": {
