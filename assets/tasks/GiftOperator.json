                                "Typhoeus",
                                "ティフォロス",
                                "티프로스"
                            ]
                        },
                        "GiftOperatorSendCandidate": {
                            "enabled": true,
                            "attach": {
                                "templates": [
                                    "GiftOperator/Operators/Typhoeus.png"
                                ],
                                "generic": false
                            }
                        }
                    }
                },
                {
                    "name": "Purrchena",
                    "label": "$operator.Purrchena",
                    "pipeline_override": {
                        "GiftOperatorContacSortOrder": {
                            "enabled": false
                        },
                        "GiftOperatorContacSortBy": {
                            "enabled": false
                        },
                        "GiftOperatorName": {
                            "expected": [
                                "噗切娜",
                                "噗切娜",
                                "Purrchena",
                                "プチエナ",
                                "푸치나"
                            ]
                        },
                        "GiftOperatorSendCandidate": {
                            "enabled": true,
                            "attach": {
                                "templates": [
                                    "GiftOperator/Operators/Purrchena.png"
                                ],
                                "generic": false
                            }
                        }
                    }
                }
            ],
            "default_case": "Any"
        },
        "OnlyReceiveGift": {
            "type": "switch",
            "label": "$option.OnlyReceiveGift.label",
            "description": "$option.OnlyReceiveGift.description",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "GiftOperatorSendMain": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "No",
                    "option": [
                        "SelectOperator",
                        "GiftOperatorCount",
                        "GiftRingCount"
                    ],
                    "pipeline_override": {
                        "GiftOperatorSendMain": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "GiftOperatorCount": {
            "type": "input",
            "label": "$option.GiftOperatorCount.label",
            "inputs": [
                {
                    "name": "Count",
                    "label": "$option.GiftOperatorCount.inputs.Count.label",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$"
                }
            ],
            "pipeline_override": {
                "GiftOperatorSendMain": {
                    "custom_action_param": {
                        "operation": "init",
                        "count": "{Count}"
                    }
                }
            }
        },
        "GiftRingCount": {
            "type": "select",
            "label": "$option.GiftRingCount.label",
            "cases": [
                {
                    "name": "OneRing",
                    "label": "$option.GiftRingCount.OneRing.label",
                    "pipeline_override": {
                        "GiftOperatorSendMain": {
                            "attach": {
                                "target_rings": 1
                            }
                        }
                    }
                },
                {
                    "name": "TwoRings",
                    "label": "$option.GiftRingCount.TwoRings.label",
                    "pipeline_override": {
                        "GiftOperatorSendMain": {
                            "attach": {
                                "target_rings": 2
                            }
                        }
                    }
                },
                {
                    "name": "ThreeRings",
                    "label": "$option.GiftRingCount.ThreeRings.label",
                    "pipeline_override": {
                        "GiftOperatorSendMain": {
                            "attach": {
                                "target_rings": 3
                            }
                        }
                    }
                }
            ],
            "default_case": "ThreeRings"
        }
    }
}
