                        },
                        "GiftOperatorSelectGiftOp": {
                            "enabled": false
                        },
                        "GiftOperatorSelectSpecifiedGiftOp_Camille": {
                            "enabled": true
                        },
                        "GiftOperatorReceiveDialog": {
                            "next": [
                                "GiftOperatorMain"
                            ]
                        }
                    }
                },
                {
                    "name": "Jue",
