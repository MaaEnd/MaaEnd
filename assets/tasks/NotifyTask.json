{
    "task": [
        {
            "name": "NotifyTask",
            "label": "$task.NotifyTask.label",
            "entry": "NotifySend",
            "description": "$task.NotifyTask.description",
            "group": [
                "other_menu"
            ],
            "option": [
                "NotifyTaskTitle",
                "NotifyTaskBody"
            ]
        }
    ],
    "option": {
        "NotifyTaskTitle": {
            "type": "input",
            "label": "$option.NotifyTaskTitle.label",
            "inputs": [
                {
                    "name": "Title",
                    "label": "$option.NotifyTaskTitle.Title.label",
                    "pipeline_type": "string",
                    "default": ""
                }
            ],
            "pipeline_override": {
                "__NotifyConfig": {
                    "attach": {
                        "task_title": "{Title}"
                    }
                }
            }
        },
        "NotifyTaskBody": {
            "type": "input",
            "label": "$option.NotifyTaskBody.label",
            "inputs": [
                {
                    "name": "Body",
                    "label": "$option.NotifyTaskBody.Body.label",
                    "pipeline_type": "string",
                    "default": ""
                }
            ],
            "pipeline_override": {
                "__NotifyConfig": {
                    "attach": {
                        "task_body": "{Body}"
                    }
                }
            }
        }
    }
}
