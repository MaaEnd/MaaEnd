{
    "task": [
        {
            "name": "AndroidOpenGame",
            "label": "$task.AndroidOpenGame.label",
            "entry": "OpenGame",
            "description": "$task.AndroidOpenGame.description",
            "controller": [
                "ADB",
                "CloudADB",
                "PlayCover"
            ],
            "group": [
                "other_menu"
            ],
            "option": [
                "ClientVersion",
                "ClientVersionCloudLocked"
            ]
        }
    ],
    "option": {
        "ClientVersion": {
            "type": "select",
            "controller": [
                "ADB",
                "PlayCover"
            ],
            "label": "$option.ClientVersion.label",
            "default_case": "CN",
            "cases": [
                {
                    "name": "CN",
                    "label": "$option.ClientVersion.cases.CN.label",
                    "pipeline_override": {
                        "StartUpGame": {
                            "action": {
                                "type": "StartApp",
                                "param": {
                                    "package": "com.hypergryph.endfield"
                                }
                            }
                        },
                        "CloseGame": {
                            "action": {
                                "type": "StopApp",
                                "param": {
                                    "package": "com.hypergryph.endfield"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Bilibili",
                    "label": "$option.ClientVersion.cases.Bilibili.label",
                    "pipeline_override": {
                        "StartUpGame": {
                            "action": {
                                "type": "StartApp",
                                "param": {
                                    "package": "com.hypergryph.endfield.bilibili"
                                }
                            }
                        },
                        "CloseGame": {
                            "action": {
                                "type": "StopApp",
                                "param": {
                                    "package": "com.hypergryph.endfield.bilibili"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Global",
                    "label": "$option.ClientVersion.cases.Global.label",
                    "pipeline_override": {
                        "StartUpGame": {
                            "action": {
                                "type": "StartApp",
                                "param": {
                                    "package": "com.gryphline.endfield.gp"
                                }
                            }
                        },
                        "CloseGame": {
                            "action": {
                                "type": "StopApp",
                                "param": {
                                    "package": "com.gryphline.endfield.gp"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "VN",
                    "label": "$option.ClientVersion.cases.VN.label",
                    "pipeline_override": {
                        "StartUpGame": {
                            "action": {
                                "type": "StartApp",
                                "param": {
                                    "package": "com.hypergryph.endfield.vn"
                                }
                            }
                        },
                        "CloseGame": {
                            "action": {
                                "type": "StopApp",
                                "param": {
                                    "package": "com.hypergryph.endfield.vn"
                                }
                            }
                        }
                    }
                }
            ]
        },
        "ClientVersionCloudLocked": {
            "type": "select",
            "controller": [
                "CloudADB"
            ],
            "label": "$option.ClientVersionCloudLocked.label",
            "description": "$option.ClientVersionCloudLocked.description",
            "default_case": "Cloud",
            "cases": [
                {
                    "name": "Cloud",
                    "label": "$option.ClientVersion.cases.Cloud.label",
                    "pipeline_override": {
                        "StartUpGame": {
                            "action": {
                                "type": "StartApp",
                                "param": {
                                    "package": "com.hypergryph.cloud.endfield"
                                }
                            }
                        },
                        "CloseGame": {
                            "action": {
                                "type": "StopApp",
                                "param": {
                                    "package": "com.hypergryph.cloud.endfield"
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
}
