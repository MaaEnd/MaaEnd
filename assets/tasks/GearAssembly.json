{
    "task": [
        {
            "name": "GearAssembly",
            "label": "$task.GearAssembly.label",
            "entry": "GearAssemblyStart",
            "description": "$task.GearAssembly.description",
            "option": [
                "GearCraftingPriority",
                "GearCraftingSelectMethod"
            ],
            "group": [
                "daily"
            ]
        }
    ],
    "option": {
        "GearCraftingPriority": {
            "type": "select",
            "label": "$task.GearAssembly.option.GearCraftingPriority.label",
            "default_case": "Lower",
            "cases": [
                {
                    "name": "Lower",
                    "label": "$task.GearAssembly.option.GearCraftingPriority.cases.Lower.label",
                    "pipeline_override": {
                        "GearAssemblySwitchAscending": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "Higher",
                    "label": "$task.GearAssembly.option.GearCraftingPriority.cases.Higher.label",
                    "pipeline_override": {
                        "GearAssemblySwitchAscending": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "GearCraftingSelectMethod": {
            "type": "select",
            "label": "$task.GearAssembly.option.GearCraftingSelectMethod.label",
            "default_case": "Auto",
            "cases": [
                {
                    "name": "Auto",
                    "label": "$task.GearAssembly.option.GearCraftingSelectMethod.cases.Auto.label",
                    "pipeline_override": {
                        "GearAssemblyAutoAssemble": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "First",
                    "label": "$task.GearAssembly.option.GearCraftingSelectMethod.cases.First.label",
                    "pipeline_override": {
                        "GearAssemblyFirstAssemble": {
                            "enabled": true
                        }
                    }
                }
            ]
        }
    }
}
