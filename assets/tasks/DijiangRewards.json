            "inputs": [
                {
                    "name": "MaxClueSend",
                    "label": "$option.ClueSend.MaxClueSend.label",
                    "default": "3",
                    "pipeline_type": "int"
                }
            ],
            "pipeline_override": {
                "ReceptionRoomSendCluesSelectClues": {
                    "max_hit": "{MaxClueSend}"
                }
            }
        },
        "ClueStockLimit": {
            "type": "select",
            "label": "$option.ClueStockLimit.label",
            "description": "$option.ClueStockLimit.description",
            "cases": [
                {
                    "name": "1",
                    "label": "$option.ClueStockLimit.cases.1.label",
                    "pipeline_override": {
                        "ClueItemCount": {
                            "expected": "^(?:[2-9]|[1-9]\\d+)$"
                        }
                    }
                },
                {
                    "name": "2",
                    "label": "$option.ClueStockLimit.cases.2.label",
                    "pipeline_override": {
                        "ClueItemCount": {
                            "expected": "^(?:[3-9]|[1-9]\\d+)$"
                        }
                    }
                }
            ],
            "default_case": "2"
        },
