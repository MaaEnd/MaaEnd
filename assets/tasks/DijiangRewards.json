                {
                    "name": "GrowAgain",
                    "label": "$option.SelectToGrow.cases.GrowAgain.label",
                    "pipeline_override": {
                        "GrowthChamberGrow": {
                            "enabled": false
                        },
                        "GrowthChamberGrowAgain": {
                            "enabled": true
                        },
                        "GrowthChamberFakeTrue": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Any",
                    "label": "$option.SelectToGrow.cases.Any.label",
