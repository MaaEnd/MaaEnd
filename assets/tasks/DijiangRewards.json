            "description": "$option.GrowthChamberStage.description",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "GrowthChamberMain": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "GrowthChamberMain": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "ClueSetting": {
            "type": "switch",
            "label": "$option.ClueSetting.label",
            "description": "$option.ClueSetting.description",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "SendCluesDirect",
                        "ClueSend",
                        "ClueStockLimit"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "ReceptionRoomSendCluesSelectClues": {
                            "max_hit": 3
                        },
                        "ClueItemCount": {
                            "expected": "^(?:[3-9]|[1-9]\\d+)$"
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "SendCluesDirect": {
            "type": "switch",
            "label": "$option.SendCluesDirect.label",
            "description": "$option.SendCluesDirect.description",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
