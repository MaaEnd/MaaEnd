{
    "task": [
        {
            "name": "DijiangRewards",
            "label": "$task.DijiangRewards.label",
            "entry": "DijiangRewards",
            "description": "$task.DijiangRewards.description",
            "group": [
                "dijiang_ship"
            ],
            "controller": [
                "ADB",
                "CloudADB",
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "MacOS-Background",
                "MacOS-Front",
                "PlayCover",
                "Win32-Front"
            ],
            "option": [
                "AutoStartExchange",
                "StageTaskSetting",
                "ClueSetting",
                "QuickGiveDuplicateClues",
                "SelectToGrow"
            ]
        }
    ],
    "option": {
        "AutoStartExchange": {
            "type": "switch",
            "label": "$option.AutoStartExchange.label",
            "description": "$option.AutoStartExchange.description",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "WaitExchangeBeforeStart"
                    ],
                    "pipeline_override": {
                        "ReceptionRoomStartExchange": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "ReceptionRoomStartExchange": {
                            "enabled": false
                        },
                        "ReceptionRoomWaitExchangeBeforeStart": {
                            "enabled": false
                        },
                        "ReceptionRoomWaitExchangeUntilReady": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "WaitExchangeBeforeStart": {
            "type": "switch",
            "label": "$option.WaitExchangeBeforeStart.label",
            "description": "$option.WaitExchangeBeforeStart.description",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "WaitExchangeBeforeStartThreshold"
                    ],
                    "pipeline_override": {
                        "ReceptionRoomWaitExchangeBeforeStart": {
                            "enabled": true
                        },
                        "ReceptionRoomWaitExchangeUntilReady": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "ReceptionRoomWaitExchangeBeforeStart": {
                            "enabled": false
                        },
                        "ReceptionRoomWaitExchangeUntilReady": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "WaitExchangeBeforeStartThreshold": {
            "type": "input",
            "label": "$option.WaitExchangeBeforeStartThreshold.label",
            "description": "$option.WaitExchangeBeforeStartThreshold.description",
            "inputs": [
                {
                    "name": "WaitExchangeBeforeStartMinutes",
                    "label": "$option.WaitExchangeBeforeStartThreshold.label",
                    "description": "$option.WaitExchangeBeforeStartThreshold.description",
                    "default": "5",
                    "pipeline_type": "int",
                    "verify": "^(?:[1-9]|[1-9]\\d|[1-9]\\d{2}|1[01]\\d{2}|1200)$",
                    "pattern_msg": "$option.WaitExchangeBeforeStartThreshold.inputs.WaitExchangeBeforeStartMinutes.pattern_msg"
                }
            ],
            "pipeline_override": {
                "ReceptionRoomExchangeCountdownWithinThreshold": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "threshold_minutes": "{WaitExchangeBeforeStartMinutes}"
                            }
                        }
                    }
                },
                "ReceptionRoomWaitExchangeCountdownNotice": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "threshold_minutes": "{WaitExchangeBeforeStartMinutes}",
                                "report_waiting": true
                            }
                        }
                    }
                }
            }
        },
        "StageTaskSetting": {
            "type": "switch",
            "label": "$option.StageTaskSetting.label",
            "description": "$option.StageTaskSetting.description",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "FastCollect",
                        "RecoveryEmotionStage",
                        "ReceptionRoomStage",
                        "ManufacturingStage",
                        "GrowthChamberStage"
                    ]
                },
                {
                    "name": "No"
                }
            ],
            "default_case": "No"
        },
        "FastCollect": {
            "type": "switch",
            "label": "$option.FastCollect.label",
            "description": "$option.FastCollect.description",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DijiangRewardsFastCollectProduction": {
                            "enabled": true
                        },
                        "DijiangRewardsFastCollectClues": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DijiangRewardsFastCollectProduction": {
                            "enabled": false
                        },
                        "DijiangRewardsFastCollectClues": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "RecoveryEmotionStage": {
            "type": "switch",
            "label": "$option.RecoveryEmotionStage.label",
            "description": "$option.RecoveryEmotionStage.description",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "RecoveryEmotionCabins"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "RecoveryEmotionMain": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "RecoveryEmotionCabins": {
            "type": "checkbox",
            "label": "$option.RecoveryEmotionCabins.label",
            "cases": [
                {
                    "name": "ControlNexus",
                    "label": "$option.RecoveryEmotionCabins.cases.ControlNexus.label",
                    "pipeline_override": {
                        "RecoveryEmotionMain": {
                            "enabled": true
                        },
                        "RecoveryEmotionCabinControlNexus": {
                            "next": [
                                "RecoveryEmotionSelectCurrentOperator"
                            ]
                        }
                    }
                },
                {
                    "name": "ReceptionRoom",
                    "label": "$option.RecoveryEmotionCabins.cases.ReceptionRoom.label",
                    "pipeline_override": {
                        "RecoveryEmotionMain": {
                            "enabled": true
                        },
                        "RecoveryEmotionCabinReceptionRoom": {
                            "next": [
                                "RecoveryEmotionSelectCurrentOperator"
                            ]
                        }
                    }
                },
                {
                    "name": "ManufacturingI",
                    "label": "$option.RecoveryEmotionCabins.cases.ManufacturingI.label",
                    "pipeline_override": {
                        "RecoveryEmotionMain": {
                            "enabled": true
                        },
                        "RecoveryEmotionCabinManufacturingI": {
                            "next": [
                                "RecoveryEmotionSelectCurrentOperator"
                            ]
                        }
                    }
                },
                {
                    "name": "ManufacturingII",
                    "label": "$option.RecoveryEmotionCabins.cases.ManufacturingII.label",
                    "pipeline_override": {
                        "RecoveryEmotionMain": {
                            "enabled": true
                        },
                        "RecoveryEmotionCabinManufacturingII": {
                            "next": [
                                "RecoveryEmotionSelectCurrentOperator"
                            ]
                        }
                    }
                },
                {
                    "name": "GrowthChamberI",
                    "label": "$option.RecoveryEmotionCabins.cases.GrowthChamberI.label",
                    "pipeline_override": {
                        "RecoveryEmotionMain": {
                            "enabled": true
                        },
                        "RecoveryEmotionCabinGrowthChamberI": {
                            "next": [
                                "RecoveryEmotionSelectCurrentOperator"
                            ]
                        }
                    }
                }
            ],
            "default_case": [
                "ControlNexus",
                "ReceptionRoom",
                "ManufacturingI",
                "ManufacturingII",
                "GrowthChamberI"
            ]
        },
        "ReceptionRoomStage": {
            "type": "switch",
            "label": "$option.ReceptionRoomStage.label",
            "description": "$option.ReceptionRoomStage.description",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "ReceptionRoomMain": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "ReceptionRoomMain": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "ManufacturingStage": {
            "type": "switch",
            "label": "$option.ManufacturingStage.label",
            "description": "$option.ManufacturingStage.description",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "MFGCabinMain": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "MFGCabinMain": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "GrowthChamberStage": {
            "type": "switch",
