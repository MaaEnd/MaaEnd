                    "pipeline_override": {
                        "SwitchTeamChooseTextRecognition": {
                            "expected": [
                                "03"
                            ]
                        }
                    }
                },
                {
                    "name": "SwitchTeamTeamChoose04",
                    "label": "04",
                    "pipeline_override": {
                        "SwitchTeamChooseTextRecognition": {
