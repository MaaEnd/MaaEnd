{
    "task": [
        {
            "name": "IntelArchive",
            "label": "$task.IntelArchive.label",
            "entry": "IntelArchiveMain",
            "description": "$task.IntelArchive.description",
            "option": [
                "IntelArchiveSyncOwned",
                "IntelArchiveShowInventory"
            ],
            "controller": [
                "ADB",
                "CloudADB",
                "MacOS-Background",
                "MacOS-Front",
                "PlayCover",
                "Win32-Front",
                "Wlroots"
            ],
            "group": [
                "other_menu"
            ]
        }
    ],
    "option": {
        "IntelArchiveSyncOwned": {
            "type": "switch",
            "label": "$task.IntelArchive.option.SyncOwned.label",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "IntelArchiveSyncSub": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "IntelArchiveSyncSub": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "IntelArchiveShowInventory": {
            "type": "switch",
            "label": "$task.IntelArchive.option.ShowInventory.label",
            "description": "$task.IntelArchive.option.ShowInventory.description",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "IntelArchiveShowInventorySub": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "IntelArchiveShowInventorySub": {
                            "enabled": false
                        }
                    }
                }
            ]
        }
    }
}
