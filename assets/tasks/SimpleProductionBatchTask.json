                            "enabled": true
                        }
                    },
                    "option": [
                        "Citromix",
                        "ThornyYazhenPowder",
                        "FluffedJincaoPowder"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "CraftEMS": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
