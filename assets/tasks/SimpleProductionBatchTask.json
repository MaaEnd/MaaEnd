{
    "task": [
        {
            "name": "SimpleProductionBatch",
            "label": "$task.SimpleProductionBatch.label",
            "entry": "CraftStart0",
            "description": "$task.SimpleProductionBatch.description",
            "option": [
                "MakeAll"
            ],
            "group": [
                "utility"
            ]
        }
    ],
    "option": {
        "MakeAll": {
            "type": "switch",
            "label": "$option.MakeAll.label",
            "description": "$option.MakeAll.description",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "CraftMakeALL": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "CraftMakeALL": {
                            "enabled": false
                        }
                    },
                    "option": [
                        "TeleportToDijin",
                        "CraftEMS",
                        "CraftFine"
                    ]
                }
            ]
        },
        "TeleportToDijin": {
            "type": "switch",
            "label": "$option.TeleportToDijin.label",
            "description": "$option.TeleportToDijin.description",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "CraftTeleport": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
