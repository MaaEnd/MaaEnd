{
    "task": [
        {
            "name": "VisitFriends",
            "label": "$task.VisitFriends.label",
            "entry": "VisitFriendsMain",
            "description": "$task.VisitFriends.description",
            "group": [
                "dijiang_ship"
            ],
            "controller": [
                "ADB",
                "CloudADB",
                "CloudWeb",
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "MacOS-Background",
                "MacOS-Front",
                "PlayCover",
                "Win32-Front"
            ],
            "option": [
                "VisitFriendsRemark",
                "VisitFriendsPriorityRemarkEnable",
                "ProductionAssistControl"
            ]
        }
    ],
    "option": {
        "VisitFriendsRemark": {
            "type": "switch",
            "label": "$option.VisitFriendsRemark.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "VisitFriendsMenuScanTargetFriendOpenRemark": {
                            "enabled": true
                        },
                        "VisitFriendsMenuScanTargetFriendOpen": {
                            "enabled": false
                        },
                        "VisitFriendsMenuScanRemarkFallback": {
                            "enabled": true
                        },
                        "VisitFriendsMenuScanPriorityFallbackToRemark": {
                            "enabled": true
                        },
                        "VisitFriendsMenuScanPriorityFallbackToNormal": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "VisitFriendsMenuScanTargetFriendOpenRemark": {
                            "enabled": false
                        },
                        "VisitFriendsMenuScanTargetFriendOpen": {
                            "enabled": true
                        },
                        "VisitFriendsMenuScanRemarkFallback": {
                            "enabled": false
                        },
                        "VisitFriendsMenuScanPriorityFallbackToRemark": {
                            "enabled": false
                        },
                        "VisitFriendsMenuScanPriorityFallbackToNormal": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "VisitFriendsPriorityRemarkEnable": {
            "type": "switch",
            "label": "$option.VisitFriendsPriorityRemarkEnable.label",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "VisitFriendsPriorityRemark",
                        "VisitFriendsPrioritySearchEnable",
                        "BtwAutoStockpileElasticGoodsEnable"
                    ],
                    "pipeline_override": {
                        "VisitFriendsPriorityInit": {
                            "enabled": true
                        },
                        "VisitFriendsMenuScanTargetFriendOpenPriority": {
                            "enabled": true
                        },
                        "VisitFriendsMenuScanTargetFriendOpenRemark": {
                            "enabled": false
                        },
                        "VisitFriendsMenuScanTargetFriendOpen": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "VisitFriendsMenuScanTargetFriendOpenPriority": {
                            "enabled": false
                        },
                        "VisitFriendsMenuScanPriorityFallbackToRemark": {
                            "enabled": false
                        },
                        "VisitFriendsMenuScanPriorityFallbackToNormal": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "VisitFriendsPriorityRemark": {
            "type": "input",
            "label": "$option.VisitFriendsPriorityRemark.label",
            "inputs": [
                {
                    "name": "PriorityRemarkName",
                    "label": "$option.VisitFriendsPriorityRemark.inputs.PriorityRemarkName.label",
                    "default": "",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "VisitFriendsPriorityInit": {
                    "custom_action_param": {
                        "target": "VisitFriendsRecognitionItemNamePriorityByEnterButton",
                        "keywords": "{PriorityRemarkName}",
                        "substring": true
                    }
                },
                "VisitFriendsPrioritySearchInit": {
                    "custom_action_param": {
                        "texts": "{PriorityRemarkName}"
                    }
                }
            }
        },
        "VisitFriendsPrioritySearchEnable": {
            "type": "switch",
            "label": "$option.VisitFriendsPrioritySearchEnable.label",
            "description": "$option.VisitFriendsPrioritySearchEnable.description",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "VisitFriendsPrioritySearchInit": {
                            "enabled": true
                        },
                        "VisitFriendsPrioritySearchNext": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No"
                }
            ],
            "default_case": "No"
        },
        "ProductionAssistControl": {
            "type": "checkbox",
            "label": "$option.ProductionAssistControl.label",
            "cases": [
                {
                    "name": "ProductionAssistControlNexus",
                    "label": "$option.ProductionAssistControl.ProductionAssistControlNexus.label",
                    "pipeline_override": {
                        "VisitFriendsCheckAssistControlNexus": {
                            "recognition": "And",
                            "all_of": [
                                "VisitFriendsRecognitionItemDetailControlNexusAssist"
                            ]
                        },
                        "VisitFriendsMenuAssistControlNexusEntry": {
                            "enabled": true
                        },
                        "VisitFriendsAssistFullInit": {
                            "enabled": false
                        },
                        "VisitFriendsQuickVisitNextClue": {
                            "recognition": "DirectHit"
                        }
                    }
                },
                {
                    "name": "ProductionAssistMFGCabin",
                    "label": "$option.ProductionAssistControl.ProductionAssistMFGCabin.label",
                    "pipeline_override": {
                        "VisitFriendsCheckAssistMFGCabin": {
                            "recognition": "And",
                            "all_of": [
                                "VisitFriendsRecognitionItemDetailMFGCabinAssist"
                            ]
                        },
                        "VisitFriendsMenuAssistMFGCabin1Entry": {
                            "enabled": true
                        },
                        "VisitFriendsMenuAssistMFGCabin2Entry": {
                            "enabled": true
                        },
                        "VisitFriendsAssistFullInit": {
                            "enabled": false
                        },
                        "VisitFriendsQuickVisitNextClue": {
                            "recognition": "DirectHit"
                        }
                    }
                },
                {
                    "name": "ProductionAssistGrowthChamber",
                    "label": "$option.ProductionAssistControl.ProductionAssistGrowthChamber.label",
                    "pipeline_override": {
                        "VisitFriendsCheckAssistGrowthChamber": {
                            "recognition": "And",
                            "all_of": [
                                "VisitFriendsRecognitionItemDetailGrowthChamberAssist"
                            ]
                        },
                        "VisitFriendsMenuAssistGrowthChamberSwipeEntry": {
                            "enabled": true
                        },
                        "VisitFriendsAssistFullInit": {
                            "enabled": false
                        },
                        "VisitFriendsQuickVisitNextClue": {
                            "recognition": "DirectHit"
                        }
                    }
                }
            ],
            "default_case": [
                "ProductionAssistControlNexus",
                "ProductionAssistMFGCabin",
                "ProductionAssistGrowthChamber"
            ]
        },
        "BtwAutoStockpileElasticGoodsEnable": {
            "type": "switch",
            "label": "$option.BtwAutoStockpileElasticGoodsEnable.label",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "BtwAutoStockpileSellableArea"
                    ],
                    "pipeline_override": {
                        "VisitFriendsAssistFull": {
                            "enabled": false
                        },
                        "VisitFriendsFull": {
                            "enabled": false
                        },
                        "VisitFriendsCheckAssistBtwSell": {
                            "enabled": true
                        },
                        "VisitFriendsShipEnterStockRedistribution": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "VisitFriendsShipEnterStockRedistribution": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "BtwAutoStockpileSellableArea": {
            "type": "checkbox",
            "label": "$option.BtwAutoStockpileSellableArea.label",
            "cases": [
                {
                    "name": "BtwValleyIV",
                    "label": "$option.BtwAutoStockpileSellableArea.BtwValleyIV.label",
                    "pipeline_override": {
                        "VisitFriendsBtwSellValleyIVSwitch": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "BtwWuling",
                    "label": "$option.BtwAutoStockpileSellableArea.BtwWuling.label",
                    "pipeline_override": {
                        "VisitFriendsBtwSellWulingSwitch": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": [
                "BtwValleyIV",
                "BtwWuling"
            ]
        }
    }
}
