{
    "task": [
        {
            "name": "VisitFriends",
            "label": "$task.VisitFriends.label",
            "entry": "VisitFriendsMain",
            "description": "$task.VisitFriends.description",
            "group": [
                "dijiang_ship"
            ],
            "controller": [
                "ADB",
                "CloudADB",
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "MacOS-Background",
                "MacOS-Front",
                "PlayCover",
                "Win32-Front"
            ],
            "option": [
                "VisitFriendsLimitVisits",
                "VisitFriendsRemark",
                "VisitFriendsPriorityRemarkEnable",
                "ProductionAssistControl"
            ]
        }
    ],
    "option": {
        "VisitFriendsLimitVisits": {
            "type": "switch",
            "label": "$option.VisitFriendsLimitVisits.label",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "VisitFriendsMaxVisits"
                    ]
                },
                {
                    "name": "No"
                }
            ],
            "default_case": "No"
        },
        "VisitFriendsMaxVisits": {
            "type": "input",
            "label": "$option.VisitFriendsMaxVisits.label",
            "inputs": [
                {
                    "name": "MaxVisits",
                    "label": "$option.VisitFriendsMaxVisits.inputs.MaxVisits.label",
                    "default": "99",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d{0,2}$"
                }
            ],
            "pipeline_override": {
                "VisitFriendsEnterShipBudget": {
                    "max_hit": "{MaxVisits}"
                }
            }
        },
        "VisitFriendsRemark": {
            "type": "switch",
            "label": "$option.VisitFriendsRemark.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "VisitFriendsMenuScanTargetFriendOpenRemark": {
                            "enabled": true
                        },
                        "VisitFriendsMenuScanTargetFriendOpen": {
                            "enabled": false
                        },
                        "VisitFriendsMenuScanRemarkFallback": {
                            "enabled": true
                        },
                        "VisitFriendsMenuScanPriorityRemarkFallbackToRemark": {
                            "enabled": true
                        },
                        "VisitFriendsMenuScanPriorityRemarkFallbackToNormal": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "VisitFriendsMenuScanTargetFriendOpenRemark": {
                            "enabled": false
                        },
                        "VisitFriendsMenuScanTargetFriendOpen": {
                            "enabled": true
                        },
                        "VisitFriendsMenuScanRemarkFallback": {
                            "enabled": false
                        },
                        "VisitFriendsMenuScanPriorityRemarkFallbackToRemark": {
                            "enabled": false
                        },
                        "VisitFriendsMenuScanPriorityRemarkFallbackToNormal": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "VisitFriendsPriorityRemarkEnable": {
            "type": "switch",
            "label": "$option.VisitFriendsPriorityRemarkEnable.label",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "VisitFriendsPriorityRemark",
                        "BtwAutoStockpileElasticGoodsEnable"
                    ],
                    "pipeline_override": {
                        "VisitFriendsWaitFriendNameLoaded": {
                            "next": [
                                "VisitFriendsPriorityRemarkInit",
                                "VisitFriendsMenuScan"
                            ]
                        },
                        "VisitFriendsPriorityRemarkInit": {
                            "enabled": true
                        },
                        "VisitFriendsMenuScanTargetFriendOpenPriorityRemark": {
                            "enabled": true
                        },
                        "VisitFriendsMenuScanTargetFriendOpenRemark": {
                            "enabled": false
                        },
                        "VisitFriendsMenuScanTargetFriendOpen": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "VisitFriendsMenuScanTargetFriendOpenPriorityRemark": {
                            "enabled": false
                        },
                        "VisitFriendsMenuScanPriorityRemarkFallbackToRemark": {
                            "enabled": false
                        },
                        "VisitFriendsMenuScanPriorityRemarkFallbackToNormal": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "VisitFriendsPriorityRemark": {
            "type": "input",
            "label": "$option.VisitFriendsPriorityRemark.label",
            "inputs": [
                {
                    "name": "PriorityRemarkName",
                    "label": "$option.VisitFriendsPriorityRemark.inputs.PriorityRemarkName.label",
                    "default": "",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "VisitFriendsPriorityRemarkInit": {
                    "custom_action_param": {
                        "target": "VisitFriendsRecognitionItemNamePriorityRemarkByEnterButton",
                        "keywords": "{PriorityRemarkName}",
                        "substring": true
                    }
                }
            }
        },
        "ProductionAssistControl": {
            "type": "checkbox",
            "label": "$option.ProductionAssistControl.label",
            "cases": [
                {
                    "name": "ProductionAssistControlNexus",
                    "label": "$option.ProductionAssistControl.ProductionAssistControlNexus.label",
                    "pipeline_override": {
                        "VisitFriendsCheckAssistControlNexus": {
                            "recognition": "And",
                            "all_of": [
                                "VisitFriendsRecognitionItemDetailControlNexusAssist"
                            ]
                        },
                        "VisitFriendsMenuAssistControlNexusEntry": {
                            "enabled": true
                        },
                        "VisitFriendsAssistFullInit": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "ProductionAssistMFGCabin",
                    "label": "$option.ProductionAssistControl.ProductionAssistMFGCabin.label",
                    "pipeline_override": {
                        "VisitFriendsCheckAssistMFGCabin": {
                            "recognition": "And",
                            "all_of": [
                                "VisitFriendsRecognitionItemDetailMFGCabinAssist"
                            ]
                        },
                        "VisitFriendsMenuAssistMFGCabin1Entry": {
                            "enabled": true
                        },
                        "VisitFriendsMenuAssistMFGCabin2Entry": {
                            "enabled": true
                        },
                        "VisitFriendsAssistFullInit": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "ProductionAssistGrowthChamber",
                    "label": "$option.ProductionAssistControl.ProductionAssistGrowthChamber.label",
                    "pipeline_override": {
                        "VisitFriendsCheckAssistGrowthChamber": {
                            "recognition": "And",
                            "all_of": [
                                "VisitFriendsRecognitionItemDetailGrowthChamberAssist"
                            ]
                        },
                        "VisitFriendsMenuAssistGrowthChamberSwipeEntry": {
                            "enabled": true
                        },
                        "VisitFriendsAssistFullInit": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": [
                "ProductionAssistControlNexus",
                "ProductionAssistMFGCabin",
                "ProductionAssistGrowthChamber"
            ]
        },
        "BtwAutoStockpileElasticGoodsEnable": {
            "type": "switch",
            "label": "$option.BtwAutoStockpileElasticGoodsEnable.label",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "BtwAutoStockpileSellableArea"
                    ],
                    "pipeline_override": {
                        "VisitFriendsAssistFull": {
                            "enabled": false
                        },
                        "VisitFriendsFull": {
                            "enabled": false
                        },
                        "VisitFriendsShipEnterStockRedistribution": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "VisitFriendsShipEnterStockRedistribution": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "BtwAutoStockpileSellableArea": {
            "type": "checkbox",
            "label": "$option.BtwAutoStockpileSellableArea.label",
            "cases": [
                {
                    "name": "BtwValleyIV",
                    "label": "$option.BtwAutoStockpileSellableArea.BtwValleyIV.label",
                    "pipeline_override": {
                        "VisitFriendsBtwSellValleyIVSwitch": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "BtwWuling",
                    "label": "$option.BtwAutoStockpileSellableArea.BtwWuling.label",
                    "pipeline_override": {
                        "VisitFriendsBtwSellWulingSwitch": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": [
                "BtwValleyIV",
                "BtwWuling"
            ]
        }
    }
}
