{
    "task": [
        {
            "name": "SanityExtractor",
            "label": "$task.SanityExtractor.label",
            "entry": "SanityExtractorMain",
            "description": "$task.SanityExtractor.description",
            "group": [
                "valuables_vault"
            ],
            "controller": [
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "MacOS-Background",
                "MacOS-Front",
                "Win32-Front"
            ],
            "option": [
                "SanityExtractorTimes"
            ]
        }
    ],
    "option": {
        "SanityExtractorTimes": {
            "type": "input",
            "label": "$task.SanityExtractor.option.Times.label",
            "inputs": [
                {
                    "name": "Times",
                    "label": "$task.SanityExtractor.option.Times.input.label",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$",
                    "pattern_msg": "$task.SanityExtractor.option.Times.input.error"
                }
            ],
            "pipeline_override": {
                "SanityExtractorRoundGate": {
                    "max_hit": "{Times}"
                }
            }
        }
    }
}
