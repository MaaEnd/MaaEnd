{
    "task": [
        {
            "name": "SanityExtractor",
            "label": "$task.SanityExtractor.label",
            "entry": "SanityExtractorSchedule",
            "description": "$task.SanityExtractor.description",
            "group": [
                "valuables_vault"
            ],
            "controller": [
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "MacOS-Background",
                "MacOS-Front",
                "Win32-Front"
            ],
            "option": [
                "SanityExtractorSchedule",
                "SanityExtractorTimes"
            ]
        }
    ],
    "option": {
        "SanityExtractorSchedule": {
            "type": "checkbox",
            "label": "$option.TaskSchedule.label",
            "cases": [
                {
                    "name": "SanityExtractorScheduleMonday",
                    "label": "$option.TaskScheduleMonday.label",
                    "pipeline_override": {
                        "SanityExtractorScheduleEnabled": {
                            "attach": {
                                "monday": true
                            }
                        }
                    }
                },
                {
                    "name": "SanityExtractorScheduleTuesday",
                    "label": "$option.TaskScheduleTuesday.label",
                    "pipeline_override": {
                        "SanityExtractorScheduleEnabled": {
                            "attach": {
                                "tuesday": true
                            }
                        }
                    }
                },
                {
                    "name": "SanityExtractorScheduleWednesday",
                    "label": "$option.TaskScheduleWednesday.label",
                    "pipeline_override": {
                        "SanityExtractorScheduleEnabled": {
                            "attach": {
                                "wednesday": true
                            }
                        }
                    }
                },
                {
                    "name": "SanityExtractorScheduleThursday",
                    "label": "$option.TaskScheduleThursday.label",
                    "pipeline_override": {
                        "SanityExtractorScheduleEnabled": {
                            "attach": {
                                "thursday": true
                            }
                        }
                    }
                },
                {
                    "name": "SanityExtractorScheduleFriday",
                    "label": "$option.TaskScheduleFriday.label",
                    "pipeline_override": {
                        "SanityExtractorScheduleEnabled": {
                            "attach": {
                                "friday": true
                            }
                        }
                    }
                },
                {
                    "name": "SanityExtractorScheduleSaturday",
                    "label": "$option.TaskScheduleSaturday.label",
                    "pipeline_override": {
                        "SanityExtractorScheduleEnabled": {
                            "attach": {
                                "saturday": true
                            }
                        }
                    }
                },
                {
                    "name": "SanityExtractorScheduleSunday",
                    "label": "$option.TaskScheduleSunday.label",
                    "pipeline_override": {
                        "SanityExtractorScheduleEnabled": {
                            "attach": {
                                "sunday": true
                            }
                        }
                    }
                }
            ],
            "default_case": [
                "SanityExtractorScheduleMonday",
                "SanityExtractorScheduleTuesday",
                "SanityExtractorScheduleWednesday",
                "SanityExtractorScheduleThursday",
                "SanityExtractorScheduleFriday",
                "SanityExtractorScheduleSaturday",
                "SanityExtractorScheduleSunday"
            ]
        },
        "SanityExtractorTimes": {
            "type": "input",
            "label": "$task.SanityExtractor.option.Times.label",
            "inputs": [
                {
                    "name": "Times",
                    "label": "$task.SanityExtractor.option.Times.input.label",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$",
                    "pattern_msg": "$task.SanityExtractor.option.Times.input.error"
                }
            ],
            "pipeline_override": {
                "SanityExtractorRoundGate": {
                    "max_hit": "{Times}"
                }
            }
        }
    }
}
