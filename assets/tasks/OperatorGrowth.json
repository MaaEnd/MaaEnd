                {
                    "name": "OperatorGrowthScheduleSunday",
                    "label": "$option.TaskScheduleSunday.label",
                    "pipeline_override": {
                        "OperatorGrowthScheduleEnabled": {
                            "attach": {
                                "sunday": true
                            }
                        }
                    }
                }
            ],
            "default_case": [
                "OperatorGrowthScheduleMonday",
                "OperatorGrowthScheduleTuesday",
                "OperatorGrowthScheduleWednesday",
                "OperatorGrowthScheduleThursday",
                "OperatorGrowthScheduleFriday",
                "OperatorGrowthScheduleSaturday",
                "OperatorGrowthScheduleSunday"
            ]
