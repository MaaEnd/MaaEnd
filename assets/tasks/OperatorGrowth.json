{
    "task": [
        {
            "name": "OperatorGrowth",
            "label": "$task.OperatorGrowth.label",
            "entry": "OperatorGrowthSchedule",
            "description": "$task.OperatorGrowth.description",
            "group": [
                "sanity_sink"
            ],
            "controller": [
                "ADB",
                "CloudADB",
                "PlayCover",
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "Win32-Front"
            ],
            "option": [
                "OperatorGrowthSchedule",
                "AutoFightSetting",
                "ProtocolSpaceTeamChoose",
                "ProtocolSpaceObtainModeClaim",
                "OperatorGrowthOperator"
            ],
            "pipeline_override": {
                "ProtocolSpaceRewardClaimSuccessNext": {
                    "next": [
                        "OperatorGrowthFinishBattle"
                    ]
                },
                "ProtocolSpaceRewardSelectClaim": {
                    "enabled": true
                },
                "ProtocolSpaceRewardSelectNoClaim": {
                    "enabled": false
                },
                "ProtocolSpaceEnterSpaceSelectClaimReward": {
                    "enabled": true
                },
                "ProtocolSpaceEnterSpaceSelectNoClaimReward": {
                    "enabled": false
                },
                "ProtocolSpaceOperationFailedContinue": {
                    "enabled": false
                },
                "ProtocolSpaceLevelChoose": {
                    "recognition": {
                        "param": {
                            "index": 4
                        }
                    }
                }
            }
        }
    ],
    "option": {
        "OperatorGrowthSchedule": {
            "type": "checkbox",
            "label": "$option.TaskSchedule.label",
            "cases": [
                {
                    "name": "OperatorGrowthScheduleMonday",
                    "label": "$option.TaskScheduleMonday.label",
                    "pipeline_override": {
                        "OperatorGrowthScheduleEnabled": {
                            "attach": {
                                "monday": true
                            }
                        }
                    }
                },
                {
                    "name": "OperatorGrowthScheduleTuesday",
