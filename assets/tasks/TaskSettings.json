{
    "task": [
        {
            "name": "TaskSettings",
            "label": "$task.TaskSettings.label",
            "entry": "TaskSettingsMain",
            "description": "$task.TaskSettings.description",
            "controller": [
                "Win32-Front",
                "ADB",
                "PlayCover",
                "Wlroots"
            ],
            "option": [
                "TaskSettingsAutoFightSetting"
            ],
            "group": [
                "other_tasks"
            ]
        }
    ],
    "option": {
        "AutoFightSettingHint": {
            "type": "switch",
            "label": "$option.AutoFightSettingHint.label",
            "description": "$option.AutoFightSettingHint.description",
            "cases": [
                {
                    "name": "Yes"
                },
                {
                    "name": "No"
                }
            ]
        },
        "TaskSettingsAutoFightSetting": {
            "type": "switch",
            "label": "$option.AutoFightSettingFull.label",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "TaskSettingsAutoFightKeymap",
                        "TaskSettingsAutoFightAttack",
                        "TaskSettingsAutoFightDodge",
                        "TaskSettingsAutoFightLockTarget",
                        "TaskSettingsAutoFightHealthDangerousSwitch",
                        "TaskSettingsAutoFightAxisFullSetting"
                    ]
                },
                {
                    "name": "No"
                }
            ]
        },
        "TaskSettingsAutoFightKeymap": {
            "label": "$option.AutoFightKeymap.label",
            "description": "$option.AutoFightKeymap.description",
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "TaskSettingsAutoFightKeymapInput"
                    ]
                },
                {
                    "name": "No"
                }
            ]
        },
        "TaskSettingsAutoFightKeymapInput": {
            "label": "$option.AutoFightKeymapInput.label",
            "description": "$option.AutoFightKeymapInput.description",
            "type": "input",
            "inputs": [
                {
                    "name": "TaskSettingsAutoFightKeymapCombo",
                    "label": "$option.AutoFightKeymapInput.inputs.AutoFightKeymapCombo.label",
                    "pipeline_type": "string",
                    "verify": "^(F([1-9]|1[0-2])|[A-Z]|[0-9])$",
                    "default": "E"
                },
                {
                    "name": "TaskSettingsAutoFightKeymapSkill1",
                    "label": "$option.AutoFightKeymapInput.inputs.AutoFightKeymapSkill1.label",
                    "pipeline_type": "string",
                    "verify": "^(F([1-9]|1[0-2])|[A-Z]|[0-9])$",
                    "default": "1"
                },
                {
                    "name": "TaskSettingsAutoFightKeymapSkill2",
                    "label": "$option.AutoFightKeymapInput.inputs.AutoFightKeymapSkill2.label",
                    "pipeline_type": "string",
                    "verify": "^(F([1-9]|1[0-2])|[A-Z]|[0-9])$",
                    "default": "2"
                },
                {
                    "name": "TaskSettingsAutoFightKeymapSkill3",
                    "label": "$option.AutoFightKeymapInput.inputs.AutoFightKeymapSkill3.label",
                    "pipeline_type": "string",
                    "verify": "^(F([1-9]|1[0-2])|[A-Z]|[0-9])$",
                    "default": "3"
                },
                {
                    "name": "TaskSettingsAutoFightKeymapSkill4",
                    "label": "$option.AutoFightKeymapInput.inputs.AutoFightKeymapSkill4.label",
                    "pipeline_type": "string",
                    "verify": "^(F([1-9]|1[0-2])|[A-Z]|[0-9])$",
                    "default": "4"
                },
                {
                    "name": "TaskSettingsAutoFightKeymapSwitchOperator1",
                    "label": "$option.AutoFightKeymapInput.inputs.AutoFightKeymapSwitchOperator1.label",
                    "pipeline_type": "string",
                    "verify": "^(F([1-9]|1[0-2])|[A-Z]|[0-9])$",
                    "default": "F1"
                },
                {
                    "name": "TaskSettingsAutoFightKeymapSwitchOperator2",
                    "label": "$option.AutoFightKeymapInput.inputs.AutoFightKeymapSwitchOperator2.label",
                    "pipeline_type": "string",
                    "verify": "^(F([1-9]|1[0-2])|[A-Z]|[0-9])$",
                    "default": "F2"
                },
                {
                    "name": "TaskSettingsAutoFightKeymapSwitchOperator3",
                    "label": "$option.AutoFightKeymapInput.inputs.AutoFightKeymapSwitchOperator3.label",
                    "pipeline_type": "string",
                    "verify": "^(F([1-9]|1[0-2])|[A-Z]|[0-9])$",
                    "default": "F3"
                },
                {
                    "name": "TaskSettingsAutoFightKeymapSwitchOperator4",
                    "label": "$option.AutoFightKeymapInput.inputs.AutoFightKeymapSwitchOperator4.label",
                    "pipeline_type": "string",
                    "verify": "^(F([1-9]|1[0-2])|[A-Z]|[0-9])$",
                    "default": "F4"
                }
            ],
            "pipeline_override": {
                "TaskSettingsAutoFightKeymap": {
                    "custom_action_param": {
                        "patch": {
                            "AutoFight": {
                                "attach": {
                                    "combo_keymap": "{TaskSettingsAutoFightKeymapCombo}",
                                    "skill_keymap1": "{TaskSettingsAutoFightKeymapSkill1}",
                                    "skill_keymap2": "{TaskSettingsAutoFightKeymapSkill2}",
                                    "skill_keymap3": "{TaskSettingsAutoFightKeymapSkill3}",
                                    "skill_keymap4": "{TaskSettingsAutoFightKeymapSkill4}",
                                    "switch_operator_keymap1": "{TaskSettingsAutoFightKeymapSwitchOperator1}",
                                    "switch_operator_keymap2": "{TaskSettingsAutoFightKeymapSwitchOperator2}",
                                    "switch_operator_keymap3": "{TaskSettingsAutoFightKeymapSwitchOperator3}",
                                    "switch_operator_keymap4": "{TaskSettingsAutoFightKeymapSwitchOperator4}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "TaskSettingsAutoFightAttack": {
            "label": "$option.AutoFightAttack.label",
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "TaskSettingsAutoFightAttack": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_attack": true
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "TaskSettingsAutoFightAttack": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_attack": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "TaskSettingsAutoFightCombo": {
            "label": "$option.AutoFightCombo.label",
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "TaskSettingsAutoFightCombo": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_combo": true
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "TaskSettingsAutoFightCombo": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_combo": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "TaskSettingsAutoFightDodge": {
            "label": "$option.AutoFightDodge.label",
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "TaskSettingsAutoFightDodgeCompat"
                    ],
                    "pipeline_override": {
                        "TaskSettingsAutoFightDodge": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_dodge": true
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "TaskSettingsAutoFightDodge": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_dodge": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "TaskSettingsAutoFightDodgeCompat": {
            "label": "$option.AutoFightDodgeCompat.label",
            "description": "$option.AutoFightDodgeCompat.description",
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "TaskSettingsAutoFightDodgeCompat": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_dodge_compat": true
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "TaskSettingsAutoFightDodgeCompat": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_dodge_compat": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "TaskSettingsAutoFightAxisFullSetting": {
            "label": "$option.AutoFightAxis.label",
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "TaskSettingsAutoFightAxisData"
                    ]
                },
                {
                    "name": "No",
                    "option": [
                        "TaskSettingsAutoFightCombo",
                        "TaskSettingsAutoFightSkill",
                        "TaskSettingsAutoFightEndSkill"
                    ]
                }
            ]
        },
        "TaskSettingsAutoFightAxisData": {
            "label": "$option.AutoFightAxisData.label",
            "description": "$option.AutoFightAxisData.description",
            "type": "input",
            "inputs": [
                {
                    "name": "TaskSettingsAutoFightAxisCodeString",
                    "label": "$option.AutoFightAxisCodeString.label",
                    "description": "$option.AutoFightAxisCodeString.description",
                    "pipeline_type": "string",
                    "default": ""
                }
            ],
            "pipeline_override": {
                "TaskSettingsAutoFightAxis": {
                    "custom_action_param": {
                        "patch": {
                            "AutoFight": {
                                "attach": {
                                    "end_axis_timeline_code": "{TaskSettingsAutoFightAxisCodeString}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "TaskSettingsAutoFightSkill": {
            "label": "$option.AutoFightSkill.label",
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "TaskSettingsAutoFightSkill": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_skill": true
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "option": [
                        "TaskSettingsAutoFightReserveSkillLevel"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "TaskSettingsAutoFightSkill": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_skill": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "TaskSettingsAutoFightReserveSkillLevel": {
            "label": "$option.AutoFightReserveSkillLevel.label",
            "type": "select",
            "default_case": "1",
            "cases": [
                {
                    "name": "0",
                    "pipeline_override": {
                        "TaskSettingsAutoFightReserveSkillLevel": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "reserve_skill_level": 0
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "1",
                    "pipeline_override": {
                        "TaskSettingsAutoFightReserveSkillLevel": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "reserve_skill_level": 1
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "option": [
                        "TaskSettingsAutoFightBreakAccumulatingPower"
                    ]
                },
                {
                    "name": "2",
                    "pipeline_override": {
                        "TaskSettingsAutoFightReserveSkillLevel": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "reserve_skill_level": 2
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "option": [
                        "TaskSettingsAutoFightBreakAccumulatingPower"
                    ]
                }
            ]
        },
        "TaskSettingsAutoFightBreakAccumulatingPower": {
            "label": "$option.AutoFightBreakAccumulatingPower.label",
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "TaskSettingsAutoFightBreakAccumulatingPower": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_break_accumulating_power": true
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "TaskSettingsAutoFightBreakAccumulatingPower": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_break_accumulating_power": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "TaskSettingsAutoFightEndSkill": {
            "label": "$option.AutoFightEndSkill.label",
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "TaskSettingsAutoFightEndSkill": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_end_skill": true
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "TaskSettingsAutoFightEndSkill": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_end_skill": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "TaskSettingsAutoFightHealthDangerousSwitch": {
            "label": "$option.AutoFightHealthDangerousSwitch.label",
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "TaskSettingsAutoFightHealthDangerousSwitch": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_health_dangerous_switch": true
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "TaskSettingsAutoFightHealthDangerousSwitch": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_health_dangerous_switch": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "TaskSettingsAutoFightLockTarget": {
            "label": "$option.AutoFightLockTarget.label",
            "description": "$option.AutoFightLockTarget.description",
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "TaskSettingsAutoFightLockTarget": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_lock_target": true
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "TaskSettingsAutoFightLockTarget": {
                            "custom_action_param": {
                                "patch": {
                                    "AutoFight": {
                                        "attach": {
                                            "enable_lock_target": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
}
