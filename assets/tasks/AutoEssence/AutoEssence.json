        "AutoUseSpMedication": {
            "type": "select",
            "label": "$option.AutoUseSpMedication.label",
            "cases": [
                {
                    "name": "EndTask",
                    "label": "$option.AutoUseSpMedication.cases.EndTask.label",
                    "pipeline_override": {
                        "AutoEssenceDismissWarningSanityLowStop": {
                            "enabled": true
                        },
                        "AutoEssenceDismissWarningSanityLowUseSpMedicationPrepare": {
                            "enabled": false
                        },
                        "AutoEssenceLowSpUseMedication": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "UseMedication",
                    "label": "$option.AutoUseSpMedication.cases.UseMedication.label",
                    "option": [
                        "AutoEssenceSpMedicationExpireWithinDays"
                    ],
                    "pipeline_override": {
                        "AutoEssenceDismissWarningSanityLowStop": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningSanityLowUseSpMedicationPrepare": {
                            "enabled": true
                        },
                        "AutoEssenceLowSpUseMedication": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "UseMedication"
        },
        "AutoEssenceSpMedicationExpireWithinDays": {
            "type": "select",
            "label": "$option.AutoUseSpMedicationExpireWithinDays.label",
            "cases": [
                {
                    "name": "All",
                    "label": "$option.AutoUseSpMedicationExpireWithinDays.cases.All.label",
                    "pipeline_override": {
                        "__AutoUseSpMedicationOCRRecognitionEmergencySanityBoosterRemainingTime": {
                            "expected": [
                                // 剩余时间 OCR：行首锚定，避免匹配「剩余23小时」「剩余1天」等带前缀文本
                                // @i18n-skip
                                "^(\\d+小时|([1-9]|1[0-3])天)"
                            ]
                        }
                    }
                },
                {
                    "name": "Days10",
                    "label": "$option.AutoUseSpMedicationExpireWithinDays.cases.Days10.label",
                    "pipeline_override": {
                        "__AutoUseSpMedicationOCRRecognitionEmergencySanityBoosterRemainingTime": {
                            "expected": [
                                // 剩余时间 OCR：行首锚定，避免匹配「剩余23小时」「剩余1天」等带前缀文本
                                // @i18n-skip
                                "^(\\d+小时|([1-9]|10)天)"
                            ]
                        }
                    }
                },
                {
                    "name": "Days7",
                    "label": "$option.AutoUseSpMedicationExpireWithinDays.cases.Days7.label",
                    "pipeline_override": {
                        "__AutoUseSpMedicationOCRRecognitionEmergencySanityBoosterRemainingTime": {
                            "expected": [
                                // 剩余时间 OCR：行首锚定，避免匹配「剩余23小时」「剩余1天」等带前缀文本
                                // @i18n-skip
                                "^(\\d+小时|[1-7]天)"
                            ]
                        }
                    }
                },
                {
                    "name": "Days3",
                    "label": "$option.AutoUseSpMedicationExpireWithinDays.cases.Days3.label",
                    "pipeline_override": {
                        "__AutoUseSpMedicationOCRRecognitionEmergencySanityBoosterRemainingTime": {
                            "expected": [
                                // 剩余时间 OCR：行首锚定，避免匹配「剩余23小时」「剩余1天」等带前缀文本
                                // @i18n-skip
                                "^(\\d+小时|[1-3]天)"
                            ]
                        }
                    }
                },
                {
                    "name": "Days1",
                    "label": "$option.AutoUseSpMedicationExpireWithinDays.cases.Days1.label",
                    "pipeline_override": {
                        "__AutoUseSpMedicationOCRRecognitionEmergencySanityBoosterRemainingTime": {
                            "expected": [
                                // 剩余时间 OCR：行首锚定，避免匹配「剩余23小时」「剩余1天」等带前缀文本
                                // @i18n-skip
                                "^(\\d+小时|1天)"
                            ]
                        }
                    }
                }
            ],
            "default_case": "Days3"
        },
        "AutoEssenceDoOverride": {
            "type": "switch",
            "label": "$option.AutoEssenceDoOverride.label",
            "description": "$option.AutoEssenceDoOverride.description",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AutoEssenceChooseOverrideOff": {
                            "enabled": false
                        },
                        "AutoEssenceChooseOverrideOn": {
                            "enabled": true
                        },
                        "AutoEssenceDismissWarningEngravePermitInsufficientContinue": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningEngravePermitInsufficientCancel": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AutoEssenceChooseOverrideOff": {
                            "enabled": true
                        },
                        "AutoEssenceChooseOverrideOn": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningEngravePermitInsufficientContinue": {
                            "enabled": true
                        },
                        "AutoEssenceDismissWarningEngravePermitInsufficientCancel": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "AutoEssenceRepeatCount": {
            "type": "input",
            "label": "$option.AutoEssenceRepeatCount.label",
            "inputs": [
                {
                    "name": "AutoEssenceRepeatCountValue",
                    "label": "$option.AutoEssenceRepeatCount.inputs.AutoEssenceRepeatCountValue.label",
                    "description": "$option.AutoEssenceRepeatCount.inputs.AutoEssenceRepeatCountValue.description",
                    "default": "5",
                    "pipeline_type": "int",
                    "verify": "^(([1-9])|([1-9][0-9]))$"
                }
            ],
            "pipeline_override": {
                "AutoEssenceMain": {
                    "max_hit": "{AutoEssenceRepeatCountValue}"
                },
                "AutoEssenceOnSuccess": {
                    "next": [
                        "AutoEssenceMain",
                        "[JumpBack]AutoEssenceAfterBattleRunEndLootReport",
                        "AutoEssenceOnComplete"
                    ]
                }
            }
        },
        "EssenceFilterAfterBattle": {
            "type": "switch",
            "label": "$option.EssenceFilterAfterBattle.label",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "EssenceFilterAfterBattleSelectWeaponRarity",
                        "EssenceFilterAfterBattleSelectEssence",
                        "EssenceFilterAfterBattleSelectExtraRules"
                    ],
                    "pipeline_override": {
                        "EssenceFilterAfterBattleStart": {
                            "enabled": true
                        },
                        "AutoEssenceAfterBattleRunEndLootReport": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "EssenceFilterAfterBattleStart": {
                            "enabled": false
                        },
                        "AutoEssenceAfterBattleRunEndLootReport": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "EssenceFilterAfterBattleSelectWeaponRarity": {
