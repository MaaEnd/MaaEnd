{
    "task": [
        {
            "name": "AutoEssence",
            "label": "$task.AutoEssence.label",
            "entry": "AutoEssenceSchedule",
            "group": [
                "sanity_sink"
            ],
            "option": [
                "AutoEssenceSchedule",
                "AutoEssenceMenu",
                "AutoEssenceStashBackpackSubTask",
                "AutoFightSettingFull"
            ]
        }
    ],
    "option": {
        "AutoEssenceSchedule": {
            "type": "checkbox",
            "label": "$option.TaskSchedule.label",
            "cases": [
                {
                    "name": "AutoEssenceScheduleMonday",
                    "label": "$option.TaskScheduleMonday.label",
                    "pipeline_override": {
                        "AutoEssenceScheduleEnabled": {
                            "attach": {
                                "monday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoEssenceScheduleTuesday",
                    "label": "$option.TaskScheduleTuesday.label",
                    "pipeline_override": {
                        "AutoEssenceScheduleEnabled": {
                            "attach": {
                                "tuesday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoEssenceScheduleWednesday",
                    "label": "$option.TaskScheduleWednesday.label",
                    "pipeline_override": {
                        "AutoEssenceScheduleEnabled": {
                            "attach": {
                                "wednesday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoEssenceScheduleThursday",
                    "label": "$option.TaskScheduleThursday.label",
                    "pipeline_override": {
                        "AutoEssenceScheduleEnabled": {
                            "attach": {
                                "thursday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoEssenceScheduleFriday",
                    "label": "$option.TaskScheduleFriday.label",
                    "pipeline_override": {
                        "AutoEssenceScheduleEnabled": {
                            "attach": {
                                "friday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoEssenceScheduleSaturday",
                    "label": "$option.TaskScheduleSaturday.label",
                    "pipeline_override": {
                        "AutoEssenceScheduleEnabled": {
                            "attach": {
                                "saturday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoEssenceScheduleSunday",
                    "label": "$option.TaskScheduleSunday.label",
                    "pipeline_override": {
                        "AutoEssenceScheduleEnabled": {
                            "attach": {
                                "sunday": true
                            }
                        }
                    }
                }
            ],
            "default_case": [
                "AutoEssenceScheduleMonday",
                "AutoEssenceScheduleTuesday",
                "AutoEssenceScheduleWednesday",
                "AutoEssenceScheduleThursday",
                "AutoEssenceScheduleFriday",
                "AutoEssenceScheduleSaturday",
                "AutoEssenceScheduleSunday"
            ]
        },
        "AutoEssenceStashBackpackSubTask": {
            "type": "switch",
            "label": "$task.AutoEssence.option.AutoEssenceStashBackpackSubTask.label",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "StashBackpackType",
                        "StashBackpackArea"
                    ],
                    "pipeline_override": {
                        "StashBackpackMain": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "StashBackpackMain": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "AutoEssenceMenu": {
            "type": "select",
            "label": "$option.AutoEssenceMenu.label",
            "description": "$option.AutoEssenceMenu.description",
            "cases": [
                {
                    "name": "Random",
                    "label": "$option.AutoEssenceMenu.cases.Random.label",
                    "description": "$option.AutoEssenceMenu.cases.Random.description",
                    "option": [
                        "AutoEssenceChooseLocation",
                        "AutoEssenceObtainMode",
                        "AutoEssenceDiscardOthers",
                        "AutoEssenceRepeatCount"
                    ],
                    // 随机模式不配置预刻写词条：跳过条件检查/调整，直接开刷；
                    // 未选词条时由 AutoEssenceDismissWarningPreEngrave 关闭警告弹窗
                    "pipeline_override": {
                        "AutoEssenceClickEssenceStartPrepare": {
                            "next": [
                                "AutoEssenceClickEssenceStartButton"
                            ]
                        }
                    }
                },
                {
                    "name": "Location",
                    "label": "$option.AutoEssenceMenu.cases.Location.label",
                    "description": "$option.AutoEssenceMenu.cases.Location.description",
                    "option": [
                        "AutoEssenceSelectLocation",
                        "AutoEssenceObtainModeClaimOnly",
                        "AutoEssenceDiscardOthers",
                        "AutoEssenceRepeatCount"
                    ]
                },
                {
                    "name": "Target",
                    "label": "$option.AutoEssenceMenu.cases.Target.label",
                    "description": "$option.AutoEssenceMenu.cases.Target.description",
                    "option": [
                        "AutoEssenceWeaponTypeSword",
                        "AutoEssenceWeaponTypeClaymore",
                        "AutoEssenceWeaponTypePistol",
                        "AutoEssenceWeaponTypeWand",
                        "AutoEssenceWeaponTypeLance",
                        "AutoEssenceObtainModeClaimOnlyForcedFilter",
                        "AutoEssenceDiscardOthers",
                        "AutoEssenceRefreshInventory"
                    ],
                    "pipeline_override": {
                        "AutoEssenceMain": {
                            "max_hit": 999999,
                            "next": [
                                "AutoEssenceTargetPrepare",
                                "AutoEssenceTargetPlan"
                            ]
                        },
                        "AutoEssenceOnSuccess": {
                            "next": [
                                "AutoEssenceMain",
                                "[JumpBack]AutoEssenceAfterBattleRunEndLootReport",
                                "AutoEssenceAfterStashBackpack"
                            ]
                        },
                        "AutoEssenceOnComplete": {
                            "focus": {
                                "Node.Action.Starting": "🎉**目标模式：基质目标已满足或任务结束**"
                            }
                        }
                    }
                }
            ],
            "default_case": "Random"
        },
        "AutoEssenceObtainMode": {
            "type": "select",
            "label": "$option.AutoEssenceObtainMode.label",
            "description": "$option.AutoEssenceObtainMode.description",
            "cases": [
                {
                    "name": "Discard",
                    "label": "$option.AutoEssenceObtainMode.cases.Discard.label",
                    "pipeline_override": {
                        "AutoEssenceClickObtainButton": {
                            "enabled": false
                        },
                        "AutoEssenceClickDiscardButton": {
                            "enabled": true
                        },
                        "AutoEssenceDismissWarningSanityLowStop": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningSanityLowUseSpMedicationPrepare": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningSanityLowContinue": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "ObtainScaling1",
                    "label": "$option.AutoEssenceObtainMode.cases.ObtainScaling1.label",
                    "option": [
                        "AutoEssenceDoOverride",
                        "AutoUseSpMedication"
                    ],
                    "pipeline_override": {
                        "AutoEssenceClickObtainButton": {
                            "enabled": true
                        },
                        "AutoEssenceClickDiscardButton": {
                            "enabled": false
                        },
                        "AutoEssenceChooseScaling2": {
                            "enabled": false
                        },
                        "AutoEssenceLowSpFallbackScaling1": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningSanityLowContinue": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "ObtainScaling2",
                    "label": "$option.AutoEssenceObtainMode.cases.ObtainScaling2.label",
                    "option": [
                        "AutoEssenceDoOverride",
                        "AutoUseSpMedication"
                    ],
                    "pipeline_override": {
                        "AutoEssenceClickObtainButton": {
                            "enabled": true
                        },
                        "AutoEssenceClickDiscardButton": {
                            "enabled": false
                        },
                        "AutoEssenceChooseScaling2": {
                            "enabled": true
                        },
                        "AutoEssenceLowSpFallbackScaling1": {
                            "enabled": true
                        },
                        "AutoEssenceDismissWarningSanityLowContinue": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "ObtainScaling2"
        },
        "AutoEssenceObtainModeClaimOnly": {
            "type": "select",
            "label": "$option.AutoEssenceObtainMode.label",
            "description": "$option.AutoEssenceObtainMode.description",
            "cases": [
                {
                    "name": "ObtainScaling1",
                    "label": "$option.AutoEssenceObtainMode.cases.ObtainScaling1.label",
                    "option": [
                        "AutoEssenceDoOverride",
                        "AutoUseSpMedication"
                    ],
                    "pipeline_override": {
                        "AutoEssenceClickObtainButton": {
                            "enabled": true
                        },
                        "AutoEssenceClickDiscardButton": {
                            "enabled": false
                        },
                        "AutoEssenceChooseScaling2": {
                            "enabled": false
                        },
                        "AutoEssenceLowSpFallbackScaling1": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningSanityLowContinue": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "ObtainScaling2",
                    "label": "$option.AutoEssenceObtainMode.cases.ObtainScaling2.label",
                    "option": [
                        "AutoEssenceDoOverride",
                        "AutoUseSpMedication"
                    ],
                    "pipeline_override": {
                        "AutoEssenceClickObtainButton": {
                            "enabled": true
                        },
                        "AutoEssenceClickDiscardButton": {
                            "enabled": false
                        },
                        "AutoEssenceChooseScaling2": {
                            "enabled": true
                        },
                        "AutoEssenceLowSpFallbackScaling1": {
                            "enabled": true
                        },
                        "AutoEssenceDismissWarningSanityLowContinue": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "ObtainScaling2"
        },
        "AutoEssenceObtainModeClaimOnlyForcedFilter": {
            "type": "select",
            "label": "$option.AutoEssenceObtainMode.label",
            "description": "$option.AutoEssenceObtainMode.description",
            "cases": [
                {
                    "name": "ObtainScaling1",
                    "label": "$option.AutoEssenceObtainMode.cases.ObtainScaling1.label",
                    "option": [
                        "AutoUseSpMedication"
                    ],
                    "pipeline_override": {
                        "AutoEssenceClickObtainButton": {
                            "enabled": true
                        },
                        "AutoEssenceClickDiscardButton": {
                            "enabled": false
                        },
                        "AutoEssenceChooseScaling2": {
                            "enabled": false
                        },
                        "AutoEssenceLowSpFallbackScaling1": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningSanityLowContinue": {
                            "enabled": false
                        },
                        "AutoEssenceChooseOverrideOff": {
                            "enabled": false
                        },
                        "AutoEssenceChooseOverrideOn": {
                            "enabled": true
                        },
                        "AutoEssenceDismissWarningEngravePermitInsufficientContinue": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningEngravePermitInsufficientCancel": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "ObtainScaling2",
                    "label": "$option.AutoEssenceObtainMode.cases.ObtainScaling2.label",
                    "option": [
                        "AutoUseSpMedication"
                    ],
                    "pipeline_override": {
                        "AutoEssenceClickObtainButton": {
                            "enabled": true
                        },
                        "AutoEssenceClickDiscardButton": {
                            "enabled": false
                        },
                        "AutoEssenceChooseScaling2": {
                            "enabled": true
                        },
                        "AutoEssenceLowSpFallbackScaling1": {
                            "enabled": true
                        },
                        "AutoEssenceDismissWarningSanityLowContinue": {
                            "enabled": false
                        },
                        "AutoEssenceChooseOverrideOff": {
                            "enabled": false
                        },
                        "AutoEssenceChooseOverrideOn": {
                            "enabled": true
                        },
                        "AutoEssenceDismissWarningEngravePermitInsufficientContinue": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningEngravePermitInsufficientCancel": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "ObtainScaling2"
        },
        "AutoEssenceDiscardOthers": {
            "type": "switch",
            "label": "$option.AutoEssenceDiscardOthers.label",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "EssenceFilterAfterBattleInit": {
                            "attach": {
                                "discard_unmatched": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "EssenceFilterAfterBattleInit": {
                            "attach": {
                                "discard_unmatched": false
                            }
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "AutoEssenceRefreshInventory": {
            "type": "switch",
            "label": "$option.AutoEssenceRefreshInventory.label",
            "description": "$option.AutoEssenceRefreshInventory.description",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AutoEssenceTargetPrepare": {
                            "attach": {
                                "force_refresh": true
                            }
                        }
                    }
                },
                {
                    "name": "No"
                }
            ],
            "default_case": "No"
        },
        "AutoUseSpMedication": {
            "type": "select",
            "label": "$option.AutoUseSpMedication.label",
            "cases": [
                {
                    "name": "EndTask",
                    "label": "$option.AutoUseSpMedication.cases.EndTask.label",
                    "pipeline_override": {
                        "AutoEssenceDismissWarningSanityLowStop": {
                            "enabled": true
                        },
                        "AutoEssenceDismissWarningSanityLowUseSpMedicationPrepare": {
                            "enabled": false
                        },
                        "AutoEssenceLowSpUseMedication": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "UseMedication",
                    "label": "$option.AutoUseSpMedication.cases.UseMedication.label",
                    "option": [
                        "AutoEssenceSpMedicationExpireWithinDays"
                    ],
                    "pipeline_override": {
                        "AutoEssenceDismissWarningSanityLowStop": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningSanityLowUseSpMedicationPrepare": {
                            "enabled": true
                        },
                        "AutoEssenceLowSpUseMedication": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "UseMedication"
        },
        "AutoEssenceSpMedicationExpireWithinDays": {
            "type": "select",
            "label": "$option.AutoUseSpMedicationExpireWithinDays.label",
            "cases": [
                {
                    "name": "All",
                    "label": "$option.AutoUseSpMedicationExpireWithinDays.cases.All.label",
                    "pipeline_override": {
                        "__AutoUseSpMedicationOCRRecognitionEmergencySanityBoosterRemainingTime": {
                            "expected": [
                                // 剩余时间 OCR：行首锚定，避免匹配「剩余23小时」「剩余1天」等带前缀文本
                                // @i18n-skip
                                "^(\\d+小时|([1-9]|1[0-3])天)"
                            ]
                        }
                    }
                },
                {
                    "name": "Days10",
                    "label": "$option.AutoUseSpMedicationExpireWithinDays.cases.Days10.label",
                    "pipeline_override": {
                        "__AutoUseSpMedicationOCRRecognitionEmergencySanityBoosterRemainingTime": {
                            "expected": [
                                // 剩余时间 OCR：行首锚定，避免匹配「剩余23小时」「剩余1天」等带前缀文本
                                // @i18n-skip
                                "^(\\d+小时|([1-9]|10)天)"
                            ]
                        }
                    }
                },
                {
                    "name": "Days7",
                    "label": "$option.AutoUseSpMedicationExpireWithinDays.cases.Days7.label",
                    "pipeline_override": {
                        "__AutoUseSpMedicationOCRRecognitionEmergencySanityBoosterRemainingTime": {
                            "expected": [
                                // 剩余时间 OCR：行首锚定，避免匹配「剩余23小时」「剩余1天」等带前缀文本
                                // @i18n-skip
                                "^(\\d+小时|[1-7]天)"
                            ]
                        }
                    }
                },
                {
                    "name": "Days3",
                    "label": "$option.AutoUseSpMedicationExpireWithinDays.cases.Days3.label",
                    "pipeline_override": {
                        "__AutoUseSpMedicationOCRRecognitionEmergencySanityBoosterRemainingTime": {
                            "expected": [
                                // 剩余时间 OCR：行首锚定，避免匹配「剩余23小时」「剩余1天」等带前缀文本
                                // @i18n-skip
                                "^(\\d+小时|[1-3]天)"
                            ]
                        }
                    }
                },
                {
                    "name": "Days1",
                    "label": "$option.AutoUseSpMedicationExpireWithinDays.cases.Days1.label",
                    "pipeline_override": {
                        "__AutoUseSpMedicationOCRRecognitionEmergencySanityBoosterRemainingTime": {
                            "expected": [
                                // 剩余时间 OCR：行首锚定，避免匹配「剩余23小时」「剩余1天」等带前缀文本
                                // @i18n-skip
                                "^(\\d+小时|1天)"
                            ]
                        }
                    }
                }
            ],
            "default_case": "Days3"
        },
        "AutoEssenceDoOverride": {
            "type": "switch",
            "label": "$option.AutoEssenceDoOverride.label",
            "description": "$option.AutoEssenceDoOverride.description",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AutoEssenceChooseOverrideOff": {
                            "enabled": false
                        },
                        "AutoEssenceChooseOverrideOn": {
                            "enabled": true
                        },
                        "AutoEssenceDismissWarningEngravePermitInsufficientContinue": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningEngravePermitInsufficientCancel": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AutoEssenceChooseOverrideOff": {
                            "enabled": true
                        },
                        "AutoEssenceChooseOverrideOn": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningEngravePermitInsufficientContinue": {
                            "enabled": true
                        },
                        "AutoEssenceDismissWarningEngravePermitInsufficientCancel": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "AutoEssenceRepeatCount": {
            "type": "input",
            "label": "$option.AutoEssenceRepeatCount.label",
            "inputs": [
                {
                    "name": "AutoEssenceRepeatCountValue",
                    "label": "$option.AutoEssenceRepeatCount.inputs.AutoEssenceRepeatCountValue.label",
                    "description": "$option.AutoEssenceRepeatCount.inputs.AutoEssenceRepeatCountValue.description",
                    "default": "5",
                    "pipeline_type": "int",
                    "verify": "^(([1-9])|([1-9][0-9]))$"
                }
            ],
            "pipeline_override": {
                "AutoEssenceMain": {
                    "max_hit": "{AutoEssenceRepeatCountValue}"
                },
                "AutoEssenceOnSuccess": {
                    "next": [
                        "AutoEssenceMain",
                        "[JumpBack]AutoEssenceAfterBattleRunEndLootReport",
                        "AutoEssenceAfterStashBackpack"
                    ]
                }
            }
        }
    }
}
