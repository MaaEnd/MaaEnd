{
    "task": [
        {
            "name": "AutoEssence",
            "label": "$task.AutoEssence.label",
            "entry": "AutoEssenceSchedule",
            "group": [
                "sanity_sink"
            ],
            "controller": [
                "ADB",
                "CloudADB",
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "PlayCover",
                "Win32-Front"
            ],
            "option": [
                "AutoEssenceSchedule",
                "AutoEssenceMenu",
                "AutoFightSettingFull"
            ]
        }
    ],
    "option": {
        "AutoEssenceSchedule": {
            "type": "checkbox",
            "label": "$option.TaskSchedule.label",
            "cases": [
                {
                    "name": "AutoEssenceScheduleMonday",
                    "label": "$option.TaskScheduleMonday.label",
                    "pipeline_override": {
                        "AutoEssenceScheduleEnabled": {
                            "attach": {
                                "monday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoEssenceScheduleTuesday",
                    "label": "$option.TaskScheduleTuesday.label",
                    "pipeline_override": {
                        "AutoEssenceScheduleEnabled": {
                            "attach": {
                                "tuesday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoEssenceScheduleWednesday",
                    "label": "$option.TaskScheduleWednesday.label",
                    "pipeline_override": {
                        "AutoEssenceScheduleEnabled": {
                            "attach": {
                                "wednesday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoEssenceScheduleThursday",
                    "label": "$option.TaskScheduleThursday.label",
                    "pipeline_override": {
                        "AutoEssenceScheduleEnabled": {
                            "attach": {
                                "thursday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoEssenceScheduleFriday",
                    "label": "$option.TaskScheduleFriday.label",
                    "pipeline_override": {
                        "AutoEssenceScheduleEnabled": {
                            "attach": {
                                "friday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoEssenceScheduleSaturday",
                    "label": "$option.TaskScheduleSaturday.label",
                    "pipeline_override": {
                        "AutoEssenceScheduleEnabled": {
                            "attach": {
                                "saturday": true
                            }
                        }
                    }
                },
                {
                    "name": "AutoEssenceScheduleSunday",
                    "label": "$option.TaskScheduleSunday.label",
                    "pipeline_override": {
                        "AutoEssenceScheduleEnabled": {
                            "attach": {
                                "sunday": true
                            }
                        }
                    }
                }
            ],
            "default_case": [
                "AutoEssenceScheduleMonday",
                "AutoEssenceScheduleTuesday",
                "AutoEssenceScheduleWednesday",
                "AutoEssenceScheduleThursday",
                "AutoEssenceScheduleFriday",
                "AutoEssenceScheduleSaturday",
                "AutoEssenceScheduleSunday"
            ]
        },
        "AutoEssenceMenu": {
            "type": "select",
            "label": "$option.AutoEssenceMenu.label",
            "description": "$option.AutoEssenceMenu.description",
            "cases": [
                {
                    "name": "Random",
                    "label": "$option.AutoEssenceMenu.cases.Random.label",
                    "description": "$option.AutoEssenceMenu.cases.Random.description",
                    "option": [
                        "AutoEssenceChooseLocation",
                        "AutoEssenceObtainMode",
                        "AutoEssenceRepeatCount"
                    ],
                    // 随机模式不配置预刻写词条：跳过条件检查/调整，直接开刷；
                    // 未选词条时由 AutoEssenceDismissWarningPreEngrave 关闭警告弹窗
                    "pipeline_override": {
                        "AutoEssenceClickEssenceStartPrepare": {
                            "next": [
                                "AutoEssenceClickEssenceStartButton"
                            ]
                        }
                    }
                },
                {
                    "name": "Location",
                    "label": "$option.AutoEssenceMenu.cases.Location.label",
                    "description": "$option.AutoEssenceMenu.cases.Location.description",
                    "option": [
                        "AutoEssenceSelectLocation",
                        "AutoEssenceObtainModeClaimOnly",
                        "AutoEssenceRepeatCount"
                    ]
                },
                {
                    "name": "Target",
                    "label": "$option.AutoEssenceMenu.cases.Target.label",
                    "description": "$option.AutoEssenceMenu.cases.Target.description",
                    "option": [
                        "AutoEssenceWeaponTypeSword",
                        "AutoEssenceWeaponTypeClaymore",
                        "AutoEssenceWeaponTypePistol",
                        "AutoEssenceWeaponTypeWand",
                        "AutoEssenceWeaponTypeLance",
                        "AutoEssenceObtainModeClaimOnlyForcedFilter"
                    ],
                    "pipeline_override": {
                        "AutoEssenceMain": {
                            "max_hit": 999999,
                            "next": [
                                "AutoEssenceTargetPrepare",
                                "AutoEssenceTargetPlan"
                            ]
                        },
                        "AutoEssenceOnSuccess": {
                            "next": [
                                "AutoEssenceMain",
                                "[JumpBack]AutoEssenceAfterBattleRunEndLootReport",
                                "AutoEssenceOnComplete"
                            ]
                        },
                        "AutoEssenceOnComplete": {
                            "focus": {
                                "Node.Action.Starting": "🎉**目标模式：基质目标已满足或任务结束**"
                            }
                        },
                        // 目标模式依赖战后精确匹配 Add 更新内存库存，强制开启战后基质筛选
                        "EssenceFilterAfterBattleStart": {
                            "enabled": true
                        },
                        "AutoEssenceAfterBattleRunEndLootReport": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "Random"
        },
        "AutoEssenceObtainMode": {
            "type": "select",
            "label": "$option.AutoEssenceObtainMode.label",
            "description": "$option.AutoEssenceObtainMode.description",
            "cases": [
                {
                    "name": "Discard",
                    "label": "$option.AutoEssenceObtainMode.cases.Discard.label",
                    "pipeline_override": {
                        "AutoEssenceClickObtainButton": {
                            "enabled": false
                        },
                        "AutoEssenceClickDiscardButton": {
                            "enabled": true
                        },
                        "AutoEssenceDismissWarningSanityLowStop": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningSanityLowUseSpMedicationPrepare": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningSanityLowContinue": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "ObtainScaling1",
                    "label": "$option.AutoEssenceObtainMode.cases.ObtainScaling1.label",
                    "option": [
                        "AutoEssenceDoOverride",
                        "EssenceFilterAfterBattle",
                        "AutoUseSpMedication"
                    ],
                    "pipeline_override": {
                        "AutoEssenceClickObtainButton": {
                            "enabled": true
                        },
                        "AutoEssenceClickDiscardButton": {
                            "enabled": false
                        },
                        "AutoEssenceChooseScaling2": {
                            "enabled": false
                        },
                        "AutoEssenceLowSpFallbackScaling1": {
                            "enabled": false
                        },
                        "AutoEssenceDismissWarningSanityLowContinue": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "ObtainScaling2",
                    "label": "$option.AutoEssenceObtainMode.cases.ObtainScaling2.label",
                    "option": [
                        "AutoEssenceDoOverride",
                        "EssenceFilterAfterBattle",
                        "AutoUseSpMedication"
                    ],
                    "pipeline_override": {
                        "AutoEssenceClickObtainButton": {
                            "enabled": true
                        },
                        "AutoEssenceClickDiscardButton": {
                            "enabled": false
                        },
                        "AutoEssenceChooseScaling2": {
                            "enabled": true
                        },
                        "AutoEssenceLowSpFallbackScaling1": {
                            "enabled": true
                        },
                        "AutoEssenceDismissWarningSanityLowContinue": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "ObtainScaling2"
        },
        "AutoEssenceObtainModeClaimOnly": {
            "type": "select",
