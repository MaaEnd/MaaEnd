                        "AutoUseSpMedication"
                    ],
                    "pipeline_override": {
                        "AutoEssenceClickObtainButton": {
                            "enabled": true
                        },
                        "AutoEssenceClickDiscardButton": {
                            "enabled": false
                        },
                        "AutoEssenceChooseScaling2": {
                            "enabled": true
                        },
                        "AutoEssenceLowSpFallbackScaling1": {
                            "enabled": true
                        },
                        "AutoEssenceDismissWarningSanityLowContinue": {
