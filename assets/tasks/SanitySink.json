                {
                    "name": "No",
                    "pipeline_override": {
                        "AutoUseSpMedicationSelectEmergencySanityBoosterInCombat": {
                            "enabled": false
                        },
                        "ProtocolSpaceRewardClaimSuccessSanityLowDialog": {
