                        "ProtocolSpaceRewardClaimSuccessSanityLow": {
                            "enabled": false
                        },
                        "AutoEssenceLowSpCancelObtain": {
                            "enabled": false
                        },
                        "AutoEssenceLowSpStopTask": {
                            "enabled": false
                        }
