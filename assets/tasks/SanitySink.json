{
    "task": [
        {
            "name": "SanitySink",
            "label": "$task.SanitySink.label",
            "entry": "SanitySinkMain",
            "description": "$task.SanitySink.description",
            "option": [
                "ProtocolSpaceSchedule",
                "SanitySinkMode",
                "SanitySinkRewardMode",
                "SanitySinkSuccessCount",
                "AutoFightSetting",
                "SanitySinkUseSpMedicationWhenSanityLow"
            ],
            "controller": [
                "ADB",
                "PlayCover",
                "Win32-Front",
                "Wlroots"
            ],
            "group": [
                "sanity_sink"
            ]
        }
    ],
    "option": {
        "SanitySinkRewardMode": {
            "type": "select",
            "label": "$option.SanitySinkRewardMode.label",
            "description": "$option.SanitySinkRewardMode.description",
            "default_case": "SingleClaim",
            "cases": [
                {
                    "name": "NoClaim",
                    "label": "$option.SanitySinkRewardMode.cases.NoClaim.label",
                    "pipeline_override": {
                        "ProtocolSpaceRewardSelectClaim": {
                            "enabled": false
                        },
                        "ProtocolSpaceRewardSelectNoClaim": {
                            "enabled": true
                        },
                        "ProtocolSpaceEnterSpaceSelectClaimReward": {
                            "enabled": false
                        },
                        "ProtocolSpaceEnterSpaceSelectNoClaimReward": {
                            "enabled": true
                        },
                        "AutoEssenceClickObtainButtonPre": {
                            "next": [
                                "AutoEssenceClickDiscardButton"
                            ]
                        }
                    }
                },
                {
                    "name": "SingleClaim",
                    "label": "$option.SanitySinkRewardMode.cases.SingleClaim.label",
                    "pipeline_override": {
                        "ProtocolSpaceRewardSelectClaim": {
                            "enabled": true
                        },
                        "ProtocolSpaceRewardSelectNoClaim": {
                            "enabled": false
                        },
                        "ProtocolSpaceEnterSpaceSelectClaimReward": {
                            "enabled": true
                        },
                        "ProtocolSpaceEnterSpaceSelectNoClaimReward": {
                            "enabled": false
                        },
                        "ProtocolSpaceRewardUsePermit": {
                            "enabled": false
                        },
                        "AutoEssenceClickObtainButtonPre": {
                            "next": [
                                "AutoEssenceClickObtainButton"
                            ]
                        },
                        "AutoEssenceChooseScaling2": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "DoubleClaim",
                    "label": "$option.SanitySinkRewardMode.cases.DoubleClaim.label",
                    "pipeline_override": {
                        "ProtocolSpaceRewardSelectClaim": {
                            "enabled": true
                        },
                        "ProtocolSpaceRewardSelectNoClaim": {
                            "enabled": false
                        },
                        "ProtocolSpaceEnterSpaceSelectClaimReward": {
                            "enabled": true
                        },
                        "ProtocolSpaceEnterSpaceSelectNoClaimReward": {
                            "enabled": false
                        },
                        "ProtocolSpaceRewardUsePermit": {
                            "enabled": true
                        },
                        "AutoEssenceClickObtainButtonPre": {
                            "next": [
                                "AutoEssenceClickObtainButton"
                            ]
                        },
                        "AutoEssenceChooseScaling2": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "SanitySinkSuccessCount": {
            "type": "select",
            "label": "$option.SanitySinkSuccessCount.label",
            "description": "$option.SanitySinkSuccessCount.description",
            "default_case": "Unlimited",
            "cases": [
                {
                    "name": "Count1",
                    "label": "1",
                    "pipeline_override": {
                        "ProtocolSpaceRewardClaimSuccessContinue": {
                            "max_hit": 0
                        },
                        "ProtocolSpaceRewardNoClaimSuccessContinue": {
                            "max_hit": 0
                        },
                        "AutoEssenceMain": {
                            "max_hit": 1
                        },
                        "AutoEssenceOnSuccess": {
                            "next": [
                                "AutoEssenceMain",
                                "[JumpBack]AutoEssenceAfterBattleRunEndLootReport",
                                "AutoEssenceOnComplete"
                            ]
                        }
                    }
                },
                {
                    "name": "Count2",
                    "label": "2",
                    "pipeline_override": {
                        "ProtocolSpaceRewardClaimSuccessContinue": {
                            "max_hit": 1
                        },
                        "ProtocolSpaceRewardNoClaimSuccessContinue": {
                            "max_hit": 1
                        },
                        "AutoEssenceMain": {
                            "max_hit": 2
                        },
                        "AutoEssenceOnSuccess": {
                            "next": [
                                "AutoEssenceMain",
                                "[JumpBack]AutoEssenceAfterBattleRunEndLootReport",
                                "AutoEssenceOnComplete"
                            ]
                        }
                    }
                },
                {
                    "name": "Count3",
                    "label": "3",
                    "pipeline_override": {
                        "ProtocolSpaceRewardClaimSuccessContinue": {
                            "max_hit": 2
                        },
                        "ProtocolSpaceRewardNoClaimSuccessContinue": {
                            "max_hit": 2
                        },
                        "AutoEssenceMain": {
                            "max_hit": 3
                        },
                        "AutoEssenceOnSuccess": {
                            "next": [
                                "AutoEssenceMain",
                                "[JumpBack]AutoEssenceAfterBattleRunEndLootReport",
                                "AutoEssenceOnComplete"
                            ]
                        }
                    }
                },
                {
                    "name": "Count4",
                    "label": "4",
                    "pipeline_override": {
                        "ProtocolSpaceRewardClaimSuccessContinue": {
                            "max_hit": 3
                        },
                        "ProtocolSpaceRewardNoClaimSuccessContinue": {
                            "max_hit": 3
                        },
                        "AutoEssenceMain": {
                            "max_hit": 4
                        },
                        "AutoEssenceOnSuccess": {
                            "next": [
                                "AutoEssenceMain",
                                "[JumpBack]AutoEssenceAfterBattleRunEndLootReport",
                                "AutoEssenceOnComplete"
                            ]
                        }
                    }
                },
                {
                    "name": "Count5",
                    "label": "5",
                    "pipeline_override": {
                        "ProtocolSpaceRewardClaimSuccessContinue": {
                            "max_hit": 4
                        },
                        "ProtocolSpaceRewardNoClaimSuccessContinue": {
                            "max_hit": 4
                        },
                        "AutoEssenceMain": {
                            "max_hit": 5
                        },
                        "AutoEssenceOnSuccess": {
                            "next": [
                                "AutoEssenceMain",
                                "[JumpBack]AutoEssenceAfterBattleRunEndLootReport",
                                "AutoEssenceOnComplete"
                            ]
                        }
                    }
                },
                {
                    "name": "Unlimited",
                    "label": "$option.ProtocolSpaceCountUnlimited.label",
                    "pipeline_override": {
                        "AutoEssenceMain": {
                            "max_hit": 99
                        },
                        "AutoEssenceOnSuccess": {
                            "next": [
                                "AutoEssenceMain",
                                "[JumpBack]AutoEssenceAfterBattleRunEndLootReport",
                                "AutoEssenceOnComplete"
                            ]
                        }
                    }
                }
            ]
        },
        "SanitySinkUseSpMedicationWhenSanityLow": {
            "type": "switch",
            "label": "$option.SanitySinkUseSpMedicationWhenSanityLow.label",
            "description": "$option.SanitySinkUseSpMedicationWhenSanityLow.description",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AutoUseSpMedicationSelectEmergencySanityBoosterInCombat": {
                            "enabled": true
