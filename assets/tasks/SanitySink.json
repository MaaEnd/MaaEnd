        "SanitySinkMode": {
            "type": "select",
            "label": "$option.SanitySinkMode.label",
            "description": "$option.SanitySinkMode.description",
            "default_case": "ProtocolSpace",
            "cases": [
                {
                    "name": "ProtocolSpace",
                    "label": "$task.ProtocolSpace.label",
                    "pipeline_override": {
                        "SanitySinkProtocolSpaceEntry": {
                            "enabled": true
                        },
                        "SanitySinkAutoEssenceEntry": {
                            "enabled": false
                        }
                    },
                    "option": [
                        "ProtocolSpaceTab",
                        "ProtocolSpaceTeamChoose",
                        "ProtocolSpaceFailedCount"
                    ]
                },
                {
                    "name": "AutoEssence",
                    "label": "$task.AutoEssence.label",
                    "pipeline_override": {
                        "SanitySinkProtocolSpaceEntry": {
                            "enabled": false
                        },
                        "SanitySinkAutoEssenceEntry": {
                            "enabled": true
                        },
                        "AutoEssenceClickEssenceChallengeUsingWalk": {
                            "enabled": false
                        },
                        "AutoEssenceClickEssenceChallengeUsingAutoFight": {
                            "enabled": true
                        }
                    },
