{
    "task": [
        {
            "name": "QuickStashBackpack",
            "label": "$task.QuickStashBackpack.label",
            "entry": "QuickStashBackpackMain",
            "controller": [
                "Win32-Window",
                "Win32-Window-Background",
                "Win32-Front",
                "Wlroots"
            ],
            "group": [
                "backpack"
            ]
        }
    ],
    "option": {
        "QuickStashBackpackEnable": {
            "type": "switch",
            "label": "$task.QuickStashBackpack.option.QuickStashBackpackEnable.label",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "QuickStashBackpackMain": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "QuickStashBackpackMain": {
                            "enabled": false
                        }
                    }
                }
            ]
        }
    }
}
