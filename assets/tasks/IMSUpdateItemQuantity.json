{
    "task": [
        {
            "name": "IMSUpdateItemQuantity",
            "label": "[测试] IMS A1 增减缓存数量",
            "entry": "UpdateItemQuantity",
            "description": "测试 UpdateItemQuantity：对指定物品缓存做 +/-，结果下限为 0。不改变就绪状态。",
            "controller": [
                "Win32-Front",
                "ADB",
                "PlayCover",
                "Wlroots"
            ],
            "group": [
                "other_menu"
            ],
            "option": [
                "IMSUpdateItemQuantityParams"
            ]
        }
    ],
    "option": {
        "IMSUpdateItemQuantityParams": {
            "type": "input",
            "label": "A1 参数",
            "description": "物品 ID 与有符号增量（正加负减）",
            "inputs": [
                {
                    "name": "IMSItemId",
                    "label": "物品 ID",
                    "description": "如 PROTODISK、ARMS_INSP_SET",
                    "pipeline_type": "string",
                    "default": "PROTODISK"
                },
                {
                    "name": "IMSDelta",
                    "label": "增量 delta",
                    "description": "正数增加、负数减少",
                    "pipeline_type": "int",
                    "default": "1",
                    "verify": "^-?\\d+$"
                }
            ],
            "pipeline_override": {
                "UpdateItemQuantity": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "item": "{IMSItemId}",
                                "delta": "{IMSDelta}"
                            }
                        }
                    }
                }
            }
        }
    }
}
