                {
                    "name": "TeleWalkFetchDeliver",
                    "label": "$task.SeizeDeliveryJobsPostProcessing.cases.TeleWalkFetchDeliver.label",
                    "option": [
                        "SeizeDeliveryJobsPostDepartureRiskAcknowledgement",
                        "SeizeDeliveryJobsPostDeparturePreferZipline",
                        "SeizeDeliveryJobsRepeatCount"
                    ],
                    "pipeline_override": {
                        "SeizeDeliveryJobsPostProcessingEntry": {
                            "enabled": true,
                            "next": [
                                "SeizeDeliveryJobsGuard",
                                "SeizeDeliveryJobsFullDelivery"
                            ]
                        }
                    }
                }
            ]
        },
        "SeizeDeliveryJobsPostDepartureRiskAcknowledgement": {
            "type": "switch",
            "label": "$task.AutoDeliveryRiskAcknowledgement.label",
            "description": "$task.AutoDeliveryRiskAcknowledgement.description",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "SeizeDeliveryJobsGuard": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "Yes"
                }
            ]
        },
        "SeizeDeliveryJobsPostDeparturePreferZipline": {
            "type": "switch",
            "label": "$task.AutoDeliveryPreferZipline.label",
            "description": "$task.AutoDeliveryPreferZipline.description",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "AutoDeliveryNavigateDepot": {
                            "attach": {
                                "zip": false
                            }
                        },
                        "AutoDeliveryNavigateDestination": {
                            "attach": {
                                "zip": false
                            }
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AutoDeliveryNavigateDepot": {
                            "attach": {
                                "zip": true
                            }
                        },
                        "AutoDeliveryNavigateDestination": {
                            "attach": {
                                "zip": true
                            }
                        }
                    }
                }
            ]
        },
        "SeizeDeliveryJobsRefreshLimit": {
            "type": "input",
            "label": "$task.SeizeDeliveryJobsRefreshLimit.label",
            "inputs": [
                {
                    "name": "Limit",
                    "label": "$task.SeizeDeliveryJobsRefreshLimit.inputs.Limit.label",
                    "default": "100",
                    "pipeline_type": "int",
                    "verify": "^([1-9]\\d{0,2}|1\\d{3}|2000)$",
                    "pattern_msg": "$task.SeizeDeliveryJobsRefreshLimit.inputs.Limit.pattern_msg"
                }
            ],
            "pipeline_override": {
                "SeizeDeliveryJobsRefreshHit": {
                    "max_hit": "{Limit}"
                }
            }
        },
        "SeizeDeliveryJobsRepeatCount": {
            "type": "select",
            "default_case": "3",
            "label": "$task.SeizeDeliveryJobsRepeatCount.label",
            "description": "$task.SeizeDeliveryJobsRepeatCount.description",
            "cases": [
                {
                    "name": "1",
                    "label": "$task.SeizeDeliveryJobsRepeatCount.cases.1.label",
                    "pipeline_override": {
                        "SeizeDeliveryJobsMain": {
                            "max_hit": 1
                        }
                    }
                },
                {
                    "name": "2",
                    "label": "$task.SeizeDeliveryJobsRepeatCount.cases.2.label",
                    "pipeline_override": {
                        "SeizeDeliveryJobsMain": {
                            "max_hit": 2
                        }
                    }
                },
                {
                    "name": "3",
                    "label": "$task.SeizeDeliveryJobsRepeatCount.cases.3.label",
                    "pipeline_override": {
                        "SeizeDeliveryJobsMain": {
                            "max_hit": 3
                        }
                    }
                }
            ]
        },
