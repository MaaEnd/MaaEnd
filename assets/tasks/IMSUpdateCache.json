{
    "task": [
        {
            "name": "IMSUpdateCache",
            "label": "$task.IMSUpdateCache.label",
            "entry": "EnsureItemDataReadyMain",
            "description": "$task.IMSUpdateCache.description",
            "controller": [
                "ADB",
                "PlayCover",
                "Win32-Front",
                "Wlroots"
            ],
            "option": [
                "IMSUpdateCacheRefreshDays"
            ],
            "group": [
                "valuables_vault"
            ]
        }
    ],
    "option": {
        "IMSUpdateCacheRefreshDays": {
            "type": "select",
            "label": "$option.IMSUpdateCacheRefreshDays.label",
            "description": "$option.IMSUpdateCacheRefreshDays.description",
            "default_case": "Days7",
            "cases": [
                {
                    "name": "Always",
                    "label": "$option.IMSUpdateCacheRefreshDays.case.Always.label",
                    "pipeline_override": {
                        "EnsureItemDataReadyAlreadyOk": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Days7",
                    "label": "$option.IMSRefreshDays.7.label",
                    "pipeline_override": {
                        "ItemDataReady": {
                            "recognition": {
                                "param": {
                                    "custom_recognition_param": {
                                        "refresh_days": 7
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Days30",
                    "label": "$option.IMSRefreshDays.30.label",
                    "pipeline_override": {
                        "ItemDataReady": {
                            "recognition": {
                                "param": {
                                    "custom_recognition_param": {
                                        "refresh_days": 30
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "SyncOnly",
                    "label": "$option.IMSUpdateCacheRefreshDays.case.SyncOnly.label",
                    "pipeline_override": {
                        "ItemDataReady": {
                            "recognition": {
                                "param": {
                                    "custom_recognition_param": {
                                        "refresh_days": 0
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
}
