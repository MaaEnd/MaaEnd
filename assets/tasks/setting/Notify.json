                {
                    "name": "Yes",
                    "option": [
                        "NotifyWebhookUrl",
                        "NotifyWebhookMethod",
                        "NotifyWebhookHeaders",
                        "NotifyWebhookBody"
                    ],
                    "pipeline_override": {
                        "__NotifyConfig": {
                            "attach": {
                                "webhook_enabled": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "__NotifyConfig": {
                            "attach": {
                                "webhook_enabled": false
                            }
                        }
                    }
                }
            ]
        },
