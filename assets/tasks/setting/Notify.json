{
    "setting": [
        {
            "name": "NotifyChannel",
            "label": "$option.NotifyChannel.label",
            "description": "$option.NotifyChannel.description",
            "option": [
                "NotifyHelp",
                "NotifyWebhook",
                "NotifyBark",
                "NotifyServerChan"
            ]
        },
        {
            "name": "NotifyContent",
            "label": "$option.NotifyContent.label",
            "description": "$option.NotifyContent.description",
            "option": [
                "NotifyAllowTask",
                "NotifyFail"
            ]
        }
    ],
