        "NotifyWebhook": {
            "type": "switch",
            "label": "$option.NotifyWebhook.label",
            "description": "$option.NotifyWebhook.description",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "$option.NotifyWebhook.cases.Yes.label",
                    "option": [
                        "NotifyWebhookUrl",
                        "NotifyWebhookMethod",
                        "NotifyWebhookHeaders",
                        "NotifyWebhookBody"
                    ],
                    "pipeline_override": {
                        "__NotifyConfig": {
                            "attach": {
                                "webhook_enabled": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "$option.NotifyWebhook.cases.No.label",
                    "pipeline_override": {
                        "__NotifyConfig": {
                            "attach": {
                                "webhook_enabled": false
                            }
                        }
                    }
                }
            ]
        },
