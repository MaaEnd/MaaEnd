{
    "task": [
        {
            "name": "ZiplineImport",
            "label": "$task.ZiplineImport.label",
            "entry": "ZiplineImportMain",
            "description": "$task.ZiplineImport.description",
            "option": [
                "ZiplineImportRegion",
                "ZiplineImportClearLogin"
            ],
            "controller": [
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "Win32-Front"
            ],
            "group": [
                "open_world"
            ]
        }
    ],
    "option": {
        "ZiplineImportRegion": {
            "type": "select",
            "label": "$option.ZiplineImportRegion.label",
            "default_case": "CN",
            "cases": [
                {
                    "name": "CN",
                    "label": "$option.ZiplineImportRegion.cases.CN.label",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "url": "https://game.skland.com/map/endfield"
                            }
                        }
                    }
                },
                {
                    "name": "Global",
                    "label": "$option.ZiplineImportRegion.cases.Global.label",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "url": "https://game.skport.com/map/endfield"
                            }
                        }
                    }
                }
            ]
        },
        "ZiplineImportClearLogin": {
            "type": "switch",
            "controller": [
                "Win32-Front"
            ],
            "label": "$option.ZiplineImportClearLogin.label",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "clear_login": true
                            }
                        }
                    }
                },
                {
                    "name": "No"
                }
            ]
        }
    }
}
