{
    "task": [
        {
            "name": "ZiplineImport",
            "label": "$task.ZiplineImport.label",
            "entry": "ZiplineImportMain",
            "description": "$task.ZiplineImport.description",
            "option": [
                "ZiplineImportRegion",
                "ZiplineImportClearLogin"
            ],
            "controller": [
                "Win32-Front"
            ],
            "group": [
                "open_world"
            ]
        }
    ],
    "option": {
        "ZiplineImportRegion": {
            "type": "select",
            "label": "$option.ZiplineImportRegion.label",
            "description": "$option.ZiplineImportRegion.description",
            "default_case": "CN",
            "cases": [
                {
                    "name": "CN",
                    "label": "$option.ZiplineImportRegion.cases.CN.label",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "url": "https://game.skland.com/map/endfield"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Global",
                    "label": "$option.ZiplineImportRegion.cases.Global.label",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "url": "https://game.skport.com/map/endfield"
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "ZiplineImportClearLogin": {
            "type": "switch",
            "label": "$option.ZiplineImportClearLogin.label",
            "description": "$option.ZiplineImportClearLogin.description",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "clear_login": true
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No"
                }
            ]
        }
    }
}
