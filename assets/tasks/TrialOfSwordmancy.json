{
    "task": [
        {
            "name": "TrialOfSwordmancy",
            "label": "$task.TrialOfSwordmancy.label",
            "entry": "TrialOfSwordmancyMain",
            "description": "$task.TrialOfSwordmancy.description",
            "group": [
                "regional_development"
            ],
            "controller": [
                "ADB",
                "CloudADB",
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "PlayCover",
                "Win32-Front"
            ],
            "option": [
                "TrialOfSwordmancyMode"
            ]
        }
    ],
    "option": {
        "TrialOfSwordmancyMode": {
            "type": "select",
            "label": "$option.TrialOfSwordmancyMode.label",
            "description": "$option.TrialOfSwordmancyMode.description",
            "cases": [
                {
                    "name": "Daily",
                    "label": "$option.TrialOfSwordmancyMode.cases.Daily.label",
                    "option": [
                        "TrialOfSwordmancyOverflow",
                        "TrialOfSwordmancyAutoFight"
                    ],
                    "pipeline_override": {
                        "TrialOfSwordmancyDaily": {
                            "enabled": true
                        },
                        "TrialOfSwordmancyDecide": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "FreeCalc",
                    "label": "$option.TrialOfSwordmancyMode.cases.FreeCalc.label",
                    "option": [
                        // "TrialOfSwordmancyAutoFight",
                        "TrialOfSwordmancyFreeCalcBounds"
                    ],
                    "pipeline_override": {
                        "TrialOfSwordmancyFreeCalc": {
                            "enabled": true
                        },
                        "TrialOfSwordmancyFreeCalcDecide": {
                            "enabled": true
                        },
                        "TrialOfSwordmancyRecognizeFullDeck": {
                            "action": "DoNothing"
                        },
                        "TrialOfSwordmancyProbeAbandon": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Daily"
        },
        "TrialOfSwordmancyOverflow": {
            "type": "select",
            "label": "$option.TrialOfSwordmancyOverflow.label",
            "description": "$option.TrialOfSwordmancyOverflow.description",
            "cases": [
                {
                    "name": "None",
                    "label": "$option.TrialOfSwordmancyOverflow.cases.None.label",
                    "pipeline_override": {
                        "TrialOfSwordmancyRecognizeFullDeck": {
                            "custom_action_param": {
                                "overflowMode": "OverflowNone"
                            }
                        }
                    }
                },
                {
                    "name": "Once",
                    "label": "$option.TrialOfSwordmancyOverflow.cases.Once.label",
                    "option": [
                        "TrialOfSwordmancyStopOnOverflow"
                    ],
                    "pipeline_override": {
                        "TrialOfSwordmancyRecognizeFullDeck": {
                            "custom_action_param": {
                                "overflowMode": "OverflowOnce"
                            }
                        }
                    }
                },
                {
                    "name": "Twice",
                    "label": "$option.TrialOfSwordmancyOverflow.cases.Twice.label",
                    "option": [
                        "TrialOfSwordmancyStopOnOverflow"
                    ]
                }
            ],
            "default_case": "None"
        },
        "TrialOfSwordmancyStopOnOverflow": {
            "type": "switch",
            "label": "$option.TrialOfSwordmancyStopOnOverflow.label",
            "description": "$option.TrialOfSwordmancyStopOnOverflow.description",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "TrialOfSwordmancyFinishOnOverflow": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "TrialOfSwordmancyAutoFight": {
            "type": "switch",
            "label": "$option.TrialOfSwordmancyAutoFight.label",
            "description": "$option.TrialOfSwordmancyAutoFight.description",
            "cases": [
                {
                    "name": "No",
                    "option": [
                        "TrialOfSwordmancyReturnToWorld"
                    ],
                    "pipeline_override": {
                        "TrialOfSwordmancyStartTrial": {
                            "action": "DoNothing",
                            "next": []
                        }
                    }
                },
                {
                    "name": "Yes",
                    "option": [
                        "AutoFightSetting",
                        "TrialOfSwordmancyRecoverBeforeBattle"
                    ],
                    "pipeline_override": {
                        "AutoFight": {
                            "attach": {
                                "pause_exit_nodes": [
                                    "TrialOfSwordmancyFightFinish"
                                ]
                            }
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "TrialOfSwordmancyRecoverBeforeBattle": {
            "type": "switch",
            "label": "$option.TrialOfSwordmancyRecoverBeforeBattle.label",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "TrialOfSwordmancyFightSuccess": {
                            "next": [
                                "TrialOfSwordmancyFightSuccessLeave"
                            ]
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "TrialOfSwordmancyReturnToWorld": {
            "type": "switch",
            "label": "$option.TrialOfSwordmancyReturnToWorld.label",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "TrialOfSwordmancyStartTrial": {
                            "next": [
                                "SceneAnyEnterWorld"
                            ]
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "TrialOfSwordmancyFreeCalcBounds": {
            "type": "input",
            "label": "$option.TrialOfSwordmancyFreeCalcBounds.label",
            "inputs": [
                {
                    "name": "TrialOfSwordmancyFreeCalcLowerBound",
                    "label": "$option.TrialOfSwordmancyFreeCalcBounds.TrialOfSwordmancyFreeCalcLowerBound.label",
                    "default": "21",
                    "pipeline_type": "int",
                    "verify": "^(?:[1-9]|1\\d|2[0-5])$",
                    "pattern_msg": "$option.TrialOfSwordmancyFreeCalcBounds.pattern_msg"
                },
                {
                    "name": "TrialOfSwordmancyFreeCalcUpperBound",
                    "label": "$option.TrialOfSwordmancyFreeCalcBounds.TrialOfSwordmancyFreeCalcUpperBound.label",
                    "default": "21",
                    "pipeline_type": "int",
                    "verify": "^(?:[1-9]|1\\d|2[0-5])$",
                    "pattern_msg": "$option.TrialOfSwordmancyFreeCalcBounds.pattern_msg"
                }
            ],
            "pipeline_override": {
                "TrialOfSwordmancyFreeCalcDecide": {
                    "custom_action_param": {
                        "lower_bound": "{TrialOfSwordmancyFreeCalcLowerBound}",
                        "upper_bound": "{TrialOfSwordmancyFreeCalcUpperBound}"
                    }
                }
            }
        }
    }
}
