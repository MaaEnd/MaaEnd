        // },
        {
            "name": "ADB",
            "label": "$controller.ADB.label",
            "description": "$controller.ADB.description",
            "type": "Adb",
            "attach_resource_path": [
                "./resource_adb"
            ]
        },
        {
            "name": "CloudADB",
            "label": "$controller.CloudADB.label",
            "description": "$controller.CloudADB.description",
            "type": "Adb",
            "attach_resource_path": [
                "./resource_adb",
                "./resource_cloud_adb"
            ],
            "option": [
                "ClientVersionCloudLocked"
            ]
        },
        {
            "name": "PlayCover",
            "type": "PlayCover",
            "playcover": {
                "uuid": "maa.playcover"
            },
            "attach_resource_path": [
                "./resource_adb",
                "./resource_playcover"
            ]
        },
        {
            "name": "Linux-Gamescope",
            "label": "$controller.Linux-Gamescope.label",
            "description": "$controller.Linux-Gamescope.description",
            "type": "Linux",
            "attach_resource_path": [
                "./resource_linux"
            ],
            "linux": {
                "input": "Libei",
                "screencap": "PipeWire",
                "pipewire_source": "Gamescope",
                "use_win32_vk_code": true
            }
        },
        {
            "name": "Linux-ScreenCast",
            "label": "$controller.Linux-ScreenCast.label",
            "description": "$controller.Linux-ScreenCast.description",
            "type": "Linux",
            "attach_resource_path": [
                "./resource_linux"
            ],
            "linux": {
                "input": "UInput",
                "screencap": "PipeWire",
                "pipewire_source": "Portal",
                "use_win32_vk_code": true
            }
        },
        {
            "name": "Linux-Wlroots",
            "label": "$controller.Linux-Wlroots.label",
            "description": "$controller.Linux-Wlroots.description",
            "type": "Linux",
            "attach_resource_path": [
                "./resource_linux"
            ],
            "linux": {
                "input": "Wlr",
                "screencap": "Wlr",
                "use_win32_vk_code": true
            }
        },
        {
            "name": "MacOS-Front",
            "label": "$controller.MacOS-Front.label",
            "description": "$controller.MacOS-Front.description",
            "type": "MacOS",
            "macos": {
                "title_regex": "Endfield",
                "screencap": "ScreenCaptureKit",
                "input": "GlobalEvent"
            },
            "attach_resource_path": [
                "./resource_macos"
            ]
        },
        {
            "name": "MacOS-Background",
            "label": "$controller.MacOS-Background.label",
            "description": "$controller.MacOS-Background.description",
            "type": "MacOS",
            "macos": {
                "title_regex": "Endfield",
                "screencap": "ScreenCaptureKit",
                "input": "PostToPid"
            },
            "attach_resource_path": [
                "./resource_macos"
            ]
        }
    ],
    "resource": [
        {
            "name": "官服",
            "label": "$resource.CN.label",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": [
        {
            "child_exec": "agent/go-service"
        },
        {
            "child_exec": "agent/cpp-algo",
            "child_args": []
        }
