{
    // 移动端（尤其云终末地）画面有延迟：精确点击后立即复查会读到点击前的数量（实测读到滑到最大时的 960），
    // 按旧读数走一轮微调或校准都会算错。点击后等画面稳定再复查，最多等 2s
    "BetterSlidingPreciseClick": {
        "post_wait_freezes": {
            "time": 500,
            // 精确点击是直接点坐标，识别框为空，不写 target 时 wait_freezes 取不到区域直接跳过
            "target": [
                0,
                0,
                0,
                0
            ],
            "timeout": 2000
        }
    }
}
