{
    "__AutoEssenceRecoEssenceTrigger": {
        "desc": "正式识别并点击激发的大世界按钮（ADB）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    640,
                    300,
                    270,
                    290
                ],
                "template": "AdbOnly/AutoEssence/EssenceTrigger.png",
                "green_mask": true,
                "threshold": 0.75
            }
        }
    },
    "AutoEssenceMistakeFactoryDevice": {
        "desc": "识别是否误入工业设备界面，并将其关闭（ADB）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1105,
                    10,
                    175,
                    150
                ],
                "template": "AutoEssence/FactoryDeviceDialog.png"
            }
        },
        "action": {
            "type": "Click", // 此处点击的是工业设备界面的关闭按钮
            "param": {
                "target_offset": [
                    60,
                    5,
                    -60,
                    -10
                ]
            }
        }
    },
    "AutoEssenceClickObtainButton": {
        "desc": "识别领取奖励的大世界按钮（ADB）；等待与复检流程沿用主 Pipeline",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    660,
                    280,
                    290,
                    320
                ],
                "template": "AdbOnly/AutoEssence/EssenceObtain.png",
                "green_mask": true,
                "threshold": 0.55,
                "order_by": "Score"
            }
        }
    },
    "AutoEssenceClickObtainButtonRecheck": {
        "desc": "再次识别领取奖励按钮并 Alt 点击（ADB）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    660,
                    280,
                    290,
                    320
                ],
                "template": "AdbOnly/AutoEssence/EssenceObtain.png",
                "green_mask": true,
                "threshold": 0.55,
                "order_by": "Score"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AutoAltClickAction",
                "custom_action_param": {
                    "target_offset": [
                        -10,
                        20,
                        -10,
                        -75
                    ]
                }
            }
        }
    }
}
