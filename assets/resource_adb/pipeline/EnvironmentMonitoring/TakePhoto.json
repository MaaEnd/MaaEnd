{
    "EnvironmentMonitoringEnterCameraMode": {
        "action": "Click"
    },
    "EnterCameraModeClick": {
        "action": "Click"
    },
    // 移动端没有 R 键：按住右侧工具键，轮盘按手指相对按键中心的方向选工具，松开确认
    "EnterCameraModeLongPress": {
        "action": "Custom",
        "custom_action": "TouchInputAction",
        "custom_action_param": {
            "node": "EnterCameraModeLongPressTouchAction"
        },
        "timeout": 5000,
        // 轮盘开着就往下走：中心是「选择工具」最好；已经预选了某个工具时直接认拍照图标，
        // 否则 InSelectTool 永远等不到，手指一直按着
        "next": [
            "EnterCameraModeInSelectTool",
            "EnterCameraModeChooseCamera"
        ],
        "on_error": [
            "EnterCameraModeReleaseOnError"
        ]
    },
    "EnterCameraModeInSelectTool": {
        "timeout": 5000,
        "on_error": [
            "EnterCameraModeReleaseOnError"
        ]
    },
    "EnterCameraModeChooseCamera": {
        "action": "Custom",
        "custom_action": "TouchInputAction",
        "custom_action_param": {
            "node": "EnterCameraModeChooseCameraTouchAction"
        },
        "timeout": 5000,
        "on_error": [
            "EnterCameraModeReleaseOnError"
        ]
    },
    "EnterCameraModeKeyUp": {
        // 游戏按帧读摇杆：拖动后几毫秒就松开，会落进同一帧，高亮还没切过去就按原选择取消了。
        // 先确认中心不再是「选择工具」（游戏已经处理了这次拖动），再等画面稳住（高亮切换画完）才松开
        "recognition": "And",
        "all_of": [
            "InSelectTool"
        ],
        "inverse": true,
        "pre_wait_freezes": {
            "time": 100,
            "timeout": 3000
        },
        "action": "Custom",
        "custom_action": "TouchInputAction",
        "custom_action_param": {
            "node": "EnterCameraModeKeyUpTouchAction"
        },
        "on_error": [
            "EnterCameraModeReleaseOnError"
        ]
    },
    "EnterCameraModeReleaseOnError": {
        "desc": "进入拍照模式失败，松开按住的工具键；随后仍按失败结束，交给上层记录",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "TouchInputAction",
        "custom_action_param": {
            "node": "EnterCameraModeReleaseOnErrorTouchAction"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "FailedNode"
        ]
    },
    "EnterCameraModeLongPressTouchAction": {
        "action": "TouchDown",
        "target": [
            1176,
            282,
            4,
            4
        ],
        "auto_up": true
    },
    "EnterCameraModeChooseCameraTouchAction": {
        "action": "TouchMove",
        "target": [
            1112,
            218,
            10,
            10
        ]
    },
    "EnterCameraModeKeyUpTouchAction": {
        "action": "TouchUp"
    },
    "EnterCameraModeReleaseOnErrorTouchAction": {
        "action": "TouchUp"
    }
}
