<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe：Windows 图形程序（不弹控制台）；需要控制台时用 console 参数 -->
    <OutputType>WinExe</OutputType>
    <!-- 本机只有 .NET 10 目标包；WinForms 必须带 -windows 后缀 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 声明清单：DPI/长路径 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MaaEndWebHost</AssemblyName>
    <!-- x64：WebView2 运行时按架构分发，明确指定避免 AnyCPU 的坑 -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- DPI 由这里统一配置（manifest 里就别再写 dpiAware，否则编译器会警告 WFAC010） -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- 版本写死保证可复现；本机 NuGet 缓存已有 1.0.4258.31 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
