{
    "version": 5,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "NinjaMulti Win32",
            "displayName": "Ninja MultiConfig Win32",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build",
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "NinjaMulti Win32 ARM64",
            "displayName": "Ninja MultiConfig Win32 ARM64",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build-arm64",
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "architecture": {
                "value": "ARM64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Release",
            "configurePreset": "NinjaMulti Win32",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "Release ARM64",
            "configurePreset": "NinjaMulti Win32 ARM64",
            "configuration": "RelWithDebInfo"
        }
    ]
}
